# Monolithic deployment configuration (React + Vite)
# New Vite environment variables
VITE_API_BASE_URL=http://localhost:8080/api
VITE_SIGNALR_URL=http://localhost:8080/hubs/printers

# Legacy variables (deprecated) kept for reference; do not use
# REACT_APP_API_BASE_URL=http://localhost:8080
# REACT_APP_SIGNALR_URL=http://localhost:8080/hubs/printers

# For monolithic deployment (default)
# DEPLOYMENT_MODE=monolithic

# Optional: override SPA dev server URL (defaults to http://localhost:3000 during development)
# SPA_DEV_URL=http://localhost:3000
# Optional: tweak probe timeout (ms) for SPA dev server availability
# SPA_PROXY_PROBE_TIMEOUT_MS=500
