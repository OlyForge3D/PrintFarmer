# PrintFarmer Docker Configuration
# Generated by deploy-docker.sh on Mon Oct  6 12:57:28 PDT 2025

# Architecture
DEPLOYMENT_TYPE=monolithic

# Application Settings
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:8080

# Database Configuration
DB_PROVIDER=sqlite
ConnectionStrings__Default=Data Source=/data/farm.db

# Network Configuration
ALLOW_LOCAL_NETWORK=true
ALLOWED_NETWORK_RANGES=192.168.0.0/16,10.0.0.0/8
NETWORK_MODE=bridge
DOCKER_HOST_NETWORK=false

# CORS Configuration
CORS__AllowedOrigins=http://localhost:3000,http://localhost:8080

# Feature Flags  
ENABLE_SWAGGER=false
ENABLE_DETAILED_LOGGING=false
ENABLE_DISTRIBUTED_SLICING=true
ORCA_WORKER_COUNT=1
PRUSA_WORKER_COUNT=0
ENABLE_ORCA_WORKER=yes
ENABLE_PRUSA_WORKER=no
ORCA_HOST_PORT=8081
PRUSA_HOST_PORT=8082

# Spoolman
SPOOLMAN_ENABLED=no
SPOOLMAN_BASE_URL=
SPOOLMAN_PORT=

# Port Configuration
HTTP_PORT=8080
