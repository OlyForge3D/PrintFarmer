#!/bin/bash

set -e

# PrintFarmer Development CLI
# Fast rebuild/redeploy for individual services during development
#
# Usage: pfdev <command> [service]
# Commands: redeploy, build, deploy, help, install, uninstall
# Services: api, frontend, orcaslicer-worker, printer-discovery, nginx
#
# IMPORTANT: This script does NOT generate docker-compose.yml
# Only ./scripts/deploy-docker.sh should generate that file.
# If docker-compose.yml is missing, you must run deploy-docker.sh first.

# Get the real path of this script (resolve symlinks)
SCRIPT_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/pfdev"
if [[ -L "${BASH_SOURCE[0]}" ]]; then
    SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
fi
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
SYMLINK_PATH="/usr/local/bin/pfdev"
COMPOSE_FILE="$REPO_ROOT/docker-compose.yml"
DEPLOY_CONFIG_FILE="$REPO_ROOT/.deploy-config"
CERT_SCRIPT="$REPO_ROOT/scripts/generate-certs.sh"
CERT_DIR="$REPO_ROOT/deploy/nginx/certs"
LEGACY_CERT_DIR="$REPO_ROOT/nginx/certs"

# Ensure symlink exists for global access
ensure_symlink() {
    if [[ ! -L "$SYMLINK_PATH" ]] || [[ "$(readlink "$SYMLINK_PATH")" != "$SCRIPT_PATH" ]]; then
        echo "📍 Setting up global pfdev command..."
        if sudo ln -sf "$SCRIPT_PATH" "$SYMLINK_PATH"; then
            echo "✅ pfdev is now available globally as 'pfdev'"
        else
            echo "⚠️  Could not create symlink. You may need to run: sudo ln -sf $SCRIPT_PATH $SYMLINK_PATH"
        fi
    fi
}

# Remove symlink
remove_symlink() {
    if [[ -L "$SYMLINK_PATH" ]]; then
        echo "🗑️  Removing global pfdev command..."
        if sudo rm "$SYMLINK_PATH"; then
            echo "✅ pfdev symlink removed"
        else
            echo "⚠️  Could not remove symlink. You may need to run: sudo rm $SYMLINK_PATH"
        fi
    else
        echo "ℹ️  No pfdev symlink found at $SYMLINK_PATH"
    fi
}

# Service configuration (user-facing alias : docker compose service)
SERVICES=(
    "api:api"
    "frontend:frontend"
    "orcaslicer-worker:orcaslicer-worker"
    "printer-discovery:printer-discovery"
    "nginx:nginx-proxy"
)

# Dockerfile paths (kept for reference if needed)
DOCKERFILES=(
    "api:Dockerfile.api"
    "frontend:Dockerfile.frontend"
    "orcaslicer-worker:Dockerfile"
    "printer-discovery:Dockerfile.printer-discovery"
    "nginx:Dockerfile.nginx-proxy"
)

resolve_service() {
    local requested_service=$1
    local service_entry
    local service_alias

    for service_entry in "${SERVICES[@]}"; do
        service_alias=${service_entry%%:*}
        if [[ "$service_alias" == "$requested_service" ]]; then
            echo "${service_entry#*:}"
            return 0
        fi
    done

    return 1
}

load_deployment_env() {
    if [[ -f "$DEPLOY_CONFIG_FILE" ]]; then
        set -a
        # shellcheck disable=SC1090
        source "$DEPLOY_CONFIG_FILE"
        set +a
    fi
}

check_required_files() {
    local missing_files=()

    if [[ ! -f "$COMPOSE_FILE" ]]; then
        missing_files+=("docker-compose.yml")
    fi

    if [[ ! -f "$REPO_ROOT/Dockerfile.multistage" ]]; then
        missing_files+=("Dockerfile.multistage")
    fi

    if [[ ! -f "$REPO_ROOT/docker-entrypoint-config.sh" ]]; then
        missing_files+=("docker-entrypoint-config.sh")
    fi

    if [[ ${#missing_files[@]} -gt 0 ]]; then
        echo "❌ Required generated files are missing:"
        for file in "${missing_files[@]}"; do
            echo "   - $file"
        done
        echo ""
        echo "These files are generated by the deployment script."
        echo "Run: ./scripts/deploy-docker.sh"
        echo ""
        exit 1
    fi
}

tls_cert_dir_needs_refresh() {
    local cert_dir=$1
    local cert_text

    if [[ ! -f "$cert_dir/tls.crt" || ! -f "$cert_dir/tls.key" || ! -f "$cert_dir/ca.crt" || ! -f "$cert_dir/ca.cer" || ! -f "$cert_dir/tls-fullchain.crt" ]]; then
        return 0
    fi

    if ! command -v openssl >/dev/null 2>&1; then
        return 1
    fi

    cert_text=$(openssl x509 -in "$cert_dir/tls.crt" -noout -text 2>/dev/null || true)
    if [[ -z "$cert_text" ]]; then
        return 0
    fi

    if [[ "$cert_text" != *"CA:FALSE"* ]]; then
        return 0
    fi

    if [[ "$cert_text" != *"TLS Web Server Authentication"* ]]; then
        return 0
    fi

    if ! openssl verify -CAfile "$cert_dir/ca.crt" "$cert_dir/tls.crt" >/dev/null 2>&1; then
        return 0
    fi

    return 1
}

tls_cert_needs_refresh() {
    if tls_cert_dir_needs_refresh "$CERT_DIR"; then
        return 0
    fi

    if [[ -d "$(dirname "$LEGACY_CERT_DIR")" ]] && tls_cert_dir_needs_refresh "$LEGACY_CERT_DIR"; then
        return 0
    fi

    return 1
}

ensure_tls_certificates() {
    local requested_service=$1

    case "$requested_service" in
        nginx|frontend)
            ;;
        *)
            return 0
            ;;
    esac

    if tls_cert_needs_refresh; then
        if [[ ! -x "$CERT_SCRIPT" ]]; then
            echo "❌ Missing certificate generator: $CERT_SCRIPT"
            exit 1
        fi

        echo "🔐 Refreshing nginx TLS certificates... [$(date '+%H:%M:%S')]"
        (
            cd "$REPO_ROOT"
            "$CERT_SCRIPT"
        )
        echo "✅ Refreshed nginx TLS certificates [$(date '+%H:%M:%S')]"
    fi
}

print_usage() {
    cat << EOF
PrintFarmer Development CLI

Usage: pfdev <command> [service1] [service2] ...

Commands:
  redeploy <service...>  Build and deploy service(s) (most common)
  build <service...>     Build service(s) Docker image only
  deploy <service...>    Deploy service(s) (image must already exist)
  install                Create global symlink to use 'pfdev' from anywhere
  uninstall              Remove global symlink
  help                   Show this help message

Available Services:
  • api
  • frontend
  • orcaslicer-worker
  • printer-discovery
  • nginx

Examples:
  pfdev redeploy api
  pfdev redeploy api frontend
  pfdev build frontend orcaslicer-worker
  pfdev deploy api nginx
EOF
}

build_image() {
    local service=$1
    local compose_service
    local start_time=$(date +%s)

    check_required_files
    ensure_tls_certificates "$service"
    compose_service=$(resolve_service "$service")
    
    echo "📦 Building $service... [$(date '+%H:%M:%S')]"
    cd "$REPO_ROOT"
    # Force cache invalidation by removing the image first
    docker rmi "printfarmer-$compose_service:latest" 2>/dev/null || true
    # Don't use --pull since we use local upgraded base images
    DOCKER_BUILDKIT=1 docker compose build --no-cache "$compose_service"
    
    local end_time=$(date +%s)
    local elapsed=$((end_time - start_time))
    echo "✅ Successfully built $service [$(date '+%H:%M:%S')] (${elapsed}s)"
}

deploy_service() {
    local service=$1
    local compose_service
    local start_time=$(date +%s)

    check_required_files
    ensure_tls_certificates "$service"
    compose_service=$(resolve_service "$service")
    
    echo "🚀 Deploying $service... [$(date '+%H:%M:%S')]"
    cd "$REPO_ROOT"
    docker compose up -d --remove-orphans "$compose_service"
    
    local end_time=$(date +%s)
    local elapsed=$((end_time - start_time))
    echo "✅ Successfully deployed $service [$(date '+%H:%M:%S')] (${elapsed}s)"
}

redeploy_service() {
    local service=$1
    local start_time=$(date +%s)
    
    echo "🔄 Redeploying $service... [$(date '+%H:%M:%S')]"
    build_image "$service" || return 1
    deploy_service "$service" || return 1
    
    local end_time=$(date +%s)
    local elapsed=$((end_time - start_time))
    echo "✅ Successfully redeployed $service [$(date '+%H:%M:%S')] (${elapsed}s)"
}

# Main
if [[ $# -lt 1 ]]; then
    ensure_symlink
    print_usage
    exit 1
fi

COMMAND=$1
SERVICE=$2

# Only ensure symlink on first run or help command
if [[ "$COMMAND" == "help" ]] || [[ "$COMMAND" == "-h" ]] || [[ "$COMMAND" == "--help" ]]; then
    ensure_symlink
fi

case "$COMMAND" in
    redeploy)
        if [[ $# -lt 2 ]]; then
            echo "❌ At least one service name required"
            print_usage
            exit 1
        fi
        shift  # Remove command from args
        for SERVICE in "$@"; do
            if ! resolve_service "$SERVICE" >/dev/null; then
                echo "❌ Unknown service: $SERVICE"
                echo ""
                print_usage
                exit 1
            fi
            redeploy_service "$SERVICE" || exit 1
        done
        ;;
    build)
        if [[ $# -lt 2 ]]; then
            echo "❌ At least one service name required"
            print_usage
            exit 1
        fi
        shift  # Remove command from args
        for SERVICE in "$@"; do
            if ! resolve_service "$SERVICE" >/dev/null; then
                echo "❌ Unknown service: $SERVICE"
                echo ""
                print_usage
                exit 1
            fi
            build_image "$SERVICE" || exit 1
        done
        ;;
    deploy)
        if [[ $# -lt 2 ]]; then
            echo "❌ At least one service name required"
            print_usage
            exit 1
        fi
        shift  # Remove command from args
        for SERVICE in "$@"; do
            if ! resolve_service "$SERVICE" >/dev/null; then
                echo "❌ Unknown service: $SERVICE"
                echo ""
                print_usage
                exit 1
            fi
            deploy_service "$SERVICE" || exit 1
        done
        ;;
    install)
        ensure_symlink
        ;;
    uninstall)
        remove_symlink
        ;;
    help|-h|--help)
        print_usage
        ;;
    *)
        echo "❌ Unknown command: $COMMAND"
        echo ""
        print_usage
        exit 1
        ;;
esac
