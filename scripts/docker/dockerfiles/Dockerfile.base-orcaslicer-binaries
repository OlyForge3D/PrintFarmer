############################################################
# OrcaSlicer Binary Layer - Pre-extracted and cached
# Downloads and extracts OrcaSlicer binaries for offline use
# This layer is used in the multistage build as a cache layer
############################################################

# Global ARGs must be declared before the first FROM to remain available to all stages.
ARG ORCASLICER_VERSION=2.4.2
ARG ORCASLICER_SHA256=d12fb8c8eac1aecd2dfb6377acd48f994f8fa439ed5292fa532dd82880f029fd

FROM --platform=linux/amd64 ubuntu:24.04 AS orcaslicer-binaries-base
ARG ORCASLICER_VERSION
ARG ORCASLICER_SHA256
ARG ORCASLICER_URL=https://github.com/OrcaSlicer/OrcaSlicer/releases/download/v${ORCASLICER_VERSION}/OrcaSlicer_Linux_AppImage_Ubuntu2404_V${ORCASLICER_VERSION}.AppImage
ARG CACHE_BUST=latest
WORKDIR /tmp

RUN echo "Cache bust: ${CACHE_BUST}" && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        curl ca-certificates p7zip-full squashfs-tools libarchive-tools file \
    && rm -rf /var/lib/apt/lists/*

# A precached layer is a release artifact, not a development fallback. Download
# exactly the configured x86_64 AppImage, verify its official digest, and fail
# instead of creating a version-labelled stub.
RUN set -e; \
    if [ -z "${ORCASLICER_SHA256}" ]; then \
        echo "[orcaslicer-binaries] ERROR: ORCASLICER_SHA256 is required"; \
        exit 1; \
    fi; \
    echo "[orcaslicer-binaries] Downloading OrcaSlicer ${ORCASLICER_VERSION}"; \
    curl -H "User-Agent: OrcaSlicerWorker/1.0" -fSL \
        -o orcaslicer.AppImage "${ORCASLICER_URL}"; \
    echo "${ORCASLICER_SHA256}  orcaslicer.AppImage" > orcaslicer.AppImage.sha256; \
    sha256sum --check --strict orcaslicer.AppImage.sha256; \
    chmod +x orcaslicer.AppImage; \
    if unsquashfs -d squashfs-root orcaslicer.AppImage >/dev/null 2>&1; then \
        :; \
    elif ./orcaslicer.AppImage --appimage-extract >/dev/null 2>&1; then \
        :; \
    else \
        echo "[orcaslicer-binaries] ERROR: failed to extract verified AppImage"; \
        exit 1; \
    fi; \
    mkdir -p /orcaslicer-dist/opt; \
    mv squashfs-root /orcaslicer-dist/opt/orcaslicer; \
    cp /orcaslicer-dist/opt/orcaslicer/AppRun /orcaslicer-dist/orcaslicer; \
    chmod +x /orcaslicer-dist/orcaslicer; \
    printf '%s' "${ORCASLICER_VERSION}" > /orcaslicer-dist/orcaslicer.version; \
    printf '%s' "${ORCASLICER_SHA256}" > /orcaslicer-dist/orcaslicer.sha256; \
    test -d /orcaslicer-dist/opt/orcaslicer/resources/profiles; \
    echo "[orcaslicer-binaries] Verified OrcaSlicer ${ORCASLICER_VERSION} binary layer"

# Keep the /orcaslicer-dist prefix expected by Dockerfile.multistage.
FROM scratch AS orcaslicer-binaries
ARG ORCASLICER_VERSION
ARG ORCASLICER_SHA256
COPY --from=orcaslicer-binaries-base /orcaslicer-dist /orcaslicer-dist

LABEL prebuild="true" \
      purpose="orcaslicer-binaries" \
      version="${ORCASLICER_VERSION}" \
      orcaslicer.version="${ORCASLICER_VERSION}" \
      orcaslicer.sha256="${ORCASLICER_SHA256}" \
      orcaslicer.allow_stub="false"
