# syntax=docker/dockerfile:1
############################################################
# Multi-Stage PrintFarmer Build
# Builds all .NET projects once and creates efficient runtime containers
# This approach avoids rebuilding shared libraries in each worker container
############################################################

# Global build arguments
ARG ORCASLICER_VERSION=2.3.1
ARG BUILD_VERBOSITY=quiet

# Base image tags - use pre-cached upgraded images for faster builds
# Build these with: docker build -f dockerfiles/Dockerfile.base-sdk -t mcr.microsoft.com/dotnet/sdk:9.0-upgraded .
ARG SDK_TAG=9.0-upgraded
ARG ASPNET_TAG=9.0-bookworm-slim-upgraded
ARG NODE_TAG=22-alpine
ARG NGINX_TAG=alpine-upgraded
ARG UBUNTU_TAG=24.04-upgraded

############################################################
# Shared Build Stage - Build all .NET projects once
############################################################
FROM mcr.microsoft.com/dotnet/sdk:${SDK_TAG} AS shared-build
WORKDIR /src

# Copy all project files for dependency resolution
COPY Directory.Build.props ./
COPY global.json ./
COPY src/infra/*.csproj ./infra/
COPY src/import/*.csproj ./import/
COPY src/api/*.csproj ./api/
COPY src/worker-shared/*.csproj ./worker-shared/
COPY src/orcaslicer-worker/*.csproj ./orcaslicer-worker/
COPY src/printer-discovery/*.csproj ./printer-discovery/
COPY src/Slicers/Farm.Slicers.OrcaSlicer.v2_3_1/*.csproj ./Slicers/Farm.Slicers.OrcaSlicer.v2_3_1/
# Place proto at filesystem root so ../../proto from /src/api resolves
COPY proto /proto

# Restore all dependencies in one go
RUN dotnet restore ./api/Farm.Web.Api.csproj && \
    dotnet restore ./orcaslicer-worker/Farm.OrcaSlicer.Worker.csproj && \
    dotnet restore ./printer-discovery/PrinterDiscoveryService.csproj && \
    dotnet restore ./Slicers/Farm.Slicers.OrcaSlicer.v2_3_1/Farm.Slicers.OrcaSlicer.v2_3_1.csproj

# Copy all source code
COPY src/ ./
# Ensure proto still present at /proto
COPY proto /proto

# Build and publish all services: sequential restore, then sequential publish
# Using BUILD_VERBOSITY argument: quiet, minimal, normal, or detailed
RUN --mount=type=cache,target=/root/.nuget/packages \
    dotnet restore ./api/Farm.Web.Api.csproj && \
    dotnet restore ./orcaslicer-worker/Farm.OrcaSlicer.Worker.csproj && \
    dotnet restore ./printer-discovery/PrinterDiscoveryService.csproj && \
    echo "Publishing API..." && \
    dotnet publish ./api/Farm.Web.Api.csproj -c Release -o /app/publish/api --no-restore --verbosity ${BUILD_VERBOSITY:-quiet} && \
    echo "Publishing OrcaSlicer Worker..." && \
    dotnet publish ./orcaslicer-worker/Farm.OrcaSlicer.Worker.csproj -c Release -o /app/publish/orcaslicer-worker --no-restore --verbosity ${BUILD_VERBOSITY:-quiet} && \
    echo "Publishing Printer Discovery..." && \
    dotnet publish ./printer-discovery/PrinterDiscoveryService.csproj -c Release -o /app/publish/printer-discovery --no-restore --verbosity ${BUILD_VERBOSITY:-quiet}

# Verify critical runtime files exist and fail immediately if any are missing
RUN echo "Checking published artifacts..." && \
    echo "API publish directory:" && ls -lah /app/publish/api/ 2>&1 | head -20 && \
    echo "OrcaSlicer Worker publish directory:" && ls -lah /app/publish/orcaslicer-worker/ 2>&1 | head -20 && \
    echo "Printer Discovery publish directory:" && ls -lah /app/publish/printer-discovery/ 2>&1 | head -20 && \
    ([ -f /app/publish/api/Farm.Web.Api.dll ] || (echo "✗ MISSING: /app/publish/api/Farm.Web.Api.dll"; exit 1)) && \
    ([ -f /app/publish/orcaslicer-worker/Farm.OrcaSlicer.Worker.dll ] || (echo "✗ MISSING: /app/publish/orcaslicer-worker/Farm.OrcaSlicer.Worker.dll"; exit 1)) && \
    ([ -f /app/publish/printer-discovery/PrinterDiscoveryService.dll ] || (echo "✗ MISSING: /app/publish/printer-discovery/PrinterDiscoveryService.dll"; exit 1)) && \
    echo "✓ All .NET builds completed successfully"

############################################################
# API Runtime Container
############################################################
FROM mcr.microsoft.com/dotnet/aspnet:${ASPNET_TAG} AS api-runtime
WORKDIR /app
EXPOSE 5000

# Create necessary directories with proper ownership
# Note: appuser (UID 1000) is pre-created in base image, tools are pre-installed
RUN mkdir -p /app/uploads /app/gcode /app/slicers /data /app/wwwroot/gcode-library && \
    chown -R appuser:appuser /app

# Copy API binaries from shared build stage (as appuser)
COPY --chown=appuser:appuser --from=shared-build /app/publish/api .

# Set environment
ENV ASPNETCORE_WEBROOT=/app/wwwroot
ENV ASPNETCORE_URLS=http://+:5000
ENV ASPNETCORE_ENVIRONMENT=Production
ENV GCODE_STORAGE_PATH=/app/gcode
ENV MODEL_UPLOAD_PATH=/app/uploads
ENV SLICER_PROFILES_PATH=/app/profiles

# Run as non-root user
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=5 \
    CMD curl -f http://localhost:5000/healthz || exit 1

ENTRYPOINT ["dotnet", "Farm.Web.Api.dll"]

############################################################
# OrcaSlicer Binary Layer (cached layer for binary assets)
############################################################
FROM ubuntu:${UBUNTU_TAG} AS orcaslicer-binaries
ARG ORCASLICER_VERSION
ARG ORCASLICER_URL=https://github.com/SoftFever/OrcaSlicer/releases/download/v${ORCASLICER_VERSION}/OrcaSlicer_Linux_V${ORCASLICER_VERSION}.AppImage
ARG ALLOW_STUB=true
ARG GITHUB_TOKEN
WORKDIR /tmp

# Note: All extraction tools (curl, jq, p7zip-full, squashfs-tools, etc.) are pre-installed in base image

# Download and extract OrcaSlicer binaries with robust error handling
RUN set -e; \
    echo "[orcaslicer-binaries] Resolving OrcaSlicer version=${ORCASLICER_VERSION}"; \
    mkdir -p /orcaslicer-dist/opt; \
    \
    if [ "$ALLOW_STUB" = "true" ]; then \
        echo "[orcaslicer-binaries] ALLOW_STUB=true, will create stub if download fails"; \
    else \
        echo "[orcaslicer-binaries] ALLOW_STUB=false, must download real binary"; \
    fi; \
    \
    # Try to find the correct download URL dynamically \
    dynamic_url=$(curl -H "Accept: application/vnd.github+json" \
                      -H "User-Agent: OrcaSlicerWorker/1.0" \
                      -fsSL "https://api.github.com/repos/SoftFever/OrcaSlicer/releases" | \
                  jq -r --arg ver "v${ORCASLICER_VERSION}" \
                     '.[] | select(.tag_name==$ver) | .assets[] | select(.name | test("(?i)(orca)?slicer.*(linux).*(x86_64|amd64).*AppImage$") or test("(?i)(orca)?slicer.*(aarch64|arm64).*AppImage$") or test("(?i)AppImage$")) | .browser_download_url' | \
                  head -n1 || true); \
    \
    if [ -n "$dynamic_url" ]; then \
        echo "[orcaslicer-binaries] Discovered asset: $dynamic_url"; \
        ORCASLICER_URL="$dynamic_url"; \
    fi; \
    \
    # Download function with validation \
    try_download() { \
        url="$1"; \
        echo "[orcaslicer-binaries] Attempting download: $url"; \
        if curl -H "User-Agent: OrcaSlicerWorker/1.0" -fSL -o orcaslicer.AppImage.tmp "$url"; then \
            size=$(stat -c%s orcaslicer.AppImage.tmp 2>/dev/null || echo 0); \
            if [ "$size" -gt 5000000 ]; then \
                mv orcaslicer.AppImage.tmp orcaslicer.AppImage; \
                echo "[orcaslicer-binaries] Download successful (size: $size bytes)"; \
                return 0; \
            else \
                echo "[orcaslicer-binaries] Download too small (size $size < 5MB), invalid"; \
            fi; \
        fi; \
        rm -f orcaslicer.AppImage.tmp || true; \
        return 1; \
    }; \
    \
    # Try multiple URL patterns \
    try_download "${ORCASLICER_URL}" \
    || try_download "https://github.com/SoftFever/OrcaSlicer/releases/download/v${ORCASLICER_VERSION}/OrcaSlicer_V${ORCASLICER_VERSION}_Linux_x86_64.AppImage" \
    || try_download "https://github.com/SoftFever/OrcaSlicer/releases/download/v${ORCASLICER_VERSION}/OrcaSlicer_Linux_V${ORCASLICER_VERSION}.AppImage" \
    || echo "[orcaslicer-binaries] WARNING: All download attempts failed"; \
    \
    # Extract AppImage if available \
    if [ -f orcaslicer.AppImage ]; then \
        chmod +x orcaslicer.AppImage; \
        arch=$(uname -m); \
        echo "[orcaslicer-binaries] File magic: $( (command -v file >/dev/null 2>&1 && file orcaslicer.AppImage) || echo 'file N/A')"; \
        echo "[orcaslicer-binaries] Host build arch: $arch"; \
        \
        if [ "$arch" = "x86_64" ] || [ "$arch" = "aarch64" ] || [ "$arch" = "arm64" ]; then \
            echo "[orcaslicer-binaries] Attempting unsquashfs extraction"; \
            if unsquashfs -d squashfs-root orcaslicer.AppImage >/dev/null 2>&1; then \
                mv squashfs-root /orcaslicer-dist/opt/orcaslicer; \
                cp /orcaslicer-dist/opt/orcaslicer/AppRun /orcaslicer-dist/orcaslicer 2>/dev/null || true; \
                echo "[orcaslicer-binaries] unsquashfs extraction successful"; \
            elif ./orcaslicer.AppImage --appimage-extract 2>extract.err; then \
                mv squashfs-root /orcaslicer-dist/opt/orcaslicer; \
                cp /orcaslicer-dist/opt/orcaslicer/AppRun /orcaslicer-dist/orcaslicer 2>/dev/null || true; \
                echo "[orcaslicer-binaries] --appimage-extract successful"; \
            elif command -v 7z >/dev/null 2>&1 && 7z x -y -oorca7z orcaslicer.AppImage >/dev/null 2>&1; then \
                [ -d orca7z/squashfs-root ] && mv orca7z/squashfs-root /orcaslicer-dist/opt/orcaslicer; \
                [ ! -d /orcaslicer-dist/opt/orcaslicer ] && mkdir -p /orcaslicer-dist/opt/orcaslicer && cp -R orca7z/* /orcaslicer-dist/opt/orcaslicer/ 2>/dev/null || true; \
                cp /orcaslicer-dist/opt/orcaslicer/AppRun /orcaslicer-dist/orcaslicer 2>/dev/null || true; \
                echo "[orcaslicer-binaries] 7z extraction successful"; \
            elif command -v bsdtar >/dev/null 2>&1 && bsdtar -xf orcaslicer.AppImage 2>/dev/null && [ -d squashfs-root ]; then \
                mv squashfs-root /orcaslicer-dist/opt/orcaslicer; \
                cp /orcaslicer-dist/opt/orcaslicer/AppRun /orcaslicer-dist/orcaslicer 2>/dev/null || true; \
                echo "[orcaslicer-binaries] bsdtar extraction successful"; \
            fi; \
        else \
            echo "[orcaslicer-binaries] Skipping extraction due to unsupported arch: $arch"; \
        fi; \
        rm -f orcaslicer.AppImage; \
    fi; \
    \
    # Create stub if binary extraction failed but ALLOW_STUB is true \
    if [ ! -f /orcaslicer-dist/orcaslicer ]; then \
        if [ "${ALLOW_STUB}" = "true" ]; then \
            echo "[orcaslicer-binaries] Creating stub binary"; \
            printf '#!/bin/sh\n>&2 echo "[WARN] OrcaSlicer binary not present (version %s)"\nexit 2\n' "${ORCASLICER_VERSION}" > /orcaslicer-dist/orcaslicer; \
            chmod +x /orcaslicer-dist/orcaslicer; \
        else \
            echo "[orcaslicer-binaries] ERROR: Binary missing and ALLOW_STUB=false"; \
            exit 1; \
        fi; \
    fi; \
    \
    # OrcaSlicer profiles are already in /opt/orcaslicer/resources/profiles \
    echo "[orcaslicer-binaries] OrcaSlicer profiles available at /opt/orcaslicer/resources/profiles"; \
    if [ -d /orcaslicer-dist/opt/orcaslicer/resources/profiles ]; then \
        echo "[orcaslicer-binaries] Verified: profiles directory present"; \
        ls /orcaslicer-dist/opt/orcaslicer/resources/profiles/*.json 2>/dev/null | head -5 || true; \
    else \
        echo "[orcaslicer-binaries] Warning: OrcaSlicer profiles not found in extracted AppImage"; \
    fi

############################################################
# Slicer Base Runtime (shared runtime for all workers)
############################################################
FROM mcr.microsoft.com/dotnet/aspnet:${ASPNET_TAG} AS slicer-base
WORKDIR /app

# Note: All runtime dependencies (libgtk-3-0, xvfb, fuse, etc.) and appuser are pre-installed in base image

# Create necessary directories and set ownership for appuser
RUN mkdir -p /app/temp /app/gcode /app/profiles && chown -R appuser:appuser /app

############################################################
# OrcaSlicer Worker Runtime Container  
############################################################
FROM slicer-base AS orcaslicer-worker
ARG ORCASLICER_VERSION
ARG ALLOW_STUB

LABEL component="orcaslicer-worker" \
      orcaslicer.version="${ORCASLICER_VERSION}" \
      description="Dedicated OrcaSlicer worker container" \
      security.sandbox="true"

# Copy OrcaSlicer binaries from the binary layer (as appuser)
COPY --chown=appuser:appuser --from=orcaslicer-binaries /orcaslicer-dist/orcaslicer /usr/local/bin/orcaslicer
COPY --chown=appuser:appuser --from=orcaslicer-binaries /orcaslicer-dist/opt/orcaslicer /opt/orcaslicer

# Copy OrcaSlicer Worker binaries from shared build stage (as appuser)
COPY --chown=appuser:appuser --from=shared-build /app/publish/orcaslicer-worker .

# Verify binary installation and set up permissions
RUN set -e; \
    chmod +x /usr/local/bin/orcaslicer && \
    test -f /usr/local/bin/orcaslicer && \
    test -s ./Farm.OrcaSlicer.Worker.dll && \
    echo "✓ OrcaSlicer worker binaries verified" && \
    # Verify profile directories exist \
    PROFILES_DIR="/opt/orcaslicer/resources/profiles"; \
    if [ -d "$PROFILES_DIR" ]; then \
        profile_count=$(find "$PROFILES_DIR" -name "*.json" 2>/dev/null | wc -l); \
        echo "✓ Profile directory verified with $profile_count JSON profiles"; \
    else \
        echo "ERROR: Profile directory not found at $PROFILES_DIR"; \
        exit 1; \
    fi && \
    echo "✓ OrcaSlicer worker setup completed"

# Run as non-root user
USER appuser

# Set environment
ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production
ENV Worker__OrcaSlicerPath=/usr/local/bin/orcaslicer
ENV Worker__WorkingDirectory=/app/temp

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/healthz || exit 1

EXPOSE 8080

ENTRYPOINT ["dotnet", "Farm.OrcaSlicer.Worker.dll"]

############################################################
# React Frontend Build Stage
############################################################
FROM node:${NODE_TAG} AS frontend-build
WORKDIR /app

# Accept build arguments for frontend configuration
ARG VITE_API_BASE_URL=/api
ARG VITE_SIGNALR_PRINTERS_URL=/hubs/printers
ARG VITE_SIGNALR_HARVEST_URL=/hubs/harvest

# Copy Slicer workspace packages first (needed for vite alias resolution)
# The vite alias resolves to /Slicers in Docker builds
COPY src/Slicers /Slicers

# Copy package files
COPY src/Web/ReactApp/package*.json ./

# Install dependencies faster with offline caching
RUN npm install --prefer-offline --no-audit --legacy-peer-deps 2>&1 | tail -10

# Copy source code and build with environment variables
COPY src/Web/ReactApp/ ./
RUN VITE_API_BASE_URL=${VITE_API_BASE_URL} \
    VITE_SIGNALR_PRINTERS_URL=${VITE_SIGNALR_PRINTERS_URL} \
    VITE_SIGNALR_HARVEST_URL=${VITE_SIGNALR_HARVEST_URL} \
    npm run build

############################################################
# React Frontend Runtime Container
############################################################
FROM nginx:${NGINX_TAG} AS frontend-runtime
WORKDIR /usr/share/nginx/html

# Copy built React app
COPY --from=frontend-build /app/dist .

# Copy nginx configuration
COPY scripts/docker/nginx.conf /etc/nginx/nginx.conf

# Note: curl and nginx directories are pre-configured in base image

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:80/health || exit 1

EXPOSE 80

# Override the default nginx entrypoint to just run nginx directly
ENTRYPOINT []
CMD ["nginx", "-g", "daemon off;"]

############################################################
# Printer Discovery Service Runtime Container
############################################################
FROM mcr.microsoft.com/dotnet/aspnet:${ASPNET_TAG} AS printer-discovery-runtime
WORKDIR /app

# Create discovery user (different from appuser for service isolation)
# Note: curl and other tools are pre-installed in base image
RUN groupadd -r discovery && useradd -r -g discovery discovery && \
    chown -R discovery:discovery /app

# Copy published printer discovery service (as discovery user)
COPY --chown=discovery:discovery --from=shared-build /app/publish/printer-discovery .

# Run as non-root user
USER discovery

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:5246/health || exit 1

EXPOSE 5246

ENTRYPOINT ["dotnet", "PrinterDiscoveryService.dll"]