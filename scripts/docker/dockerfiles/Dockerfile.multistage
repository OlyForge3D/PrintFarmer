# syntax=docker/dockerfile:1
############################################################
# Multi-Stage PrintFarmer Build
# Builds all .NET projects once and creates efficient runtime containers
# This approach avoids rebuilding shared libraries in each worker container
############################################################

# Global build arguments
ARG ORCASLICER_VERSION=2.4.2
ARG ORCASLICER_SHA256=d12fb8c8eac1aecd2dfb6377acd48f994f8fa439ed5292fa532dd82880f029fd
ARG BUILD_VERBOSITY=quiet
# Short git SHA of the source commit; embedded into each service's version endpoint
ARG GIT_SHA=unknown

# Multi-architecture support
# BUILDPLATFORM = arch of the build host (for compile stages — faster, no emulation)
# TARGETPLATFORM = arch of the target deployment (for runtime stages)
ARG BUILDPLATFORM
ARG TARGETPLATFORM

# Base image tags - use Ubuntu 24.04 (Noble) with glibc 2.39 for AssimpNetter compatibility
# Ubuntu Noble has glibc 2.39 which is compatible with bundled Assimp libraries (built for 2.38)
ARG SDK_TAG=10.0-noble
ARG ASPNET_TAG=10.0-noble
ARG NODE_TAG=24-alpine
ARG NGINX_TAG=alpine
ARG UBUNTU_TAG=24.04
ARG BUILD_VERSION=development
ARG VCS_REF=unknown
ARG SOURCE_REPOSITORY=""
ARG SOURCE_ARCHIVE_URL=""
ARG SBOM_URL=""

FROM scratch AS legal-assets
COPY LICENSE /LICENSE
COPY THIRD-PARTY-NOTICES.md /THIRD-PARTY-NOTICES.md

############################################################
# Restore-Manifest Stage - project/solution files only
# Copies the full src/ tree and then prunes everything except
# *.csproj/*.sln/Directory.Build.props(.targets)/Directory.Packages.props,
# preserving directory structure. This lets the shared-build stage's
# `dotnet restore` layer depend only on manifest content, so a source-only
# edit no longer busts the restore cache (issue #2330). Pruning by filename
# (rather than hand-listing every project) also covers every transitively
# referenced project automatically, so nothing can be missed from the
# restore list below.
############################################################
FROM --platform=${BUILDPLATFORM:-linux/amd64} mcr.microsoft.com/dotnet/sdk:${SDK_TAG} AS restore-manifest
WORKDIR /manifest
COPY src/ ./src/
RUN find ./src -type f \
      ! -name '*.csproj' \
      ! -name '*.sln' \
      ! -name 'Directory.Build.props' \
      ! -name 'Directory.Build.targets' \
      ! -name 'Directory.Packages.props' \
      -delete

############################################################
# Shared Build Stage - Build all .NET projects once
# Uses BUILDPLATFORM to compile on the build host's native arch (faster, no QEMU)
# .NET publishes framework-dependent IL output that runs on any target architecture
############################################################
FROM --platform=${BUILDPLATFORM:-linux/amd64} mcr.microsoft.com/dotnet/sdk:${SDK_TAG} AS shared-build
WORKDIR /

# Re-declare git SHA in this stage (ARGs are scoped per-stage after FROM).
# Passed to `dotnet publish` as GitCommitSha so InformationalVersion carries the commit.
ARG GIT_SHA=unknown

# Copy root-level files and the pruned (manifest-only) src directory.
# The context root is the repository root (/home/pi/pfarm)
COPY Directory.Build.props ./
COPY global.json ./
COPY VERSION ./
COPY proto ./proto
COPY --from=restore-manifest /manifest/src/ ./src/

# Set working directory for builds
WORKDIR /src

# Restore all dependencies in one go. This list is the UNION of every project
# graph entry point built below (api, workers, backend plugins, and both
# OrcaSlicer plugin versions) so every subsequent `--no-restore` build/publish
# step has already been restored here - see issue #2330 for why this list
# must never diverge from what is built with --no-restore further down.
RUN dotnet restore ./api/Farm.Web.Api.csproj && \
    dotnet restore ./orcaslicer-worker/Farm.OrcaSlicer.Worker.csproj && \
    dotnet restore ./printer-discovery/PrinterDiscoveryService.csproj && \
    dotnet restore ./slicer/Farm.Slicer.Host/Farm.Slicer.Host.csproj && \
    dotnet restore ./moonraker-emulator/Farm.Moonraker.Emulator/Farm.Moonraker.Emulator.csproj && \
    dotnet restore ./Slicers/Farm.Slicers.OrcaSlicer.v2_4_0/Farm.Slicers.OrcaSlicer.v2_4_0.csproj && \
    dotnet restore ./Slicers/Farm.Slicers.OrcaSlicer.v2_3_1/Farm.Slicers.OrcaSlicer.v2_3_1.csproj && \
    dotnet restore ./backends/Farm.Backend.Plugin.Moonraker/Farm.Backend.Plugin.Moonraker.csproj && \
    dotnet restore ./backends/Farm.Backend.Plugin.PrusaLink/Farm.Backend.Plugin.PrusaLink.csproj && \
    dotnet restore ./backends/Farm.Backend.Plugin.OctoPrint/Farm.Backend.Plugin.OctoPrint.csproj && \
    dotnet restore ./backends/Farm.Backend.Plugin.Sdcp/Farm.Backend.Plugin.Sdcp.csproj && \
    dotnet restore ./backends/Farm.Backend.Plugin.FlashForge/Farm.Backend.Plugin.FlashForge.csproj && \
    dotnet restore ./backends/Farm.Backend.Plugin.TestEmulator/Farm.Backend.Plugin.TestEmulator.csproj

# Now bring in the full source tree from the real build context. This layer's
# cache is invalidated on every source edit, but it comes *after* restore, so
# the (cacheable) restore layer above is unaffected by source-only changes.
COPY src/ ./src/

# Build and publish all services (restore already completed above -- no
# duplicate restore; NOTE: NuGet cache mount removed to prevent corruption
# during .NET version migrations)
RUN echo "Publishing API..." && \
    dotnet publish ./api/Farm.Web.Api.csproj -c Release -o /app/publish/api --no-restore -p:GitCommitSha=${GIT_SHA} --verbosity ${BUILD_VERBOSITY:-quiet} && \
    echo "Publishing OrcaSlicer Worker..." && \
    dotnet publish ./orcaslicer-worker/Farm.OrcaSlicer.Worker.csproj -c Release -o /app/publish/orcaslicer-worker --no-restore -p:GitCommitSha=${GIT_SHA} --verbosity ${BUILD_VERBOSITY:-quiet} && \
    echo "Publishing Printer Discovery..." && \
    dotnet publish ./printer-discovery/PrinterDiscoveryService.csproj -c Release -o /app/publish/printer-discovery --no-restore -p:GitCommitSha=${GIT_SHA} --verbosity ${BUILD_VERBOSITY:-quiet} && \
    echo "Publishing Slicer Host..." && \
    dotnet publish ./slicer/Farm.Slicer.Host/Farm.Slicer.Host.csproj -c Release -o /app/publish/slicer-host --no-restore -p:GitCommitSha=${GIT_SHA} --verbosity ${BUILD_VERBOSITY:-quiet} && \
    echo "Publishing Moonraker Emulator..." && \
    dotnet publish ./moonraker-emulator/Farm.Moonraker.Emulator/Farm.Moonraker.Emulator.csproj -c Release -o /app/publish/moonraker-emulator --no-restore -p:GitCommitSha=${GIT_SHA} --verbosity ${BUILD_VERBOSITY:-quiet} && \
    echo "Building backend plugins..." && \
    dotnet build ./backends/Farm.Backend.Plugin.Moonraker/Farm.Backend.Plugin.Moonraker.csproj -c Release -o /app/publish/api --no-restore --verbosity ${BUILD_VERBOSITY:-quiet} && \
    dotnet build ./backends/Farm.Backend.Plugin.PrusaLink/Farm.Backend.Plugin.PrusaLink.csproj -c Release -o /app/publish/api --no-restore --verbosity ${BUILD_VERBOSITY:-quiet} && \
    dotnet build ./backends/Farm.Backend.Plugin.OctoPrint/Farm.Backend.Plugin.OctoPrint.csproj -c Release -o /app/publish/api --no-restore --verbosity ${BUILD_VERBOSITY:-quiet} && \
    dotnet build ./backends/Farm.Backend.Plugin.Sdcp/Farm.Backend.Plugin.Sdcp.csproj -c Release -o /app/publish/api --no-restore --verbosity ${BUILD_VERBOSITY:-quiet} && \
    dotnet build ./backends/Farm.Backend.Plugin.FlashForge/Farm.Backend.Plugin.FlashForge.csproj -c Release -o /app/publish/api --no-restore --verbosity ${BUILD_VERBOSITY:-quiet} && \
    dotnet build ./backends/Farm.Backend.Plugin.TestEmulator/Farm.Backend.Plugin.TestEmulator.csproj -c Release -o /app/publish/api --no-restore --verbosity ${BUILD_VERBOSITY:-quiet} && \
    echo "Building slicer plugins (issue #578 dual-engine)..." && \
    dotnet build ./slicer/Farm.Slicer.Module.Api/Farm.Slicer.Module.Api.csproj -c Release -o /app/publish/api/plugins/slicer --no-restore --verbosity ${BUILD_VERBOSITY:-quiet} && \
    dotnet build ./Slicers/Farm.Slicers.OrcaSlicer.v2_4_0/Farm.Slicers.OrcaSlicer.v2_4_0.csproj -c Release -o /app/publish/api/plugins/slicer --no-restore --verbosity ${BUILD_VERBOSITY:-quiet} && \
    dotnet build ./Slicers/Farm.Slicers.OrcaSlicer.v2_3_1/Farm.Slicers.OrcaSlicer.v2_3_1.csproj -c Release -o /app/publish/api/plugins/slicer --no-restore --verbosity ${BUILD_VERBOSITY:-quiet} && \
    dotnet build ./migrations/Farm.Slicer.Migrations.PostgreSQL/Farm.Slicer.Migrations.PostgreSQL.csproj -c Release -o /app/publish/api/plugins/slicer --no-restore --verbosity ${BUILD_VERBOSITY:-quiet} && \
    dotnet build ./migrations/Farm.Slicer.Migrations.SqlServer/Farm.Slicer.Migrations.SqlServer.csproj -c Release -o /app/publish/api/plugins/slicer --no-restore --verbosity ${BUILD_VERBOSITY:-quiet} && \
    dotnet build ./migrations/Farm.Slicer.Migrations.Sqlite/Farm.Slicer.Migrations.Sqlite.csproj -c Release -o /app/publish/api/plugins/slicer --no-restore --verbosity ${BUILD_VERBOSITY:-quiet} && \
    echo "Mirroring slicer plugins into slicer-host publish payload (issue #578; microservices split loads plugins via Slicer:PluginsPath)..." && \
    mkdir -p /app/publish/slicer-host/plugins/slicer && \
    dotnet build ./Slicers/Farm.Slicers.OrcaSlicer.v2_4_0/Farm.Slicers.OrcaSlicer.v2_4_0.csproj -c Release -o /app/publish/slicer-host/plugins/slicer --no-restore --verbosity ${BUILD_VERBOSITY:-quiet} && \
    dotnet build ./Slicers/Farm.Slicers.OrcaSlicer.v2_3_1/Farm.Slicers.OrcaSlicer.v2_3_1.csproj -c Release -o /app/publish/slicer-host/plugins/slicer --no-restore --verbosity ${BUILD_VERBOSITY:-quiet}

# Verify critical runtime files exist and fail immediately if any are missing
RUN echo "Checking published artifacts..." && \
    echo "API publish directory:" && ls -lah /app/publish/api/ 2>&1 | head -20 && \
    echo "OrcaSlicer Worker publish directory:" && ls -lah /app/publish/orcaslicer-worker/ 2>&1 | head -20 && \
    echo "Printer Discovery publish directory:" && ls -lah /app/publish/printer-discovery/ 2>&1 | head -20 && \
    echo "Slicer Host publish directory:" && ls -lah /app/publish/slicer-host/ 2>&1 | head -20 && \
    echo "Moonraker Emulator publish directory:" && ls -lah /app/publish/moonraker-emulator/ 2>&1 | head -20 && \
    echo "Checking for plugin DLLs in API directory:" && ls -lah /app/publish/api/Farm.Backend.Plugin.*.dll 2>&1 && \
    ([ -f /app/publish/api/Farm.Web.Api.dll ] || (echo "✗ MISSING: /app/publish/api/Farm.Web.Api.dll"; exit 1)) && \
    ([ -f /app/publish/orcaslicer-worker/Farm.OrcaSlicer.Worker.dll ] || (echo "✗ MISSING: /app/publish/orcaslicer-worker/Farm.OrcaSlicer.Worker.dll"; exit 1)) && \
    ([ -f /app/publish/printer-discovery/PrinterDiscoveryService.dll ] || (echo "✗ MISSING: /app/publish/printer-discovery/PrinterDiscoveryService.dll"; exit 1)) && \
    ([ -f /app/publish/slicer-host/Farm.Slicer.Host.dll ] || (echo "✗ MISSING: /app/publish/slicer-host/Farm.Slicer.Host.dll"; exit 1)) && \
    ([ -f /app/publish/moonraker-emulator/Farm.Moonraker.Emulator.dll ] || (echo "✗ MISSING: /app/publish/moonraker-emulator/Farm.Moonraker.Emulator.dll"; exit 1)) && \
    ([ -f /app/publish/api/Farm.Backend.Plugin.Core.dll ] || (echo "✗ MISSING: /app/publish/api/Farm.Backend.Plugin.Core.dll"; exit 1)) && \
    ([ -f /app/publish/api/Farm.Backend.Plugin.Moonraker.dll ] || (echo "✗ MISSING: /app/publish/api/Farm.Backend.Plugin.Moonraker.dll"; exit 1)) && \
    ([ -f /app/publish/api/Farm.Backend.Plugin.PrusaLink.dll ] || (echo "✗ MISSING: /app/publish/api/Farm.Backend.Plugin.PrusaLink.dll"; exit 1)) && \
    ([ -f /app/publish/api/Farm.Backend.Plugin.OctoPrint.dll ] || (echo "✗ MISSING: /app/publish/api/Farm.Backend.Plugin.OctoPrint.dll"; exit 1)) && \
    ([ -f /app/publish/api/Farm.Backend.Plugin.Sdcp.dll ] || (echo "✗ MISSING: /app/publish/api/Farm.Backend.Plugin.Sdcp.dll"; exit 1)) && \
    ([ -f /app/publish/api/Farm.Backend.Plugin.FlashForge.dll ] || (echo "✗ MISSING: /app/publish/api/Farm.Backend.Plugin.FlashForge.dll"; exit 1)) && \
    ([ -f /app/publish/api/Farm.Backend.Plugin.TestEmulator.dll ] || (echo "✗ MISSING: /app/publish/api/Farm.Backend.Plugin.TestEmulator.dll"; exit 1)) && \
    echo "Checking for slicer plugin DLLs (issue #578 dual-engine):" && ls -lah /app/publish/api/plugins/slicer/ 2>&1 | head -30 && \
    ([ -f /app/publish/api/plugins/slicer/Farm.Slicer.Module.Api.dll ] || (echo "✗ MISSING: /app/publish/api/plugins/slicer/Farm.Slicer.Module.Api.dll"; exit 1)) && \
    ([ -f /app/publish/api/plugins/slicer/Farm.Slicers.OrcaSlicer.v2_4_0.dll ] || (echo "✗ MISSING: /app/publish/api/plugins/slicer/Farm.Slicers.OrcaSlicer.v2_4_0.dll"; exit 1)) && \
    ([ -f /app/publish/api/plugins/slicer/Farm.Slicers.OrcaSlicer.v2_3_1.dll ] || (echo "✗ MISSING: /app/publish/api/plugins/slicer/Farm.Slicers.OrcaSlicer.v2_3_1.dll"; exit 1)) && \
    ([ -f /app/publish/api/plugins/slicer/Farm.Slicer.Migrations.Sqlite.dll ] || (echo "✗ MISSING: /app/publish/api/plugins/slicer/Farm.Slicer.Migrations.Sqlite.dll"; exit 1)) && \
    echo "Checking for slicer plugin DLLs in slicer-host payload (issue #578; microservices split):" && ls -lah /app/publish/slicer-host/plugins/slicer/ 2>&1 | head -10 && \
    ([ -f /app/publish/slicer-host/plugins/slicer/Farm.Slicers.OrcaSlicer.v2_4_0.dll ] || (echo "✗ MISSING: /app/publish/slicer-host/plugins/slicer/Farm.Slicers.OrcaSlicer.v2_4_0.dll"; exit 1)) && \
    ([ -f /app/publish/slicer-host/plugins/slicer/Farm.Slicers.OrcaSlicer.v2_3_1.dll ] || (echo "✗ MISSING: /app/publish/slicer-host/plugins/slicer/Farm.Slicers.OrcaSlicer.v2_3_1.dll"; exit 1)) && \
    echo "✓ All .NET builds completed successfully"

############################################################
# API Runtime Container
############################################################
FROM mcr.microsoft.com/dotnet/aspnet:${ASPNET_TAG} AS api-runtime
ARG BUILD_VERSION
ARG VCS_REF
ARG SOURCE_REPOSITORY
ARG SOURCE_ARCHIVE_URL
ARG SBOM_URL
WORKDIR /app
EXPOSE 5000

LABEL org.opencontainers.image.title="PrintFarmer API" \
      org.opencontainers.image.description="PrintFarmer API server" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.source="${SOURCE_REPOSITORY}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.version="${BUILD_VERSION}" \
      org.printfarmer.source-archive="${SOURCE_ARCHIVE_URL}" \
      org.printfarmer.sbom="${SBOM_URL}"

# Install runtime tools that are present in the upgraded image
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl wget ca-certificates iputils-ping iproute2 net-tools dnsutils \
    && rm -rf /var/lib/apt/lists/*

# Create appuser if it doesn't exist (for standard base images)
# Use UID 1001 as UID 1000 may already be taken in Ubuntu 24.04
RUN if ! id appuser >/dev/null 2>&1; then useradd -m -u 1001 -s /bin/bash appuser; fi

# Create necessary directories with proper ownership
RUN mkdir -p /app/gcode /app/uploads /app/slicers /app/models && \
    chown -R appuser:appuser /app

# Copy API binaries from shared build stage (as appuser)
COPY --chown=appuser:appuser --from=shared-build /app/publish/api .
COPY --from=legal-assets /LICENSE /usr/share/licenses/printfarmer/LICENSE
COPY --from=legal-assets /THIRD-PARTY-NOTICES.md /usr/share/licenses/printfarmer/THIRD-PARTY-NOTICES.md

# Download and extract Lib3MF library for 3MF file support
# Lib3MF native library is already copied to output by csproj during build
# No additional steps needed - it's included in the published output

# Create startup script to fix mounted volume permissions for appuser (UID 1001)
# This handles the case where mounted volumes from host preserve host UID/GID
# Run as root initially to fix permissions, then drop to appuser to run the app
RUN printf '%s\n' \
    '#!/bin/bash' \
    'set -e' \
    '# Fix permissions on mounted volumes to ensure appuser (UID 1001) can access them' \
    '# The appuser may not own these directories if they are bind mounts from the host' \
    'mkdir -p /app/gcode /app/uploads /app/slicers /app/models /app/profiles /app/data-protection-keys 2>/dev/null || true' \
    'chown -R appuser:appuser /app/gcode /app/uploads /app/slicers /app/models /app/profiles /app/data-protection-keys 2>/dev/null || true' \
    '# Drop to appuser and run application' \
    'exec gosu appuser dotnet Farm.Web.Api.dll' \
    > /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Install gosu for privilege dropping (used by many Docker images)
RUN apt-get update && apt-get install -y --no-install-recommends gosu && rm -rf /var/lib/apt/lists/*

# Set environment
ENV ASPNETCORE_URLS=http://+:5000
ENV ASPNETCORE_ENVIRONMENT=Production
ENV GCODE_STORAGE_PATH=/app/gcode
ENV MODEL_UPLOAD_PATH=/app/models
ENV SLICER_PROFILES_PATH=/app/profiles
ENV PFARM__SourceInfo__Version=${BUILD_VERSION}
ENV PFARM__SourceInfo__Revision=${VCS_REF}
ENV PFARM__SourceInfo__RepositoryUrl=${SOURCE_REPOSITORY}
ENV PFARM__SourceInfo__SourceArchiveUrl=${SOURCE_ARCHIVE_URL}
ENV PFARM__SourceInfo__SbomUrl=${SBOM_URL}

# Keep as root so entrypoint can fix permissions
# USER appuser

# Health check (note: changed to run as appuser context would fail, run as is)
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=5 \
    CMD curl -f http://localhost:5000/healthz || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]

############################################################
# Slicer Host Runtime Container (split mode only)
# Standalone slicer service with its own database and HTTP
# clients that call back to the main API for cross-domain
# data (printers, catalog models, manufacturers).
# NOTE: amd64-only — depends on OrcaSlicer binaries
############################################################
FROM --platform=linux/amd64 mcr.microsoft.com/dotnet/aspnet:${ASPNET_TAG} AS slicer-host-runtime
ARG BUILD_VERSION
ARG VCS_REF
ARG SOURCE_REPOSITORY
ARG SOURCE_ARCHIVE_URL
ARG SBOM_URL
WORKDIR /app
EXPOSE 5246

LABEL org.opencontainers.image.title="PrintFarmer Slicer Host" \
      org.opencontainers.image.description="PrintFarmer distributed slicer host" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.source="${SOURCE_REPOSITORY}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.version="${BUILD_VERSION}" \
      org.printfarmer.source-archive="${SOURCE_ARCHIVE_URL}" \
      org.printfarmer.sbom="${SBOM_URL}"

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN if ! id appuser >/dev/null 2>&1; then useradd -m -u 1001 -s /bin/bash appuser; fi

RUN mkdir -p /app/artifacts /data && chown -R appuser:appuser /app /data

COPY --chown=appuser:appuser --from=shared-build /app/publish/slicer-host .
COPY --from=legal-assets /LICENSE /usr/share/licenses/printfarmer/LICENSE
COPY --from=legal-assets /THIRD-PARTY-NOTICES.md /usr/share/licenses/printfarmer/THIRD-PARTY-NOTICES.md

ENV ASPNETCORE_URLS=http://+:5246
ENV ASPNETCORE_ENVIRONMENT=Production
# Issue #578 dual-engine: point plugin discovery at the mirrored plugin payload
# copied above so ISlicerRegistry sees both v2_4_0 and v2_3_1 in slicer-host too.
ENV Slicer__PluginsPath=/app/plugins/slicer

USER appuser

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:5246/healthz || exit 1

ENTRYPOINT ["dotnet", "Farm.Slicer.Host.dll"]

############################################################
# OrcaSlicer Binary Layer (cached layer for binary assets)
# NOTE: OrcaSlicer only has x86_64 Linux binaries — this stage is amd64-only
############################################################
FROM --platform=linux/amd64 ubuntu:${UBUNTU_TAG} AS orcaslicer-binaries
ARG ORCASLICER_VERSION
ARG ORCA_ASSET_PATH=""
ARG ORCASLICER_URL=https://github.com/OrcaSlicer/OrcaSlicer/releases/download/v${ORCASLICER_VERSION}/OrcaSlicer_Linux_AppImage_Ubuntu2404_V${ORCASLICER_VERSION}.AppImage
# SHA-256 of the pinned upstream AppImage. Required whenever a real binary is built.
# Supply it explicitly at build time; the build fails rather than accepting an unverified download.
ARG ORCASLICER_SHA256
# Production default: never silently substitute a stub for the pinned upstream binary.
ARG ALLOW_STUB=false
ARG GITHUB_TOKEN
ARG _SKIP_ORCA_BINARY_BUILD=0
LABEL orcaslicer.version="${ORCASLICER_VERSION}" \
      orcaslicer.sha256="${ORCASLICER_SHA256}" \
      orcaslicer.allow_stub="${ALLOW_STUB}"
WORKDIR /tmp

# Install AppImage/tooling stack (matches upgraded base image)
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates jq p7zip-full squashfs-tools libarchive-tools file wget \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Download and extract OrcaSlicer binaries from the pinned release URL only.
# There is no release discovery: the URL and its checksum are the reproducibility contract.
RUN set -e; \
    echo "[orcaslicer-binaries] Resolving OrcaSlicer version=${ORCASLICER_VERSION}"; \
    mkdir -p /orcaslicer-dist/opt; \
    \
    # If _SKIP_ORCA_BINARY_BUILD=1, skip all download/extraction (using prebuilt image) \
    if [ "${_SKIP_ORCA_BINARY_BUILD}" = "1" ]; then \
        echo "[orcaslicer-binaries] Skipping binary build (using prebuilt image via additional_contexts)"; \
        mkdir -p /orcaslicer-dist/opt/orcaslicer && \
        printf '' > /orcaslicer-dist/orcaslicer.sha256 && \
        echo "[orcaslicer-binaries] Setup complete (waiting for additional_contexts to populate /opt/orcaslicer)"; \
        exit 0; \
    fi; \
    \
    if [ "$ALLOW_STUB" = "true" ]; then \
        echo "[orcaslicer-binaries] ALLOW_STUB=true (non-production build): a stub may replace the real binary"; \
    else \
        echo "[orcaslicer-binaries] ALLOW_STUB=false, must download and verify the pinned binary"; \
        if [ -z "${ORCASLICER_SHA256}" ]; then \
            echo "[orcaslicer-binaries] ERROR: ORCASLICER_SHA256 is required when ALLOW_STUB=false."; \
            echo "[orcaslicer-binaries] Pass --build-arg ORCASLICER_SHA256=<sha256 of ${ORCASLICER_URL}>"; \
            exit 1; \
        fi; \
    fi; \
    \
    # Verifies a candidate AppImage against the pinned checksum. \
    verify_checksum() { \
        if [ -z "${ORCASLICER_SHA256}" ]; then \
            echo "[orcaslicer-binaries] WARNING: no ORCASLICER_SHA256 supplied; skipping verification (stub build only)"; \
            return 0; \
        fi; \
        echo "${ORCASLICER_SHA256}  orcaslicer.AppImage" > orcaslicer.AppImage.sha256; \
        if sha256sum -c orcaslicer.AppImage.sha256; then \
            echo "[orcaslicer-binaries] Checksum verified"; \
            checksum_verified=1; \
            return 0; \
        fi; \
        echo "[orcaslicer-binaries] ERROR: checksum verification failed"; \
        rm -f orcaslicer.AppImage; \
        return 1; \
    }; \
    checksum_verified=0; \
    \
    # Check if AppImage is available from ORCA_ASSET_PATH (for offline builds) \
    cached_appimage=""; \
    if [ -n "${ORCA_ASSET_PATH}" ] && [ -d "${ORCA_ASSET_PATH}" ]; then \
        echo "[orcaslicer-binaries] Searching for cached AppImage in ${ORCA_ASSET_PATH}"; \
        cached_appimage=$(find "${ORCA_ASSET_PATH}" -maxdepth 1 -name "*.AppImage" -type f | head -n1 || true); \
        if [ -n "$cached_appimage" ]; then \
            echo "[orcaslicer-binaries] Found cached AppImage: $cached_appimage"; \
            cp "$cached_appimage" orcaslicer.AppImage; \
            chmod +x orcaslicer.AppImage; \
        fi; \
    fi; \
    \
    # Determine target architecture for asset selection (2.4.0+ ships both x86_64 and aarch64 AppImages) \
    target_arch="$(uname -m)"; \
    case "$target_arch" in aarch64|arm64) arch_is_arm=1;; *) arch_is_arm=0;; esac; \
    echo "[orcaslicer-binaries] Target arch=${target_arch} (arm=${arch_is_arm})"; \
    \
    # Release discovery exists only for unpinned development builds. Once ORCASLICER_SHA256 is \
    # supplied, the pinned URL and its checksum are the reproducibility contract and no other \
    # asset may be substituted for them. \
    if [ -z "${ORCASLICER_SHA256}" ] && [ ! -f orcaslicer.AppImage ]; then \
        all_appimages=$(curl -H "Accept: application/vnd.github+json" \
                          -H "User-Agent: OrcaSlicerWorker/1.0" \
                          -fsSL "https://api.github.com/repos/OrcaSlicer/OrcaSlicer/releases" | \
                      jq -r --arg ver "v${ORCASLICER_VERSION}" \
                         '.[] | select(.tag_name==$ver) | .assets[] | select(.name | test("(?i)AppImage$")) | .browser_download_url' || true); \
        if [ "$arch_is_arm" = "1" ]; then \
            dynamic_url=$(printf '%s\n' "$all_appimages" | grep -iE 'aarch64|arm64' | head -n1 || true); \
        else \
            dynamic_url=$(printf '%s\n' "$all_appimages" | grep -ivE 'aarch64|arm64' | head -n1 || true); \
        fi; \
        [ -z "$dynamic_url" ] && dynamic_url=$(printf '%s\n' "$all_appimages" | head -n1 || true); \
        \
        if [ -n "$dynamic_url" ]; then \
            echo "[orcaslicer-binaries] Discovered asset: $dynamic_url"; \
            ORCASLICER_URL="$dynamic_url"; \
        fi; \
    fi; \
    \
    # Download function with size validation \
    try_download() { \
        url="$1"; \
        echo "[orcaslicer-binaries] Attempting download: $url"; \
        if curl -H "User-Agent: OrcaSlicerWorker/1.0" -fSL -o orcaslicer.AppImage.tmp "$url"; then \
            size=$(stat -c%s orcaslicer.AppImage.tmp 2>/dev/null || echo 0); \
            if [ "$size" -gt 5000000 ]; then \
                mv orcaslicer.AppImage.tmp orcaslicer.AppImage; \
                echo "[orcaslicer-binaries] Download successful (size: $size bytes)"; \
                return 0; \
            else \
                echo "[orcaslicer-binaries] Download too small (size $size < 5MB), invalid"; \
            fi; \
        fi; \
        rm -f orcaslicer.AppImage.tmp || true; \
        return 1; \
    }; \
    \
    # Pinned builds resolve exactly one URL; unpinned development builds may fall back per-arch. \
    if [ ! -f orcaslicer.AppImage ]; then \
        if [ -n "${ORCASLICER_SHA256}" ]; then \
            # Exactly one pinned URL; a failure here is a build failure, not a fallback. \
            try_download "${ORCASLICER_URL}" \
            || echo "[orcaslicer-binaries] WARNING: pinned download failed"; \
        elif [ "$arch_is_arm" = "1" ]; then \
            # Try the aarch64 asset first: ORCASLICER_URL defaults to the x86_64 AppImage, \
            # so if dynamic discovery failed we must NOT fall through to it on ARM. \
            try_download "https://github.com/OrcaSlicer/OrcaSlicer/releases/download/v${ORCASLICER_VERSION}/OrcaSlicer_Linux_AppImage_Ubuntu2404_aarch64_V${ORCASLICER_VERSION}.AppImage" \
            || try_download "${ORCASLICER_URL}" \
            || echo "[orcaslicer-binaries] WARNING: All ARM download attempts failed"; \
        else \
            try_download "${ORCASLICER_URL}" \
            || try_download "https://github.com/OrcaSlicer/OrcaSlicer/releases/download/v${ORCASLICER_VERSION}/OrcaSlicer_Linux_AppImage_Ubuntu2404_V${ORCASLICER_VERSION}.AppImage" \
            || try_download "https://github.com/OrcaSlicer/OrcaSlicer/releases/download/v${ORCASLICER_VERSION}/OrcaSlicer_V${ORCASLICER_VERSION}_Linux_x86_64.AppImage" \
            || try_download "https://github.com/OrcaSlicer/OrcaSlicer/releases/download/v${ORCASLICER_VERSION}/OrcaSlicer_Linux_V${ORCASLICER_VERSION}.AppImage" \
            || echo "[orcaslicer-binaries] WARNING: All download attempts failed"; \
        fi; \
    fi; \
    \
    if [ -f orcaslicer.AppImage ]; then \
        verify_checksum || { \
            if [ "${ALLOW_STUB}" != "true" ]; then \
                exit 1; \
            fi; \
        }; \
    fi; \
    \
    # Extract AppImage if available \
    if [ -f orcaslicer.AppImage ]; then \
        chmod +x orcaslicer.AppImage; \
        arch=$(uname -m); \
        echo "[orcaslicer-binaries] File magic: $( (command -v file >/dev/null 2>&1 && file orcaslicer.AppImage) || echo 'file N/A')"; \
        echo "[orcaslicer-binaries] Host build arch: $arch"; \
        \
        if [ "$arch" = "x86_64" ] || [ "$arch" = "aarch64" ] || [ "$arch" = "arm64" ]; then \
            echo "[orcaslicer-binaries] Attempting unsquashfs extraction"; \
            if unsquashfs -d squashfs-root orcaslicer.AppImage >/dev/null 2>&1; then \
                mv squashfs-root /orcaslicer-dist/opt/orcaslicer; \
                cp /orcaslicer-dist/opt/orcaslicer/AppRun /orcaslicer-dist/orcaslicer 2>/dev/null || true; \
                echo "[orcaslicer-binaries] unsquashfs extraction successful"; \
            elif ./orcaslicer.AppImage --appimage-extract 2>extract.err; then \
                mv squashfs-root /orcaslicer-dist/opt/orcaslicer; \
                cp /orcaslicer-dist/opt/orcaslicer/AppRun /orcaslicer-dist/orcaslicer 2>/dev/null || true; \
                echo "[orcaslicer-binaries] --appimage-extract successful"; \
            elif command -v 7z >/dev/null 2>&1 && 7z x -y -oorca7z orcaslicer.AppImage >/dev/null 2>&1; then \
                [ -d orca7z/squashfs-root ] && mv orca7z/squashfs-root /orcaslicer-dist/opt/orcaslicer; \
                [ ! -d /orcaslicer-dist/opt/orcaslicer ] && mkdir -p /orcaslicer-dist/opt/orcaslicer && cp -R orca7z/* /orcaslicer-dist/opt/orcaslicer/ 2>/dev/null || true; \
                cp /orcaslicer-dist/opt/orcaslicer/AppRun /orcaslicer-dist/orcaslicer 2>/dev/null || true; \
                echo "[orcaslicer-binaries] 7z extraction successful"; \
            elif command -v bsdtar >/dev/null 2>&1 && bsdtar -xf orcaslicer.AppImage 2>/dev/null && [ -d squashfs-root ]; then \
                mv squashfs-root /orcaslicer-dist/opt/orcaslicer; \
                cp /orcaslicer-dist/opt/orcaslicer/AppRun /orcaslicer-dist/orcaslicer 2>/dev/null || true; \
                echo "[orcaslicer-binaries] bsdtar extraction successful"; \
            fi; \
        else \
            echo "[orcaslicer-binaries] Skipping extraction due to unsupported arch: $arch"; \
        fi; \
        rm -f orcaslicer.AppImage; \
    fi; \
    \
    # Record the identity of what was actually installed, not what the build argument asked for. \
    # The digest is only attested when the pinned AppImage was downloaded AND verified AND extracted; \
    # anything else (including the stub fallback below) leaves the attestation empty, which makes the \
    # worker register as unverified instead of claiming a pin it cannot prove. \
    if [ -f /orcaslicer-dist/orcaslicer ] && [ "${checksum_verified}" = "1" ]; then \
        printf '%s' "${ORCASLICER_SHA256}" > /orcaslicer-dist/orcaslicer.sha256; \
        printf '%s' "${ORCASLICER_VERSION}" > /orcaslicer-dist/orcaslicer.version; \
        echo "[orcaslicer-binaries] Attested installed binary digest"; \
    else \
        printf '' > /orcaslicer-dist/orcaslicer.sha256; \
        rm -f /orcaslicer-dist/orcaslicer.version; \
        echo "[orcaslicer-binaries] No verified binary installed; attestation left empty"; \
    fi; \
    \
    # Create stub if binary extraction failed but ALLOW_STUB is true \
    if [ ! -f /orcaslicer-dist/orcaslicer ]; then \
        if [ "${ALLOW_STUB}" = "true" ]; then \
            echo "[orcaslicer-binaries] Creating stub binary"; \
            printf '#!/bin/sh\n>&2 echo "[WARN] OrcaSlicer binary not present (version %s)"\nexit 2\n' "${ORCASLICER_VERSION}" > /orcaslicer-dist/orcaslicer; \
            chmod +x /orcaslicer-dist/orcaslicer; \
            printf '' > /orcaslicer-dist/orcaslicer.sha256; \
        else \
            echo "[orcaslicer-binaries] ERROR: Binary missing and ALLOW_STUB=false"; \
            exit 1; \
        fi; \
    fi; \
    \
    # OrcaSlicer profiles are already in /opt/orcaslicer/resources/profiles \
    echo "[orcaslicer-binaries] OrcaSlicer profiles available at /opt/orcaslicer/resources/profiles"; \
    if [ -d /orcaslicer-dist/opt/orcaslicer/resources/profiles ]; then \
        echo "[orcaslicer-binaries] Verified: profiles directory present"; \
        ls /orcaslicer-dist/opt/orcaslicer/resources/profiles/*.json 2>/dev/null | head -5 || true; \
    else \
        echo "[orcaslicer-binaries] Warning: OrcaSlicer profiles not found in extracted AppImage"; \
    fi

############################################################
# Slicer Base Runtime (shared runtime for all workers)
# NOTE: amd64-only — OrcaSlicer has no ARM64 binaries
############################################################
FROM --platform=linux/amd64 mcr.microsoft.com/dotnet/aspnet:${ASPNET_TAG} AS slicer-base
WORKDIR /app

# Install OrcaSlicer runtime deps for Ubuntu 24.04 (libgl1-mesa-glx → libgl1-mesa-glx | libglx0)
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl wget ca-certificates \
        libgtk-3-0 libglx0 libglib2.0-0 libstdc++6 libopengl0 libegl1 \
        libglu1-mesa \
        libgstreamer1.0-0 libgstreamer-plugins-base1.0-0 libmspack0 \
        libwebkit2gtk-4.1-0 libjavascriptcoregtk-4.1-0 \
        xvfb fuse squashfs-tools file p7zip-full \
    && rm -rf /var/lib/apt/lists/*

# Create appuser if it doesn't exist (for standard base images)
# Use UID 1001 as UID 1000 may already be taken in Ubuntu 24.04
RUN if ! id appuser >/dev/null 2>&1; then useradd -m -u 1001 -s /bin/bash appuser; fi

# Create necessary directories and set ownership for appuser
RUN mkdir -p /app/temp /app/gcode /app/profiles && chown -R appuser:appuser /app

############################################################
# OrcaSlicer Worker Runtime Container  
############################################################
FROM slicer-base AS orcaslicer-worker
ARG ORCASLICER_VERSION
ARG ALLOW_STUB=false
ARG ORCASLICER_SHA256
ARG BUILD_VERSION
ARG VCS_REF
ARG SOURCE_REPOSITORY
ARG SOURCE_ARCHIVE_URL
ARG SBOM_URL

LABEL org.opencontainers.image.title="PrintFarmer OrcaSlicer Worker" \
      org.opencontainers.image.description="PrintFarmer dedicated OrcaSlicer worker" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.source="${SOURCE_REPOSITORY}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.version="${BUILD_VERSION}" \
      org.printfarmer.source-archive="${SOURCE_ARCHIVE_URL}" \
      org.printfarmer.sbom="${SBOM_URL}" \
      component="orcaslicer-worker" \
      orcaslicer.version="${ORCASLICER_VERSION}" \
      orcaslicer.sha256="${ORCASLICER_SHA256}" \
      orcaslicer.distribution="upstream" \
      orcaslicer.attestation="/etc/printfarmer/orcaslicer.sha256" \
      orcaslicer.allow_stub="${ALLOW_STUB}" \
      security.sandbox="true"

# Copy OrcaSlicer binaries from the binary layer (as appuser)
COPY --chown=appuser:appuser --from=orcaslicer-binaries /orcaslicer-dist/orcaslicer /usr/local/bin/orcaslicer
COPY --chown=appuser:appuser --from=orcaslicer-binaries /orcaslicer-dist/opt/orcaslicer /opt/orcaslicer
# Reject external binary contexts that do not attest the exact requested release.
RUN --mount=type=bind,from=orcaslicer-binaries,source=/orcaslicer-dist,target=/tmp/orcaslicer-dist,readonly \
    set -e; \
    actual_version="$(cat /tmp/orcaslicer-dist/orcaslicer.version 2>/dev/null || true)"; \
    actual_sha256="$(cat /tmp/orcaslicer-dist/orcaslicer.sha256 2>/dev/null || true)"; \
    if [ "${ALLOW_STUB}" != "true" ]; then \
        if [ -z "$actual_version" ]; then \
            echo "ERROR: cached OrcaSlicer binary layer is missing embedded version metadata"; \
            exit 1; \
        fi; \
        if [ "$actual_version" != "${ORCASLICER_VERSION}" ]; then \
            echo "ERROR: cached OrcaSlicer binary version '$actual_version' does not match requested '${ORCASLICER_VERSION}'"; \
            exit 1; \
        fi; \
        if [ -z "$actual_sha256" ]; then \
            echo "ERROR: cached OrcaSlicer binary layer is missing checksum metadata"; \
            exit 1; \
        fi; \
        if [ "$actual_sha256" != "${ORCASLICER_SHA256}" ]; then \
            echo "ERROR: cached OrcaSlicer binary checksum does not match the requested release"; \
            exit 1; \
        fi; \
    fi; \
    install -d -o appuser -g appuser -m 0755 /etc/printfarmer; \
    printf '%s' "$actual_version" > /etc/printfarmer/orcaslicer.version; \
    printf '%s' "$actual_sha256" > /etc/printfarmer/orcaslicer.sha256; \
    chown appuser:appuser /etc/printfarmer/orcaslicer.version /etc/printfarmer/orcaslicer.sha256; \
    chmod 0644 /etc/printfarmer/orcaslicer.version /etc/printfarmer/orcaslicer.sha256

# Copy OrcaSlicer Worker binaries from shared build stage (as appuser)
COPY --chown=appuser:appuser --from=shared-build /app/publish/orcaslicer-worker .
COPY --chown=appuser:appuser scripts/docker/orcaslicer-worker-entrypoint.sh /usr/local/bin/orcaslicer-worker-entrypoint
COPY --from=legal-assets /LICENSE /usr/share/licenses/printfarmer/LICENSE
COPY --from=legal-assets /THIRD-PARTY-NOTICES.md /usr/share/licenses/printfarmer/THIRD-PARTY-NOTICES.md

# Verify binary installation and set up permissions
RUN set -e; \
    if [ -f /opt/orcaslicer/AppRun ]; then \
        rm -f /usr/local/bin/orcaslicer; \
        ln -s /opt/orcaslicer/AppRun /usr/local/bin/orcaslicer; \
    fi; \
    chmod +x /usr/local/bin/orcaslicer && \
    test -f /usr/local/bin/orcaslicer && \
    test -s ./Farm.OrcaSlicer.Worker.dll && \
    echo "✓ OrcaSlicer worker binaries verified" && \
    # Create cache directory for SQLite profile cache \
    mkdir -p /app/cache && \
    chown appuser:appuser /app/cache && \
    # Create the writable, version-pinned custom source and composed overlay roots \
    mkdir -p /app/custom-profiles /app/profiles && \
    chown appuser:appuser /app/custom-profiles /app/profiles && \
    chmod +x /usr/local/bin/orcaslicer-worker-entrypoint && \
    # Ensure temp working directory is writable by appuser \
    mkdir -p /app/temp && \
    chown appuser:appuser /app/temp && \
    # Verify profile directories exist \
    PROFILES_DIR="/opt/orcaslicer/resources/profiles"; \
    if [ -d "$PROFILES_DIR" ]; then \
        profile_count=$(find "$PROFILES_DIR" -name "*.json" 2>/dev/null | wc -l); \
        echo "✓ Profile directory verified with $profile_count JSON profiles"; \
    else \
        echo "ERROR: Profile directory not found at $PROFILES_DIR"; \
        exit 1; \
    fi && \
    echo "✓ OrcaSlicer worker setup completed"

# Run as non-root user
USER appuser

# Set environment
ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production
ENV Worker__OrcaSlicerPath=/opt/orcaslicer/bin/orca-slicer
ENV Worker__WorkingDirectory=/app/temp
ENV ORCA_STOCK_PROFILES_PATH=/opt/orcaslicer/resources/profiles
ENV ORCA_CUSTOM_PROFILES_PATH=/app/custom-profiles
ENV ORCA_PROFILES_PATH=/app/profiles
ENV PROFILE_CACHE_PATH=/app/cache
# Inject actual OrcaSlicer version for registration (overrides appsettings default).
# Both keys are set from the single ORCASLICER_VERSION build arg so worker capability
# advertisement (Worker__EngineVersion) and slicer registration (SlicerRegistry__Version)
# can never drift from the binary that was baked into the image (issue #578).
ENV SlicerRegistry__Version=${ORCASLICER_VERSION}
ENV Worker__EngineVersion=${ORCASLICER_VERSION}
# Reproducible build identity reported at worker registration. The worker reads the attestation the
# build wrote for the binary it actually installed; the declared build argument is not exported,
# because the ALLOW_STUB fallback does not honour it. An empty attestation means "unverified", which
# keeps calibration capabilities false rather than asserting an unproven pin.
ENV Worker__OrcaSlicerAttestationPath=/etc/printfarmer/orcaslicer.sha256

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/healthz || exit 1

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/orcaslicer-worker-entrypoint"]
CMD ["dotnet", "Farm.OrcaSlicer.Worker.dll"]

############################################################
# React Frontend Build Stage
############################################################
# Accept build arguments for frontend configuration
ARG VITE_API_BASE_URL=/api
ARG VITE_SIGNALR_PRINTERS_URL=/hubs/printers
ARG VITE_SIGNALR_HARVEST_URL=/hubs/harvest

FROM --platform=${BUILDPLATFORM:-linux/amd64} node:${NODE_TAG} AS frontend-build
WORKDIR /app

# Copy package files directly from ReactApp (no workspaces)
COPY src/Web/ReactApp/package.json src/Web/ReactApp/package-lock.json ./

# Install npm dependencies with proper error handling
RUN set -eux; \
    echo "[frontend-build] Node.js version:"; node --version; \
    echo "[frontend-build] npm version:"; npm --version; \
    \
    if [ -f package-lock.json ]; then \
        echo "[frontend-build] package-lock.json found - using npm ci"; \
        npm ci --prefer-offline --no-audit --legacy-peer-deps 2>&1 | tee /tmp/npm-install.log; \
    else \
        echo "[frontend-build] package-lock.json NOT found - using npm install"; \
        npm install --prefer-offline --no-audit --legacy-peer-deps 2>&1 | tee /tmp/npm-install.log; \
    fi; \
    npm_status=$?; \
    \
    if [ "$npm_status" -ne 0 ]; then \
        echo "[frontend-build] ERROR: npm install/ci failed with status $npm_status"; \
        tail -n 50 /tmp/npm-install.log; \
        exit 1; \
    fi; \
    \
    if [ ! -f node_modules/.bin/vite ]; then \
        echo "[frontend-build] ERROR: vite not found in node_modules/.bin"; \
        ls -la node_modules/.bin 2>&1 | head -20; \
        exit 1; \
    fi; \
    \
    echo "[frontend-build] Dependencies installed successfully"; \
    npm ls --depth=0 2>&1 | head -25

# Copy source code and build with environment variables
COPY src/Web/ReactApp/ ./
COPY scripts/compliance /scripts/compliance
COPY compliance/dependency-license-policy.json /compliance/dependency-license-policy.json
COPY compliance/licenses /compliance/licenses
ARG VITE_API_BASE_URL=/api
ARG VITE_SIGNALR_PRINTERS_URL=/hubs/printers
ARG VITE_SIGNALR_HARVEST_URL=/hubs/harvest
# Short git SHA baked into the frontend bundle (vite.config reads process.env.VITE_GIT_SHA
# as a fallback when .git is not present in the build context).
ARG GIT_SHA=unknown
ARG VITE_GIT_SHA=${GIT_SHA}
RUN set -eux; \
    echo "[frontend-build] Starting React build with Vite..."; \
    echo "[frontend-build] VITE_API_BASE_URL=${VITE_API_BASE_URL}"; \
    echo "[frontend-build] VITE_SIGNALR_PRINTERS_URL=${VITE_SIGNALR_PRINTERS_URL}"; \
    echo "[frontend-build] VITE_SIGNALR_HARVEST_URL=${VITE_SIGNALR_HARVEST_URL}"; \
    echo "[frontend-build] VITE_GIT_SHA=${VITE_GIT_SHA}"; \
    \
    export VITE_API_BASE_URL="${VITE_API_BASE_URL}"; \
    export VITE_SIGNALR_PRINTERS_URL="${VITE_SIGNALR_PRINTERS_URL}"; \
    export VITE_SIGNALR_HARVEST_URL="${VITE_SIGNALR_HARVEST_URL}"; \
    export VITE_GIT_SHA="${VITE_GIT_SHA}"; \
    \
    set +e; \
    npm run build > /tmp/frontend-build.log 2>&1; \
    build_status=$?; \
    set -e; \
    \
    if [ "$build_status" -ne 0 ]; then \
        echo "[frontend-build] ERROR: Build failed with status $build_status"; \
        tail -n 200 /tmp/frontend-build.log; \
        exit $build_status; \
    fi; \
    \
    node /scripts/compliance/create-npm-notices.mjs \
        --repo / \
        --package-root app \
        --output app/dist/THIRD-PARTY-LICENSES.npm.txt; \
    \
    if [ ! -d dist ] || [ ! -f dist/index.html ]; then \
        echo "[frontend-build] ERROR: dist directory or index.html not found!"; \
        ls -la; \
        tail -n 80 /tmp/frontend-build.log || true; \
        exit 1; \
    fi; \
    \
    echo "[frontend-build] Build completed successfully"; \
    ls -lah dist/

############################################################
# React Frontend Runtime Container
############################################################
FROM nginx:${NGINX_TAG} AS frontend-runtime
ARG BUILD_VERSION
ARG VCS_REF
ARG SOURCE_REPOSITORY
ARG SOURCE_ARCHIVE_URL
ARG SBOM_URL
WORKDIR /usr/share/nginx/html

LABEL org.opencontainers.image.title="PrintFarmer Frontend" \
      org.opencontainers.image.description="PrintFarmer React web client" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.source="${SOURCE_REPOSITORY}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.version="${BUILD_VERSION}" \
      org.printfarmer.source-archive="${SOURCE_ARCHIVE_URL}" \
      org.printfarmer.sbom="${SBOM_URL}"

# Ensure curl present for health checks
RUN apk update && apk add --no-cache curl && rm -rf /var/cache/apk/*

# Copy built React app (from /app/dist since source was copied flat)
COPY --from=frontend-build /app/dist .
COPY --from=legal-assets /LICENSE /usr/share/licenses/printfarmer/LICENSE
COPY --from=legal-assets /THIRD-PARTY-NOTICES.md /usr/share/licenses/printfarmer/THIRD-PARTY-NOTICES.md

# Copy nginx configuration
COPY scripts/docker/nginx.conf /etc/nginx/nginx.conf

# Note: curl and nginx directories are pre-configured in base image

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:80/health || exit 1

EXPOSE 80

# Override the default nginx entrypoint to just run nginx directly
ENTRYPOINT []
CMD ["nginx", "-g", "daemon off;"]

############################################################
# Monolith Runtime Container (API + Frontend in single container)
# For Raspberry Pi / low-resource deployments
############################################################
FROM api-runtime AS monolith-runtime

LABEL org.opencontainers.image.title="PrintFarmer Monolith" \
      org.opencontainers.image.description="PrintFarmer API and web client monolith"

# Copy React frontend build into wwwroot for static file serving
COPY --from=frontend-build /app/dist ./wwwroot/
COPY --from=frontend-build /app/dist/THIRD-PARTY-LICENSES.npm.txt ./THIRD-PARTY-LICENSES.npm.txt

# Set monolith deployment mode
ENV DEPLOYMENT_MODE=monolith

# Monolith serves both API and frontend on port 5000
# No separate nginx needed — ASP.NET Core serves static files directly
# Override inherited healthcheck with longer start_period for ARM/RPi deployments
HEALTHCHECK --interval=30s --timeout=15s --start-period=120s --retries=8 \
    CMD curl -f http://localhost:5000/healthz || exit 1

############################################################
# Printer Discovery Service Runtime Container
############################################################
FROM mcr.microsoft.com/dotnet/aspnet:${ASPNET_TAG} AS printer-discovery-runtime
ARG BUILD_VERSION
ARG VCS_REF
ARG SOURCE_REPOSITORY
ARG SOURCE_ARCHIVE_URL
ARG SBOM_URL
WORKDIR /app

LABEL org.opencontainers.image.title="PrintFarmer Printer Discovery" \
      org.opencontainers.image.description="PrintFarmer network printer discovery service" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.source="${SOURCE_REPOSITORY}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.version="${BUILD_VERSION}" \
      org.printfarmer.source-archive="${SOURCE_ARCHIVE_URL}" \
      org.printfarmer.sbom="${SBOM_URL}"

# Install curl for health checks (standard base images don't have it)
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# Create discovery user (different from appuser for service isolation)
RUN groupadd -r discovery && useradd -r -g discovery discovery && \
    chown -R discovery:discovery /app

# Copy published printer discovery service (as discovery user)
COPY --chown=discovery:discovery --from=shared-build /app/publish/printer-discovery .
COPY --from=legal-assets /LICENSE /usr/share/licenses/printfarmer/LICENSE
COPY --from=legal-assets /THIRD-PARTY-NOTICES.md /usr/share/licenses/printfarmer/THIRD-PARTY-NOTICES.md

# Run as non-root user
USER discovery

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:5247/api/discovery/health || exit 1

EXPOSE 5247

ENTRYPOINT ["dotnet", "PrinterDiscoveryService.dll"]

############################################################
# Moonraker Emulator Runtime Container
# Standalone repository-built Moonraker protocol emulator used only by the
# digest-pinned daily validation stack (and local opt-in use). It has no
# Docker socket mount, no physical network scanning, and no external service
# dependencies: it only serves deterministic printer-shaped HTTP/WebSocket
# state to the unchanged Farm.Backend.Plugin.Moonraker client.
############################################################
FROM mcr.microsoft.com/dotnet/aspnet:${ASPNET_TAG} AS moonraker-emulator-runtime
ARG BUILD_VERSION
ARG VCS_REF
ARG SOURCE_REPOSITORY
ARG SOURCE_ARCHIVE_URL
ARG SBOM_URL
WORKDIR /app

LABEL org.opencontainers.image.title="PrintFarmer Moonraker Emulator" \
      org.opencontainers.image.description="Repository-built Moonraker protocol emulator for digest-pinned daily validation" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.source="${SOURCE_REPOSITORY}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.version="${BUILD_VERSION}" \
      org.printfarmer.source-archive="${SOURCE_ARCHIVE_URL}" \
      org.printfarmer.sbom="${SBOM_URL}"

# Install curl for health checks (standard base images don't have it)
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# Create emulator user (isolated from appuser/discovery for service separation)
RUN groupadd -r emulator && useradd -r -g emulator emulator && \
    chown -R emulator:emulator /app

# Copy published Moonraker emulator service (as emulator user)
COPY --chown=emulator:emulator --from=shared-build /app/publish/moonraker-emulator .
COPY --from=legal-assets /LICENSE /usr/share/licenses/printfarmer/LICENSE
COPY --from=legal-assets /THIRD-PARTY-NOTICES.md /usr/share/licenses/printfarmer/THIRD-PARTY-NOTICES.md

ENV ASPNETCORE_URLS=http://+:7125
ENV ASPNETCORE_ENVIRONMENT=Production
# Control API (scenario/fault injection) is emulator-only and off unless the
# validation topology explicitly enables it.
ENV Emulator__EnableControlApi=false

# Run as non-root user; the image is compatible with a read-only root
# filesystem (Compose supplies a writable /tmp tmpfs for ASP.NET Core).
USER emulator

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:7125/healthz || exit 1

EXPOSE 7125

ENTRYPOINT ["dotnet", "Farm.Moonraker.Emulator.dll"]