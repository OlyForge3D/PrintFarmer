# syntax=docker/dockerfile:1
############################################################
# OrcaSlicer Worker Container
# Builds the dedicated Orca slicer worker (.NET) and installs
# OrcaSlicer on top of the neutral slicer-base runtime image.
#
# Expectations:
#  - Parent image 'slicer-base' already built (Dockerfile.slicer-base)
#  - This image focuses ONLY on Orca-specific bits
############################################################

ARG ORCASLICER_VERSION=2.3.1
# Default URL (x86_64). Dynamic discovery may override; we also attempt arm64/aarch64 patterns.
ARG ORCASLICER_URL=https://github.com/SoftFever/OrcaSlicer/releases/download/v${ORCASLICER_VERSION}/OrcaSlicer_Linux_V${ORCASLICER_VERSION}.AppImage
ARG ALLOW_STUB=true
ARG GITHUB_TOKEN

# Pre-install tooling in a separate layer for better caching
FROM printfarmer-slicer-base AS orca-tools
USER root
RUN set -e; apk add --no-cache curl ca-certificates jq 2>/dev/null || (apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates jq fuse libfuse2 squashfs-tools libarchive-tools p7zip-full file && rm -rf /var/lib/apt/lists/*)


########################################
# Build Stage (.NET publish for Orca worker)
########################################
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Copy shared + worker project files first (restore layer caching)

# Copy shared, infrastructure, and worker project files first (restore layer caching)
COPY Directory.Build.props ./
COPY src/shared/*.csproj ./shared/
COPY src/infra/*.csproj ./infra/
COPY src/worker-shared/*.csproj ./worker-shared/
COPY src/orcaslicer-worker/*.csproj ./orcaslicer-worker/

RUN dotnet restore ./orcaslicer-worker/Farm.OrcaSlicer.Worker.csproj

# Copy sources
COPY src/shared/ ./shared/
COPY src/infra/ ./infra/
COPY src/worker-shared/ ./worker-shared/
COPY src/orcaslicer-worker/ ./orcaslicer-worker/

RUN set -e; \
    echo "[build] Starting dotnet publish"; \
    dotnet publish ./orcaslicer-worker/Farm.OrcaSlicer.Worker.csproj -c Release -o /app/publish --verbosity minimal > /tmp/publish.log 2>&1 || (echo "[build] dotnet publish FAILED - dumping /tmp/publish.log" && cat /tmp/publish.log && exit 1); \
    # Verify critical runtime files exist and are non-empty
    test -s /app/publish/Farm.OrcaSlicer.Worker.dll && \
    test -s /app/publish/Farm.OrcaSlicer.Worker.runtimeconfig.json && \
    echo "[build] Published files verified successfully" || \
    (echo "[build] ERROR: Critical publish files missing or empty" && ls -la /app/publish || true && cat /tmp/publish.log || true && exit 1)

########################################
# Runtime Stage
########################################
########################################
# Orca Binary Assets Stage (optimized caching layer)
########################################
FROM orcaslicer-binaries:${ORCASLICER_VERSION} AS orcaassets

########################################
# Final Runtime Stage
########################################
FROM printfarmer-slicer-base AS final
ARG ORCASLICER_VERSION
ARG ALLOW_STUB
LABEL component="orcaslicer-worker" \
    orcaslicer.version="${ORCASLICER_VERSION}" \
    description="Dedicated OrcaSlicer worker container" \
    security.sandbox="true" \
    org.opencontainers.image.source="https://github.com/jpapiez/PrintFarmer"
USER root
WORKDIR /app

# Install runtime dependencies needed by the OrcaSlicer ELF (graphics / webkit / gstreamer)
RUN set -e; \
        apt-get update && apt-get install -y --no-install-recommends \
            libegl1 libegl1-mesa libgles2 libgtk-3-0 libwebkit2gtk-4.0-37 libjavascriptcoregtk-4.0-18 \
            gstreamer1.0-plugins-base gstreamer1.0-plugins-good gstreamer1.0-plugins-bad \
            gstreamer1.0-libav libgstreamer1.0-0 libgstreamer-plugins-base1.0-0 \
            fontconfig locales tzdata && rm -rf /var/lib/apt/lists/*; \
        # Ensure a minimal locale is present (some GTK/WebKit code expects it)
        locale-gen en_US.UTF-8 || true

# Copy binary assets (real or stub) & optional extracted directory
COPY --from=orcaassets /orcaslicer-dist/orcaslicer /usr/local/bin/orcaslicer
COPY --from=orcaassets /orcaslicer-dist/opt/orcaslicer /opt/orcaslicer

USER sliceruser
# Copy published .NET worker bits (already trimmed via publish) and ensure ownership
COPY --chown=sliceruser:sliceruser --from=build /app/publish .

# Harden runtime via env toggles; disable diagnostics pipe & set invariant globalization
ENV DOTNET_EnableDiagnostics=0 \
    COMPlus_EnableDiagnostics=0 \
    Worker__OrcaSlicerPath=/usr/local/bin/orcaslicer \
    Worker__WorkingDirectory=/app/temp \
    Worker__StorageEndpoint=http://api:5245 \
    Worker__MaxMemoryMb=1024 \
    Worker__MaxConcurrentJobs=1

# Mark working/temp directories writable, keep rest read-only when run with 'read_only: true' in compose
RUN mkdir -p /app/temp /app/logs /app/cache && \
    chmod 700 /app/temp && chmod 700 /app/logs && chmod 700 /app/cache

EXPOSE 8080
ENTRYPOINT ["dotnet", "Farm.OrcaSlicer.Worker.dll"]

# Recommended runtime (compose) security options (documented in WORKER_SANDBOXING.md):
#   read_only: true
#   cap_drop: ["ALL"]
#   security_opt:
#     - no-new-privileges:true
#   tmpfs:
#     - /tmp:rw,noexec,nosuid,size=64m
#   pids_limit: 128
#   ulimits:
#     nofile: 1024
