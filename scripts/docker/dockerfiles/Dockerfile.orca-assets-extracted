# Build an assets image from already-extracted AppImage content (orca7z)
ARG ORCASLICER_VERSION=2.3.1
FROM ubuntu:22.04
ARG ORCASLICER_VERSION
LABEL orcaslicer.version="${ORCASLICER_VERSION}"
WORKDIR /tmp
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates file && rm -rf /var/lib/apt/lists/*
COPY orca7z/ /orcaslicer-dist/opt/orcaslicer/
## ensure bin/ exists and copy the real orca-slicer binary if present
RUN mkdir -p /orcaslicer-dist/opt/orcaslicer/bin || true
COPY orcaslicer_binary/orca-slicer /orcaslicer-dist/opt/orcaslicer/bin/orca-slicer
## Place the real ELF at top-level /orcaslicer-dist/orcaslicer for runtime
COPY orcaslicer_binary/orca-slicer /orcaslicer-dist/orcaslicer
RUN chmod +x /orcaslicer-dist/orcaslicer || true
CMD ["true"]
