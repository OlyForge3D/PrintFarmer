# Small assets builder for OrcaSlicer
# Copies a local orcaslicer.AppImage and extracts a runnable binary into /orcaslicer-dist
ARG ORCASLICER_VERSION=2.3.1
FROM ubuntu:24.04
ARG ORCASLICER_VERSION
LABEL orcaslicer.version="${ORCASLICER_VERSION}"
WORKDIR /tmp
RUN apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates curl jq p7zip-full squashfs-tools libarchive-tools file wget && rm -rf /var/lib/apt/lists/*
COPY orcaslicer.AppImage ./orcaslicer.AppImage
RUN set -e; \
    chmod +x orcaslicer.AppImage || true; \
    mkdir -p /orcaslicer-dist/opt; \
    # Try several extraction strategies
    if unsquashfs -d squashfs-root orcaslicer.AppImage >/dev/null 2>&1; then \
      mv squashfs-root /orcaslicer-dist/opt/orcaslicer; \
      cp /orcaslicer-dist/opt/orcaslicer/AppRun /orcaslicer-dist/orcaslicer || true; \
    elif ./orcaslicer.AppImage --appimage-extract >/dev/null 2>&1; then \
      mv squashfs-root /orcaslicer-dist/opt/orcaslicer; \
      cp /orcaslicer-dist/opt/orcaslicer/AppRun /orcaslicer-dist/orcaslicer || true; \
    elif 7z x -oorca7z orcaslicer.AppImage >/dev/null 2>&1 && [ -d orca7z/squashfs-root ]; then \
      mv orca7z/squashfs-root /orcaslicer-dist/opt/orcaslicer; \
      cp /orcaslicer-dist/opt/orcaslicer/AppRun /orcaslicer-dist/orcaslicer || true; \
    elif bsdtar -xf orcaslicer.AppImage 2>/dev/null && [ -d squashfs-root ]; then \
      mv squashfs-root /orcaslicer-dist/opt/orcaslicer; \
      cp /orcaslicer-dist/opt/orcaslicer/AppRun /orcaslicer-dist/orcaslicer || true; \
    else \
      # Attempt raw carve
      off=$(grep -aob 'hsqs' orcaslicer.AppImage | head -n1 | cut -d: -f1 || true); \
      if [ -n "$off" ]; then dd if=orcaslicer.AppImage bs=1 skip=$off of=core.squashfs 2>/dev/null || true; \
        if unsquashfs -d squashfs-root core.squashfs >/dev/null 2>&1; then mv squashfs-root /orcaslicer-dist/opt/orcaslicer; cp /orcaslicer-dist/opt/orcaslicer/AppRun /orcaslicer-dist/orcaslicer || true; fi; \
      fi; \
    fi; \
    rm -f orcaslicer.AppImage || true; \
    if [ ! -f /orcaslicer-dist/orcaslicer ]; then \
      printf '#!/bin/sh\n>&2 echo "[WARN] OrcaSlicer binary not present (version %s)"\nexit 2\n' "${ORCASLICER_VERSION}" > /orcaslicer-dist/orcaslicer; \
      chmod +x /orcaslicer-dist/orcaslicer; \
    fi
CMD ["true"]
