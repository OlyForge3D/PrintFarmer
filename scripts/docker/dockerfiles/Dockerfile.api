ARG BUILD_VERSION=development
ARG VCS_REF=unknown
ARG SOURCE_REPOSITORY=""
ARG SOURCE_ARCHIVE_URL=""
ARG SBOM_URL=""

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
WORKDIR /app
EXPOSE 5000

# Install network tools for enhanced Docker Desktop networking and Assimp for 3D model thumbnail generation
# Update to latest packages to get compatible glibc/libstdc++ for bundled Assimp native library
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y curl iputils-ping iproute2 net-tools dnsutils && \
    rm -rf /var/lib/apt/lists/*

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy project files
COPY src/infra/*.csproj ./infra/
COPY src/import/*.csproj ./import/
COPY src/modules/Farm.Modules.Abstractions/*.csproj ./modules/Farm.Modules.Abstractions/
COPY src/modules/Farm.Modules.SmartPlug/*.csproj ./modules/Farm.Modules.SmartPlug/
COPY src/modules/Farm.Modules.PrintQueue/*.csproj ./modules/Farm.Modules.PrintQueue/
COPY src/modules/Farm.Modules.Maintenance/*.csproj ./modules/Farm.Modules.Maintenance/
COPY src/modules/Farm.Modules.Calibration/*.csproj ./modules/Farm.Modules.Calibration/
COPY src/modules/Farm.Modules.Gcode/*.csproj ./modules/Farm.Modules.Gcode/
COPY src/modules/Farm.Modules.Identity/*.csproj ./modules/Farm.Modules.Identity/
COPY src/api/*.csproj ./api/
# Place proto at filesystem root so ../../proto from /src/api resolves
COPY proto /proto
COPY Directory.Build.props ./
COPY global.json ./

# Restore dependencies
RUN dotnet restore ./api/Farm.Web.Api.csproj

# Copy source code
COPY src/ ./
# Ensure proto still present at /proto (second copy retained for clarity if context changed)
COPY proto /proto

# Build and publish
RUN dotnet publish ./api/Farm.Web.Api.csproj \
    -c Release \
    -o /app/publish \
    --no-restore

FROM base AS final
ARG BUILD_VERSION
ARG VCS_REF
ARG SOURCE_REPOSITORY
ARG SOURCE_ARCHIVE_URL
ARG SBOM_URL
WORKDIR /app

LABEL org.opencontainers.image.title="PrintFarmer API" \
      org.opencontainers.image.description="PrintFarmer API server" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.source="${SOURCE_REPOSITORY}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.version="${BUILD_VERSION}" \
      org.printfarmer.source-archive="${SOURCE_ARCHIVE_URL}" \
      org.printfarmer.sbom="${SBOM_URL}"

COPY --from=build /app/publish .
COPY LICENSE /usr/share/licenses/printfarmer/LICENSE
COPY THIRD-PARTY-NOTICES.md /usr/share/licenses/printfarmer/THIRD-PARTY-NOTICES.md

# Create necessary directories
RUN mkdir -p /app/uploads /app/gcode /app/slicers

# Set environment
ENV ASPNETCORE_URLS=http://+:5000
ENV ASPNETCORE_ENVIRONMENT=Production
ENV PFARM__SourceInfo__Version=${BUILD_VERSION}
ENV PFARM__SourceInfo__Revision=${VCS_REF}
ENV PFARM__SourceInfo__RepositoryUrl=${SOURCE_REPOSITORY}
ENV PFARM__SourceInfo__SourceArchiveUrl=${SOURCE_ARCHIVE_URL}
ENV PFARM__SourceInfo__SbomUrl=${SBOM_URL}

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=5 \
    CMD curl -f http://localhost:5000/healthz || exit 1

ENTRYPOINT ["dotnet", "Farm.Web.Api.dll"]
