FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
WORKDIR /app
EXPOSE 5000

# Install network tools for enhanced Docker Desktop networking and Assimp for 3D model thumbnail generation
# Update to latest packages to get compatible glibc/libstdc++ for bundled Assimp native library
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y curl iputils-ping iproute2 net-tools dnsutils && \
    rm -rf /var/lib/apt/lists/*

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy project files
COPY src/infra/*.csproj ./infra/
COPY src/import/*.csproj ./import/
COPY src/api/*.csproj ./api/
# Place proto at filesystem root so ../../proto from /src/api resolves
COPY proto /proto
COPY Directory.Build.props ./
COPY global.json ./

# Restore dependencies
RUN dotnet restore ./api/Farm.Web.Api.csproj

# Copy source code
COPY src/ ./
# Ensure proto still present at /proto (second copy retained for clarity if context changed)
COPY proto /proto

# Build and publish
RUN dotnet publish ./api/Farm.Web.Api.csproj \
    -c Release \
    -o /app/publish \
    --no-restore

FROM base AS final
WORKDIR /app
COPY --from=build /app/publish .

# Create necessary directories
RUN mkdir -p /app/uploads /app/gcode /app/slicers

# Set environment
ENV ASPNETCORE_URLS=http://+:5000
ENV ASPNETCORE_ENVIRONMENT=Production

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=5 \
    CMD curl -f http://localhost:5000/healthz || exit 1

ENTRYPOINT ["dotnet", "Farm.Web.Api.dll"]
