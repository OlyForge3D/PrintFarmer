# syntax=docker/dockerfile:1
############################################################
# OrcaSlicer Binaries Only - Optimized Caching Layer
# This Dockerfile downloads and extracts ONLY the OrcaSlicer
# binaries to create a reusable Docker layer that can be
# cached independently of application code changes.
#
# Usage:
#   docker build -f Dockerfile.orcaslicer-binaries -t orcaslicer-binaries:2.3.1 .
#   docker build -f Dockerfile.orcaslicer-binaries -t orcaslicer-binaries:latest .
#
# Benefits:
#   - Binary download/extraction happens only once
#   - Application rebuilds skip binary download
#   - Version-specific tagging for binary management
############################################################

ARG ORCASLICER_VERSION=2.3.1
ARG ORCASLICER_URL=https://github.com/SoftFever/OrcaSlicer/releases/download/v${ORCASLICER_VERSION}/OrcaSlicer_Linux_V${ORCASLICER_VERSION}.AppImage
ARG ALLOW_STUB=true
ARG GITHUB_TOKEN

FROM ubuntu:24.04 AS downloader
ARG ORCASLICER_VERSION
ARG ORCASLICER_URL
ARG ALLOW_STUB
ARG GITHUB_TOKEN
ARG PRESEED_SECRET_ID=orca

LABEL component="orcaslicer-binaries" \
      orcaslicer.version="${ORCASLICER_VERSION}" \
      description="OrcaSlicer binary assets for worker containers" \
      org.opencontainers.image.source="https://github.com/jpapiez/PrintFarmer"

WORKDIR /tmp

# Install extraction tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates jq p7zip-full squashfs-tools libarchive-tools \
    file wget && rm -rf /var/lib/apt/lists/*

# Download and extract OrcaSlicer binaries
# If a buildkit secret with id matching PRESEED_SECRET_ID is provided, it will be mounted at /run/secrets/${PRESEED_SECRET_ID}
RUN --mount=type=secret,id=orca,required=false \
    set -e; \
    echo "[orcaslicer-binaries] Resolving OrcaSlicer version=${ORCASLICER_VERSION}"; \
    \
    # Check for preseeded AppImage first
    if [ -f "/run/secrets/${PRESEED_SECRET_ID}" ]; then \
        echo "[orcaslicer-binaries] Using preseeded AppImage from /run/secrets/${PRESEED_SECRET_ID}"; \
        cp "/run/secrets/${PRESEED_SECRET_ID}" orcaslicer.AppImage || true; \
    fi; \
    \
    # If no preseeded file, download from GitHub
    if [ ! -f orcaslicer.AppImage ]; then \
        API_URL="https://api.github.com/repos/SoftFever/OrcaSlicer/releases"; \
        AUTH=""; [ -n "${GITHUB_TOKEN}" ] && AUTH="-H Authorization: Bearer ${GITHUB_TOKEN}"; \
        echo "[orcaslicer-binaries] Querying GitHub Releases API"; \
        \
        # Try to find the correct download URL dynamically
        dynamic_url=$(curl -H "Accept: application/vnd.github+json" \
                          -H "User-Agent: OrcaSlicerWorker/1.0" \
                          $AUTH -fsSL "$API_URL" | \
                      jq -r --arg ver "v${ORCASLICER_VERSION}" \
                         '.[] | select(.tag_name==$ver) | .assets[] | select(.name | test("(?i)(orca)?slicer.*(linux).*(x86_64|amd64).*AppImage$") or test("(?i)(orca)?slicer.*(aarch64|arm64).*AppImage$") or test("(?i)AppImage$")) | .browser_download_url' | \
                      head -n1 || true); \
        \
        if [ -n "$dynamic_url" ]; then \
            echo "[orcaslicer-binaries] Discovered asset: $dynamic_url"; \
            ORCASLICER_URL="$dynamic_url"; \
        fi; \
        \
        # Download function with multiple fallback URLs
        try_download() { \
            url="$1"; \
            echo "[orcaslicer-binaries] Attempting download: $url"; \
            if curl -H "User-Agent: OrcaSlicerWorker/1.0" -fSL -o orcaslicer.AppImage.tmp "$url"; then \
                size=$(stat -c%s orcaslicer.AppImage.tmp || echo 0); \
                if [ "$size" -gt 5000000 ]; then \
                    mv orcaslicer.AppImage.tmp orcaslicer.AppImage; \
                    return 0; \
                fi; \
                echo "[orcaslicer-binaries] Download too small (size $size < 5MB), invalid"; \
            fi; \
            rm -f orcaslicer.AppImage.tmp || true; \
            return 1; \
        }; \
        \
        # Try multiple URL patterns
        try_download "${ORCASLICER_URL}" \
        || try_download "https://github.com/SoftFever/OrcaSlicer/releases/download/v${ORCASLICER_VERSION}/OrcaSlicer_V${ORCASLICER_VERSION}_Linux_x86_64.AppImage" \
        || try_download "https://github.com/SoftFever/OrcaSlicer/releases/download/v${ORCASLICER_VERSION}/OrcaSlicer_Linux_V${ORCASLICER_VERSION}.AppImage" \
        || echo "[orcaslicer-binaries] WARNING: All download attempts failed."; \
    fi; \
    \
    # Create extraction directory
    mkdir -p /orcaslicer-dist/opt; \
    \
    # Extract AppImage if available
    if [ -f orcaslicer.AppImage ]; then \
        chmod +x orcaslicer.AppImage; \
        arch=$(uname -m); \
        echo "[orcaslicer-binaries] File magic: $( (command -v file >/dev/null 2>&1 && file orcaslicer.AppImage) || echo 'file N/A')"; \
        echo "[orcaslicer-binaries] Head bytes: $(od -An -tx1 -N8 orcaslicer.AppImage 2>/dev/null | tr -s ' ' | sed 's/^ //')"; \
        echo "[orcaslicer-binaries] Host build arch: $arch"; \
        \
        if [ "$arch" = "x86_64" ] || [ "$arch" = "aarch64" ] || [ "$arch" = "arm64" ]; then \
            echo "[orcaslicer-binaries] Attempting unsquashfs extraction first"; \
            if unsquashfs -d squashfs-root orcaslicer.AppImage >/dev/null 2>&1; then \
                mv squashfs-root /orcaslicer-dist/opt/orcaslicer; \
                cp /orcaslicer-dist/opt/orcaslicer/AppRun /orcaslicer-dist/orcaslicer || true; \
            else \
                echo "[orcaslicer-binaries] unsquashfs failed, trying --appimage-extract"; \
                if ./orcaslicer.AppImage --appimage-extract 2>extract.err; then \
                    mv squashfs-root /orcaslicer-dist/opt/orcaslicer; \
                    cp /orcaslicer-dist/opt/orcaslicer/AppRun /orcaslicer-dist/orcaslicer || true; \
                else \
                    # Fallback extraction methods
                    echo "[orcaslicer-binaries] Primary extract failed. Trying 7z then bsdtar then carve"; \
                    if command -v 7z >/dev/null 2>&1; then \
                        if 7z x -y -oorca7z orcaslicer.AppImage >/dev/null 2>&1; then \
                            if [ -d orca7z/squashfs-root ]; then \
                                mv orca7z/squashfs-root /orcaslicer-dist/opt/orcaslicer; \
                            fi; \
                            if [ ! -d /orcaslicer-dist/opt/orcaslicer ]; then \
                                mkdir -p /orcaslicer-dist/opt/orcaslicer; \
                                cp -R orca7z/* /orcaslicer-dist/opt/orcaslicer/ || true; \
                            fi; \
                            cp /orcaslicer-dist/opt/orcaslicer/AppRun /orcaslicer-dist/orcaslicer 2>/dev/null || true; \
                        else \
                            echo "[orcaslicer-binaries] 7z extraction failed"; \
                        fi; \
                    fi; \
                    \
                    if [ ! -d /orcaslicer-dist/opt/orcaslicer ] && command -v bsdtar >/dev/null 2>&1; then \
                        if bsdtar -xf orcaslicer.AppImage 2>/dev/null && [ -d squashfs-root ]; then \
                            mv squashfs-root /orcaslicer-dist/opt/orcaslicer; \
                            cp /orcaslicer-dist/opt/orcaslicer/AppRun /orcaslicer-dist/orcaslicer 2>/dev/null || true; \
                        fi; \
                    fi; \
                    \
                    # Raw carve as last resort
                    if [ ! -d /orcaslicer-dist/opt/orcaslicer ]; then \
                        echo "[orcaslicer-binaries] Attempting raw carve for hsqs magic"; \
                        off=$(grep -aob 'hsqs' orcaslicer.AppImage | head -n1 | cut -d: -f1 || true); \
                        if [ -n "$off" ]; then \
                            dd if=orcaslicer.AppImage bs=1 skip=$off of=core.squashfs 2>/dev/null || true; \
                            if unsquashfs -d squashfs-root core.squashfs >/dev/null 2>&1; then \
                                mv squashfs-root /orcaslicer-dist/opt/orcaslicer; \
                                cp /orcaslicer-dist/opt/orcaslicer/AppRun /orcaslicer-dist/orcaslicer 2>/dev/null || true; \
                            else \
                                echo "[orcaslicer-binaries] Carve unsquashfs failed"; \
                            fi; \
                        else \
                            echo "[orcaslicer-binaries] hsqs magic not found"; \
                        fi; \
                    fi; \
                fi; \
            fi; \
        else \
            echo "[orcaslicer-binaries] Skipping extraction due to unsupported arch: $arch"; \
        fi; \
        rm -f orcaslicer.AppImage; \
    fi; \
    \
    # Create stub if binary extraction failed but ALLOW_STUB is true
    if [ ! -f /orcaslicer-dist/orcaslicer ]; then \
        if [ "${ALLOW_STUB}" = "true" ]; then \
            echo "[orcaslicer-binaries] Creating stub binary"; \
            printf '#!/bin/sh\n>&2 echo "[WARN] OrcaSlicer binary not present (version %s)"\nexit 2\n' "${ORCASLICER_VERSION}" > /orcaslicer-dist/orcaslicer; \
            chmod +x /orcaslicer-dist/orcaslicer; \
        else \
            echo "[orcaslicer-binaries] ERROR: Binary missing and ALLOW_STUB=false"; \
            exit 1; \
        fi; \
    fi; \
    \
    # Verify what we extracted
    echo "[orcaslicer-binaries] Extraction complete. Contents:"; \
    ls -la /orcaslicer-dist/ || true; \
    ls -la /orcaslicer-dist/opt/ || true; \
    file /orcaslicer-dist/orcaslicer || true;

# Final stage - minimal image with just the binaries
FROM scratch AS binaries
COPY --from=downloader /orcaslicer-dist /orcaslicer-dist
CMD ["true"]