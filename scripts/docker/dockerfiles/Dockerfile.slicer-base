# syntax=docker/dockerfile:1
# Slicer Worker Base Runtime Image (no slicer engines installed)
# Provides common runtime deps (GTK/offscreen, xvfb), non-root user, health tooling.

FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS slicer-base

LABEL maintainer="PrintFarmer Team" \
    description="Neutral base runtime for engine-specific slicer workers (no slicer binaries)" \
    version="1.0.0" \
    component="slicer-base"

ENV DOTNET_RUNNING_IN_CONTAINER=true \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=true \
    ASPNETCORE_URLS=http://0.0.0.0:8080 \
    DISPLAY=:99 \
    QT_QPA_PLATFORM=offscreen

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl wget ca-certificates \
    libgtk-3-0 libgl1-mesa-glx libglib2.0-0 libstdc++6 libopengl0 xvfb \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1000 sliceruser \
    && useradd --uid 1000 --gid sliceruser --shell /bin/bash --create-home sliceruser

WORKDIR /app

# Create common data dirs (will be owned by non-root)
RUN mkdir -p /app/data /app/temp /app/logs && chown -R sliceruser:sliceruser /app

USER sliceruser

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8080/healthz || exit 1

# Intentionally no ENTRYPOINT here; child images provide it.
