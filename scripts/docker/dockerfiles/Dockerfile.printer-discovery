ARG BUILD_VERSION=development
ARG VCS_REF=unknown
ARG SOURCE_REPOSITORY=""
ARG SOURCE_ARCHIVE_URL=""
ARG SBOM_URL=""

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY ["src/printer-discovery/PrinterDiscoveryService.csproj", "src/printer-discovery/"]

RUN dotnet restore "src/printer-discovery/PrinterDiscoveryService.csproj"

COPY . .
WORKDIR "/src/src/printer-discovery"

RUN dotnet build "PrinterDiscoveryService.csproj" -c Release -o /app/build

FROM build AS publish
RUN dotnet publish "PrinterDiscoveryService.csproj" -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0
ARG BUILD_VERSION
ARG VCS_REF
ARG SOURCE_REPOSITORY
ARG SOURCE_ARCHIVE_URL
ARG SBOM_URL
WORKDIR /app

LABEL org.opencontainers.image.title="PrintFarmer Printer Discovery" \
      org.opencontainers.image.description="PrintFarmer network printer discovery service" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.source="${SOURCE_REPOSITORY}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.version="${BUILD_VERSION}" \
      org.printfarmer.source-archive="${SOURCE_ARCHIVE_URL}" \
      org.printfarmer.sbom="${SBOM_URL}"

COPY --from=publish /app/publish .
COPY LICENSE /usr/share/licenses/printfarmer/LICENSE
COPY THIRD-PARTY-NOTICES.md /usr/share/licenses/printfarmer/THIRD-PARTY-NOTICES.md

EXPOSE 7080

ENTRYPOINT ["dotnet", "PrinterDiscoveryService.dll"]
