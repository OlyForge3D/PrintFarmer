{
  "$schema": "./release-version-sequence.schema.json",
  "schemaVersion": 1,
  "contract": {
    "versionSyntax": "MAJOR.MINOR.PATCH[-insider.SEQUENCE]",
    "componentType": "unsigned decimal integer without leading zeroes",
    "manifestSequenceJsonType": "integer",
    "implementationType": "signed 64-bit integer",
    "formula": "major * 1000000000 + minor * 1000000 + patch * 1000 + suffix",
    "radices": {
      "minor": 1000,
      "patch": 1000,
      "suffix": 1000
    },
    "limits": {
      "major": 99,
      "minor": 999,
      "patch": 999,
      "insiderSequence": 998,
      "stableSuffix": 999
    }
  },
  "validCases": [
    {
      "name": "minimum insider",
      "version": "1.0.0-insider.1",
      "parsed": {
        "major": 1,
        "minor": 0,
        "patch": 0,
        "kind": "insider",
        "suffix": 1
      },
      "expectedSequence": "1000000001"
    },
    {
      "name": "minimum stable",
      "version": "1.0.0",
      "parsed": {
        "major": 1,
        "minor": 0,
        "patch": 0,
        "kind": "stable",
        "suffix": 999
      },
      "expectedSequence": "1000000999"
    },
    {
      "name": "ordinary insider",
      "version": "1.2.3-insider.1",
      "parsed": {
        "major": 1,
        "minor": 2,
        "patch": 3,
        "kind": "insider",
        "suffix": 1
      },
      "expectedSequence": "1002003001"
    },
    {
      "name": "ordinary stable",
      "version": "1.2.3",
      "parsed": {
        "major": 1,
        "minor": 2,
        "patch": 3,
        "kind": "stable",
        "suffix": 999
      },
      "expectedSequence": "1002003999"
    },
    {
      "name": "maximum insider suffix",
      "version": "1.2.3-insider.998",
      "parsed": {
        "major": 1,
        "minor": 2,
        "patch": 3,
        "kind": "insider",
        "suffix": 998
      },
      "expectedSequence": "1002003998"
    },
    {
      "name": "weighted boundary left",
      "version": "1.1.999",
      "parsed": {
        "major": 1,
        "minor": 1,
        "patch": 999,
        "kind": "stable",
        "suffix": 999
      },
      "expectedSequence": "1001999999"
    },
    {
      "name": "weighted boundary right",
      "version": "1.2.0",
      "parsed": {
        "major": 1,
        "minor": 2,
        "patch": 0,
        "kind": "stable",
        "suffix": 999
      },
      "expectedSequence": "1002000999"
    },
    {
      "name": "stable reserved suffix",
      "version": "1.2.3-insider.998",
      "parsed": {
        "major": 1,
        "minor": 2,
        "patch": 3,
        "kind": "insider",
        "suffix": 998
      },
      "expectedSequence": "1002003998"
    },
    {
      "name": "stable reserved suffix stable",
      "version": "1.2.3",
      "parsed": {
        "major": 1,
        "minor": 2,
        "patch": 3,
        "kind": "stable",
        "suffix": 999
      },
      "expectedSequence": "1002003999"
    },
    {
      "name": "maximum insider",
      "version": "99.999.999-insider.998",
      "parsed": {
        "major": 99,
        "minor": 999,
        "patch": 999,
        "kind": "insider",
        "suffix": 998
      },
      "expectedSequence": "99999999998"
    },
    {
      "name": "maximum stable",
      "version": "99.999.999",
      "parsed": {
        "major": 99,
        "minor": 999,
        "patch": 999,
        "kind": "stable",
        "suffix": 999
      },
      "expectedSequence": "99999999999"
    }
  ],
  "invalidCases": [
    {
      "name": "empty",
      "version": "",
      "errorContains": "without leading zeros"
    },
    {
      "name": "missing patch",
      "version": "1.2",
      "errorContains": "without leading zeros"
    },
    {
      "name": "extra component",
      "version": "1.2.3.4",
      "errorContains": "without leading zeros"
    },
    {
      "name": "stable metadata",
      "version": "1.2.3+build.4",
      "errorContains": "without leading zeros"
    },
    {
      "name": "unsupported beta",
      "version": "1.2.3-beta.1",
      "errorContains": "stable or insider"
    },
    {
      "name": "unsupported release candidate",
      "version": "1.2.3-rc.1",
      "errorContains": "stable or insider"
    },
    {
      "name": "zero-major signed release",
      "version": "0.2.3",
      "errorContains": "major version must be greater than zero"
    },
    {
      "name": "leading zero major",
      "version": "01.2.3",
      "errorContains": "without leading zeros"
    },
    {
      "name": "leading zero minor",
      "version": "1.02.3",
      "errorContains": "without leading zeros"
    },
    {
      "name": "leading zero patch",
      "version": "1.2.03",
      "errorContains": "without leading zeros"
    },
    {
      "name": "zero insider suffix",
      "version": "1.2.3-insider.0",
      "errorContains": "without leading zeros"
    },
    {
      "name": "leading zero insider suffix",
      "version": "1.2.3-insider.01",
      "errorContains": "without leading zeros"
    },
    {
      "name": "major above maximum",
      "version": "100.0.0",
      "errorContains": "Major version exceeds"
    },
    {
      "name": "minor above maximum",
      "version": "1.1000.0",
      "errorContains": "Minor version exceeds"
    },
    {
      "name": "patch above maximum",
      "version": "1.0.1000",
      "errorContains": "Patch version exceeds"
    },
    {
      "name": "insider suffix above maximum",
      "version": "1.0.0-insider.999",
      "errorContains": "Prerelease sequence exceeds"
    }
  ],
  "ordering": [
    {
      "name": "insider sequence increments",
      "lower": "1.2.3-insider.1",
      "higher": "1.2.3-insider.2"
    },
    {
      "name": "maximum insider remains below stable",
      "lower": "1.2.3-insider.998",
      "higher": "1.2.3"
    },
    {
      "name": "patch increments across weighted boundary",
      "lower": "1.1.999",
      "higher": "1.2.0"
    },
    {
      "name": "stable reserved suffix dominates insider",
      "lower": "1.2.3-insider.998",
      "higher": "1.2.3"
    },
    {
      "name": "maximum insider remains below maximum stable",
      "lower": "99.999.999-insider.998",
      "higher": "99.999.999"
    }
  ],
  "distinctGroups": [
    {
      "name": "weighted boundary versions",
      "versions": [
        "1.1.999",
        "1.2.0"
      ]
    },
    {
      "name": "stable and insider identities",
      "versions": [
        "1.2.3-insider.1",
        "1.2.3-insider.998",
        "1.2.3"
      ]
    }
  ]
}
