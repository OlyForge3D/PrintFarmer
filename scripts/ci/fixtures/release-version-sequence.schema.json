{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OlyForge3D/PrintFarmer/blob/development/scripts/ci/fixtures/release-version-sequence.schema.json",
  "title": "PrintFarmer release version and sequence golden contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contract",
    "validCases",
    "invalidCases",
    "ordering",
    "distinctGroups"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "versionSyntax",
        "componentType",
        "manifestSequenceJsonType",
        "implementationType",
        "formula",
        "radices",
        "limits"
      ],
      "properties": {
        "versionSyntax": {
          "const": "MAJOR.MINOR.PATCH[-insider.SEQUENCE]"
        },
        "componentType": {
          "const": "unsigned decimal integer without leading zeroes"
        },
        "manifestSequenceJsonType": {
          "const": "integer"
        },
        "implementationType": {
          "const": "signed 64-bit integer"
        },
        "formula": {
          "const": "((((major * 1000) + minor) * 100000) + patch) * 100000 + suffix"
        },
        "radices": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minor",
            "patch",
            "suffix"
          ],
          "properties": {
            "minor": {
              "const": 1000
            },
            "patch": {
              "const": 100000
            },
            "suffix": {
              "const": 100000
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "major",
            "minor",
            "patch",
            "insiderSequence",
            "stableSuffix"
          ],
          "properties": {
            "major": {
              "const": 99
            },
            "minor": {
              "const": 999
            },
            "patch": {
              "const": 99999
            },
            "insiderSequence": {
              "const": 99998
            },
            "stableSuffix": {
              "const": 99999
            }
          }
        }
      }
    },
    "validCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/validCase"
      }
    },
    "invalidCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/invalidCase"
      }
    },
    "ordering": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "lower",
          "higher"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "lower": {
            "type": "string",
            "minLength": 1
          },
          "higher": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "distinctGroups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "versions"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "versions": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "parsedVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "major",
        "minor",
        "patch",
        "kind",
        "suffix"
      ],
      "properties": {
        "major": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        },
        "patch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99999
        },
        "kind": {
          "enum": [
            "stable",
            "insider"
          ]
        },
        "suffix": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99999
        }
      }
    },
    "validCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "parsed",
        "expectedSequence"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "parsed": {
          "$ref": "#/$defs/parsedVersion"
        },
        "expectedSequence": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        }
      }
    },
    "invalidCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "errorContains"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "errorContains": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
