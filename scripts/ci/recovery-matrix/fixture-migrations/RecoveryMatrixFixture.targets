<!--
  Recovery-matrix test fixture only (#3167). Imported exclusively through
  -p:CustomAfterMicrosoftCommonTargets=... by Dockerfile.target-schema-delta, never by a
  product project. Adds exactly one fixture migration to each PostgreSQL / SQL Server
  migrations project so a recovery-matrix target image is N+1 over its prior image.
-->
<Project>
  <PropertyGroup>
    <_RecoveryMatrixFixtureDir>$(MSBuildThisFileDirectory)</_RecoveryMatrixFixtureDir>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Farm.Migrations.PostgreSQL' Or '$(MSBuildProjectName)' == 'Farm.Migrations.SqlServer'">
    <Compile Include="$(_RecoveryMatrixFixtureDir)RecoveryMatrixFixtureSchemaDelta.cs" Link="RecoveryMatrixFixture/RecoveryMatrixFixtureSchemaDelta.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Farm.Slicer.Migrations.PostgreSQL' Or '$(MSBuildProjectName)' == 'Farm.Slicer.Migrations.SqlServer'">
    <Compile Include="$(_RecoveryMatrixFixtureDir)RecoveryMatrixFixtureSlicerSchemaDelta.cs" Link="RecoveryMatrixFixture/RecoveryMatrixFixtureSlicerSchemaDelta.cs" />
  </ItemGroup>
</Project>
