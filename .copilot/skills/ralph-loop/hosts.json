{
  "schemaVersion": 1,
  "policyVersion": "printfarmer-cross-host-v1",
  "repository": "OlyForge3D/PrintFarmer",
  "baseBranch": "development",
  "hosts": {
    "macos-mobile": {
      "configured": true,
      "platform": "darwin",
      "scope": "mixed",
      "admission": "native-local",
      "maxLocalSessions": 5,
      "maxMobileSessions": 1,
      "maxGeneralSessions": 4,
      "maxLocalXcodeJobs": 1,
      "generalAdmission": "blocked-pending-shared-authority",
      "commissionReviews": true,
      "mergeHeldPrs": [2603],
      "dallas": { "model": "gpt-6-astra", "reasoningEffort": "xhigh" },
      "kickoffClauses": "macos-kickoff.md"
    },
    "windows-general": {
      "configured": true,
      "platform": "win32",
      "scope": "general",
      "admission": "windows-shared",
      "maxLocalSessions": 5,
      "maxMobileSessions": 0,
      "maxGeneralSessions": 5,
      "newRemoteMobileDispatch": false
    }
  }
}
