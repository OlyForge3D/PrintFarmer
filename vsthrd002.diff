index 543260a21..b854b8509 100644
--- a/src/tests/Directory.Build.props
+++ b/src/tests/Directory.Build.props
@@ -81,7 +81,35 @@
            in "Async" and every call site was updated accordingly; this is a purely
            mechanical naming-convention fix with zero behavioral impact, so no suppressions
            were required. -->
-      VSTHRD002;<!-- Avoid problematic synchronous waits (16) -->
+      <!-- VSTHRD002 (Avoid problematic synchronous waits) fully cleared across src/tests/ —
+           see #2106 burn-down. All 14 distinct instances (the issue's original "16" estimate
+           was close but not exact; 12 were in projects that ship in farm-web.sln, plus 2 more
+           in Farm.Web.IntegrationTests, which is excluded from that solution's default
+           `dotnet test` run via IsTestProject=false unless RunIntegrationTests=true but still
+           inherits this file's NoWarn and was rebuilt/tested separately to confirm) were
+           `.GetAwaiter().GetResult()`/`.Wait()` calls on tasks from otherwise-synchronous test
+           code and were fixed directly: xUnit constructor-based async seeding was moved to
+           `IAsyncLifetime.InitializeAsync`, `void`-returning test methods and helper methods
+           that only existed to bridge to a synchronous caller were converted to `async Task`
+           with a real `await`, and one mocked-HTTP-content read used `HttpContent.ReadAsStream()`
+           instead of an async read, since the content there is always built synchronously by the
+           code under test from data already fully buffered in memory (never a network/file
+           stream), regardless of whether it's a `StringContent` or a
+           `MultipartFormDataContent`/`ByteArrayContent` pair. Two instances are a deliberately
+           blocking wait inside a method overriding a fixed synchronous base signature that
+           cannot be made async — `IServiceScopeFactory.CreateScope()` and
+           `WebApplicationFactory<T>.CreateHost()` respectively — each always driven from a
+           background thread rather than the test's own thread, suppressed with a scoped #pragma
+           warning disable/restore VSTHRD002 plus an explanatory comment at the site. Dozens of
+           other `.GetAwaiter().GetResult()` calls remain in `Func<HttpRequestMessage,
+           HttpResponseMessage>`-typed fake-HTTP-handler callbacks (e.g. SpoolmanServiceTests,
+           MoonrakerClientBusyTests, DirectApnsNativePushSenderTests) — these are not VSTHRD002
+           violations at all: the analyzer does not flag a synchronous wait inside a lambda whose
+           delegate type cannot itself be made async, which was confirmed empirically by
+           reverting one already-fixed call site to its original synchronous form and rebuilding,
+           which reproduced the VSTHRD002 error, while these callback sites never do, even from a
+           fully clean rebuild. -->
+
       IDISP024; <!-- Don't call GC.SuppressFinalize when no finalizer exists (16) -->
       CA2025;   <!-- Do not pass 'IDisposable' instances into unawaited tasks (14) -->
       IDISP007; <!-- Don't dispose an injected dependency (12) -->
