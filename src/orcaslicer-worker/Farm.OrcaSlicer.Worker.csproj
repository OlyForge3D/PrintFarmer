<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Farm.OrcaSlicer.Worker</AssemblyName>
    <RootNamespace>Farm.OrcaSlicer.Worker</RootNamespace>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <PreserveCompilationContext>false</PreserveCompilationContext>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Farm.OrcaSlicer.Worker.Tests" />

    <!--
      The pinned-container real-OrcaSlicer-CLI rotation test (issue #1802) calls the production
      rotation/placement pure functions (ToOrcaRotation, BuildTransformFlags, PlanPlacement,
      TryReadBedCenter, BuildOrcaSlicerArguments) directly instead of reimplementing them, so the
      test exercises the exact code under test rather than a parallel copy of it.
    -->
    <InternalsVisibleTo Include="Farm.Web.IntegrationTests" />
  </ItemGroup>
  <!-- Note: Health check and System.Text.Json packages removed - available via project references -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../worker-shared/Farm.Slicer.Worker.Core.csproj" />
    <ProjectReference Include="../infra/Farm.Infrastructure.csproj" />
    <ProjectReference Include="../slicer/Farm.Slicer.Module/Farm.Slicer.Module.csproj" />
    <ProjectReference Include="../slicer/Farm.Slicer.ProfileParsing/Farm.Slicer.ProfileParsing.csproj" />
  </ItemGroup>
</Project>
