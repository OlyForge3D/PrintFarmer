{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SlicerApi": {
    "BaseUrl": "http://api:5245"
  },
  "Worker": {
    "WorkingDirectory": "/app/temp",
    "StorageEndpoint": "http://api:5245",
    "QueueKey": "slicer:queue:orcaslicer",
    "ProcessingKey": "slicer:processing",
    "OrcaSlicerPath": "/opt/orcaslicer/bin/orca-slicer",
    "MaxConcurrentJobs": 1,
    "ModelDownloadMaxBytes": 536870912,
    "ModelDownloadTimeoutSeconds": 120,
    "EngineVersion": "2.4.2",
    "VerifyBinaryVersion": true
  },
  "SlicerRegistry": {
    "ApiBaseUrl": "http://api:5245",
    "ServiceName": "orcaslicer-worker",
    "Version": "2.4.2",
    "Host": "http://orcaslicer-worker:8080",
    "HeartbeatIntervalSeconds": 30
  },
  "WorkerAuth": {
    "SharedKey": ""
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  }
}
