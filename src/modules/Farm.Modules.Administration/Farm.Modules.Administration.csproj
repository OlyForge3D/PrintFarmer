<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Matches Farm.Web.Api.csproj's prior suppressions for the moved
         controllers/services: 1591 (missing XML doc comment on a public
         member) and S6960 ("controller has multiple responsibilities") fire
         on some of the moved admin/settings controllers, which were already
         suppressing them in their prior host location. This is a move-only
         refactor, so no new warning should surface as a result of relocating
         unmodified code. -->
    <NoWarn>$(NoWarn);1591;S6960</NoWarn>
    <Description>Vertical-slice module for administration: the Admin Control
Center overview aggregation, the admin data export/import, Home Assistant, and
Telegram admin controllers, plus the settings and unified-settings
controllers. Moves AdminOverviewController, Controllers/Admin/{AdminDataController,
AdminHomeAssistantController, AdminTelegramController}, SettingsController,
UnifiedSettingsController, AdminOverviewService, and
DiscoveryHeartbeatMonitorService out of Farm.Web.Api. Registers via
IApiModule (see Farm.Modules.Abstractions, issue #2035). Phase 14 of the
module-decomposition epic #2019. Namespaces were renamed from
Farm.Web.Api.* to Farm.Modules.Administration.* by Phase 19 (issue #2047),
completing the move-first-rename-last strategy.
DiscoveryHeartbeatMonitorService is not explicitly named by issue #2042, but
moved alongside UnifiedSettingsController (its only consumer) to avoid a
circular Farm.Web.Api -> Farm.Modules.Administration -> Farm.Web.Api
dependency, mirroring how Phase 13 moved TokenRevocationCleanupService for the
same reason.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Required for IServiceCollection/IMvcBuilder/IEndpointRouteBuilder/ControllerBase/IHostedService -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\infra\Farm.Infrastructure.csproj" />
    <ProjectReference Include="..\..\settings\Farm.Settings.Abstractions\Farm.Settings.Abstractions.csproj" />
    <ProjectReference Include="..\Farm.Modules.Abstractions\Farm.Modules.Abstractions.csproj" />
  </ItemGroup>

</Project>
