<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Vertical-slice module for smart-plug power monitoring: SmartPlug provider
implementations (Kasa/Tasmota/Shelly/HomeAssistant), the PowerMonitor polling background
service, and the admin power-monitors controller. Registers via IApiModule (see
Farm.Modules.Abstractions, issue #2035). Pilot for the module-decomposition epic #2019 --
namespaces are intentionally unchanged from their prior Farm.Web.Api location
(move-first-rename-last).</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Required for IServiceCollection/IMvcBuilder/IEndpointRouteBuilder/ControllerBase/HttpClient -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\infra\Farm.Infrastructure.csproj" />
    <ProjectReference Include="..\Farm.Modules.Abstractions\Farm.Modules.Abstractions.csproj" />
  </ItemGroup>

</Project>
