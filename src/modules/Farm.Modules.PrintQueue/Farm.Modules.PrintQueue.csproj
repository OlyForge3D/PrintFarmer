<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Vertical-slice module for the print job queue: PrintJobManagementService
(moved as-is, no internal decomposition), job queue/analytics/scheduling controllers,
dispatch/auto-dispatch/retry controllers, the slice-to-print bridge controller, and their
retry/SignalR/queue DTOs. Registers via IApiModule (see Farm.Modules.Abstractions,
issue #2035). Phase 12 of the module-decomposition epic #2019. Namespaces were
renamed from Farm.Web.Api.* to Farm.Modules.PrintQueue.* by Phase 19 (issue #2047),
completing the move-first-rename-last strategy.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Required for IServiceCollection/IMvcBuilder/IEndpointRouteBuilder/ControllerBase/HttpClient -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\infra\Farm.Infrastructure.csproj" />
    <ProjectReference Include="..\Farm.Modules.Abstractions\Farm.Modules.Abstractions.csproj" />
    <ProjectReference Include="..\Farm.Modules.Calibration\Farm.Modules.Calibration.csproj" />
    <ProjectReference Include="..\Farm.Modules.Gcode\Farm.Modules.Gcode.csproj" />
    <!-- SlicePrintBridgeController bridges slicer jobs to durable G-code promotion and print workflows. -->
    <ProjectReference Include="..\..\slicer\Farm.Slicer.Module\Farm.Slicer.Module.csproj" />
  </ItemGroup>

</Project>
