<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Farm.Modules.Abstractions</RootNamespace>
    <Description>Host seam for vertical-slice API modules: the IApiModule contract, module
discovery/registration extensions, and the shared ProblemDetails/attribute shapes
Farm.Modules.* assemblies build on. No dependencies beyond ASP.NET Core -- a dependency-graph
leaf by design, so any project may reference it without risking a cycle. Consumed by every
Farm.Modules.* assembly, Farm.Web.Api, and Farm.Infrastructure (see epic #2019 and issue
#2100).</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Required for IServiceCollection/IMvcBuilder/IEndpointRouteBuilder/ProblemDetails/IFilterFactory -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
