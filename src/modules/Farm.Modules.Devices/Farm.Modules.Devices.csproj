<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Vertical-slice module for device integrations: OctoPrint API-key authentication
(handler, attribute, and auth service), NFC tag/device controllers, and camera and
camera-snapshot controllers. Registers via IApiModule (see Farm.Modules.Abstractions, issue
#2035). Phase 15 of the module-decomposition epic #2019 -- namespaces are intentionally
unchanged from their prior Farm.Web.Api location (move-first-rename-last).</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Required for IServiceCollection/IMvcBuilder/IEndpointRouteBuilder/ControllerBase/HttpClient -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\infra\Farm.Infrastructure.csproj" />
    <ProjectReference Include="..\..\discovery\Farm.Shared.Discovery.csproj" />
    <ProjectReference Include="..\Farm.Modules.Abstractions\Farm.Modules.Abstractions.csproj" />
  </ItemGroup>

</Project>
