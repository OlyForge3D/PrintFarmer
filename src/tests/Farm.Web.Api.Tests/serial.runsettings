<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <!-- Force single-threaded test execution to reduce resource pressure during DB-heavy tests -->
    <MaxCpuCount>1</MaxCpuCount>
    <!-- Put results under tests project's TestResults folder -->
    <ResultsDirectory>TestResults</ResultsDirectory>
  </RunConfiguration>
</RunSettings>
