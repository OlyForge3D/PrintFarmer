      Executing DbCommand [Parameters=[@__printerId_0='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT "p"."Id", "p"."GcodeFileId", "g"."DisplayName" AS "GcodeFileName", "p"."AssignedPrinterId", "p0"."Name" AS "AssignedPrinterName", CAST("p"."Status" AS INTEGER) AS "Status", "p"."Priority", 0 AS "QueuePosition", "p"."RequiredNozzleDiameter", "p"."RequiredMaterialType", "p"."EstimatedPrintTime", "p"."EstimatedFilamentUsage", "p"."ActualStartTime", "p"."ActualEndTime", "p"."ActualPrintTime", "p"."ActualFilamentUsage", "p"."FailureReason", "p"."CreatedAt", "p"."UpdatedAt"
      FROM "PrintJobs" AS "p"
      INNER JOIN "GcodeFiles" AS "g" ON "p"."GcodeFileId" = "g"."Id"
      LEFT JOIN "Printers" AS "p0" ON "p"."AssignedPrinterId" = "p0"."Id"
      WHERE "p"."AssignedPrinterId" = @__printerId_0
      ORDER BY CASE
          WHEN "p"."Status" IN (3, 2) THEN 0
          ELSE 1
      END, "p"."Priority", "p"."QueuedAt"
