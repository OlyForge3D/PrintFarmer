<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  <NoWarn>$(NoWarn);S2699</NoWarn>
  <!-- Default quick-run filter: exclude Docker tests unless explicitly overridden -->
  <VSTestTestCaseFilter>Category!='Docker'</VSTestTestCaseFilter>
  </PropertyGroup>

  <!-- Enable deterministic per-project coverlet outputs (lcov) so CI can merge them predictably -->
  <PropertyGroup>
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutput>$(MSBuildProjectDirectory)/../coverage/$(MSBuildProjectName).info</CoverletOutput>
    <CoverletOutputFormat>lcov</CoverletOutputFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.9" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.msbuild" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Additional packages for slicer services testing -->
    <PackageReference Include="StackExchange.Redis" Version="2.10.1" />
    <!-- Note: Microsoft.Extensions.Options removed - available via API project reference -->
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\api\Farm.Web.Api.csproj" />
    <ProjectReference Include="..\..\infra\Farm.Infrastructure.csproj" />
    <ProjectReference Include="..\..\migrations\Farm.Migrations.Sqlite\Farm.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\..\migrations\Farm.Slicer.Migrations.PostgreSQL\Farm.Slicer.Migrations.PostgreSQL.csproj" />
    <ProjectReference Include="..\..\migrations\Farm.Slicer.Migrations.SqlServer\Farm.Slicer.Migrations.SqlServer.csproj" />
    <ProjectReference Include="..\..\migrations\Farm.Slicer.Migrations.Sqlite\Farm.Slicer.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\..\slicer\Farm.Slicer.Module\Farm.Slicer.Module.csproj" />
    <ProjectReference Include="..\..\slicer\Farm.Slicer.Module.Api\Farm.Slicer.Module.Api.csproj" />
    <ProjectReference Include="..\..\Slicers\Farm.Slicers.OrcaSlicer.v2_4_0\Farm.Slicers.OrcaSlicer.v2_4_0.csproj" />
    <ProjectReference Include="..\..\backends\Farm.Backend.Plugin.Core\Farm.Backend.Plugin.Core.csproj" />
    <ProjectReference Include="..\..\backends\Farm.Backend.Plugin.Moonraker\Farm.Backend.Plugin.Moonraker.csproj" />
    <ProjectReference Include="..\..\backends\Farm.Backend.Plugin.PrusaLink\Farm.Backend.Plugin.PrusaLink.csproj" />
    <ProjectReference Include="..\..\backends\Farm.Backend.Plugin.Sdcp\Farm.Backend.Plugin.Sdcp.csproj" />
    <ProjectReference Include="..\..\backends\Farm.Backend.Plugin.OctoPrint\Farm.Backend.Plugin.OctoPrint.csproj" />
    <ProjectReference Include="..\..\backends\Farm.Backend.Plugin.FlashForge\Farm.Backend.Plugin.FlashForge.csproj" />
    <!-- Provider migration assemblies (issue #839): referenced so migration-content tests can
         assert on the generated Up()/Down() operations without needing a live Postgres/SQL
         Server connection. -->
    <ProjectReference Include="..\..\migrations\Farm.Migrations.PostgreSQL\Farm.Migrations.PostgreSQL.csproj" />
    <ProjectReference Include="..\..\migrations\Farm.Migrations.SqlServer\Farm.Migrations.SqlServer.csproj" />
    <!-- Referenced so the broadcaster⇄controller route-alignment regression test can compare
         DiscoveryProgressBroadcaster's request-path constants against
         InternalDiscoveryEventsController's [Route]/[HttpPost] templates via reflection.
         Aliased because PrinterDiscoveryService also emits a top-level Program type that
         would otherwise collide with Farm.Web.Api's public Program (CS0433). -->
    <ProjectReference Include="..\..\printer-discovery\PrinterDiscoveryService.csproj" Aliases="PrinterDiscoveryRef" />
  </ItemGroup>

  <!-- Exclude Docker integration tests moved to Farm.Web.IntegrationTests -->
  <ItemGroup>
    <Compile Remove="SlicerServices\OrcaSlicerDockerIntegrationTests.cs" />
    <Compile Remove="SlicerServices\PrusaSlicerDockerIntegrationTests.cs" />
    <Compile Remove="SlicerServices\SlicerWorkerDockerCommonTests.cs" />
    <Compile Remove="Util\DockerTestHelpers.cs" />
  </ItemGroup>
</Project>
