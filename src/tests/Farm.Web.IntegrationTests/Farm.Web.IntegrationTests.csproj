<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    By default we DO NOT want integration tests to run during a standard
    'dotnet test ./farm-web.sln'. Set the MSBuild property RunIntegrationTests
    (or environment variable RunIntegrationTests) to 'true' to enable these
    tests, e.g.:

      RunIntegrationTests=true dotnet test ./farm-web.sln

    When RunIntegrationTests != 'true' the project will not be treated as a
    test project (IsTestProject=false) and will be skipped by 'dotnet test'.
  -->
  <PropertyGroup>
    <RunIntegrationTests Condition="'$(RunIntegrationTests)'==''">false</RunIntegrationTests>
    <!-- Only mark as test project when explicitly enabled -->
    <IsTestProject Condition="'$(RunIntegrationTests)'!='true'">false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="8.9.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="coverlet.collector" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="StackExchange.Redis" Version="2.12.14" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\api\Farm.Web.Api.csproj" />
    <ProjectReference Include="..\..\migrations\Farm.Slicer.Migrations.Sqlite\Farm.Slicer.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\..\migrations\Farm.Migrations.Sqlite\Farm.Migrations.Sqlite.csproj" />
    <!--
      The monolith ships the slicer module and its API layer next to the API assembly, and the shim
      discovers them by scanning loaded assemblies. Referencing them here reproduces that deployment
      shape so the artifact, worker and promotion hops are routable in the smoke host.
    -->
    <ProjectReference Include="..\..\slicer\Farm.Slicer.Module\Farm.Slicer.Module.csproj" />
    <ProjectReference Include="..\..\slicer\Farm.Slicer.Module.Api\Farm.Slicer.Module.Api.csproj" />

    <!--
      Referenced so the real-OrcaSlicer-CLI rotation test (issue #1802) can call the production
      ToOrcaRotation/BuildTransformFlags/PlanPlacement/TryReadBedCenter/BuildOrcaSlicerArguments
      and ThreeMfProjectBuilder internals directly (see InternalsVisibleTo on
      Farm.OrcaSlicer.Worker.csproj) instead of reimplementing the rotation/placement math.
    -->
    <ProjectReference Include="..\..\orcaslicer-worker\Farm.OrcaSlicer.Worker.csproj" />
  </ItemGroup>

  <!--
    The pinned OrcaSlicer worker smoke gate reuses the calibration seed and the publication/digest
    rules that the default test suite already covers, so the operational gate and its focused unit
    tests exercise one implementation instead of two drifting copies.
  -->
  <ItemGroup>
    <Compile Include="..\Farm.Web.Api.Tests\Calibration\Generation\PinnedOrcaPublication.cs"
             Link="Calibration\Shared\PinnedOrcaPublication.cs" />
    <Compile Include="..\Farm.Web.Api.Tests\Calibration\Generation\CalibrationGenerationSeed.cs"
             Link="Calibration\Shared\CalibrationGenerationSeed.cs" />
    <Compile Include="..\Farm.Web.Api.Tests\Calibration\Generation\CalibrationGenerationFixture.cs"
             Link="Calibration\Shared\CalibrationGenerationFixture.cs" />
    <Compile Include="..\Farm.Web.Api.Tests\TestInfrastructure\TestAuthHandler.cs"
             Link="Calibration\Shared\TestAuthHandler.cs" />
    <Compile Include="..\Farm.Web.Api.Tests\TestInfrastructure\SlicerModulePreloader.cs"
             Link="Calibration\Shared\SlicerModulePreloader.cs" />
  </ItemGroup>

  <!--
    Pure geometry/gcode-parsing helpers for the real-OrcaSlicer-CLI rotation test (issue #1802) are
    physically authored in Farm.OrcaSlicer.Worker.Tests, alongside their own fast, docker-free unit
    tests, and linked in here so the docker-gated test reuses the exact same math instead of a
    drifting copy.
  -->
  <ItemGroup>
    <Compile Include="..\Farm.OrcaSlicer.Worker.Tests\Support\OrientationMarkerGeometry.cs"
             Link="Calibration\Shared\OrientationMarkerGeometry.cs" />
    <Compile Include="..\Farm.OrcaSlicer.Worker.Tests\Support\OrcaGcodeOrientationReader.cs"
             Link="Calibration\Shared\OrcaGcodeOrientationReader.cs" />
  </ItemGroup>

</Project>
