<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);S2699</NoWarn>
    <!-- Default quick-run filter: exclude Docker tests unless explicitly overridden -->
    <VSTestTestCaseFilter>Category!='Docker'</VSTestTestCaseFilter>
  </PropertyGroup>

  <!-- Coverage is collected on-demand via the VSTest data collector (coverlet.collector),
       not the coverlet.msbuild post-test target. The msbuild target read back its own hit
       file in a separate build task after the test host exited; under runner contention the
       host's process-exit flush could be truncated, so that read crashed with
       "Unable to read beyond the end of the stream" and failed a job whose tests all passed
       (issue #965). The collector flushes during the test host's controlled session-end, which
       is not subject to that race. Enable it by running `dotnet test` with the
       "XPlat Code Coverage" collector and the coverlet.runsettings settings file
       (see src/coverlet.runsettings). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="StackExchange.Redis" Version="2.10.1" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\api\Farm.Web.Api.csproj" />
    <ProjectReference Include="..\..\infra\Farm.Infrastructure.csproj" />
    <ProjectReference Include="..\..\migrations\Farm.Migrations.Sqlite\Farm.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\..\migrations\Farm.Slicer.Migrations.Sqlite\Farm.Slicer.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\..\orcaslicer-worker\Farm.OrcaSlicer.Worker.csproj" Aliases="OrcaWorker" />
    <ProjectReference Include="..\..\slicer\Farm.Slicer.Module\Farm.Slicer.Module.csproj" />
    <ProjectReference Include="..\..\slicer\Farm.Slicer.Module.Api\Farm.Slicer.Module.Api.csproj" />
    <ProjectReference Include="..\..\slicer\Farm.Slicer.Host\Farm.Slicer.Host.csproj" Aliases="SlicerHost" />
    <ProjectReference Include="..\..\Slicers\Farm.Slicers.OrcaSlicer.v2_4_0\Farm.Slicers.OrcaSlicer.v2_4_0.csproj" />
  </ItemGroup>
</Project>
