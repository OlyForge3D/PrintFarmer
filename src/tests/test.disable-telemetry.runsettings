<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <!-- Environment variables to apply when running tests -->
    <EnvironmentVariables>
      <DISABLE_TELEMETRY>true</DISABLE_TELEMETRY>
      <ASPNETCORE_ENVIRONMENT>Testing</ASPNETCORE_ENVIRONMENT>
    </EnvironmentVariables>
  </RunConfiguration>
</RunSettings>
