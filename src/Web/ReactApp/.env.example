# Example environment configuration
# Copy this file to .env.development.local for local development


# SignalR URLs for development - connect directly to API server
# VITE_SIGNALR_PRINTERS_URL=http://localhost:5245/hubs/printers
# VITE_SIGNALR_HARVEST_URL=http://localhost:5245/hubs/harvest

# API Base URL (optional, defaults to relative URLs which work via proxy)
# VITE_API_BASE_URL=http://localhost:5245

# --- Playwright E2E (not read by Vite; used by e2e/fixtures/*) ---
# API_BASE_URL=http://127.0.0.1:5245
# BASE_URL=http://localhost:3000
# Each Moonraker scenario is its own root emulator instance with its own
# control URL (never a shared host + path-prefixed printer id):
# MOONRAKER_EMULATOR_URL_READY=http://127.0.0.1:17125
# MOONRAKER_EMULATOR_URL_PRINTING=http://127.0.0.1:17126
# MOONRAKER_EMULATOR_URL_PAUSED=http://127.0.0.1:17127
# MOONRAKER_EMULATOR_URL_SHUTDOWN=http://127.0.0.1:17128
# Or override just the host used to compose the defaults above:
# MOONRAKER_EMULATOR_HOST=127.0.0.1