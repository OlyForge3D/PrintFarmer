{
  "name": "printfarmer-react",
  "private": true,
  "version": "0.2.3",
  "description": "PrintFarmer web dashboard",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/OlyForge3D/PrintFarmer",
  "repository": {
    "type": "git",
    "url": "https://github.com/OlyForge3D/PrintFarmer.git",
    "directory": "src/Web/ReactApp"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:inventory-inert-state": "node ./eslint-rules/inventory-inert-state-variants.js",
    "check:empty-attrs": "node ./scripts/check-empty-attrs.cjs",
    "check": "npm run check:empty-attrs",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:e2e:emulator": "playwright test e2e/emulator/",
    "test:e2e:moonraker": "playwright test e2e/emulator/ --grep Moonraker --workers=1",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "test:e2e:list": "playwright test --list",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "icons": "dotnet run --project ../../tools/IconGen/IconGen.csproj"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.2.2",
    "@mdi/js": "^7.4.47",
    "@microsoft/signalr": "^10.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-web": "^0.66.0",
