    "@opentelemetry/instrumentation-fetch": "^0.221.0",
    "@opentelemetry/instrumentation-user-interaction": "^0.65.0",
    "@opentelemetry/instrumentation-xml-http-request": "^0.221.0",
    "@opentelemetry/resources": "^2.1.0",
    "@opentelemetry/sdk-trace-web": "^2.1.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "^10.4.21",
    "axios": "^1.18.0",
    "date-fns": "^4.4.0",
    "driver.js": "^1.4.0",
    "fflate": "^0.8.2",
    "gcode-preview": "^2.18.0",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "lucide-react": "1.34.0",
    "postcss": "^8.5.23",
    "prop-types": "^15.8.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-colorful": "^5.6.1",
    "react-csv": "^2.2.2",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.62.0",
    "react-is": "^19.2.4",
    "react-router": "^8.3.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.1.18",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tanstack/react-query-devtools": "5.87.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.1.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "0.28.1",
    "eslint": "^10.9.1",
    "eslint-plugin-local": "file:eslint-rules",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^27.4.0",
    "three": "^0.182.0",
    "three-stdlib": "^2.36.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^8.2.0",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "stats-gl": {
      "three": "0.180.0"
    },
    "minimatch": ">=10.2.3",
    "dompurify": ">=3.4.13 <4.0.0",
    "ws": ">=8.21.0 <9.0.0",
    "form-data": ">=4.0.6 <5.0.0",
    "@opentelemetry/core": ">=2.8.0 <3.0.0",
    "nanoid": ">=3.3.17 <4.0.0",
