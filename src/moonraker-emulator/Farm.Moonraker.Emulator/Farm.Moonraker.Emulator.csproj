<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Farm.Moonraker.Emulator</AssemblyName>
    <RootNamespace>Farm.Moonraker.Emulator</RootNamespace>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <UserSecretsId>farm-moonraker-emulator</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Farm.Moonraker.Emulator.Tests" />
  </ItemGroup>

  <!--
    Intentionally standalone: no ProjectReference to Farm.Infrastructure or any other
    PrintFarmer project. This service only ever needs to speak the Moonraker wire
    protocol (plain ASP.NET Core minimal APIs + WebSockets), so it defines its own
    small, self-contained DTOs instead of pulling in the API's much heavier
    dependency graph (EF Core, Npgsql, Redis, Fido2, ...). No additional NuGet
    packages are required beyond the Microsoft.NET.Sdk.Web-provided framework.
  -->
</Project>
