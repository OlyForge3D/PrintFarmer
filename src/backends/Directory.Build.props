<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!-- Backend Plugin Configuration -->
  <!-- Inherits common build settings from /src/Directory.Build.props -->
  <!-- Only defines backend-specific NuGet package references -->

  <!-- Import parent Directory.Build.props from /src -->
  <Import Project="../Directory.Build.props" />

  <!-- Common NuGet Package References for Backend Infrastructure -->
  <!-- These versions are synchronized across all backend projects -->
  <!-- Updated to 10.0.2 (latest .NET 10 patch release) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR" Version="1.2.9" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.2" />
    <PackageReference Include="Refit.HttpClientFactory" Version="9.0.2" />
  </ItemGroup>

</Project>

