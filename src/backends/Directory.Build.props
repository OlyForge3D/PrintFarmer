<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!-- Backend Plugin Configuration -->
  <!-- Inherits common build settings from /src/Directory.Build.props -->
  <!-- Only defines backend-specific NuGet package references -->

  <!-- Import parent Directory.Build.props from /src -->
  <Import Project="../Directory.Build.props" />

  <!-- Common framework and NuGet references for backend infrastructure -->
  <!-- These versions are synchronized across all backend projects -->
  <!-- Logging and dependency injection match the EF Core 10.0.12 dependency floor. -->
  <ItemGroup>
    <!-- SignalR is provided by the shared ASP.NET Core framework. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <PackageReference Include="Refit.HttpClientFactory" Version="15.2.0" />
  </ItemGroup>

</Project>
