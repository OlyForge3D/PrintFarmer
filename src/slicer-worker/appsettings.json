{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "Worker": {
    "WorkingDirectory": "/tmp/slicer-work",
    "StorageEndpoint": "http://api:5245",
    "OrcaSlicerPath": "/usr/local/bin/orcaslicer",
    "MaxConcurrentJobs": 1,
    "HeartbeatIntervalSeconds": 30
  }
}