<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WarningsNotAsErrors>nullable</WarningsNotAsErrors>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Title>Farm.Slicers.OrcaSlicer.v2_3_1</Title>
    <Description>OrcaSlicer v2.3.1 slicer library for PrintFarmer. Contains profiles, assets, and UI components.</Description>
    <Version>2.3.1</Version>
    <Authors>PrintFarmer</Authors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../infra/Farm.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Test dependencies -->
  <ItemGroup>
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="FluentAssertions" Version="6.11.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Embed assets as resources -->
  <ItemGroup>
    <EmbeddedResource Include="lib/Assets/**/*">
      <LogicalName>OrcaSlicer_v2_3_1_Assets_%(Filename)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
