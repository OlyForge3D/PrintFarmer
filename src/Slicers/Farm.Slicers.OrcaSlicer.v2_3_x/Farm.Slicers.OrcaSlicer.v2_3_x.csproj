<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WarningsNotAsErrors>nullable</WarningsNotAsErrors>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Title>Farm.Slicers.OrcaSlicer.v2_3_x</Title>
    <Description>OrcaSlicer v2.3.1 slicer library for PrintFarmer. Contains profiles, assets, and UI components.</Description>
    <Version>2.3.1</Version>
    <Authors>PrintFarmer</Authors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../shared/Farm.Web.Shared.csproj" />
  </ItemGroup>

  <!-- Embed official profiles as resources -->
  <ItemGroup>
    <EmbeddedResource Include="lib/Profiles/official-profiles.json">
      <LogicalName>OrcaSlicer_v2_3_x_Profiles.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Embed assets as resources -->
  <ItemGroup>
    <EmbeddedResource Include="lib/Assets/**/*">
      <LogicalName>OrcaSlicer_v2_3_x_Assets_%(Filename)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
