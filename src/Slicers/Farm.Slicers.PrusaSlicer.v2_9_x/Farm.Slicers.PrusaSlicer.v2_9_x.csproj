<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    
    <PackageId>Farm.Slicers.PrusaSlicer.v2_9_x</PackageId>
    <Version>1.0.0</Version>
    <Title>PrintFarmer PrusaSlicer 2.9.x Library</Title>
    <Description>PrusaSlicer 2.9.x integration library for PrintFarmer with profile provider, asset registry, and UI components</Description>
    <Authors>PrintFarmer</Authors>
    <RepositoryUrl>https://github.com/jpapiez/PFarm1</RepositoryUrl>
    <PackageProjectUrl>https://github.com/jpapiez/PFarm1</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../infra/Farm.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Embed official profiles and assets -->
  <ItemGroup>
    <EmbeddedResource Include="lib/Profiles/official-profiles.json" Link="Resources/official-profiles.json" />
    <EmbeddedResource Include="lib/Assets/manifest.json" Link="Resources/manifest.json" />
  </ItemGroup>

</Project>
