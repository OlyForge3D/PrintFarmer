{
  "Discovery": {
    "ApiBaseUrl": "http://api:5245",
    "EnablePeriodicDiscovery": true,
    "ScanIntervalSeconds": 300,
    "HeartbeatIntervalSeconds": 30,
    "Mode": "mock",
    "Subnets": "192.168.0.0/16,10.0.0.0/8"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
