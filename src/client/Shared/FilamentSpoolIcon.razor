@* Filament Spool SVG Component *@
<svg width="@Width" height="@Height" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" class="filament-spool-icon" title="@Title">
    <!-- Spool Body (Back) -->
    <ellipse cx="50" cy="20" rx="30" ry="8" fill="#2d3748" stroke="#4a5568" stroke-width="1"/>
    <ellipse cx="50" cy="80" rx="30" ry="8" fill="#2d3748" stroke="#4a5568" stroke-width="1"/>
    
    <!-- Spool Core -->
    <rect x="40" y="20" width="20" height="60" fill="#1a202c" stroke="#2d3748" stroke-width="1"/>
    
    <!-- Filament on Spool -->
    @if (FilamentColor != null && RemainingPercentage > 0)
    {
        var filamentHeight = Math.Max(5, 50 * RemainingPercentage / 100.0);
        var yOffset = 50 - (filamentHeight / 2);
        
        <!-- Filament Wound on Spool -->
        <rect x="25" y="@(yOffset)" width="50" height="@(filamentHeight)" fill="@FilamentColor" opacity="0.9" rx="2"/>
        
        <!-- Filament Highlight -->
        <rect x="27" y="@(yOffset + 2)" width="46" height="@(Math.Max(2, filamentHeight - 4))" fill="@FilamentColor" opacity="0.7" rx="2"/>
        
        <!-- Filament Texture Lines -->
        @for (int i = 0; i < Math.Min(8, (int)(filamentHeight / 6)); i++)
        {
            var lineY = yOffset + (i * 6) + 3;
            <line x1="27" y1="@lineY" x2="73" y2="@lineY" stroke="@FilamentColor" stroke-width="0.5" opacity="0.5"/>
        }
    }
    
    <!-- Spool Rim Shadows -->
    <ellipse cx="50" cy="20" rx="30" ry="8" fill="none" stroke="#4a5568" stroke-width="2" opacity="0.6"/>
    <ellipse cx="50" cy="80" rx="30" ry="8" fill="none" stroke="#4a5568" stroke-width="2" opacity="0.6"/>
    
    <!-- Center Hub -->
    <ellipse cx="50" cy="50" rx="12" ry="30" fill="#1a202c" stroke="#2d3748" stroke-width="1"/>
    
    <!-- Hub Highlight -->
    <ellipse cx="48" cy="50" rx="8" ry="26" fill="#2d3748" opacity="0.6"/>
    
    <!-- Empty Spool Indicator -->
    @if (!HasSpoolLoaded)
    {
        <!-- No spool loaded overlay - circle with diagonal line -->
        <g>
            <circle cx="50" cy="50" r="35" fill="rgba(239, 68, 68, 0.1)" stroke="#ef4444" stroke-width="2"/>
            <line x1="25" y1="25" x2="75" y2="75" stroke="#ef4444" stroke-width="3" stroke-linecap="round"/>
            <text x="50" y="88" text-anchor="middle" font-size="7" fill="#ef4444" font-weight="bold">NO SPOOL</text>
        </g>
    }
    else if (FilamentColor == null || RemainingPercentage <= 0)
    {
        <!-- Empty indicator -->
        <g>
            <text x="50" y="55" text-anchor="middle" font-size="8" fill="#9ca3af" font-family="Arial">EMPTY</text>
        </g>
    }
    else if (RemainingPercentage <= 15)
    {
        <!-- Low filament warning -->
        <circle cx="75" cy="25" r="5" fill="#ef4444"/>
        <g>
            <text x="75" y="28" text-anchor="middle" font-size="6" fill="white" font-weight="bold">!</text>
        </g>
    }
</svg>

@code {
    [Parameter] public string? FilamentColor { get; set; }
    [Parameter] public double RemainingPercentage { get; set; } = 100;
    [Parameter] public int Width { get; set; } = 50;
    [Parameter] public int Height { get; set; } = 50;
    [Parameter] public string? Title { get; set; }
    [Parameter] public bool HasSpoolLoaded { get; set; } = true;
}
