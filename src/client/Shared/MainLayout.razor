@inherits LayoutComponentBase

<PageTitle>ForgeIQ</PageTitle>

<div class="page">
    <div class="sidebar">
        <NavLink href="/" Match="NavLinkMatch.All">Printers</NavLink>
        <NavLink href="/spools">Spools</NavLink>
        <NavLink href="/catalog">Catalog</NavLink>
        <NavLink href="/manage">Management</NavLink>
        <NavLink href="/settings">Settings</NavLink>
    </div>
    <main>
        <div class="top-row">
            <img src="/img/forgeiq-logo.png" alt="ForgeIQ" style="height:72px" />
            <div class="health" title="Server health">● @healthText</div>
        </div>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<Toast />

<style>
.page { display: grid; grid-template-columns: 220px 1fr; min-height: 100vh; background:#0b1020; }
.sidebar { background: linear-gradient(180deg,#070a16,#0b1020 60%, #070a16); color: #e5e7eb; padding: 1rem; display:flex; flex-direction:column; gap:.5rem; box-shadow: inset -1px 0 0 rgba(255,255,255,.06); }
.sidebar a { color: #e5e7eb; text-decoration: none; padding: .35rem .5rem; border-radius: 6px; font-weight:600; letter-spacing:.2px; }
.sidebar a.active { background: linear-gradient(180deg,#1f2937,#111827); box-shadow: inset 0 1px 0 rgba(255,255,255,.06); }
.top-row { padding: .9rem 1rem; border-bottom: 1px solid rgba(255,255,255,.08); background: linear-gradient(180deg,#0b1020,#0b1228); color:#e5e7eb; display:flex; align-items:center; gap:1rem; }
.content { color:#e5e7eb; }
main { background:#0f172a; }
.health { margin-left:auto; font-weight:600; }
.health:before { content:""; display:inline-block; width:10px; height:10px; border-radius:50%; margin-right:.35rem; background:#22c55e; }
</style>

@code {
    [Inject] private HttpClient Http { get; set; } = default!;
    private string healthText = "checking";
    private System.Threading.Timer? timer;

    protected override async Task OnInitializedAsync()
    {
        await Ping();
        // poll every 20s
        timer = new System.Threading.Timer(async _ => { await Ping(); StateHasChanged(); }, null, TimeSpan.FromSeconds(20), TimeSpan.FromSeconds(20));
    }

    private async Task Ping()
    {
        try
        {
            var resp = await Http.GetAsync("/healthz");
            healthText = resp.IsSuccessStatusCode ? "ok" : "down";
        }
        catch { healthText = "down"; }
    }

    public void Dispose()
    {
        timer?.Dispose();
    }
}
