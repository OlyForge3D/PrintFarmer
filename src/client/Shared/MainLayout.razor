@inherits LayoutComponentBase

<PageTitle>ForgeIQ</PageTitle>

<div class="page @(isCollapsed ? "sidebar-collapsed" : "")">
    <div class="sidebar">
        <button class="sidebar-toggle" @onclick="ToggleSidebar" title="@(isCollapsed ? "Expand sidebar" : "Collapse sidebar")">
            <span class="toggle-icon">@(isCollapsed ? "⏵" : "⏴")</span>
        </button>
        <div class="nav-links @(isCollapsed ? "collapsed" : "")">
            <NavLink href="/" Match="NavLinkMatch.All">
                <span class="nav-icon">🖨️</span>
                <span class="nav-text">Printers</span>
            </NavLink>
            <NavLink href="/spools">
                <span class="nav-icon">🧵</span>
                <span class="nav-text">Spools</span>
            </NavLink>
            <NavLink href="/catalog">
                <span class="nav-icon">📚</span>
                <span class="nav-text">Catalog</span>
            </NavLink>
            <NavLink href="/manage">
                <span class="nav-icon">⚙️</span>
                <span class="nav-text">Management</span>
            </NavLink>
            <NavLink href="/settings">
                <span class="nav-icon">🔧</span>
                <span class="nav-text">Settings</span>
            </NavLink>
        </div>
    </div>
    <main>
        <div class="top-row">
            <img src="/img/forgeiq-logo.png" alt="ForgeIQ" style="height:72px" />
            <div class="health" title="Server health">● @healthText</div>
        </div>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<Toast />

<style>
.page { display: grid; grid-template-columns: 220px 1fr; grid-gap: 16px; min-height: 100vh; background:#0b1020; transition: grid-template-columns 0.3s ease; padding-right: 16px; }
.page.sidebar-collapsed { grid-template-columns: 60px 1fr; }
.sidebar { background: linear-gradient(180deg,#070a16,#0b1020 60%, #070a16); color: #e5e7eb; padding: 1rem; display:flex; flex-direction:column; gap:.5rem; box-shadow: inset -1px 0 0 rgba(255,255,255,.06); position: relative; border-radius: 0 8px 8px 0; }
.sidebar-toggle { background: none; border: none; color: #e5e7eb; padding: .35rem; border-radius: 6px; cursor: pointer; margin-bottom: .5rem; font-size: 16px; transition: background-color 0.2s ease; align-self: flex-start; }
.sidebar-toggle:hover { background: rgba(255,255,255,.1); }
.nav-links { display: flex; flex-direction: column; gap: .5rem; }
.nav-links a { color: #e5e7eb; text-decoration: none; padding: .35rem .5rem; border-radius: 6px; font-weight:600; letter-spacing:.2px; display: flex; align-items: center; gap: .5rem; transition: all 0.2s ease; }
.nav-links a .nav-icon { font-size: 16px; min-width: 20px; }
.nav-links a .nav-text { transition: opacity 0.2s ease; }
.nav-links.collapsed a .nav-text { opacity: 0; width: 0; overflow: hidden; }
.nav-links a.active { background: linear-gradient(180deg,#1f2937,#111827); box-shadow: inset 0 1px 0 rgba(255,255,255,.06); }
.top-row { padding: .9rem 1rem; border-bottom: 1px solid rgba(255,255,255,.08); background: linear-gradient(180deg,#0b1020,#0b1228); color:#e5e7eb; display:flex; align-items:center; gap:1rem; }
.content { color:#e5e7eb; padding-left: 8px; }
main { background:#0f172a; border-radius: 8px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06); }
.health { margin-left:auto; font-weight:600; }
.health:before { content:""; display:inline-block; width:10px; height:10px; border-radius:50%; margin-right:.35rem; background:#22c55e; }
</style>

@code {
    [Inject] private HttpClient Http { get; set; } = default!;
    private string healthText = "checking";
    private System.Threading.Timer? timer;
    private bool isCollapsed = false;

    protected override async Task OnInitializedAsync()
    {
        await Ping();
        // poll every 20s
        timer = new System.Threading.Timer(async _ => { await Ping(); StateHasChanged(); }, null, TimeSpan.FromSeconds(20), TimeSpan.FromSeconds(20));
    }

    private void ToggleSidebar()
    {
        isCollapsed = !isCollapsed;
    }

    private async Task Ping()
    {
        try
        {
            var resp = await Http.GetAsync("/healthz");
            healthText = resp.IsSuccessStatusCode ? "ok" : "down";
        }
        catch { healthText = "down"; }
    }

    public void Dispose()
    {
        timer?.Dispose();
    }
}
