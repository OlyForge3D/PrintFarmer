@page "/manage"
@using Farm.Web.Shared
@inject HttpClient Http

<h2>Management</h2>

<div class="manage-grid">
  <div class="manage-card">
    <h3>Catalog</h3>
    <p>Manage Manufacturers and Models.</p>
    <a class="btn" href="/catalog">Open Catalog</a>
  </div>

  <div class="manage-card">
    <h3>Printers</h3>
    <p>Edit printer details.</p>
    <ul>
      @if (printers is null)
      {
        <div class="loading-state">
          <div class="spinner"></div>
          <p>Loading printers...</p>
        </div>
      }
      else if (printers.Count == 0)
      {
        <div class="empty-state">
          <div class="empty-icon">🖨️</div>
          <h3>No Printers Found</h3>
          <p>Add your first printer to get started with print management.</p>
          <a href="/printers/new" class="btn btn-primary">Add Printer</a>
        </div>
      }
      else
      {
        @foreach (var p in printers)
        {
          <li><a href="/printers/@p.Id/edit">@p.Name</a></li>
        }
      }
    </ul>
  </div>
</div>

@code {
  private List<PrinterDto>? printers;
  protected override async Task OnInitializedAsync()
  {
    printers = await Http.GetFromJsonAsync<List<PrinterDto>>("api/printers");
  }
}
