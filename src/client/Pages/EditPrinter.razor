@page "/printers/{id:guid}/edit"
@using Farm.Web.Shared
@inject HttpClient Http
@inject NavigationManager Nav
@inject Farm.Web.Client.ToastService toast
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Components.Forms

<h2>Edit Printer Details</h2>

@if (form is null)
{
  <p>Loading…</p>
}
else
{
  <div class="form">
    <label>Name</label>
    <div class="field">
  <InputText class="@(string.IsNullOrWhiteSpace(form.Name) ? "invalid" : null)" @bind-Value="form.Name" />
      @if (string.IsNullOrWhiteSpace(form.Name))
      {
        <div class="hint error">Name is required.</div>
      }
    </div>


    <label>Backend</label>
    <div class="field">
      <InputSelect class="form-control" TValue="PrinterBackend" @bind-Value="form.Backend">
        <option value="@PrinterBackend.Moonraker">Moonraker</option>
        <option value="@PrinterBackend.PrusaLink">PrusaLink</option>
      </InputSelect>
    </div>

    <label>Base URL</label>
    <div class="field">
      <div class="row-inline" style="gap:.5rem; align-items:center;">
  <InputText class="@(string.IsNullOrWhiteSpace(form.ServerUrl) ? "invalid" : null)" @bind-Value="form.ServerUrl" placeholder="http://printer:7125 or http://prusalink:80" />
        <button class="btn" type="button" title="Resolve to IP" @onclick="ResolveHostname">Resolve</button>
      </div>
      @if (string.IsNullOrWhiteSpace(form.ServerUrl))
      {
        <div class="hint error">Base URL is required.</div>
      }
      @if (!string.IsNullOrWhiteSpace(originalServerUrl))
      {
        <div class="hint">Original URL: @originalServerUrl</div>
      }
      @if (!string.IsNullOrWhiteSpace(ipAddress))
      {
        <div class="hint">IP Address: @ipAddress</div>
      }
    </div>

    @if (form.Backend == PrinterBackend.PrusaLink)
    {
      <label>API Key</label>
      <div class="field">
  <InputText class="form-control" @bind-Value="form.ApiKey" />
      </div>
    }

    <label>Notes</label>
  <InputText @bind-Value="form.Notes" />

    <label>Manufacturer</label>
    <div class="field">
      <div class="row-inline" style="gap:.25rem; align-items:center;">
        <select style="flex:1" @bind="selectedManufacturerId" @bind:after="OnManufacturerChanged">
          <option value="">-- Select --</option>
          @foreach (var m in manufacturers)
          {
            <option value="@m.Id">@m.Name</option>
          }
        </select>
        <button class="icon-btn" title="New Manufacturer" aria-label="New Manufacturer" @onclick="ShowNewManufacturer" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M11 11V5a1 1 0 1 1 2 0v6h6a1 1 0 1 1 0 2h-6v6a1 1 0 1 1-2 0v-6H5a1 1 0 1 1 0-2h6z"/>
          </svg>
        </button>
      </div>
      @if (showNewManufacturer)
      {
        <input placeholder="New manufacturer name" @bind="newManufacturerName" />
      }
    </div>

    <label>Model</label>
    <div class="field">
      <div class="row-inline" style="gap:.25rem; align-items:center;">
        <select style="flex:1" @bind="selectedModelId">
          <option value="">-- Select --</option>
          @foreach (var m in models)
          {
            <option value="@m.Id">@m.Name</option>
          }
        </select>
        <button class="icon-btn" title="New Model" aria-label="New Model" @onclick="ShowNewModel" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M11 11V5a1 1 0 1 1 2 0v6h6a1 1 0 1 1 0 2h-6v6a1 1 0 1 1-2 0v-6H5a1 1 0 1 1 0-2h6z"/>
          </svg>
        </button>
      </div>
      @if (showNewModel)
      {
        <input placeholder="New model name" @bind="newModelName" />
      }
    </div>

    <label>Model Max (mm)</label>
    <div class="field">
      <div class="row">
        <span>X: @(@modelMaxX?.ToString() ?? "—")</span>
        <span>Y: @(@modelMaxY?.ToString() ?? "—")</span>
        <span>Z: @(@modelMaxZ?.ToString() ?? "—")</span>
      </div>
      <div class="hint">Edit model dimensions from the Catalog.</div>
    </div>

    <label>Date Acquired</label>
    <div class="row-inline" style="gap:.5rem; align-items:center;">
  <input type="date" class="form-control" @bind-value="form.DateAcquired" @bind-value:format="yyyy-MM-dd" @ref="dateAcqEditRef" />
  <button type="button" class="btn" @onclick="(()=>OpenDatePicker(dateAcqEditRef))" title="Pick date">📅</button>
    </div>

    <div class="actions">
  <button class="btn primary" @onclick="Save" disabled="@(!IsValid())">Save</button>
  <button class="btn" @onclick="Cancel" type="button">Cancel</button>
    </div>
  </div>
}

@code {
  [Parameter] public Guid id { get; set; }
  private class EditFormModel
  {
    public string Name { get; set; } = string.Empty;
  public string ServerUrl { get; set; } = string.Empty;
    public string? Notes { get; set; }
    public DateTime? DateAcquired { get; set; }
    public PrinterBackend Backend { get; set; } = PrinterBackend.Moonraker;
    public string? ApiKey { get; set; }
  }
  private string? originalServerUrl;
  private string? ipAddress;
  private EditFormModel? form;
  private List<ManufacturerDto> manufacturers = new();
  private List<ModelDto> models = new();
  private Guid? selectedManufacturerId;
  private Guid? selectedModelId;
  private bool showNewManufacturer;
  private bool showNewModel;
  private string? newManufacturerName;
  private string? newModelName;
  private double? modelMaxX;
  private double? modelMaxY;
  private double? modelMaxZ;
  private ElementReference dateAcqEditRef;

  protected override async Task OnInitializedAsync()
  {
    var details = await Http.GetFromJsonAsync<PrinterDetailsDto>($"api/printers/{id}/details");
    if (details is not null)
    {
      form = new EditFormModel
      {
        Name = details.Name,
        ServerUrl = details.ServerUrl,
        Notes = details.Notes,
        DateAcquired = details.DateAcquired,
        Backend = details.Backend,
        ApiKey = details.ApiKey
      };
      originalServerUrl = details.OriginalServerUrl;
  ipAddress = details.IpAddress;
      selectedManufacturerId = details.ManufacturerId;
      selectedModelId = details.ModelId;
      modelMaxX = details.ModelMaxX;
      modelMaxY = details.ModelMaxY;
      modelMaxZ = details.ModelMaxZ;
    }
    manufacturers = await Http.GetFromJsonAsync<List<ManufacturerDto>>("api/catalog/manufacturers") ?? new();
    await LoadModels();
  }

  private async Task LoadModels()
  {
    if (selectedManufacturerId is Guid mid)
      models = await Http.GetFromJsonAsync<List<ModelDto>>($"api/catalog/models?manufacturerId={mid}") ?? new();
    else
      models = new();
  }

  private async Task OnManufacturerChanged()
  {
    // reset model when manufacturer changes
    selectedModelId = null;
    await LoadModels();
  }

  private void ShowNewManufacturer() => showNewManufacturer = !showNewManufacturer;
  private void ShowNewModel() => showNewModel = !showNewModel;

  private async Task OpenDatePicker(ElementReference el)
  {
    await JS.InvokeVoidAsync("PF.openDatePicker", el);
  }

  private async Task Save()
  {
    // Ensure new Manufacturer/Model exist first, handle duplicates by selecting existing
    if (!string.IsNullOrWhiteSpace(newManufacturerName))
    {
      var mresp = await Http.PostAsJsonAsync("api/catalog/manufacturers", newManufacturerName);
      if ((int)mresp.StatusCode == 409)
      {
        var existing = await mresp.Content.ReadFromJsonAsync<ManufacturerDto>();
        if (existing is not null) selectedManufacturerId = existing.Id;
      }
      else if (mresp.IsSuccessStatusCode)
      {
        var created = await mresp.Content.ReadFromJsonAsync<ManufacturerDto>();
        if (created is not null) selectedManufacturerId = created.Id;
      }
    }
    if (!string.IsNullOrWhiteSpace(newModelName) && selectedManufacturerId is Guid mid)
    {
      var mresp = await Http.PostAsJsonAsync("api/catalog/models", new { ManufacturerId = mid, Name = newModelName });
      if ((int)mresp.StatusCode == 409)
      {
        var existing = await mresp.Content.ReadFromJsonAsync<ModelDto>();
        if (existing is not null) selectedModelId = existing.Id;
      }
      else if (mresp.IsSuccessStatusCode)
      {
        var created = await mresp.Content.ReadFromJsonAsync<ModelDto>();
        if (created is not null) selectedModelId = created.Id;
      }
    }
    var dto = new UpdatePrinterDto(
      form!.Name,
  form!.ServerUrl,
      form!.Notes,
      selectedManufacturerId,
      selectedModelId,
      null,
      null,
      form!.DateAcquired,
      form!.Backend,
  form!.ApiKey,
  originalServerUrl
    );
    var resp = await Http.PutAsJsonAsync($"api/printers/{id}", dto);
    if (resp.IsSuccessStatusCode) { toast.Success("Saved"); Nav.NavigateTo("/"); }
    else { toast.Error($"Save failed: {(int)resp.StatusCode}"); }
  }

  private async Task ResolveHostname()
  {
    if (form is null || string.IsNullOrWhiteSpace(form.ServerUrl)) return;
    try
    {
      var req = new ResolveHostnameRequest(form.ServerUrl, form.Backend);
      var resp = await Http.PostAsJsonAsync("api/printers/resolve", req);
      if (resp.IsSuccessStatusCode)
      {
        var data = await resp.Content.ReadFromJsonAsync<ResolveHostnameResponse>();
        if (data is not null)
        {
          originalServerUrl = data.NormalizedInputUrl;
          form.ServerUrl = data.ResolvedBaseUrl;
          ipAddress = data.ResolvedIp;
          toast.Success("Resolved");
          StateHasChanged();
        }
      }
      else
      {
        toast.Error($"Resolve failed: {(int)resp.StatusCode}");
      }
    }
    catch
    {
      toast.Error("Resolve failed");
    }
  }

  private void Cancel() => Nav.NavigateTo("/");

  private bool IsValid()
  {
    if (form is null) return false;
    if (string.IsNullOrWhiteSpace(form.Name)) return false;
  if (string.IsNullOrWhiteSpace(form.ServerUrl)) return false;
  // Optionally require ApiKey for PrusaLink
  if (form.Backend == PrinterBackend.PrusaLink && string.IsNullOrWhiteSpace(form.ApiKey)) return false;
    if (!string.IsNullOrWhiteSpace(newModelName))
    {
      if (selectedManufacturerId is null && string.IsNullOrWhiteSpace(newManufacturerName)) return false;
    }
    return true;
  }
}


