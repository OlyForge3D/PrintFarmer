    private async Task SetTemps(Guid id, double hotend, double bed)
    {
        await Http.PostAsJsonAsync($"api/printers/{id}/temps", new TempTargets(hotend, bed));
    }

    // --- Presets ---
    private FilamentPresetsDto? presets;
    private async Task EnsurePresetsAsync()
    {
        if (presets is not null) return;
        try { presets = await Http.GetFromJsonAsync<FilamentPresetsDto>("/api/presets"); }
        catch { presets = null; }
    }
    private async Task ApplyPreset(Guid id, string material)
    {
        await EnsurePresetsAsync();
        if (presets is null) return;
        TempTargets targets = material.ToUpperInvariant() switch
        {
            "ABS" => presets.Abs,
            "ASA" => presets.Asa,
            "PLA" => presets.Pla,
            "PC" => presets.Pc,
            "PCTG" => presets.Pctg,
            "PETG" => presets.Petg,
            _ => new TempTargets(GetHotend(id), GetBed(id))
        };
        if (targets.Hotend is double h) SetHotend(id, h);
        if (targets.Bed is double b) SetBed(id, b);
        await SetTemps(id, GetHotend(id), GetBed(id));
        StateHasChanged();
    }
    private Task ApplyPresetAbs(Guid id) => ApplyPreset(id, "ABS");
    private Task ApplyPresetAsa(Guid id) => ApplyPreset(id, "ASA");
    private Task ApplyPresetPla(Guid id) => ApplyPreset(id, "PLA");
    private Task ApplyPresetPc(Guid id) => ApplyPreset(id, "PC");
    private Task ApplyPresetPctg(Guid id) => ApplyPreset(id, "PCTG");
    private Task ApplyPresetPetg(Guid id) => ApplyPreset(id, "PETG");
    private async Task ApplyCooldown(Guid id)
    {
        SetHotend(id, 0);
        SetBed(id, 0);
        await SetTemps(id, 0, 0);
        StateHasChanged();
    }

    private static string PresetTip(TempTargets? t)
        => t is TempTargets tt ? ($"Hotend: {(tt.Hotend?.ToString("0") ?? "-")}°C, Bed: {(tt.Bed?.ToString("0") ?? "-")}°C") : "";
    private async Task Move(Guid id, double x, double y, double z)
        => await Http.PostAsJsonAsync($"api/printers/{id}/move", new MoveRequest(x, y, z, 3000));

    private async Task MoveX(Guid id, double dx)
