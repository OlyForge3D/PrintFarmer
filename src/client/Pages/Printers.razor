@page "/"
@using Farm.Web.Shared
@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable
@inject HttpClient Http
@inject Farm.Web.Client.ToastService toast
@inject Farm.Web.Client.RealtimeService realtime
@inject IJSRuntime JS

<h2>Printers</h2>

<div class="row">
    <a href="/printers/new">Add Printer</a>
    <a href="/catalog">Catalog</a>
 </div>

@if (printers is null)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Loading printers...</p>
    </div>
}
else if (!printers.Any())
{
    <div class="empty-state">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="currentColor" opacity="0.3">
            <path d="M20,8H4V6C4,4.89 4.89,4 6,4H18A2,2 0 0,1 20,6V8M20,20H4C2.89,20 2,19.1 2,18V10A2,2 0 0,1 4,10H20A2,2 0 0,1 22,10V18C22,19.1 21.1,20 20,20Z"/>
        </svg>
        <h3>No printers found</h3>
        <p>Add your first 3D printer to get started with monitoring and management.</p>
        <a href="/printers/new" class="btn btn-primary">Add Printer</a>
    </div>
}
else
{
    <div class="cards">
        @foreach (var p in printers)
        {
            @if (IsCollapsed(p.Id))
            {
                <!-- Collapsed View -->
                <div class="card">
                    <div class="card-header-unified">
                        <div class="card-header-main">
                            <div class="printer-identity">
                                <div class="name caps-font">@p.Name</div>
                                @if (!string.IsNullOrWhiteSpace(p.ManufacturerName) || !string.IsNullOrWhiteSpace(p.ModelName))
                                {
                                    <div class="model mini-header">@($"{p.ManufacturerName} {p.ModelName}".Trim())</div>
                                }
                                <div class="url-row">
                                    <div class="url mini-header">@p.ServerUrl</div>
                                    <a class="icon-btn" href="@ToPort80(p.ServerUrl)" target="_blank" rel="noopener" title="Open printer (port 80)" aria-label="Open printer on port 80">
                                        <!-- External link icon -->
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                            <path d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3z"/>
                                            <path d="M5 5h6V3H5c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2v-6h-2v6H5V5z"/>
                                        </svg>
                                    </a>
                                    @if (HasCamera(p))
                                    {
                                        <button class="icon-btn" title="@CameraBtnTitle(p.Id)" aria-label="Toggle camera" @onclick="() => ToggleCamera(p.Id)">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                                <path d="M17 10.5V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-3.5l4 4v-11l-4 4z"/>
                                            </svg>
                                        </button>
                                    }
                                </div>
                            </div>
                            <div class="status @(loadingStatuses.Contains(p.Id) ? "loading" : p.IsOnline ? "online" : "offline")">
                                @if (loadingStatuses.Contains(p.Id))
                                {
                                    <span class="status-loading">
                                        <!-- Loading spinner -->
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="spinner">
                                            <path d="M12,4a8,8,0,0,1,7.89,6.7A1.53,1.53,0,0,0,21.38,12h0a1.5,1.5,0,0,0,1.48-1.75,11,11,0,0,0-21.72,0A1.5,1.5,0,0,0,2.62,12h0a1.53,1.53,0,0,0,1.49-1.3A8,8,0,0,1,12,4Z"/>
                                        </svg>
                                        Loading...
                                    </span>
                                }
                                else
                                {
                                    @(p.IsOnline ? (string.IsNullOrWhiteSpace(p.State) ? "Online" : p.State) : "Offline")
                                }
                            </div>
                        </div>
                        <div class="card-header-actions">
                            <button class="icon-btn toggle-btn" @onclick="() => ToggleCard(p.Id)" title="Expand card" aria-label="Expand card">
                                <!-- Maximize/Expand icon -->
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                    <path d="M3 3h18v18H3V3zm2 2v14h14V5H5z"/>
                                    <path d="M7 7h10v10H7V7z"/>
                                </svg>
                            </button>
                            <button class="icon-btn" @onclick="() => OpenHistoryPopup(p.Id)" title="View print history" aria-label="View print history">
                                <!-- History/Clock icon -->
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/>
                                    <path d="M12.5 7H11v6l5.25 3.15.75-1.23-4.5-2.67z"/>
                                </svg>
                            </button>
                            <a class="icon-btn" href="/printers/@p.Id/edit" title="Edit details" aria-label="Edit details">
                                <!-- Edit icon -->
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                    <path d="M3 17.25V21h3.75L20.81 6.94l-3.75-3.75L3 17.25zm2.92 1.33l-.5-1.99 9.9-9.9 1.99 1.99-9.9 9.9z"/>
                                    <path d="M18.37 3.87a1.25 1.25 0 011.77 1.77l-1.06 1.06-1.77-1.77 1.06-1.06z"/>
                                </svg>
                            </a>
                        </div>
                    </div>
                    
                    <div class="control-buttons">
                        <button class="btn btn-control" title="Pause" aria-label="Pause" disabled="@(!IsPrinting(p))" @onclick="() => Pause(p.Id)">
                            <!-- Pause icon -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d="M7 5h3v14H7zM14 5h3v14h-3z"/>
                            </svg>
                            Pause
                        </button>
                        <button class="btn btn-control" title="Resume" aria-label="Resume" disabled="@(!IsPaused(p))" @onclick="() => Resume(p.Id)">
                            <!-- Play/Resume icon -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d="M8 5v14l11-7z"/>
                            </svg>
                            Resume
                        </button>
                        <button class="btn btn-control btn-danger" title="Emergency Stop" aria-label="Emergency Stop" disabled="@(!p.IsOnline)" @onclick="() => EmergencyStop(p.Id)">
                            <!-- Emergency stop icon -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d="M12 2L2 22h20L12 2zm-1 7h2v6h-2V9zm0 8h2v2h-2v-2z"/>
                            </svg>
                            Stop
                        </button>
                    </div>
                    
                    @if (p.Backend == Farm.Web.Shared.PrinterBackend.Moonraker)
                    {
                        <div class="spool-info-compact">
                            <div class="spool-icon-compact">
                                <FilamentSpoolIcon 
                                    FilamentColor="@(p.SpoolInfo?.HasActiveSpool == true ? p.SpoolInfo.ColorHex : null)" 
                                    RemainingPercentage="@(p.SpoolInfo?.HasActiveSpool == true ? CalculateRemainingPercentage(p.SpoolInfo.RemainingWeightG) : 0)"
                                    HasSpoolLoaded="@(p.SpoolInfo?.HasActiveSpool == true)"
                                    Width="32" 
                                    Height="32"
                                    Title="@GetSpoolTooltip(p.SpoolInfo)" />
                            </div>
                            <div class="spool-compact-details">
                                @if (p.SpoolInfo?.HasActiveSpool == true)
                                {
                                    @if (!string.IsNullOrWhiteSpace(p.SpoolInfo.Material))
                                    {
                                        <span class="spool-material-compact">@p.SpoolInfo.Material</span>
                                    }
                                    @if (p.SpoolInfo.RemainingWeightG.HasValue)
                                    {
                                        <span class="spool-weight-compact">@($"{p.SpoolInfo.RemainingWeightG.Value:F0}g")</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(p.SpoolInfo.SpoolName))
                                    {
                                        <span class="spool-name-compact">@p.SpoolInfo.SpoolName</span>
                                    }
                                    @if (p.SpoolInfo.ActiveSpoolId.HasValue && GetSpoolmanUrl(p.SpoolInfo.ActiveSpoolId) != null)
                                    {
                                        <a class="icon-btn spool-link-compact" href="@GetSpoolmanUrl(p.SpoolInfo.ActiveSpoolId)" target="_blank" rel="noopener" title="Open spool in Spoolman" aria-label="Open spool in Spoolman">
                                            <!-- External link icon -->
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                                <path d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3z"/>
                                                <path d="M5 5h6V3H5c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2v-6h-2v6H5V5z"/>
                                            </svg>
                                        </a>
                                    }
                                }
                                else
                                {
                                    <span class="spool-status-compact">No spool loaded</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Expanded View (Original) -->
                <div class="card">
                    <div class="card-header-unified" title="@HeaderTooltip(p)">
                        <div class="card-header-main">
                            <div class="printer-identity">
                                <div class="name caps-font">@p.Name</div>
                                @if (!string.IsNullOrWhiteSpace(p.ManufacturerName) || !string.IsNullOrWhiteSpace(p.ModelName))
                                {
                                    <div class="model mini-header">@($"{p.ManufacturerName} {p.ModelName}".Trim())</div>
                                }
                                <div class="url-row">
                                    <div class="url mini-header">@p.ServerUrl</div>
                                    <a class="icon-btn" href="@ToPort80(p.ServerUrl)" target="_blank" rel="noopener" title="Open printer (port 80)" aria-label="Open printer on port 80">
                                        <!-- External link icon -->
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                            <path d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3z"/>
                                            <path d="M5 5h6V3H5c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2v-6h-2v6H5V5z"/>
                                        </svg>
                                    </a>
                                    @if (HasCamera(p))
                                    {
                                        <button class="icon-btn" title="@CameraBtnTitle(p.Id)" aria-label="Toggle camera" @onclick="() => ToggleCamera(p.Id)">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                                <path d="M17 10.5V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-3.5l4 4v-11l-4 4z"/>
                                            </svg>
                                        </button>
                                    }
                                </div>
                                @if (IsCameraVisible(p.Id) && TryGetSnapshotUrl(p, out var snapUrl))
                                {
                                    <div class="snapshot-row">
                                        <img src="@snapUrl" alt="webcam snapshot" 
                                             onerror="this.style.display='none'" 
                                             onload="this.style.display='block'" />
                                    </div>
                                }
                            </div>
                            <div class="status @(loadingStatuses.Contains(p.Id) ? "loading" : p.IsOnline ? "online" : "offline")">
                                @if (loadingStatuses.Contains(p.Id))
                                {
                                    <span class="status-loading">
                                        <!-- Loading spinner -->
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="spinner">
                                            <path d="M12,4a8,8,0,0,1,7.89,6.7A1.53,1.53,0,0,0,21.38,12h0a1.5,1.5,0,0,0,1.48-1.75,11,11,0,0,0-21.72,0A1.5,1.5,0,0,0,2.62,12h0a1.53,1.53,0,0,0,1.49-1.3A8,8,0,0,1,12,4Z"/>
                                        </svg>
                                        Loading...
                                    </span>
                                }
                                else
                                {
                                    @(p.IsOnline ? (string.IsNullOrWhiteSpace(p.State) ? "Online" : p.State) : "Offline")
                                }
                            </div>
                        </div>
                        <div class="card-header-actions">
                            <button class="icon-btn toggle-btn" @onclick="() => ToggleCard(p.Id)" title="Collapse card" aria-label="Collapse card">
                                <!-- Minimize/Collapse icon -->
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                    <path d="M5 12h14v2H5z"/>
                                </svg>
                            </button>
                            <button class="icon-btn" @onclick="() => OpenHistoryPopup(p.Id)" title="View print history" aria-label="View print history">
                                <!-- History/Clock icon -->
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/>
                                    <path d="M12.5 7H11v6l5.25 3.15.75-1.23-4.5-2.67z"/>
                                </svg>
                            </button>
                            <a class="icon-btn" href="/printers/@p.Id/edit" title="Edit details" aria-label="Edit details">
                                <!-- Edit icon -->
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                    <path d="M3 17.25V21h3.75L20.81 6.94l-3.75-3.75L3 17.25zm2.92 1.33l-.5-1.99 9.9-9.9 1.99 1.99-9.9 9.9z"/>
                                    <path d="M18.37 3.87a1.25 1.25 0 011.77 1.77l-1.06 1.06-1.77-1.77 1.06-1.06z"/>
                                </svg>
                            </a>
                        </div>
                    </div>

                <div class="section">
                    <div class="mini-header">Temps</div>
                    <div class="axis-fields">
                        <div class="axis-field">
                            <div class="temp-row">
                                <span class="temp-label-external">Hotend</span>
                                <div class="temp-input-wrapper">
                                    <input class="temp-input" type="number" value="@GetHotend(p.Id)" @oninput="(e)=> SetHotend(p.Id, ToDouble(e.Value))" />
                                    <span class="temp-unit-internal">°C</span>
                                </div>
                            </div>
                            <span class="temp-readout-overlay" title="Current → Target">
                                [@FmtTemp(p.HotendTemp)@(p.HotendTarget is double ht ? $" → {FmtTemp(ht)}" : "")]
                            </span>
                        </div>
                        <div class="axis-field">
                            <div class="temp-row">
                                <span class="temp-label-external">Bed</span>
                                <div class="temp-input-wrapper">
                                    <input class="temp-input" type="number" value="@GetBed(p.Id)" @oninput="(e)=> SetBed(p.Id, ToDouble(e.Value))" />
                                    <span class="temp-unit-internal">°C</span>
                                </div>
                            </div>
                            <span class="temp-readout-overlay" title="Current → Target">
                                [@FmtTemp(p.BedTemp)@(p.BedTarget is double bt ? $" → {FmtTemp(bt)}" : "")]
                            </span>
                        </div>
                        <div class="axis-go">
                            <button class="btn btn-inline" @onclick="() => SetTemps(p.Id, GetHotend(p.Id), GetBed(p.Id))"><span class="caps-label">SET</span></button>
                        </div>
                    </div>
                    <div class="preset-row-spaced">
                        <button class="btn preset" style="background:#6b7280" disabled="@IsPrinting(p)" title="@PresetTip(presets?.Abs)" @onclick="() => ApplyPresetAbs(p.Id)">ABS</button>
                        <button class="btn preset" style="background:#f59e0b" disabled="@IsPrinting(p)" title="@PresetTip(presets?.Asa)" @onclick="() => ApplyPresetAsa(p.Id)">ASA</button>
                        <button class="btn preset" style="background:#10b981" disabled="@IsPrinting(p)" title="@PresetTip(presets?.Pla)" @onclick="() => ApplyPresetPla(p.Id)">PLA</button>
                        <button class="btn preset" style="background:#8b5cf6" disabled="@IsPrinting(p)" title="@PresetTip(presets?.Pc)" @onclick="() => ApplyPresetPc(p.Id)">PC</button>
                        <button class="btn preset" style="background:#06b6d4" disabled="@IsPrinting(p)" title="@PresetTip(presets?.Pctg)" @onclick="() => ApplyPresetPctg(p.Id)">PCTG</button>
                        <button class="btn preset" style="background:#ef4444" disabled="@IsPrinting(p)" title="@PresetTip(presets?.Petg)" @onclick="() => ApplyPresetPetg(p.Id)">PETG</button>
                        <button class="btn preset cooldown" style="background:#1fa2ff" disabled="@IsPrinting(p)" title="Cooldown (set all heaters to 0)" aria-label="Cooldown" @onclick="() => ApplyCooldown(p.Id)">❄</button>
                    </div>
                </div>

                @if (p.Backend == Farm.Web.Shared.PrinterBackend.Moonraker)
                {
                    <div class="section">
                        <div class="mini-header">Filament</div>
                        @if (p.SpoolInfo?.HasActiveSpool == true && !string.IsNullOrWhiteSpace(p.SpoolInfo.SpoolName))
                        {
                            <div class="spool-info">
                                <div class="spool-row">
                                    <div class="spool-icon-container">
                                        <FilamentSpoolIcon 
                                            FilamentColor="@p.SpoolInfo.ColorHex" 
                                            RemainingPercentage="@CalculateRemainingPercentage(p.SpoolInfo.RemainingWeightG)"
                                            HasSpoolLoaded="true"
                                            Width="80" 
                                            Height="80"
                                            Title="@GetSpoolTooltip(p.SpoolInfo)" />
                                    </div>
                                    <div class="spool-details">
                                        <div class="spool-name">@p.SpoolInfo.SpoolName</div>
                                        @if (!string.IsNullOrWhiteSpace(p.SpoolInfo.Material))
                                        {
                                            <div class="spool-material">@p.SpoolInfo.Material</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(p.SpoolInfo.FilamentName) || !string.IsNullOrWhiteSpace(p.SpoolInfo.Vendor))
                                        {
                                            <div class="spool-filament">
                                                @if (!string.IsNullOrWhiteSpace(p.SpoolInfo.Vendor))
                                                {
                                                    <span>@p.SpoolInfo.Vendor</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(p.SpoolInfo.FilamentName))
                                                {
                                                    <span>@p.SpoolInfo.FilamentName</span>
                                                }
                                            </div>
                                        }
                                        @if (p.SpoolInfo.RemainingWeightG.HasValue)
                                        {
                                            <div class="spool-weight">@($"{p.SpoolInfo.RemainingWeightG.Value:F0}g remaining ({CalculateRemainingPercentage(p.SpoolInfo.RemainingWeightG):F0}%)")</div>
                                        }
                                        @if (p.SpoolInfo.ActiveSpoolId.HasValue && GetSpoolmanUrl(p.SpoolInfo.ActiveSpoolId) != null)
                                        {
                                            <div class="spool-link">
                                                <a class="icon-btn" href="@GetSpoolmanUrl(p.SpoolInfo.ActiveSpoolId)" target="_blank" rel="noopener" title="Open spool in Spoolman" aria-label="Open spool in Spoolman">
                                                    <!-- External link icon -->
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                                        <path d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3z"/>
                                                        <path d="M5 5h6V3H5c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2v-6h-2v6H5V5z"/>
                                                    </svg>
                                                    View in Spoolman
                                                </a>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        else if (p.SpoolInfo?.HasActiveSpool == true)
                        {
                            <div class="spool-info">
                                <div class="spool-row">
                                    <div class="spool-icon-container">
                                        <FilamentSpoolIcon 
                                            FilamentColor="@p.SpoolInfo.ColorHex" 
                                            RemainingPercentage="50"
                                            HasSpoolLoaded="true"
                                            Width="80" 
                                            Height="80"
                                            Title="Active spool with limited information" />
                                    </div>
                                    <div class="spool-details">
                                        <div class="spool-name">Spool #@p.SpoolInfo.ActiveSpoolId</div>
                                        <div class="spool-status">No additional details available</div>
                                        @if (p.SpoolInfo.ActiveSpoolId.HasValue && GetSpoolmanUrl(p.SpoolInfo.ActiveSpoolId) != null)
                                        {
                                            <div class="spool-link">
                                                <a class="icon-btn" href="@GetSpoolmanUrl(p.SpoolInfo.ActiveSpoolId)" target="_blank" rel="noopener" title="Open spool in Spoolman" aria-label="Open spool in Spoolman">
                                                    <!-- External link icon -->
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                                        <path d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3z"/>
                                                        <path d="M5 5h6V3H5c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2v-6h-2v6H5V5z"/>
                                                    </svg>
                                                    View in Spoolman
                                                </a>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="spool-info">
                                <div class="spool-row">
                                    <div class="spool-icon-container">
                                        <FilamentSpoolIcon 
                                            FilamentColor="@null" 
                                            RemainingPercentage="0"
                                            HasSpoolLoaded="false"
                                            Width="80" 
                                            Height="80"
                                            Title="@GetSpoolTooltip(p.SpoolInfo)" />
                                    </div>
                                    <div class="spool-details">
                                        <div class="spool-status">No active spool loaded</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <div class="section move-section">
                    <div class="mini-header">Move</div>
                    <div class="move-grids">
                        <div class="move-pads">
                        <div class="xy-pad">
                            <button class="btn pad-btn xy home-all" title="Home all axes" aria-label="Home all axes" disabled="@IsPrinting(p)" @onclick="() => Home(p.Id)">
