    private string StepBtnClass(Guid id, double v) => $"btn-step {(GetStep(id) == v ? "active" : string.Empty)}";
    private static bool IsPrinting(PrinterDto p) => p.IsOnline && string.Equals(p.State, "printing", StringComparison.OrdinalIgnoreCase);
    private static bool IsPaused(PrinterDto p) => p.IsOnline && string.Equals(p.State, "paused", StringComparison.OrdinalIgnoreCase);
    private static double ToDouble(object? v) => double.TryParse(Convert.ToString(v), out var d) ? d : 0;
    private static string FmtPos(double? v) => v is double d ? d.ToString("0.###") : "--";
    private static string FmtTemp(double? v) => v is double d ? d.ToString("0") + "°C" : "--";
    private string HeaderTooltip(PrinterDto p)
        => string.IsNullOrWhiteSpace(p.ManufacturerName) && string.IsNullOrWhiteSpace(p.ModelName)
            ? ""
            : $"{p.ManufacturerName} {p.ModelName}".Trim();

    private async Task Pause(Guid id) => await Http.PostAsync($"api/printers/{id}/pause", null);
    private async Task Resume(Guid id) => await Http.PostAsync($"api/printers/{id}/resume", null);
    private async Task EmergencyStop(Guid id) => await Http.PostAsync($"api/printers/{id}/emergency-stop", null);

    private static string ToPort80(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return "#";
        try
        {
            var uri = new Uri(url);
            var builder = new UriBuilder(uri)
            {
                Scheme = Uri.UriSchemeHttp,
                Port = 80
            };
            return builder.Uri.ToString();
        }
        catch
        {
            // Fallback: if it's not a valid URI, prepend http:// and :80
            var trimmed = url.Trim();
            if (!trimmed.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                trimmed = "http://" + trimmed;
            return trimmed.EndsWith(":80", StringComparison.Ordinal) ? trimmed : trimmed.TrimEnd('/') + ":80";
        }
    }

    // --- Snapshots ---
    private readonly Dictionary<Guid, long> snapshotStamps = new();
    private readonly TimeSpan snapshotInterval = TimeSpan.FromSeconds(30);
    private CancellationTokenSource? snapshotCts;
    private readonly HashSet<Guid> cameraVisible = new();
    private string SnapshotUrl(PrinterDto p)
    {
        var timestamp = snapshotStamps.GetValueOrDefault(p.Id, 0);
        var baseUrl = p.CameraSnapshotUrl?.TrimEnd('/');
        if (string.IsNullOrWhiteSpace(baseUrl)) return string.Empty;
        
        // Add cache-busting parameter
        var separator = baseUrl.Contains('?') ? "&" : "?";
        return $"{baseUrl}{separator}t={timestamp}";
    }
    
    private bool TryGetSnapshotUrl(PrinterDto p, out string url)
    {
        url = string.Empty;
        if (string.IsNullOrWhiteSpace(p.CameraSnapshotUrl)) return false;
        if (!snapshotStamps.TryGetValue(p.Id, out var ts) || ts == 0) return false;
        
        try
        {
            url = SnapshotUrl(p);
            return !string.IsNullOrWhiteSpace(url);
        }
        catch
        {
            return false;
        }
    }
    private bool IsCameraVisible(Guid id) => cameraVisible.Contains(id);

    private bool HasCamera(PrinterDto printer) => !string.IsNullOrWhiteSpace(printer.CameraStreamUrl) || !string.IsNullOrWhiteSpace(printer.CameraSnapshotUrl);

    private string CameraBtnTitle(Guid id) => IsCameraVisible(id) ? "Hide camera" : "Show camera";
    private async Task StartSnapshotTimerAsync()
    {
        snapshotCts?.Cancel();
        var cts = snapshotCts = new CancellationTokenSource();
        try
        {
            while (!cts.IsCancellationRequested)
            {
                await Task.Delay(snapshotInterval, cts.Token);
                if (printers is null || printers.Count == 0) continue;
                var now = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
                foreach (var pr in printers)
                {
                    if (!string.IsNullOrWhiteSpace(pr.CameraSnapshotUrl))
                    {
                        snapshotStamps[pr.Id] = now; // bump cache-buster to refresh image src
                    }
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException) { }
    }

    // When toggling on, ensure an initial timestamp so the first image loads
    private void ToggleCamera(Guid id)
    {
        if (!cameraVisible.Add(id))
        {
            cameraVisible.Remove(id);
        }
        else
        {
            if (!snapshotStamps.ContainsKey(id) || snapshotStamps[id] == 0)
            {
                snapshotStamps[id] = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
            }
        }
        StateHasChanged();
    }

    // File management
    private readonly Dictionary<Guid, List<string>?> printerFiles = new();
    private readonly Dictionary<Guid, bool> loadingFiles = new();

    private string[]? GetFileList(Guid printerId) => printerFiles.TryGetValue(printerId, out var files) ? files?.ToArray() : null;
    
    private bool IsLoadingFiles(Guid printerId) => loadingFiles.TryGetValue(printerId, out var loading) && loading;
    
    private bool HasTriedLoadingFiles(Guid printerId) => printerFiles.ContainsKey(printerId);

    private async Task LoadFileList(Guid printerId)
    {
        loadingFiles[printerId] = true;
        StateHasChanged();

        try
        {
            var response = await Http.GetAsync($"/printers/{printerId}/files");
            if (response.IsSuccessStatusCode)
            {
                var files = await response.Content.ReadFromJsonAsync<string[]>();
                printerFiles[printerId] = files?.ToList() ?? new List<string>();
            }
            else
            {
                printerFiles[printerId] = new List<string>();
                toast.Error("Failed to load file list");
            }
        }
        catch (Exception ex)
        {
            printerFiles[printerId] = new List<string>();
            toast.Error($"Error loading files: {ex.Message}");
        }
        finally
        {
            loadingFiles[printerId] = false;
            StateHasChanged();
        }
    }

    private async Task StartPrintFromFile(Guid printerId, string fileName)
    {
        try
        {
            var response = await Http.PostAsync($"/printers/{printerId}/files/{Uri.EscapeDataString(fileName)}/print", null);
            if (response.IsSuccessStatusCode)
            {
                toast.Success($"Started printing {fileName}");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                toast.Error($"Failed to start print: {error}");
            }
        }
        catch (Exception ex)
        {
            toast.Error($"Error starting print: {ex.Message}");
        }
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e, Guid printerId)
    {
        var file = e.File;
        if (file == null) return;

        if (!file.Name.EndsWith(".gcode", StringComparison.OrdinalIgnoreCase))
        {
            toast.Error("Please select a .gcode file");
            return;
        }

        const long maxFileSize = 100 * 1024 * 1024; // 100 MB
        if (file.Size > maxFileSize)
        {
            toast.Error("File is too large. Maximum size is 100 MB");
            return;
        }

        try
        {
            using var content = new MultipartFormDataContent();
            using var stream = file.OpenReadStream(maxFileSize);
            using var streamContent = new StreamContent(stream);
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/octet-stream");
            content.Add(streamContent, "file", file.Name);

            var response = await Http.PostAsync($"/printers/{printerId}/files/upload", content);
            if (response.IsSuccessStatusCode)
            {
                toast.Success($"Uploaded {file.Name} successfully");
                // Refresh file list
                await LoadFileList(printerId);
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                toast.Error($"Upload failed: {error}");
            }
        }
        catch (Exception ex)
        {
            toast.Error($"Upload error: {ex.Message}");
        }
    }
    
    // Helper methods for spool information
    private double CalculateRemainingPercentage(double? remainingWeightG)
    {
        if (!remainingWeightG.HasValue || remainingWeightG <= 0)
            return 0;
        
        // Estimate percentage based on typical spool weights
        // Most filament spools are 1kg (1000g), some smaller are 500g or 250g
        // We'll use a reasonable default and cap at 100%
        const double typicalSpoolWeight = 1000.0; // 1kg default
        double percentage = (remainingWeightG.Value / typicalSpoolWeight) * 100.0;
        
        // Cap at 100% in case we have smaller spools or the weight is higher than expected
        return Math.Min(100.0, Math.Max(0.0, percentage));
    }
    
    private string GetSpoolTooltip(PrinterSpoolInfoDto? spoolInfo)
    {
        if (spoolInfo == null || !spoolInfo.HasActiveSpool)
            return "No spool loaded";
            
        var parts = new List<string>();
        
        if (!string.IsNullOrWhiteSpace(spoolInfo.SpoolName))
            parts.Add($"Name: {spoolInfo.SpoolName}");
            
        if (!string.IsNullOrWhiteSpace(spoolInfo.Material))
            parts.Add($"Material: {spoolInfo.Material}");
            
        if (!string.IsNullOrWhiteSpace(spoolInfo.Vendor))
            parts.Add($"Vendor: {spoolInfo.Vendor}");
            
        if (!string.IsNullOrWhiteSpace(spoolInfo.FilamentName))
            parts.Add($"Filament: {spoolInfo.FilamentName}");
            
        if (spoolInfo.RemainingWeightG.HasValue)
            parts.Add($"Remaining: {spoolInfo.RemainingWeightG.Value:F0}g ({CalculateRemainingPercentage(spoolInfo.RemainingWeightG):F0}%)");
            
        if (!string.IsNullOrWhiteSpace(spoolInfo.ColorHex))
            parts.Add($"Color: {spoolInfo.ColorHex}");
            
        return string.Join("\n", parts);
    }
    
    // Spoolman configuration
    private SpoolmanConfigDto? spoolmanConfig;
    
    private async Task LoadSpoolmanConfigAsync()
    {
        try
        {
            spoolmanConfig = await Http.GetFromJsonAsync<SpoolmanConfigDto?>("/api/spoolman/config");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load Spoolman config: {ex.Message}");
            spoolmanConfig = null;
        }
    }
    
    private string? GetSpoolmanUrl(int? spoolId)
    {
        if (!spoolId.HasValue || spoolmanConfig == null || string.IsNullOrWhiteSpace(spoolmanConfig.BaseUrl))
            return null;
            
        var baseUrl = spoolmanConfig.BaseUrl.TrimEnd('/');
        return $"{baseUrl}/spools/{spoolId.Value}";
    }
    
