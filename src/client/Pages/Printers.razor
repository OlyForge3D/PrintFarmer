}

@code {
    private List<PrinterDto>? printers;
    private Dictionary<Guid, PrinterStatusDto> printerStatuses = new();
    private HashSet<Guid> loadingStatuses = new();
    private HashSet<Guid> collapsedCards = new();
    // creation moved to /printers/new

    protected override async Task OnInitializedAsync()
    {
        // Use fast endpoint for immediate display with progressive loading
        try
        {
            printers = await Http.GetFromJsonAsync<List<PrinterDto>>("api/printers/fast");
            StateHasChanged(); // Show printers immediately, all offline initially
            
            // Now load status for each printer progressively
            await LoadAllStatusesProgressively();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load printers: {ex.Message}");
            // Fallback to basic endpoint
            var basicPrinters = await Http.GetFromJsonAsync<List<PrinterBasicDto>>("api/printers/basic");
            if (basicPrinters is not null)
            {
                // Create PrinterDto instances with default offline status
                printers = basicPrinters.Select(p => new PrinterDto(
                    Id: p.Id,
                    Name: p.Name,
                    ServerUrl: p.ServerUrl,
                    Notes: p.Notes,
                    IsOnline: false, // Default to offline until status loads
                    State: null,
                    ManufacturerName: p.ManufacturerName,
                    ModelName: p.ModelName,
                    Backend: p.Backend,
                    ApiKey: p.ApiKey,
                    OriginalServerUrl: p.OriginalServerUrl,
                    IpAddress: p.IpAddress
                )).ToList();
                
                StateHasChanged(); // Show cards immediately
                
                // Now load status for each printer progressively
                await LoadAllStatusesProgressively();
            }
        }
        
        // Load Spoolman configuration for spool links
        await LoadSpoolmanConfigAsync();
        
        // preload presets for tooltips
        try { presets = await Http.GetFromJsonAsync<FilamentPresetsDto>("/api/presets"); } catch { presets = null; }
        
        // Switch to SignalR push updates
        await realtime.EnsureConnectedAsync();
        // Subscribe to all updates (Guid.Empty wildcard) and merge into current list
        realtime.Subscribe(Guid.Empty, update =>
        {
            if (printers is null) return;
            var idx = printers.FindIndex(p => p.Id == update.Id);
            if (idx >= 0)
            {
                var existing = printers[idx];
                printers[idx] = existing with
                {
                    IsOnline = update.IsOnline,
                    // Preserve existing State/Progress when update doesn't include them
                    State = string.IsNullOrWhiteSpace(update.State) ? existing.State : update.State,
                    Progress = update.Progress ?? existing.Progress,
                    JobName = update.JobName ?? existing.JobName,
                    ThumbnailUrl = update.ThumbnailUrl ?? existing.ThumbnailUrl,
                    CameraStreamUrl = update.CameraStreamUrl ?? existing.CameraStreamUrl,
                    X = update.X ?? existing.X,
                    Y = update.Y ?? existing.Y,
                    Z = update.Z ?? existing.Z,
                    HotendTemp = update.HotendTemp ?? existing.HotendTemp,
                    BedTemp = update.BedTemp ?? existing.BedTemp,
                    HotendTarget = update.HotendTarget ?? existing.HotendTarget,
                    BedTarget = update.BedTarget ?? existing.BedTarget,
                    SpoolInfo = update.SpoolInfo ?? existing.SpoolInfo
                };
                // Invalidate snapshot cache for this printer so it refreshes on next tick when status changes
                snapshotStamps[update.Id] = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
                InvokeAsync(StateHasChanged);
            }
        });
        // Leave manual refresh available, but disable tight polling timer
        _ = StartSnapshotTimerAsync();
    }
    
    private Task LoadAllStatusesProgressively()
    {
        if (printers is null) return Task.CompletedTask;
        
        // Load statuses in parallel but update UI as each one completes
        var tasks = printers.Select(async p =>
        {
            loadingStatuses.Add(p.Id);
            await InvokeAsync(StateHasChanged);
            
            try
            {
                // Use HttpClient timeout override for faster response to offline printers
                using var httpClient = new HttpClient();
                httpClient.BaseAddress = Http.BaseAddress;
                httpClient.Timeout = TimeSpan.FromSeconds(3); // Fast timeout for progressive loading
                
                var response = await httpClient.GetAsync($"api/printers/{p.Id}/status");
                if (response.IsSuccessStatusCode)
                {
                    var status = await response.Content.ReadFromJsonAsync<PrinterStatusDto>();
                    if (status is not null)
                    {
                        printerStatuses[p.Id] = status;
                        
                        // Update the printer with the loaded status
                        var idx = printers.FindIndex(pr => pr.Id == p.Id);
                        if (idx >= 0)
                        {
                            printers[idx] = printers[idx] with
                            {
                                IsOnline = status.IsOnline,
                                State = status.State,
                                Progress = status.Progress,
                                JobName = status.JobName,
                                ThumbnailUrl = status.ThumbnailUrl,
                                CameraStreamUrl = status.CameraStreamUrl,
                                CameraSnapshotUrl = status.CameraSnapshotUrl,
                                SpoolInfo = status.SpoolInfo,
                                X = status.X,
                                Y = status.Y,
                                Z = status.Z,
                                HotendTemp = status.HotendTemp,
                                BedTemp = status.BedTemp,
                                HotendTarget = status.HotendTarget,
                                BedTarget = status.BedTarget
                            };
                            
                            // Update snapshot stamps for online printers
                            if (status.IsOnline || !string.IsNullOrWhiteSpace(status.CameraSnapshotUrl))
                            {
                                snapshotStamps[p.Id] = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
                            }
                            
                            // Auto-show cameras for printers that have camera URLs
                            if (!string.IsNullOrWhiteSpace(status.CameraSnapshotUrl) || !string.IsNullOrWhiteSpace(status.CameraStreamUrl))
                            {
                                cameraVisible.Add(p.Id);
                            }
                        }
                    }
                }
            }
            catch (TaskCanceledException)
            {
                // Timeout - leave as offline, which is the default
                Console.WriteLine($"Status timeout for printer {p.Name}");
            }
            catch (HttpRequestException ex)
            {
                // Network error - leave as offline
                Console.WriteLine($"Network error for printer {p.Name}: {ex.Message}");
            }
            catch (Exception ex)
            {
                // Any other error - leave as offline
                Console.WriteLine($"Error loading status for printer {p.Name}: {ex.Message}");
            }
            finally
            {
                loadingStatuses.Remove(p.Id);
                await InvokeAsync(StateHasChanged);
            }
        });
        
        // Don't await Task.WhenAll - let them complete individually with fire-and-forget
        return Task.Run(async () =>
        {
            try
            {
                await Task.WhenAll(tasks);
            }
            catch
            {
                // Individual tasks handle their own exceptions
            }
        });
    }

    public void Dispose()
    {
        // Best-effort unsubscribe wildcard
        realtime.Unsubscribe(Guid.Empty);
    }

    private bool _refreshing;
    private async Task Refresh()
    {
        if (_refreshing) return; // prevent overlap
        _refreshing = true;
        try
        {
            // Use the progressive loading approach for refresh too
            var basicPrinters = await Http.GetFromJsonAsync<List<PrinterBasicDto>>("api/printers/basic");
            if (basicPrinters is not null)
            {
                printers = basicPrinters.Select(p => new PrinterDto(
                    Id: p.Id,
                    Name: p.Name,
                    ServerUrl: p.ServerUrl,
                    Notes: p.Notes,
                    IsOnline: false,
                    State: null,
                    ManufacturerName: p.ManufacturerName,
                    ModelName: p.ModelName,
                    Backend: p.Backend,
                    ApiKey: p.ApiKey,
                    OriginalServerUrl: p.OriginalServerUrl,
                    IpAddress: p.IpAddress
                )).ToList();
                
                StateHasChanged();
                await LoadAllStatusesProgressively();
            }
        }
        finally { _refreshing = false; }
    }

    private bool IsCollapsed(Guid printerId) => collapsedCards.Contains(printerId);
    
    private void ToggleCard(Guid printerId)
    {
        if (collapsedCards.Contains(printerId))
        {
            collapsedCards.Remove(printerId);
        }
        else
        {
            collapsedCards.Add(printerId);
        }
        StateHasChanged();
    }

    // create removed; use /printers/new

    // inline editing removed; edit pages are handled under /printers/{id}/edit

    private async Task Home(Guid id)
    {
        await Http.PostAsync($"api/printers/{id}/home", null);
    }
    private async Task HomeXY(Guid id)
    {
