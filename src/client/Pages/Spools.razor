@page "/spools"
@using Farm.Web.Shared
@inject HttpClient Http
@inject IJSRuntime JS

<h2>Spools</h2>

@if (!string.IsNullOrWhiteSpace(spoolmanError))
{
    <div class="alert alert-error">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M13 13h-2V7h2m0 10h-2v-2h2M12 2A10 10 0 0 0 2 12a10 10 0 0 0 10 10 10 10 0 0 0 10-10A10 10 0 0 0 12 2z"/>
        </svg>
        <span>@spoolmanError</span>
    </div>
}

<div class="row">
    <select @onchange="OnMaterialChanged" value="@selectedMaterial" class="filter-select">
        <option value="">All Materials</option>
        @foreach (var m in MaterialOptions())
        {
            <option value="@m">@m</option>
        }
    </select>
    
    <select @onchange="OnVendorChanged" value="@selectedVendor" class="filter-select">
        <option value="">All Vendors</option>
        @foreach (var v in VendorOptions())
        {
            <option value="@v">@v</option>
        }
    </select>
    
    <select @onchange="OnColorChanged" value="@selectedColor" class="filter-select">
        <option value="">All Colors</option>
        @foreach (var c in ColorOptions())
        {
            <option value="@c">@GetColorDisplayName(c)</option>
        }
    </select>
    
    <select @onchange="OnPageSizeChanged" value="@pageSizeString" class="filter-select">
        <option value="10">10 per page</option>
        <option value="50">50 per page</option>
        <option value="100">100 per page</option>
        <option value="All">Show All</option>
    </select>

    <button class="btn-icon" title="Reset to default sort" @onclick="ResetSortingAsync">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M13,3A9,9 0 0,0 4,12H1L4.89,15.89L4.96,16.03L9,12H6A7,7 0 0,1 13,5A7,7 0 0,1 20,12A7,7 0 0,1 13,19C11.07,19 9.32,18.21 8.06,16.94L6.64,18.36C8.27,20 10.5,21 13,21A9,9 0 0,0 22,12A9,9 0 0,0 13,3Z"/>
        </svg>
    </button>
    
    <button class="btn-icon" title="Clear all filters" @onclick="ClearFilters">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
        </svg>
    </button>
    
    <button class="btn-icon" title="Refresh from Spoolman" @onclick="RefreshFromSpoolman">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
        </svg>
    </button>
</div>

@if (spools is null)
        {
            <div class="loading-state">
                <div class="spinner"></div>
                <p>Loading spools...</p>
            </div>
        }
        else if (!spools.Any())
        {
            <div class="empty-state">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="currentColor" opacity="0.3">
                    <path d="M12,2C13.1,2 14,2.9 14,4C14,5.1 13.1,6 12,6C10.9,6 10,5.1 10,4C10,2.9 10.9,2 12,2M21,9V7L15,1H5C3.89,1 3,1.89 3,3V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V9M19,9H14V4H15V7H19V9Z"/>
                </svg>
                <h3>No spools found</h3>
                <p>No spools are currently available in Spoolman. Check your Spoolman configuration or add some spools.</p>
                <button class="btn btn-primary" @onclick="RefreshFromSpoolman">Refresh Spools</button>
            </div>
        }
        else
        {
            <div class="table-container">
                <table id="spools-table" class="spools-table">
                    <thead>
                        <tr>
                            <th class="sortable-header" @onclick="@(() => SortByAsync("Id"))">
                                ID @SortIndicator("Id")
                            </th>
                            <th class="sortable-header" @onclick="@(() => SortByAsync("Vendor"))">
                                Vendor @SortIndicator("Vendor")
                            </th>
                            <th class="sortable-header" @onclick="@(() => SortByAsync("Filament"))">
                                Filament @SortIndicator("Filament")
                            </th>
                            <th class="sortable-header" @onclick="@(() => SortByAsync("Material"))">
                                Material @SortIndicator("Material")
                            </th>
                            <th class="sortable-header" @onclick="@(() => SortByAsync("Weight"))">
                                Remaining @SortIndicator("Weight")
                            </th>
                            <th class="sortable-header" @onclick="@(() => SortByAsync("Color"))">
                                Color @SortIndicator("Color")
                            </th>
                            <th class="sortable-header" @onclick="@(() => SortByAsync("Registered"))">
                                Registered @SortIndicator("Registered")
                            </th>
                            <th class="sortable-header" @onclick="@(() => SortByAsync("FirstUsed"))">
                                First Used @SortIndicator("FirstUsed")
                            </th>
                            <th class="sortable-header" @onclick="@(() => SortByAsync("LastUsed"))">
                                Last Used @SortIndicator("LastUsed")
                            </th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in PagedSpools())
                        {
                            <tr class="spool-row">
                                <td>
                                    <span class="spool-id">#@s.Id</span>
                                </td>
                                <td>
                                    <span class="vendor-name">@(string.IsNullOrWhiteSpace(s.Vendor) ? "—" : s.Vendor)</span>
                                </td>
                                <td>
                                    <span class="filament-name">@(string.IsNullOrWhiteSpace(s.FilamentName) ? "—" : s.FilamentName)</span>
                                </td>
                                <td>
                                    <span class="material-badge">@s.Material</span>
                                </td>
                                <td>
                                    @if (s.RemainingWeightG.HasValue)
                                    {
                                        <span class="weight-value">@s.RemainingWeightG.Value.ToString("0")g</span>
                                    }
                                    else
                                    {
                                        <span class="weight-unknown">—</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(s.ColorHex))
                                    {
                                        <div class="color-display">
                                            <span class="swatch" style="background-color:@s.ColorHex" title="@s.ColorHex"></span>
                                            <span class="color-name">@GetColorDisplayName(s.ColorHex)</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="color-unknown">—</span>
                                    }
                                </td>
                                <td>
                                    <span class="date-value">@FormatDate(s.RegisteredAt)</span>
                                </td>
                                <td>
                                    <span class="date-value">@FormatDate(s.FirstUsedAt)</span>
                                </td>
                                <td>
                                    <span class="date-value">@FormatDate(s.LastUsedAt)</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(spoolmanBase))
                                    {
                                        <a class="edit-icon" href="@($"{spoolmanBase}/spool/edit/{s.Id}")" target="_blank" rel="noopener noreferrer" title="Edit in Spoolman">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                                <path d="M14.06,9L15,9.94L5.92,19H5V18.08L14.06,9M17.66,3C17.41,3 17.15,3.1 16.96,3.29L15.13,5.12L18.88,8.87L20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18.17,3.09 17.92,3 17.66,3M14.06,6.19L3,17.25V21H6.75L17.81,9.94L14.06,6.19Z"/>
                                            </svg>
                                        </a>
                                    }
                                    else
                                    {
                                        <a class="edit-icon configure-icon" href="/settings" title="Configure Spoolman URL">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                                <path d="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.22,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.22,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"/>
                                            </svg>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            <div class="table-footer">
                <div class="results-info">
                    <span>@ShowingRange()</span>
                </div>
                @if (ShowPaging())
                {
                    <div class="pagination">
                        <button class="btn btn-ghost" @onclick="PrevPage" disabled="@IsPrevDisabled()">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z"/>
                            </svg>
                            Previous
                        </button>
                        <span class="page-info">Page @currentPage of @TotalPages</span>
                        <button class="btn btn-ghost" @onclick="NextPage" disabled="@IsNextDisabled()">
                            Next
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"/>
                            </svg>
                        </button>
                    </div>
                }
            </div>
        }

@code {
    private List<SpoolmanSpoolDto>? spools;
    private string? spoolmanBase;
    private int currentPage = 1;
    private int pageSize = 10; // 10, 50, 100, or int.MaxValue (All)
    private const string PageSizeStorageKey = "spools.pageSize";
    private const string SortKeyStorageKey = "spools.sortKey";
    private const string SortAscStorageKey = "spools.sortAsc";
    private string sortKey = "Id";
    private bool sortAsc = true;
    private string? selectedMaterial = string.Empty;
    private string? selectedVendor = string.Empty;
    private string? selectedColor = string.Empty;

    protected override async Task OnInitializedAsync()
    {
    await LoadSpoolmanConfig();
    await LoadPagePreferences();
    await RefreshFromSpoolman();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("Icons.renderAll");
            }
            catch { }
        } 
    }

    private async Task Refresh()
    {
    await RefreshFromSpoolman();
        StateHasChanged();
    }

    private string? spoolmanError;

    private async Task LoadSpoolmanConfig()
    {
    var cfg = await Http.GetFromJsonAsync<SpoolmanConfigDto>("api/spoolman/config");
        if (cfg is not null)
        {
            spoolmanBase = cfg.BaseUrl;
        }
    }
    // Saving moved to Settings page
    private async Task RefreshFromSpoolman()
    {
        try
        {
            spools = await Http.GetFromJsonAsync<List<SpoolmanSpoolDto>>("api/spoolman/spools") ?? [];
            spoolmanError = null;
            currentPage = 1;
        }
        catch
        {
            spoolmanError = "Unable to fetch from Spoolman. Check URL/API Key.";
        }
    }

    // Local create/delete removed

    // Paging helpers
    private IEnumerable<SpoolmanSpoolDto> PagedSpools()
    {
        var data = SortedSpools().ToList();
        if (pageSize == int.MaxValue)
        {
            foreach (var s in data) yield return s;
            yield break;
        }
        var start = (currentPage - 1) * pageSize;
        if (start < 0) start = 0;
        if (start >= data.Count) start = Math.Max(0, (TotalPages - 1) * pageSize);
        var end = Math.Min(start + pageSize, data.Count);
        for (int i = start; i < end; i++) yield return data[i];
    }

    private int TotalPages => TotalItems == 0 || pageSize == int.MaxValue
        ? 1
        : (int)Math.Ceiling((double)TotalItems / pageSize);
    private int TotalItems => SortedSpools().Count();
    private bool ShowPaging() => pageSize != int.MaxValue && TotalItems > pageSize;
    private bool IsPrevDisabled() => currentPage <= 1;
    private bool IsNextDisabled() => currentPage >= TotalPages;
    private void PrevPage() { if (currentPage > 1) currentPage--; }
    private void NextPage() { if (currentPage < TotalPages) currentPage++; }

    private string pageSizeString
        => pageSize == int.MaxValue ? "All" : pageSize.ToString();

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        SetPageSizeFromString(val);
        await JS.InvokeVoidAsync("localStorage.setItem", PageSizeStorageKey, pageSizeString);
    }

    private string ShowingRange()
    {
    var total = TotalItems;
        if (total == 0) return "No items";
        if (pageSize == int.MaxValue) return $"Showing 1–{total} of {total}";
        var start = ((currentPage - 1) * pageSize) + 1;
        var end = Math.Min(currentPage * pageSize, total);
        return $"Showing {start}–{end} of {total}";
    }

    private async Task LoadPagePreferences()
    {
        try
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", PageSizeStorageKey);
            if (!string.IsNullOrWhiteSpace(stored))
            {
                SetPageSizeFromString(stored);
            }
            var sk = await JS.InvokeAsync<string?>("localStorage.getItem", SortKeyStorageKey);
            if (!string.IsNullOrWhiteSpace(sk) && IsValidSortKey(sk)) sortKey = sk;
            var sa = await JS.InvokeAsync<string?>("localStorage.getItem", SortAscStorageKey);
            if (!string.IsNullOrWhiteSpace(sa) && bool.TryParse(sa, out var asc)) sortAsc = asc;
        }
        catch { }
    }

    private void SetPageSizeFromString(string? val)
    {
        if (string.Equals(val, "All", StringComparison.OrdinalIgnoreCase))
        {
            pageSize = int.MaxValue;
            currentPage = 1;
        }
        else if (int.TryParse(val, out var sz) && (sz == 10 || sz == 50 || sz == 100))
        {
            pageSize = sz;
            currentPage = 1;
        }
        else
        {
            pageSize = 10;
            currentPage = 1;
        }
    }

    // Sorting helpers
    private IEnumerable<SpoolmanSpoolDto> SortedSpools()
    {
        IEnumerable<SpoolmanSpoolDto> data = FilteredSpools();
        switch (sortKey)
        {
            case "Id":
                data = sortAsc ? data.OrderBy(s => s.Id) : data.OrderByDescending(s => s.Id); break;
            case "Material":
                data = sortAsc ? data.OrderBy(s => s.Material ?? string.Empty, StringComparer.OrdinalIgnoreCase)
                               : data.OrderByDescending(s => s.Material ?? string.Empty, StringComparer.OrdinalIgnoreCase); break;
            case "Filament":
                data = sortAsc ? data.OrderBy(s => s.FilamentName ?? string.Empty, StringComparer.OrdinalIgnoreCase)
                               : data.OrderByDescending(s => s.FilamentName ?? string.Empty, StringComparer.OrdinalIgnoreCase); break;
            case "Vendor":
                data = sortAsc ? data.OrderBy(s => s.Vendor ?? string.Empty, StringComparer.OrdinalIgnoreCase)
                               : data.OrderByDescending(s => s.Vendor ?? string.Empty, StringComparer.OrdinalIgnoreCase); break;
            case "Weight":
                data = sortAsc ? data.OrderBy(s => s.RemainingWeightG ?? double.MinValue)
                               : data.OrderByDescending(s => s.RemainingWeightG ?? double.MinValue); break;
            case "Color":
                data = sortAsc ? data.OrderBy(s => s.ColorHex ?? string.Empty, StringComparer.OrdinalIgnoreCase)
                               : data.OrderByDescending(s => s.ColorHex ?? string.Empty, StringComparer.OrdinalIgnoreCase); break;
            case "Registered":
                data = sortAsc ? data.OrderBy(s => s.RegisteredAt ?? DateTime.MinValue)
                               : data.OrderByDescending(s => s.RegisteredAt ?? DateTime.MinValue); break;
            case "FirstUsed":
                data = sortAsc ? data.OrderBy(s => s.FirstUsedAt ?? DateTime.MinValue)
                               : data.OrderByDescending(s => s.FirstUsedAt ?? DateTime.MinValue); break;
            case "LastUsed":
                data = sortAsc ? data.OrderBy(s => s.LastUsedAt ?? DateTime.MinValue)
                               : data.OrderByDescending(s => s.LastUsedAt ?? DateTime.MinValue); break;
            
        }
        return data;
    }

    private async Task SortByAsync(string key)
    {
        if (sortKey == key) sortAsc = !sortAsc; else { sortKey = key; sortAsc = true; }
        currentPage = 1;
        try
        {
            if (IsValidSortKey(sortKey))
            {
                await JS.InvokeVoidAsync("localStorage.setItem", SortKeyStorageKey, sortKey);
            }
            await JS.InvokeVoidAsync("localStorage.setItem", SortAscStorageKey, sortAsc.ToString());
        }
        catch { }
    }

    private string SortIndicator(string key)
        => sortKey == key ? (sortAsc ? "▲" : "▼") : string.Empty;

    private static bool IsValidSortKey(string key)
        => key is "Id" or "Material" or "Filament" or "Vendor" or "Weight" or "Color" or "Registered" or "FirstUsed" or "LastUsed";

    private async Task ResetSortingAsync()
    {
        sortKey = "Id";
        sortAsc = true;
        currentPage = 1;
        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", SortKeyStorageKey);
            await JS.InvokeVoidAsync("localStorage.removeItem", SortAscStorageKey);
        }
        catch { }
    }

    // Filter helpers
    private IEnumerable<SpoolmanSpoolDto> FilteredSpools()
    {
        if (spools is null) return Enumerable.Empty<SpoolmanSpoolDto>();
        IEnumerable<SpoolmanSpoolDto> q = spools;
        if (!string.IsNullOrWhiteSpace(selectedMaterial))
            q = q.Where(s => string.Equals(s.Material, selectedMaterial, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(selectedVendor))
            q = q.Where(s => string.Equals(s.Vendor, selectedVendor, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(selectedColor))
            q = q.Where(s => string.Equals(s.ColorHex, selectedColor, StringComparison.OrdinalIgnoreCase));
        return q;
    }

    private IEnumerable<string> MaterialOptions() => spools is null
        ? Enumerable.Empty<string>()
        : spools.Select(s => s.Material)
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(s => s, StringComparer.OrdinalIgnoreCase);

    private IEnumerable<string> VendorOptions() => spools is null
        ? Enumerable.Empty<string>()
        : spools.Select(s => s.Vendor ?? "")
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(s => s, StringComparer.OrdinalIgnoreCase);

    private IEnumerable<string> ColorOptions() => spools is null
        ? Enumerable.Empty<string>()
        : spools.Select(s => s.ColorHex ?? "")
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(s => s, StringComparer.OrdinalIgnoreCase);

    private static string FormatDate(DateTime? dt)
        => dt.HasValue ? dt.Value.ToLocalTime().ToString("yyyy-MM-dd") : "-";

    private void OnMaterialChanged(ChangeEventArgs e)
    {
        selectedMaterial = e.Value?.ToString();
        currentPage = 1;
    }
    private void OnVendorChanged(ChangeEventArgs e)
    {
        selectedVendor = e.Value?.ToString();
        currentPage = 1;
    }
    private void OnColorChanged(ChangeEventArgs e)
    {
        selectedColor = e.Value?.ToString();
        currentPage = 1;
    }

    private static string GetColorDisplayName(string hexColor)
    {
        if (string.IsNullOrWhiteSpace(hexColor)) return "";
        
        // Common color name mappings
        var colorNames = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            // Grayscale
            {"#000000", "Black"},
            {"#FFFFFF", "White"},
            {"#808080", "Gray"},
            {"#C0C0C0", "Silver"},
            {"#696969", "Dark Gray"},
            {"#DCDCDC", "Light Gray"},
            {"#F5F5F5", "Off White"},
            
            // Primary Colors
            {"#FF0000", "Red"},
            {"#00FF00", "Lime"},
            {"#0000FF", "Blue"},
            {"#FFFF00", "Yellow"},
            {"#FF00FF", "Magenta"},
            {"#00FFFF", "Cyan"},
            
            // Common Colors
            {"#800000", "Maroon"},
            {"#008000", "Green"},
            {"#000080", "Navy"},
            {"#800080", "Purple"},
            {"#808000", "Olive"},
            {"#008080", "Teal"},
            {"#FFA500", "Orange"},
            {"#FFC0CB", "Pink"},
            {"#A52A2A", "Brown"},
            {"#D2691E", "Chocolate"},
            {"#FF6347", "Tomato"},
            {"#32CD32", "Lime Green"},
            {"#87CEEB", "Sky Blue"},
            {"#DA70D6", "Orchid"},
            {"#EE82EE", "Violet"},
            {"#98FB98", "Pale Green"},
            {"#F0E68C", "Khaki"},
            {"#DDA0DD", "Plum"},
            {"#B0C4DE", "Light Steel Blue"},
            {"#FFFFE0", "Light Yellow"},
            {"#00FA9A", "Medium Spring Green"},
            {"#48D1CC", "Medium Turquoise"},
            {"#FFE4E1", "Misty Rose"},
            {"#FFDEAD", "Navajo White"},
            {"#F5DEB3", "Wheat"},
            {"#FFFAF0", "Floral White"}
        };

        // Try to find an exact match first
        if (colorNames.TryGetValue(hexColor, out var colorName))
        {
            return $"{colorName} ({hexColor})";
        }

        // If no exact match, try to find the closest common color by basic hue analysis
        var simplified = GetSimplifiedColorName(hexColor);
        return simplified != null ? $"{simplified} ({hexColor})" : hexColor;
    }

    private static string? GetSimplifiedColorName(string hexColor)
    {
        try
        {
            // Parse hex color
            var hex = hexColor.TrimStart('#');
            if (hex.Length != 6) return null;

            var r = Convert.ToInt32(hex.Substring(0, 2), 16);
            var g = Convert.ToInt32(hex.Substring(2, 2), 16);
            var b = Convert.ToInt32(hex.Substring(4, 2), 16);

            // Simple color classification based on dominant channel
            var max = Math.Max(r, Math.Max(g, b));
            var min = Math.Min(r, Math.Min(g, b));
            
            // Check if it's grayscale
            if (max - min < 30)
            {
                if (max < 50) return "Dark";
                if (max > 200) return "Light";
                return "Gray";
            }

            // Determine dominant color
            if (r > g && r > b)
            {
                if (g > b + 50) return "Orange/Yellow";
                if (b > g + 30) return "Purple/Pink";
                return "Red";
            }
            else if (g > r && g > b)
            {
                if (r > b + 30) return "Yellow/Green";
                if (b > r + 30) return "Cyan/Teal";
                return "Green";
            }
            else if (b > r && b > g)
            {
                if (r > g + 30) return "Purple/Magenta";
                if (g > r + 30) return "Cyan/Blue";
                return "Blue";
            }

            return null;
        }
        catch
        {
            return null;
        }
    }

    private static string GetContrastTextColor(string hexColor)
    {
        try
        {
            var hex = hexColor.TrimStart('#');
            if (hex.Length != 6) return "#000000";

            var r = Convert.ToInt32(hex.Substring(0, 2), 16);
            var g = Convert.ToInt32(hex.Substring(2, 2), 16);
            var b = Convert.ToInt32(hex.Substring(4, 2), 16);

            // Calculate luminance using standard formula
            var luminance = (0.299 * r + 0.587 * g + 0.114 * b) / 255;

            // Return white text for dark colors, black text for light colors
            return luminance > 0.5 ? "#000000" : "#FFFFFF";
        }
        catch
        {
            return "#000000";
        }
    }

    private void ClearFilters()
    {
        selectedMaterial = string.Empty;
        selectedVendor = string.Empty;
        selectedColor = string.Empty;
        currentPage = 1;
        StateHasChanged();
    }
