@page "/catalog"
@using Farm.Web.Shared
@inject HttpClient Http
@inject Farm.Web.Client.ToastService toast
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Catalog - PrintFarmer</PageTitle>

<h2>Catalog</h2>

<div class="catalog-container">
    <!-- Manufacturers Section -->
    <div class="catalog-section manufacturers-section">
        <div class="section-header">
            <h3>Manufacturers</h3>
            <div class="add-form">
                <input @bind="newManufacturer" @onkeypress="@(async (e) => { if (e.Key == "Enter") await AddManufacturer(); })" 
                       placeholder="Manufacturer name" class="form-control" />
                <button @onclick="AddManufacturer" class="btn" disabled="@string.IsNullOrWhiteSpace(newManufacturer)">Add</button>
            </div>
        </div>

        <div class="manufacturers-grid">
            @foreach (var manufacturer in manufacturers)
            {
                <div class="manufacturer-card @(selectedManufacturer?.Id == manufacturer.Id ? "selected" : "")"
                     @onclick="() => SelectManufacturer(manufacturer)">
                    <div class="manufacturer-name">@manufacturer.Name</div>
                    <div class="manufacturer-stats">@GetModelCount(manufacturer.Id) models</div>
                </div>
            }
        </div>

        @if (!manufacturers.Any())
        {
            <div class="empty-state">
                No manufacturers found. Add your first manufacturer above.
            </div>
        }
    </div>

    <!-- Models Section -->
    <div class="catalog-section models-section">
        <div class="section-header">
            <h3>Models @(selectedManufacturer != null ? $"— {selectedManufacturer.Name}" : "")</h3>
            @if (selectedManufacturer is not null)
            {
                <div class="add-form">
                    <input @bind="newModel" @onkeypress="@(async (e) => { if (e.Key == "Enter") await AddModel(); })" 
                           placeholder="Model name" class="form-control" />
                    <button @onclick="AddModel" class="btn" disabled="@string.IsNullOrWhiteSpace(newModel)">Add</button>
                </div>
            }
        </div>

        @if (selectedManufacturer is not null)
        {
            <div class="models-list">
                @foreach (var model in models)
                {
                    var edit = GetEdit(model);
                    bool isDirty = (edit.MaxX != model.MaxX) || (edit.MaxY != model.MaxY) || (edit.MaxZ != model.MaxZ) || (edit.DefaultBackend != model.DefaultBackend);
                    <div class="model-card">
                        <div class="model-header">
                            <h4 class="model-name">@model.Name</h4>
                            <div class="model-actions">
                                <button @onclick="() => SaveModel(model)" class="btn btn-success btn-sm" disabled="@(!isDirty)">Save</button>
                                <button @onclick="() => ResetModel(model)" class="btn btn-secondary btn-sm" disabled="@(!isDirty)">Reset</button>
                            </div>
                        </div>
                        
                        <div class="model-dimensions">
                            <div class="dimension-group">
                                <label class="dimension-label">Max X (mm)</label>
                                <InputNumber TValue="double?" @bind-Value="edit.MaxX" class="dimension-input" placeholder="—" />
                            </div>
                            <div class="dimension-group">
                                <label class="dimension-label">Max Y (mm)</label>
                                <InputNumber TValue="double?" @bind-Value="edit.MaxY" class="dimension-input" placeholder="—" />
                            </div>
                            <div class="dimension-group">
                                <label class="dimension-label">Max Z (mm)</label>
                                <InputNumber TValue="double?" @bind-Value="edit.MaxZ" class="dimension-input" placeholder="—" />
                            </div>
                            <div class="dimension-group">
                                <label class="dimension-label">Default Backend</label>
                                <InputSelect TValue="PrinterBackend?" @bind-Value="edit.DefaultBackend" class="form-control">
                                    <option value="">— None —</option>
                                    <option value="@PrinterBackend.Moonraker">Moonraker</option>
                                    <option value="@PrinterBackend.PrusaLink">PrusaLink</option>
                                    <option value="@PrinterBackend.SDCP">SDCP</option>
                                </InputSelect>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (!models.Any())
            {
                <div class="empty-state">
                    No models found for @selectedManufacturer.Name. Add your first model above.
                </div>
            }
        }
        else
        {
            <div class="selection-prompt">
                <div class="prompt-icon">🏭</div>
                <div class="prompt-text">Select a manufacturer to view and manage models</div>
            </div>
        }
    </div>
</div>

@code {
  private List<ManufacturerDto> manufacturers = new();
  private List<ModelDto> models = new();
  private ManufacturerDto? selectedManufacturer;
  private string? newManufacturer;
  private string? newModel;
  private readonly Dictionary<Guid, EditModel> edit = new();
  private Dictionary<Guid, int> manufacturerModelCounts = new();

  protected override async Task OnInitializedAsync()
  {
    manufacturers = await Http.GetFromJsonAsync<List<ManufacturerDto>>("api/catalog/manufacturers") ?? new();
    await LoadManufacturerModelCounts();
  }

  private async Task LoadManufacturerModelCounts()
  {
    manufacturerModelCounts.Clear();
    foreach (var manufacturer in manufacturers)
    {
      var manufacturerModels = await Http.GetFromJsonAsync<List<ModelDto>>($"api/catalog/models?manufacturerId={manufacturer.Id}") ?? new();
      manufacturerModelCounts[manufacturer.Id] = manufacturerModels.Count;
    }
  }

  private int GetModelCount(Guid manufacturerId)
  {
    return manufacturerModelCounts.TryGetValue(manufacturerId, out var count) ? count : 0;
  }

  private async Task AddManufacturer()
  {
    if (string.IsNullOrWhiteSpace(newManufacturer)) return;
    var resp = await Http.PostAsJsonAsync("api/catalog/manufacturers", newManufacturer);
    if (resp.IsSuccessStatusCode)
    {
      manufacturers = await Http.GetFromJsonAsync<List<ManufacturerDto>>("api/catalog/manufacturers") ?? new();
      await LoadManufacturerModelCounts();
      newManufacturer = string.Empty;
      toast.Success("Manufacturer added");
    }
    else if ((int)resp.StatusCode == 409)
    {
      // select existing
      var existing = await resp.Content.ReadFromJsonAsync<ManufacturerDto>();
      if (existing is not null)
      {
        await SelectManufacturer(existing);
        newManufacturer = string.Empty;
        toast.Success("Using existing manufacturer");
      }
    }
  }

  private async Task SelectManufacturer(ManufacturerDto m)
  {
    selectedManufacturer = m;
    models = await Http.GetFromJsonAsync<List<ModelDto>>($"api/catalog/models?manufacturerId={m.Id}") ?? new();
    BuildEditState();
  }

  private async Task AddModel()
  {
    if (selectedManufacturer is null || string.IsNullOrWhiteSpace(newModel)) return;
    var resp = await Http.PostAsJsonAsync("api/catalog/models", new { ManufacturerId = selectedManufacturer.Id, Name = newModel });
    if (resp.IsSuccessStatusCode)
    {
      models = await Http.GetFromJsonAsync<List<ModelDto>>($"api/catalog/models?manufacturerId={selectedManufacturer.Id}") ?? new();
      BuildEditState();
      newModel = string.Empty;
      toast.Success("Model added");
      
      // Update count for this manufacturer
      manufacturerModelCounts[selectedManufacturer.Id] = models.Count;
    }
    else if ((int)resp.StatusCode == 409)
    {
      var existing = await resp.Content.ReadFromJsonAsync<ModelDto>();
      if (existing is not null)
      {
        models = await Http.GetFromJsonAsync<List<ModelDto>>($"api/catalog/models?manufacturerId={selectedManufacturer.Id}") ?? new();
        BuildEditState();
        newModel = string.Empty;
        toast.Success("Using existing model");
      }
    }
  }

  private void BuildEditState()
  {
    edit.Clear();
    foreach (var m in models)
    {
      edit[m.Id] = new EditModel { MaxX = m.MaxX, MaxY = m.MaxY, MaxZ = m.MaxZ, DefaultBackend = m.DefaultBackend };
    }
  }

  private EditModel GetEdit(ModelDto m)
  {
    if (!edit.TryGetValue(m.Id, out var e))
    {
      e = new EditModel { MaxX = m.MaxX, MaxY = m.MaxY, MaxZ = m.MaxZ, DefaultBackend = m.DefaultBackend };
      edit[m.Id] = e;
    }
    return e;
  }

  private async Task SaveModel(ModelDto m)
  {
    var ed = GetEdit(m);
    // Basic validation: non-negative numbers or null
    if ((ed.MaxX is < 0) || (ed.MaxY is < 0) || (ed.MaxZ is < 0))
    {
      toast.Error("Sizes must be >= 0 or empty");
      return;
    }

    var resp = await Http.PutAsJsonAsync($"api/catalog/models/{m.Id}", new { Name = m.Name, ed.MaxX, ed.MaxY, ed.MaxZ, ed.DefaultBackend });
    if (resp.IsSuccessStatusCode)
    {
      // Refresh source of truth to keep lists in sync
      if (selectedManufacturer is not null)
      {
        models = await Http.GetFromJsonAsync<List<ModelDto>>($"api/catalog/models?manufacturerId={selectedManufacturer.Id}") ?? new();
        BuildEditState();
      }
      toast.Success("Model updated");
    }
    else
    {
      toast.Error($"Update failed: {(int)resp.StatusCode}");
    }
  }

  private void ResetModel(ModelDto m)
  {
    edit[m.Id] = new EditModel { MaxX = m.MaxX, MaxY = m.MaxY, MaxZ = m.MaxZ, DefaultBackend = m.DefaultBackend };
  }

  private class EditModel
  {
    public double? MaxX { get; set; }
    public double? MaxY { get; set; }
    public double? MaxZ { get; set; }
    public PrinterBackend? DefaultBackend { get; set; }
  }
}