@page "/library"
@using Farm.Web.Shared
@using Farm.Web.Client.Services
@inject GcodeLibraryService GcodeLibraryService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>G-code Library - PrintFarmer</PageTitle>

<div class="library-container">
    <div class="library-header">
        <h1>G-code Library</h1>
        <div class="header-actions">
            <button class="btn btn-secondary" @onclick="ShowHarvestDialog">
                🌾 Harvest from Printers
            </button>
            <button class="btn btn-primary" @onclick="ShowUploadDialog">
                ⬆️ Upload G-code
            </button>
        </div>
    </div>

    <div class="search-section">
        <div class="search-controls">
            <input type="text" @bind="searchTerm" @onkeyup="OnSearchKeyUp" placeholder="Search files..." class="search-input" />
            <select @bind="SelectedMaterial" class="filter-select">
                <option value="">All Materials</option>
                @foreach (var material in availableMaterials)
                {
                    <option value="@material">@material</option>
                }
            </select>
            <select @bind="SelectedSourceFilter" class="filter-select">
                <option value="">All Sources</option>
                <option value="Upload">Uploaded</option>
                <option value="Harvested">Harvested</option>
                <option value="Generated">Generated</option>
            </select>
            <button class="btn btn-sm btn-secondary" @onclick="ClearFilters">Clear Filters</button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>Loading G-code library...</p>
        </div>
    }
    else if (!filteredFiles.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">📁</div>
            <h2>No G-code files found</h2>
            <p>Upload your first G-code file or harvest from your printers!</p>
            <div class="empty-actions">
                <button class="btn btn-primary" @onclick="ShowUploadDialog">
                    Upload G-code
                </button>
                <button class="btn btn-secondary" @onclick="ShowHarvestDialog">
                    Harvest from Printers
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="library-stats">
            <div class="stat">
                <span class="stat-number">@allFiles.Count</span>
                <span class="stat-label">Total Files</span>
            </div>
            <div class="stat">
                <span class="stat-number">@allFiles.Count(f => f.Source == GcodeSourceDto.Upload)</span>
                <span class="stat-label">Uploaded</span>
            </div>
            <div class="stat">
                <span class="stat-number">@allFiles.Count(f => f.Source == GcodeSourceDto.Harvested)</span>
                <span class="stat-label">Harvested</span>
            </div>
            <div class="stat">
                <span class="stat-number">@FormatFileSize(allFiles.Sum(f => f.FileSizeBytes))</span>
                <span class="stat-label">Total Size</span>
            </div>
        </div>

        <div class="files-grid">
            @foreach (var file in filteredFiles.Take(50)) // Paginate for performance
            {
                <div class="file-card">
                    <div class="file-header">
                        <div class="file-source @file.Source.ToString().ToLower()">
                            @GetSourceIcon(file.Source) @file.Source
                        </div>
                        <div class="file-actions">
                            <button class="btn-icon" @onclick="() => QueuePrintJob(file)" title="Add to Print Queue">
                                ➕
                            </button>
                            <button class="btn-icon" @onclick="() => EditFile(file)" title="Edit File">
                                ✏️
                            </button>
                            <button class="btn-icon" @onclick="() => DownloadFile(file)" title="Download File">
                                ⬇️
                            </button>
                            <button class="btn-icon" @onclick="() => DeleteFile(file.Id)" title="Delete File">
                                🗑️
                            </button>
                        </div>
                    </div>
                    
                    <div class="file-details">
                        <h3>@file.DisplayName</h3>
                        @if (!string.IsNullOrEmpty(file.Description))
                        {
                            <p class="file-description">@file.Description</p>
                        }
                        
                        <div class="file-meta">
                            <div class="meta-row">
                                <span class="meta-label">Size:</span>
                                <span class="meta-value">@FormatFileSize(file.FileSizeBytes)</span>
                            </div>
                            @if (file.EstimatedPrintTimeMinutes.HasValue)
                            {
                                <div class="meta-row">
                                    <span class="meta-label">Print Time:</span>
                                    <span class="meta-value">@FormatPrintTime(file.EstimatedPrintTimeMinutes.Value)</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(file.RequiredMaterial))
                            {
                                <div class="meta-row">
                                    <span class="meta-label">Material:</span>
                                    <span class="meta-value">@file.RequiredMaterial</span>
                                </div>
                            }
                            @if (file.RequiredNozzleDiameter.HasValue)
                            {
                                <div class="meta-row">
                                    <span class="meta-label">Nozzle:</span>
                                    <span class="meta-value">@file.RequiredNozzleDiameter mm</span>
                                </div>
                            }
                            @if (file.Source == GcodeSourceDto.Harvested && !string.IsNullOrEmpty(file.SourcePrinterName))
                            {
                                <div class="meta-row">
                                    <span class="meta-label">From:</span>
                                    <span class="meta-value">@file.SourcePrinterName</span>
                                </div>
                            }
                        </div>
                        
                        @if (file.Tags?.Any() == true)
                        {
                            <div class="file-tags">
                                @foreach (var tag in file.Tags)
                                {
                                    <span class="tag">@tag</span>
                                }
                            </div>
                        }
                        
                        <div class="file-timestamps">
                            <div class="timestamp">
                                Uploaded: @file.UploadedAt.ToString("MM/dd/yyyy HH:mm")
                            </div>
                            @if (file.LastSeenOnPrinter.HasValue && file.Source == GcodeSourceDto.Harvested)
                            {
                                <div class="timestamp">
                                    Last seen: @file.LastSeenOnPrinter.Value.ToString("MM/dd/yyyy")
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (filteredFiles.Count > 50)
        {
            <div class="pagination-info">
                Showing first 50 of @filteredFiles.Count files. Use filters to narrow results.
            </div>
        }
    }
</div>

@if (showUploadDialog)
{
    <div class="modal-overlay" @onclick="HideUploadDialog">
        <div class="modal large" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Upload G-code File</h2>
                <button class="modal-close" @onclick="HideUploadDialog">×</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Display Name</label>
                    <input @bind="newFile.DisplayName" placeholder="Enter display name..." />
                </div>
                <div class="form-group">
                    <label>Description</label>
                    <textarea @bind="newFile.Description" placeholder="Optional description..."></textarea>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Required Material</label>
                        <input @bind="newFile.RequiredMaterial" placeholder="PLA" />
                    </div>
                    <div class="form-group">
                        <label>Nozzle Diameter (mm)</label>
                        <input type="number" step="0.1" @bind="newFile.RequiredNozzleDiameter" placeholder="0.4" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Print Time (minutes)</label>
                        <input type="number" @bind="newFile.EstimatedPrintTimeMinutes" placeholder="120" />
                    </div>
                    <div class="form-group">
                        <label>Filament Weight (g)</label>
                        <input type="number" step="0.1" @bind="newFile.EstimatedFilamentWeightG" placeholder="25.5" />
                    </div>
                </div>
                <div class="form-group">
                    <label>Tags (comma-separated)</label>
                    <input @bind="tagsString" placeholder="miniature, detailed, support-free" />
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="HideUploadDialog">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveFile" disabled="@(string.IsNullOrWhiteSpace(newFile.DisplayName))">
                    Upload File
                </button>
            </div>
        </div>
    </div>
}

@if (showHarvestDialog)
{
    <div class="modal-overlay" @onclick="HideHarvestDialog">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Harvest G-code from Printers</h2>
                <button class="modal-close" @onclick="HideHarvestDialog">×</button>
            </div>
            <div class="modal-body">
                <p>This feature will scan your printers for G-code files and import them into the library.</p>
                <div class="form-group">
                    <label>Select Printer</label>
                    <select @bind="selectedPrinterId">
                        <option value="">Select a printer...</option>
                        <!-- TODO: Populate with actual printers -->
                    </select>
                </div>
                <div class="form-group">
                    <label>
                        <input type="checkbox" @bind="includeSubdirectories" />
                        Include subdirectories
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="HideHarvestDialog">Cancel</button>
                <button class="btn btn-primary" @onclick="StartHarvest" disabled="@(string.IsNullOrEmpty(selectedPrinterId))">
                    Start Harvest
                </button>
            </div>
        </div>
    </div>
}

<style>
.library-container { padding: 1rem; }
.library-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
.library-header h1 { margin: 0; color: #e5e7eb; font-size: 1.75rem; }
.header-actions { display: flex; gap: 0.75rem; }

.search-section { margin-bottom: 2rem; background: linear-gradient(180deg, #1f2937, #111827); padding: 1rem; border-radius: 8px; }
.search-controls { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; }
.search-input { flex: 1; min-width: 200px; padding: 0.5rem; border: 1px solid #4b5563; border-radius: 4px; background: #374151; color: #e5e7eb; }
.filter-select { padding: 0.5rem; border: 1px solid #4b5563; border-radius: 4px; background: #374151; color: #e5e7eb; }

.loading, .empty-state { text-align: center; padding: 3rem 1rem; }
.spinner { width: 40px; height: 40px; border: 4px solid rgba(255,255,255,0.1); border-top: 4px solid #3b82f6; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto 1rem; }

.empty-state .empty-icon { font-size: 4rem; margin-bottom: 1rem; }
.empty-state h2 { color: #e5e7eb; margin-bottom: 0.5rem; }
.empty-state p { color: #9ca3af; margin-bottom: 1.5rem; }
.empty-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

.library-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
.stat { background: linear-gradient(180deg, #1f2937, #111827); padding: 1rem; border-radius: 8px; text-align: center; }
.stat-number { display: block; font-size: 1.5rem; font-weight: bold; color: #3b82f6; }
.stat-label { color: #9ca3af; font-size: 0.875rem; }

.files-grid { display: grid; gap: 1rem; }
.file-card { background: linear-gradient(180deg, #1f2937, #111827); border-radius: 8px; padding: 1rem; border-left: 4px solid #6b7280; }
.file-card:has(.upload) { border-left-color: #10b981; }
.file-card:has(.harvested) { border-left-color: #f59e0b; }
.file-card:has(.generated) { border-left-color: #8b5cf6; }

.file-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
.file-source { padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.875rem; font-weight: 600; }
.file-source.upload { background: #065f46; color: #d1fae5; }
.file-source.harvested { background: #92400e; color: #fef3c7; }
.file-source.generated { background: #5b21b6; color: #e9d5ff; }
.file-actions { display: flex; gap: 0.5rem; }

.file-details h3 { margin: 0 0 0.5rem 0; color: #e5e7eb; font-size: 1.25rem; }
.file-description { color: #9ca3af; margin-bottom: 1rem; font-style: italic; }

.file-meta { display: grid; gap: 0.5rem; margin-bottom: 1rem; }
.meta-row { display: flex; }
.meta-label { color: #9ca3af; min-width: 80px; }
.meta-value { color: #e5e7eb; }

.file-tags { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1rem; }
.tag { background: #374151; color: #e5e7eb; padding: 0.25rem 0.5rem; border-radius: 12px; font-size: 0.75rem; }

.file-timestamps { color: #9ca3af; font-size: 0.875rem; }
.timestamp { margin-bottom: 0.25rem; }

.pagination-info { text-align: center; padding: 1rem; color: #9ca3af; font-style: italic; }

.btn { padding: 0.5rem 1rem; border: none; border-radius: 6px; font-weight: 600; cursor: pointer; transition: all 0.2s ease; }
.btn-primary { background: #3b82f6; color: white; }
.btn-primary:hover { background: #2563eb; }
.btn-secondary { background: #4b5563; color: white; }
.btn-secondary:hover { background: #374151; }
.btn-sm { padding: 0.375rem 0.75rem; font-size: 0.875rem; }
.btn-icon { background: none; border: none; font-size: 1rem; cursor: pointer; padding: 0.25rem; border-radius: 4px; }
.btn-icon:hover { background: rgba(255,255,255,0.1); }

.modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.8); z-index: 1000; display: flex; align-items: center; justify-content: center; padding: 1rem; }
.modal { background: linear-gradient(180deg, #1f2937, #111827); border-radius: 8px; width: 100%; max-width: 500px; max-height: 90vh; overflow: auto; }
.modal.large { max-width: 700px; }
.modal-header { display: flex; justify-content: space-between; align-items: center; padding: 1rem; border-bottom: 1px solid #374151; }
.modal-header h2 { margin: 0; color: #e5e7eb; }
.modal-close { background: none; border: none; font-size: 1.5rem; color: #9ca3af; cursor: pointer; }
.modal-body { padding: 1rem; }
.modal-footer { display: flex; gap: 1rem; justify-content: flex-end; padding: 1rem; border-top: 1px solid #374151; }

.form-group { margin-bottom: 1rem; }
.form-group label { display: block; color: #e5e7eb; margin-bottom: 0.5rem; font-weight: 600; }
.form-group input, .form-group textarea, .form-group select { width: 100%; padding: 0.5rem; border: 1px solid #4b5563; border-radius: 4px; background: #374151; color: #e5e7eb; }
.form-group textarea { min-height: 80px; resize: vertical; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
</style>

@code {
    private List<GcodeFileDto> allFiles = new();
    private List<GcodeFileDto> filteredFiles = new();
    private List<string> availableMaterials = new();
    private bool isLoading = true;
    private bool showUploadDialog = false;
    private bool showHarvestDialog = false;
    private CreateGcodeFileDto newFile = new();
    private string searchTerm = "";
    private string selectedMaterial = "";
    private string selectedSourceFilter = "";
    private string tagsString = "";
    private string selectedPrinterId = "";
    private bool includeSubdirectories = true;

    // Property setters to trigger filter updates
    private string SelectedMaterial
    {
        get => selectedMaterial;
        set
        {
            selectedMaterial = value;
            ApplyFilters();
        }
    }

    private string SelectedSourceFilter
    {
        get => selectedSourceFilter;
        set
        {
            selectedSourceFilter = value;
            ApplyFilters();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadFiles();
        isLoading = false;
    }

    private async Task LoadFiles()
    {
        allFiles = await GcodeLibraryService.GetFilesAsync();
        availableMaterials = allFiles.Where(f => !string.IsNullOrEmpty(f.RequiredMaterial))
                                   .Select(f => f.RequiredMaterial!)
                                   .Distinct()
                                   .OrderBy(m => m)
                                   .ToList();
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        filteredFiles = allFiles.Where(file =>
        {
            if (!string.IsNullOrEmpty(searchTerm) && 
                !file.DisplayName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) &&
                !file.Description?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true)
            {
                return false;
            }
            
            if (!string.IsNullOrEmpty(selectedMaterial) && file.RequiredMaterial != selectedMaterial)
            {
                return false;
            }
            
            if (!string.IsNullOrEmpty(selectedSourceFilter) && file.Source.ToString() != selectedSourceFilter)
            {
                return false;
            }
            
            return true;
        }).ToList();
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        ApplyFilters();
        await Task.CompletedTask;
    }

    private void ClearFilters()
    {
        searchTerm = "";
        selectedMaterial = "";
        selectedSourceFilter = "";
        ApplyFilters();
    }

    private void ShowUploadDialog()
    {
        newFile = new CreateGcodeFileDto();
        tagsString = "";
        showUploadDialog = true;
    }

    private void HideUploadDialog()
    {
        showUploadDialog = false;
        newFile = new();
        tagsString = "";
    }

    private async Task SaveFile()
    {
        if (!string.IsNullOrEmpty(tagsString))
        {
            newFile.Tags = tagsString.Split(',').Select(t => t.Trim()).Where(t => !string.IsNullOrEmpty(t)).ToArray();
        }

        await GcodeLibraryService.CreateFileAsync(newFile);
        await LoadFiles();
        HideUploadDialog();
    }

    private void ShowHarvestDialog()
    {
        selectedPrinterId = "";
        includeSubdirectories = true;
        showHarvestDialog = true;
    }

    private void HideHarvestDialog()
    {
        showHarvestDialog = false;
    }

    private async Task StartHarvest()
    {
        if (!string.IsNullOrEmpty(selectedPrinterId) && Guid.TryParse(selectedPrinterId, out var printerId))
        {
            await GcodeLibraryService.HarvestFileAsync(printerId, "");
            await LoadFiles();
        }
        HideHarvestDialog();
    }

    private async Task QueuePrintJob(GcodeFileDto file)
    {
        // Navigate to queue page with pre-filled data
        Navigation.NavigateTo($"/queue?file={file.Id}");
        await Task.CompletedTask;
    }

    private void EditFile(GcodeFileDto file)
    {
        // TODO: Implement edit functionality
    }

    private async Task DownloadFile(GcodeFileDto file)
    {
        // TODO: Implement download functionality
        await JSRuntime.InvokeVoidAsync("window.open", $"/api/library/{file.Id}/download", "_blank");
    }

    private async Task DeleteFile(Guid fileId)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this file?"))
        {
            await GcodeLibraryService.DeleteFileAsync(fileId);
            await LoadFiles();
        }
    }

    private string GetSourceIcon(GcodeSourceDto source)
    {
        return source switch
        {
            GcodeSourceDto.Upload => "⬆️",
            GcodeSourceDto.Harvested => "🌾",
            GcodeSourceDto.Generated => "🔧",
            _ => "📄"
        };
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1024 * 1024 * 1024) return $"{bytes / (1024.0 * 1024):F1} MB";
        return $"{bytes / (1024.0 * 1024 * 1024):F1} GB";
    }

    private string FormatPrintTime(double minutes)
    {
        if (minutes < 60) return $"{minutes:F0}m";
        var hours = minutes / 60;
        if (hours < 24) return $"{hours:F1}h";
        var days = hours / 24;
        return $"{days:F1}d";
    }

    public async ValueTask DisposeAsync()
    {
        await Task.CompletedTask;
    }
}
