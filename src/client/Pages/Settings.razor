@page "/settings"
@using Farm.Web.Shared
@inject HttpClient Http
@inject Farm.Web.Client.ToastService toast

<h2>Settings</h2>

<div class="form">
  <label>Spoolman Base URL</label>
  <div class="field">
    <input placeholder="http://spoolman:7912" @bind="spoolmanBase" @bind:event="oninput" />
    <div class="hint">Base URL to your Spoolman instance. No API key required. Example: http://spoolman:8000</div>
    @if (!string.IsNullOrWhiteSpace(spoolmanBase))
    {
      <div class="hint">Will save as: <code>@NormalizedUrl</code></div>
      <div class="row row-inline" style="gap:.5rem; margin-top:.25rem;">
        <a class="btn ghost" href="@NormalizedUrl" target="_blank" rel="noopener noreferrer">Open Spoolman</a>
        <button class="btn" @onclick="TestSpoolman" disabled="@testing">@((testing ? "Testing..." : "Test connection"))</button>
        @if (testOk.HasValue)
        {
          <span class="hint @((testOk == true ? "ok" : "error"))">@testMessage</span>
        }
      </div>
    }
  </div>

  <div class="actions">
    <button class="btn primary" @onclick="SaveSpoolman" disabled="@string.IsNullOrWhiteSpace(spoolmanBase)">Save</button>
    <a class="btn" href="/spools">View Spools</a>
  </div>
</div>

<div class="manage-card" style="margin-top:1rem; max-width:720px;">
  <div class="section">
    <div class="section-title">Filament Temperature Presets</div>
    <div class="hint">Defaults used by preset buttons on the Printers page. Admins can override per material.</div>
    <div class="form" style="margin-top:.5rem;">
      <label>ABS (Hotend / Bed)</label>
      <div class="row row-inline">
        <input type="number" style="width:120px;" @bind-value="absHotend" @bind-value:event="oninput" />
        <input type="number" style="width:120px;" @bind-value="absBed" @bind-value:event="oninput" />
      </div>
      <label>ASA (Hotend / Bed)</label>
      <div class="row row-inline">
        <input type="number" style="width:120px;" @bind-value="asaHotend" @bind-value:event="oninput" />
        <input type="number" style="width:120px;" @bind-value="asaBed" @bind-value:event="oninput" />
      </div>
      <label>PLA (Hotend / Bed)</label>
      <div class="row row-inline">
        <input type="number" style="width:120px;" @bind-value="plaHotend" @bind-value:event="oninput" />
        <input type="number" style="width:120px;" @bind-value="plaBed" @bind-value:event="oninput" />
      </div>
      <label>PC (Hotend / Bed)</label>
      <div class="row row-inline">
        <input type="number" style="width:120px;" @bind-value="pcHotend" @bind-value:event="oninput" />
        <input type="number" style="width:120px;" @bind-value="pcBed" @bind-value:event="oninput" />
      </div>
      <label>PCTG (Hotend / Bed)</label>
      <div class="row row-inline">
        <input type="number" style="width:120px;" @bind-value="pctgHotend" @bind-value:event="oninput" />
        <input type="number" style="width:120px;" @bind-value="pctgBed" @bind-value:event="oninput" />
      </div>
      <label>PETG (Hotend / Bed)</label>
      <div class="row row-inline">
        <input type="number" style="width:120px;" @bind-value="petgHotend" @bind-value:event="oninput" />
        <input type="number" style="width:120px;" @bind-value="petgBed" @bind-value:event="oninput" />
      </div>
      <div class="actions">
        <button class="btn primary" @onclick="SavePresets">Save Presets</button>
      </div>
    </div>
  </div>
  
</div>

<div class="manage-card" style="margin-top:1rem; max-width:720px;">
  <div class="section">
    <div class="section-title">Network Discovery Settings</div>
    <div class="hint">Configure network ranges and parameters for printer discovery. Leave ranges empty to auto-detect from current network interfaces.</div>
    <div class="form" style="margin-top:.5rem;">
      <label>Network Ranges (CIDR notation)</label>
      <div class="network-ranges">
        @foreach (var range in networkRanges)
        {
          <div class="network-range-input row row-inline">
            <input type="text" style="flex:1;" @bind="range.Value" @bind:event="oninput" placeholder="e.g., 192.168.1.0/24" />
            <button class="btn ghost" @onclick="() => RemoveNetworkRange(range)" title="Remove this range">×</button>
          </div>
        }
        <button class="btn ghost" @onclick="AddNetworkRange">+ Add Range</button>
      </div>
      
      <div class="row row-inline" style="gap: 1rem; margin-top: .5rem;">
        <button class="btn ghost" @onclick="LoadDynamicRanges" disabled="@loadingDynamic">
          @(loadingDynamic ? "Detecting..." : "Auto-detect Networks")
        </button>
        @if (dynamicRanges != null && dynamicRanges.Count > 0)
        {
          <span class="hint ok">Detected: @string.Join(", ", dynamicRanges)</span>
        }
      </div>

      <label>Discovery Timeout (ms)</label>
      <input type="number" style="width:120px;" @bind-value="discoveryTimeout" @bind-value:event="oninput" min="1000" max="10000" />
      
      <label>Max Concurrent Scans</label>
      <input type="number" style="width:120px;" @bind-value="maxConcurrentScans" @bind-value:event="oninput" min="1" max="100" />
      
      <label>Ports to Scan</label>
      <div class="network-ranges">
        @foreach (var port in scanPorts)
        {
          <div class="network-range-input row row-inline">
            <input type="number" style="width:100px;" @bind="port.Value" @bind:event="oninput" placeholder="Port" min="1" max="65535" />
            <button class="btn ghost" @onclick="() => RemoveScanPort(port)" title="Remove this port">×</button>
          </div>
        }
        <button class="btn ghost" @onclick="AddScanPort">+ Add Port</button>
      </div>
      
      <div class="actions">
        <button class="btn primary" @onclick="SaveNetworkDiscoverySettings">Save Discovery Settings</button>
        <button class="btn" @onclick="ResetToDefaults">Reset to Defaults</button>
      </div>
    </div>
  </div>
</div>

@code {
  private string spoolmanBase = string.Empty;
  private FilamentPresetsDto? presets;
  private double absHotend, absBed, asaHotend, asaBed, plaHotend, plaBed, pcHotend, pcBed, pctgHotend, pctgBed, petgHotend, petgBed;
  private bool testing;
  private bool? testOk;
  private string? testMessage;

  // Network discovery settings
  private List<EditableString> networkRanges = new();
  private List<EditableInt> scanPorts = new();
  private int discoveryTimeout = 3000;
  private int maxConcurrentScans = 20;
  private bool loadingDynamic;
  private List<string>? dynamicRanges;

  private string NormalizedUrl
    => NormalizeBaseUrl(spoolmanBase ?? string.Empty);

  protected override async Task OnInitializedAsync()
  {
    var cfg = await Http.GetFromJsonAsync<SpoolmanConfigDto>("api/spoolman/config");
    if (cfg is not null) spoolmanBase = cfg.BaseUrl;
    presets = await Http.GetFromJsonAsync<FilamentPresetsDto>("/api/presets");
    if (presets is not null)
    {
      absHotend = presets.Abs.Hotend ?? 0; absBed = presets.Abs.Bed ?? 0;
      asaHotend = presets.Asa.Hotend ?? 0; asaBed = presets.Asa.Bed ?? 0;
      plaHotend = presets.Pla.Hotend ?? 0; plaBed = presets.Pla.Bed ?? 0;
      pcHotend = presets.Pc.Hotend ?? 0; pcBed = presets.Pc.Bed ?? 0;
      pctgHotend = presets.Pctg.Hotend ?? 0; pctgBed = presets.Pctg.Bed ?? 0;
      petgHotend = presets.Petg.Hotend ?? 0; petgBed = presets.Petg.Bed ?? 0;
    }
    
    // Load network discovery settings
    await LoadNetworkDiscoverySettings();
  }

  private async Task LoadNetworkDiscoverySettings()
  {
    try
    {
      var settings = await Http.GetFromJsonAsync<NetworkDiscoverySettingsDto>("/api/network-discovery/settings");
      if (settings is not null)
      {
        networkRanges = settings.NetworkRanges.Select(r => new EditableString { Value = r }).ToList();
        scanPorts = settings.Ports.Select(p => new EditableInt { Value = p }).ToList();
        discoveryTimeout = settings.TimeoutMs;
        maxConcurrentScans = settings.MaxConcurrentScans;
      }
      
      // Ensure we have at least one empty range and port for editing
      if (networkRanges.Count == 0) networkRanges.Add(new EditableString());
      if (scanPorts.Count == 0) scanPorts.Add(new EditableInt { Value = 80 });
    }
    catch (Exception ex)
    {
      toast.Error($"Failed to load network discovery settings: {ex.Message}");
      // Set defaults
      networkRanges = new List<EditableString> { new EditableString() };
      scanPorts = new List<EditableInt> { new EditableInt { Value = 80 }, new EditableInt { Value = 7125 } };
    }
  }

  private async Task SaveSpoolman()
  {
    var resp = await Http.PostAsJsonAsync("api/spoolman/config", new SpoolmanConfigDto(NormalizedUrl));
    if (resp.IsSuccessStatusCode) toast.Success("Spoolman URL saved");
    else toast.Error($"Save failed: {(int)resp.StatusCode}");
  }

  private async Task TestSpoolman()
  {
    testing = true; testOk = null; testMessage = null;
    try
    {
      // Attempt to fetch spools using current config (not saved yet); temporarily POST then GET
      var save = await Http.PostAsJsonAsync("api/spoolman/config", new SpoolmanConfigDto(NormalizedUrl));
      if (!save.IsSuccessStatusCode)
      {
        testOk = false; testMessage = $"Save failed: {(int)save.StatusCode}"; return;
      }
      var spools = await Http.GetFromJsonAsync<List<SpoolmanSpoolDto>>("api/spoolman/spools");
      testOk = true;
      testMessage = spools is { Count: > 0 } ? $"Connected. {spools.Count} spool(s) found." : "Connected. No spools returned.";
    }
    catch (Exception ex)
    {
      testOk = false; testMessage = $"Failed: {ex.Message}";
    }
    finally { testing = false; }
  }

  private static string NormalizeBaseUrl(string url)
  {
    if (string.IsNullOrWhiteSpace(url)) return string.Empty;
    var t = url.Trim();
    if (!t.StartsWith("http://", StringComparison.OrdinalIgnoreCase) && !t.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
      t = "http://" + t;
    return t.TrimEnd('/');
  }

  private async Task SavePresets()
  {
    var body = new FilamentPresetsDto(
      new TempTargets(absHotend, absBed),
      new TempTargets(asaHotend, asaBed),
      new TempTargets(plaHotend, plaBed),
      new TempTargets(pcHotend, pcBed),
      new TempTargets(pctgHotend, pctgBed),
      new TempTargets(petgHotend, petgBed)
    );
    var resp = await Http.PostAsJsonAsync("/api/presets", body);
    if (resp.IsSuccessStatusCode) toast.Success("Presets saved");
    else toast.Error($"Save failed: {(int)resp.StatusCode}");
  }

  // Network discovery methods
  private void AddNetworkRange()
  {
    networkRanges.Add(new EditableString());
  }

  private void RemoveNetworkRange(EditableString range)
  {
    networkRanges.Remove(range);
    if (networkRanges.Count == 0) networkRanges.Add(new EditableString());
  }

  private void AddScanPort()
  {
    scanPorts.Add(new EditableInt());
  }

  private void RemoveScanPort(EditableInt port)
  {
    scanPorts.Remove(port);
    if (scanPorts.Count == 0) scanPorts.Add(new EditableInt { Value = 80 });
  }

  private async Task LoadDynamicRanges()
  {
    loadingDynamic = true;
    try
    {
      dynamicRanges = await Http.GetFromJsonAsync<List<string>>("/api/network-discovery/dynamic-ranges");
      if (dynamicRanges?.Count > 0)
      {
        // Replace current ranges with detected ones
        networkRanges = dynamicRanges.Select(r => new EditableString { Value = r }).ToList();
        networkRanges.Add(new EditableString()); // Add empty one for additional input
      }
      StateHasChanged();
    }
    catch (Exception ex)
    {
      toast.Error($"Failed to detect network ranges: {ex.Message}");
      dynamicRanges = null;
    }
    finally { loadingDynamic = false; }
  }

  private async Task SaveNetworkDiscoverySettings()
  {
    try
    {
      var ranges = networkRanges.Where(r => !string.IsNullOrWhiteSpace(r.Value)).Select(r => r.Value!).ToList();
      var ports = scanPorts.Where(p => p.Value > 0 && p.Value <= 65535).Select(p => p.Value).ToList();

      if (ranges.Count == 0)
      {
        toast.Error("At least one network range is required");
        return;
      }

      if (ports.Count == 0)
      {
        toast.Error("At least one port is required");
        return;
      }

      var settings = new NetworkDiscoverySettingsDto(ranges, discoveryTimeout, maxConcurrentScans, ports);
      var resp = await Http.PostAsJsonAsync("/api/network-discovery/settings", settings);
      
      if (resp.IsSuccessStatusCode) 
        toast.Success("Network discovery settings saved");
      else 
        toast.Error($"Save failed: {(int)resp.StatusCode}");
    }
    catch (Exception ex)
    {
      toast.Error($"Failed to save settings: {ex.Message}");
    }
  }

  private void ResetToDefaults()
  {
    networkRanges = new List<EditableString> 
    { 
      new() { Value = "192.168.1.0/24" },
      new() { Value = "192.168.0.0/24" },
      new() { Value = "10.0.0.0/24" },
      new()
    };
    scanPorts = new List<EditableInt> 
    { 
      new() { Value = 80 },
      new() { Value = 7125 },
      new()
    };
    discoveryTimeout = 3000;
    maxConcurrentScans = 20;
    dynamicRanges = null;
  }

  // Helper classes for editable collections
  public class EditableString
  {
    public string? Value { get; set; }
  }

  public class EditableInt
  {
    public int Value { get; set; }
  }
}
