
@page "/printers/new"
@using Farm.Web.Shared
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http
@inject NavigationManager Nav
@inject Farm.Web.Client.ToastService toast
@inject IJSRuntime JS

<h2>Add Printer</h2>

<EditForm Model="printer" OnValidSubmit="AddPrinter">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="form-group">
        <label>Name</label>
        <InputText class="form-control" @bind-value="printer.Name" />
    </div>
    <div class="form-group">
        <label>Backend</label>
        <InputSelect class="form-control" @bind-value="printer.Backend">
            <option value="@PrinterBackend.Moonraker">Moonraker</option>
            <option value="@PrinterBackend.PrusaLink">PrusaLink</option>
        </InputSelect>
    </div>
    <div class="form-group">
        <label>Base URL</label>
        <InputText class="form-control" @bind-value="printer.MoonrakerUrl" placeholder="http://printer:7125 or http://prusalink:80" />
    </div>
    @if (printer.Backend == PrinterBackend.PrusaLink)
    {
        <div class="form-group">
            <label>API Key</label>
            <InputText class="form-control" @bind-value="printer.ApiKey" />
        </div>
    }
    <div class="form-group">
        <label>Notes</label>
        <InputTextArea class="form-control" @bind-value="printer.Notes" />
    </div>
    <div class="form-group">
        <label>Date Acquired</label>
        <div class="row-inline" style="gap:.5rem; align-items:center;">
            <input type="date" class="form-control" @bind-value="printer.DateAcquired" @bind-value:format="yyyy-MM-dd" @ref="dateAcqAddRef" />
            <button type="button" class="btn" @onclick="(()=>OpenDatePicker(dateAcqAddRef))" title="Pick date">📅</button>
        </div>
    </div>
    <button class="btn btn-primary" type="submit">Add Printer</button>
    <a class="btn btn-secondary" href="/printers">Cancel</a>
</EditForm>

@code {
    private CreatePrinterDto printer = new();
    private ElementReference dateAcqAddRef;

    private async Task OpenDatePicker(ElementReference el)
    {
        await JS.InvokeVoidAsync("PF.openDatePicker", el);
    }

    private async Task AddPrinter()
    {
        var resp = await Http.PostAsJsonAsync("api/printers", printer);
        if (resp.IsSuccessStatusCode)
        {
            toast.Success("Printer added");
            Nav.NavigateTo("/printers");
        }
        else
        {
            toast.Error($"Failed: {(int)resp.StatusCode}");
        }
    }
}
