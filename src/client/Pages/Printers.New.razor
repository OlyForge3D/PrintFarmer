
@page "/printers/new"
@using Farm.Web.Shared
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http
@inject NavigationManager Nav
@inject Farm.Web.Client.ToastService toast
@inject IJSRuntime JS

<h2>Add Printer</h2>

<EditForm Model="printer" OnValidSubmit="AddPrinter" class="add-printer-form">
    <DataAnnotationsValidator />
    <ValidationSummary />
    
    <div class="form-label">Name</div>
    <div class="form-group">
        <InputText class="form-control" @bind-Value="printer.Name" />
        <div class="hint">Enter a descriptive name for your printer</div>
    </div>
    
    <div class="form-label">Manufacturer</div>
    <div class="form-group">
        <div class="input-with-button">
            <select class="form-control flex-input" @bind="selectedManufacturerId" @bind:after="OnManufacturerChanged">
                <option value="">— Select —</option>
                @foreach (var m in manufacturers)
                {
                    <option value="@m.Id">@m.Name</option>
                }
            </select>
            <button class="btn-standard" title="New Manufacturer" aria-label="New Manufacturer" @onclick="ToggleNewManufacturer" type="button">New</button>
        </div>
        @if (showNewManufacturer)
        {
            <div class="new-item-input">
                <input class="form-control" placeholder="New manufacturer name" @bind="newManufacturerName" />
            </div>
        }
        <div class="hint">Choose the printer manufacturer</div>
    </div>

    <div class="form-label">Model</div>
    <div class="form-group">
        <div class="input-with-button">
            <select class="form-control flex-input" @bind="selectedModelId" @bind:after="OnModelChanged">
                <option value="">— Select —</option>
                @foreach (var m in models)
                {
                    <option value="@m.Id">@m.Name</option>
                }
            </select>
            <button class="btn-standard" title="@((selectedManufacturerId is null) ? "Select a manufacturer first" : "New Model")" aria-label="New Model" @onclick="ToggleNewModel" type="button" disabled="@(selectedManufacturerId is null)">New</button>
        </div>
        @if (showNewModel && selectedManufacturerId is Guid)
        {
            <div class="new-item-input">
                <input class="form-control" placeholder="New model name" @bind="newModelName" />
            </div>
        }
        @if (selectedModelId is Guid midSel)
        {
            var md = models.FirstOrDefault(x => x.Id == midSel);
            if (md is not null)
            {
                <div class="hint">
                    Max: X @(@md.MaxX?.ToString() ?? "—"), Y @(@md.MaxY?.ToString() ?? "—"), Z @(@md.MaxZ?.ToString() ?? "—")
                    @if (md.DefaultBackend.HasValue)
                    {
                        <text>, Default Backend: @md.DefaultBackend</text>
                    }
                </div>
            }
        }
        else
        {
            <div class="hint">Choose or create the printer model</div>
        }
    </div>
    
    <div class="form-label">Backend</div>
    <div class="form-group">
        <InputSelect class="form-control" TValue="PrinterBackend" @bind-Value="printer.Backend">
            <option value="@PrinterBackend.Moonraker">Moonraker</option>
            <option value="@PrinterBackend.PrusaLink">PrusaLink</option>
            <option value="@PrinterBackend.SDCP">SDCP</option>
        </InputSelect>
        <div class="hint">Moonraker (Klipper), PrusaLink (Prusa), or SDCP (Elegoo Centauri Carbon)</div>
    </div>
    
    <div class="form-label">Base URL</div>
    <div class="form-group">
        <div class="input-with-button">
            <InputText class="form-control flex-input" @bind-Value="printer.ServerUrl" placeholder="http://printer-ip or hostname" />
            <button class="btn-standard" type="button" @onclick="ResolveHostname">Resolve</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(ipAddress))
        {
            <div class="hint">IP Address: @ipAddress</div>
        }
        else
        {
            <div class="hint">
                @if (printer.Backend == PrinterBackend.Moonraker)
                {
                    <text>Moonraker URL (default port 7125)</text>
                }
                else if (printer.Backend == PrinterBackend.PrusaLink)
                {
                    <text>PrusaLink URL (default port 80)</text>
                }
                else if (printer.Backend == PrinterBackend.SDCP)
                {
                    <text>SDCP printer URL (default port 80)</text>
                }
                else
                {
                    <text>Full URL including protocol and port</text>
                }
            </div>
        }
    </div>
    
    @if (printer.Backend == PrinterBackend.PrusaLink)
    {
        <div class="form-label">API Key</div>
        <div class="form-group">
            <InputText class="form-control" @bind-Value="printer.ApiKey" />
            <div class="hint">API key required for PrusaLink printers</div>
        </div>
    }
    
    <div class="form-label">Notes</div>
    <div class="form-group">
        <InputTextArea class="form-control" @bind-Value="printer.Notes" />
        <div class="hint">Optional notes about this printer</div>
    </div>
    
    <div class="form-label">Date Acquired</div>
    <div class="form-group">
        <div class="input-with-button">
            <input type="date" class="form-control flex-input" @bind-value="printer.DateAcquired" @bind-value:format="yyyy-MM-dd" @ref="dateAcqAddRef" />
            <button type="button" class="btn-standard" @onclick="(()=>OpenDatePicker(dateAcqAddRef))" title="Pick date">📅</button>
        </div>
        <div class="hint">When did you acquire this printer?</div>
    </div>
    
    <div class="form-actions">
        <a class="btn-cancel btn-action" href="/printers">Cancel</a>
        <button class="btn-submit btn-action" type="submit">Add Printer</button>
    </div>
</EditForm>

@code {
    private CreatePrinterDto printer = new();
    private string? ipAddress;
    private ElementReference dateAcqAddRef;
    private List<ManufacturerDto> manufacturers = new();
    private List<ModelDto> models = new();
    private Guid? selectedManufacturerId;
    private Guid? selectedModelId;
    private bool showNewManufacturer;
    private bool showNewModel;
    private string? newManufacturerName;
    private string? newModelName;

    private async Task OpenDatePicker(ElementReference el)
    {
        await JS.InvokeVoidAsync("PF.openDatePicker", el);
    }

    protected override async Task OnInitializedAsync()
    {
        // Load manufacturers for selection
        manufacturers = await Http.GetFromJsonAsync<List<ManufacturerDto>>("api/catalog/manufacturers") ?? new();
    }

    private async Task AddPrinter()
    {
        // Wire selected or new manufacturer/model into the DTO
        printer.ManufacturerId = selectedManufacturerId;
        printer.ModelId = selectedModelId;
        if (!string.IsNullOrWhiteSpace(newManufacturerName))
        {
            printer.NewManufacturerName = newManufacturerName!.Trim();
        }
        if (!string.IsNullOrWhiteSpace(newModelName))
        {
            printer.NewModelName = newModelName!.Trim();
        }

        var resp = await Http.PostAsJsonAsync("api/printers", printer);
        if (resp.IsSuccessStatusCode)
        {
            toast.Success("Printer added");
            Nav.NavigateTo("/printers");
        }
        else
        {
            toast.Error($"Failed: {(int)resp.StatusCode}");
        }
    }

    private async Task ResolveHostname()
    {
        if (string.IsNullOrWhiteSpace(printer.ServerUrl)) return;
        try
        {
            var req = new ResolveHostnameRequest(printer.ServerUrl, printer.Backend);
            var resp = await Http.PostAsJsonAsync("api/printers/resolve", req);
            if (resp.IsSuccessStatusCode)
            {
                var data = await resp.Content.ReadFromJsonAsync<ResolveHostnameResponse>();
                if (data is not null)
                {
                    // Update form with resolved info
                    printer.ServerUrl = data.ResolvedBaseUrl;
                    printer.OriginalServerUrl = data.NormalizedInputUrl;
                    ipAddress = data.ResolvedIp;
                    toast.Success("Resolved");
                }
            }
            else
            {
                toast.Error($"Resolve failed: {(int)resp.StatusCode}");
            }
        }
        catch { toast.Error("Resolve failed"); }
    }

    private async Task LoadModels()
    {
        if (selectedManufacturerId is Guid mid)
        {
            models = await Http.GetFromJsonAsync<List<ModelDto>>($"api/catalog/models?manufacturerId={mid}") ?? new();
        }
        else
        {
            models = new();
        }
        StateHasChanged();
    }

    private async Task OnManufacturerChanged()
    {
        // reset model when manufacturer changes
        selectedModelId = null;
        await LoadModels();
        if (selectedManufacturerId is null)
        {
            showNewModel = false;
        }
    }

    private void OnModelChanged()
    {
        // Auto-select the default backend when a model is selected
        if (selectedModelId is Guid modelId)
        {
            var selectedModel = models.FirstOrDefault(m => m.Id == modelId);
            if (selectedModel?.DefaultBackend is PrinterBackend defaultBackend)
            {
                printer.Backend = defaultBackend;
                StateHasChanged();
            }
        }
    }

    private void ToggleNewManufacturer() => showNewManufacturer = !showNewManufacturer;
    private void ToggleNewModel() => showNewModel = !showNewModel;
}
