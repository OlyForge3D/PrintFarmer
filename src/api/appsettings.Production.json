{
  "Email": {
    "Enabled": true,
    "Provider": "mailjet",
    "FromAddress": "noreply@yourdomain.com",
    "FromName": "PrintFarmer",
    "BaseUrl": "https://yourdomain.com",
    "Mailjet": {
      "ApiKey": "${MAILJET_API_KEY}",
      "ApiSecret": "${MAILJET_API_SECRET}",
      "Sandbox": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
