{
  "Security": {
    "DevModeBypassAuth": false
  },
  "NetworkDiscovery": {
    "EnableDiscovery": true,
    "DiscoverySubnets": [
      "10.0.0.0/24"
    ],
    "Ports": [
      80
    ],
    "ClientTimeoutMs": 200,
    "RequestDelayMs": 100,
    "MaxConcurrentRequests": 20,
    "MaxRetries": 2
  },
  "SystemLog": {
    "RetentionDays": 30,
    "EnableExport": true
  },
  "SignalR": {
    "LogLevel": "Information",
    "ConsoleLoggingEnabled": true
  },
  "Slicer": {
    "Enabled": true,
    "PerEngine": null,
    "JitterPercent": 15
  },
  "GcodeUpload": {
    "AllowedExtensions": [
      ".gcode"
    ],
    "DailyUploadLimitBytes": 2147483648
  },
  "GcodeHarvest": {
    "MaxConcurrentImports": 2,
    "ImportTimeoutSeconds": 300
  },
  "HarvestQueue": {
    "Type": "memory",
    "Redis": {
      "Connection": "localhost:6379",
      "InstanceName": "pfarm:"
    }
  },
  "ModelStorage": {
    "Path": "models"
  },
  "ThumbnailGeneration": {
    "ThumbnailsPath": "models"
  },
    "ArtifactStorage": {
      "RootPath": "artifacts",
      "MaxFileSizeBytes": 104857600,
      "AllowedKinds": "gcode,thumbnail,preview,log",
      "EnableStaticServing": false,
      "StorageWarningThresholdBytes": 5368709120,
      "StorageCriticalThresholdBytes": 10737418240,
      "EnableStorageAlerts": true,
      "MaxAgeDays": 90,
      "MaxTotalBytes": 10737418240,
      "EnableCleanupDryRun": true,
      "CleanupIntervalHours": 24
    },
  "FilamentPresets": {
    "Presets": {}
  },
  "Email": {
    "Enabled": true,
    "Provider": "console",
    "FromAddress": "noreply@printfarmer.local",
    "FromName": "PrintFarmer",
    "BaseUrl": "http://localhost:3000",
    "Mailjet": {
      "ApiKey": "${MAILJET_API_KEY}",
      "ApiSecret": "${MAILJET_API_SECRET}",
      "Sandbox": true
    }
  },
  "RateLimiting": {
    "PasswordReset": {
      "MaxAttemptsPerHour": 3,
      "MaxAttemptsPerDay": 10
    },
    "EmailConfirmation": {
      "MaxAttemptsPerHour": 5,
      "MaxAttemptsPerDay": 20
    },
    "SliceJobs": {
      "MaxAttemptsPerHour": 20,
      "MaxAttemptsPerDay": 200
    }
  },
  "JobDispatchRetry": {
    "MaxAttempts": 3,
    "BaseDelayMs": 250,
    "Multiplier": 2.0
  },
  "CircuitBreaker": {
    "FailureThreshold": 3,
    "WindowSeconds": 300,
    "CooldownSeconds": 60,
    "SuccessThresholdToClose": 2
  },
  "StaleWorkerCleanup": {
    "Enabled": true,
    "IntervalSeconds": 3600,
    "StaleAfterMinutes": 1440,
    "AutoDelete": false
  },
  "PrintStatisticsSync": {
    "Enabled": true,
    "IntervalSeconds": 300,
    "IncludePrintFarmerJobs": true,
    "MaxPrintersPerIteration": 10,
    "ApiTimeoutSeconds": 10
  },
  "MaintenanceAlerts": {
    "Enabled": true,
    "IntervalSeconds": 300,
    "MaxPrintersPerIteration": 20,
    "ThresholdPercentage": 90.0,
    "AutoDismissOnMaintenance": false,
    "EnableSignalRNotifications": true
  },
  "AccountLockout": {
    "MaxFailedAttempts": 5,
    "LockoutDurationMinutes": 15,
    "AttemptWindowMinutes": 15
  }
  ,
  "OctoPrint": {
    "RequireApiKey": false,
    "HashStoredApiKeys": true,
    "RateLimitPerMinute": 60,
    "MaxUploadSizeMb": 50
  },
  "BackendTimeouts": {
    "StatusPollTimeoutSeconds": 10,
    "CommandTimeoutSeconds": 30,
    "PrintControlTimeoutSeconds": 60,
    "FileUploadTimeoutSeconds": 300,
    "FileDownloadTimeoutSeconds": 900
  },
  "SeedData": {
    "Path": "data/seed"
  }
}