{
  "NetworkDiscovery": {
    "EnableDiscovery": true,
    "DiscoverySubnets": [
      "10.0.0.0/24"
    ],
    "Ports": [
      80
    ],
    "ClientTimeoutMs": 200,
    "RequestDelayMs": 100,
    "MaxConcurrentRequests": 20,
    "MaxRetries": 2
  },
  "SystemLog": {
    "RetentionDays": 30,
    "EnableExport": true
  },
  "SignalR": {
    "LogLevel": "Information",
    "ConsoleLoggingEnabled": true
  },
  "Slicer": {
    "Enabled": true,
    "PerEngine": null,
    "JitterPercent": 15
  },
  "GcodeUpload": {
    "AllowedExtensions": [
      ".gcode",
      ".bgcode"
    ],
    "DailyUploadLimitBytes": 2147483648
  },
  "FilamentPresets": {
    "Presets": {}
  }
  ,
  "Email": {
    "Enabled": true,
    "Provider": "console",
    "FromAddress": "noreply@printfarmer.local",
    "FromName": "PrintFarmer",
    "BaseUrl": "http://localhost:3000",
    "Mailjet": {
      "ApiKey": "${MAILJET_API_KEY}",
      "ApiSecret": "${MAILJET_API_SECRET}",
      "Sandbox": true
    }
  },
  "RateLimiting": {
    "PasswordReset": {
      "MaxAttemptsPerHour": 3,
      "MaxAttemptsPerDay": 10
    },
    "EmailConfirmation": {
      "MaxAttemptsPerHour": 5,
      "MaxAttemptsPerDay": 20
      },
      "SliceJobs": {
        "MaxAttemptsPerHour": 20,
        "MaxAttemptsPerDay": 200
    }
    },
    "JobDispatchRetry": {
      "MaxAttempts": 3,
      "BaseDelayMs": 250,
      "Multiplier": 2.0
  }
}