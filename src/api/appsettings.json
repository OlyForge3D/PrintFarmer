{
  "NetworkDiscovery": {
    "EnableDiscovery": true,
    "DiscoverySubnets": [
      "10.0.0.0/24"
    ],
    "Ports": [
      80
    ],
    "ClientTimeoutMs": 200,
    "RequestDelayMs": 100,
    "MaxConcurrentRequests": 20,
    "MaxRetries": 2
  },
  "SystemLog": {
    "RetentionDays": 30,
    "EnableExport": true
  },
  "SignalR": {
    "LogLevel": "Information",
    "ConsoleLoggingEnabled": true
  },
  "Slicer": {
    "Enabled": true,
    "PerEngine": null,
    "JitterPercent": 15
  },
  "GcodeUpload": {
    "AllowedExtensions": [
      ".gcode",
      ".bgcode"
    ],
    "DailyUploadLimitBytes": 2147483648
  },
  "FilamentPresets": {
    "Presets": {}
  }
}