<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;S6960</NoWarn>
  </PropertyGroup>

  <ItemGroup>
  <ProjectReference Include="../infra/Farm.Infrastructure.csproj" />
    <ProjectReference Include="../discovery/Farm.Shared.Discovery.csproj" />
    <ProjectReference Include="../backends/Farm.Backend.Plugin.Core/Farm.Backend.Plugin.Core.csproj" />
    <!-- Plugin implementations - runtime-loaded, not compile-time referenced -->
    <ProjectReference Include="../backends/Farm.Backend.Plugin.Moonraker/Farm.Backend.Plugin.Moonraker.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="../backends/Farm.Backend.Plugin.PrusaLink/Farm.Backend.Plugin.PrusaLink.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="../backends/Farm.Backend.Plugin.Sdcp/Farm.Backend.Plugin.Sdcp.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="../backends/Farm.Backend.Plugin.OctoPrint/Farm.Backend.Plugin.OctoPrint.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.8" />
    <!-- TODO: Re-add OpenAPI packages after .NET 10 migration rewrite -->
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.1" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.3" />
    <!-- Database Providers: SQLite, PostgreSQL, SQL Server -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.3" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Refit.HttpClientFactory" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.SpaServices.Extensions" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
    <PackageReference Include="StackExchange.Redis" Version="2.10.1" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.80.0" />
    <PackageReference Include="Grpc.Tools" Version="2.81.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="OpenTelemetry" Version="1.15.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.15.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.14.0-beta.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.14.0-beta.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.15.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Slicer domain types (Models, Domain, Data namespaces) needed by FileManagement, Model3D,
         and Swagger helpers. No SignalR hubs, no OrcaSlicer, no slicer EF migrations. -->
    <ProjectReference Include="..\slicer\Farm.Slicer.Module\Farm.Slicer.Module.csproj" />
    <!-- Slicer integration shim: discovers ISlicerModule/ISlicerHubRegistrar implementations from
         DLLs in Slicer:PluginsPath at startup (Farm.Slicer.Module.Api, OrcaSlicer, etc.). -->
    <ProjectReference Include="..\slicer\Farm.Slicer.Integration\Farm.Slicer.Integration.csproj" />
    <ProjectReference Include="..\migrations\Farm.Migrations.PostgreSQL\Farm.Migrations.PostgreSQL.csproj" />
    <ProjectReference Include="..\migrations\Farm.Migrations.SqlServer\Farm.Migrations.SqlServer.csproj" />
    <ProjectReference Include=".\..\backends\Farm.Backend.Plugin.FlashForge\Farm.Backend.Plugin.FlashForge.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>    <!-- Slicer plugin projects: build before the API project but do not link their assemblies
         directly — they are loaded at runtime from the plugins/slicer directory. -->
    <ProjectReference Include="..\slicer\Farm.Slicer.Module.Api\Farm.Slicer.Module.Api.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\Slicers\Farm.Slicers.OrcaSlicer.v2_3_1\Farm.Slicers.OrcaSlicer.v2_3_1.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\migrations\Farm.Slicer.Migrations.PostgreSQL\Farm.Slicer.Migrations.PostgreSQL.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\migrations\Farm.Slicer.Migrations.SqlServer\Farm.Slicer.Migrations.SqlServer.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>  </ItemGroup>


  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <None Include="Tests\**\*.cs" />
  </ItemGroup>

  <!-- Exclude appsettings.Development.json from Release builds (Docker) -->
  <!-- This file has relative paths that only work for local development outside containers -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Content Remove="appsettings.Development.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include native Lib3MF libraries for runtime loading -->
    <None Include="runtimes/linux-x64/native/lib3mf.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Include seed data YAML files in build output -->
    <None Include="Data/seed/**/*.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Data/seed/**/*.yml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Data/seed/**/*.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Protobuf files: slicer_jobs.proto is compiled offline to avoid protoc ARM64 segfault -->
    <!-- Pre-generated stubs are in GeneratedProtos/ directory -->
  </ItemGroup>

  <!-- Copy backend plugin DLLs (runtime-loaded, not compile-time referenced)
       into $(OutputPath)plugins/backends/ so they are available at runtime. -->
  <Target Name="CopyBackendPlugins" AfterTargets="Build">
    <PropertyGroup>
      <_BackendPluginsOutputDir>$(OutputPath)plugins/backends/</_BackendPluginsOutputDir>
    </PropertyGroup>
    <MakeDir Directories="$(_BackendPluginsOutputDir)" />
    <ItemGroup>
      <_BackendPluginDll Include="$(MSBuildThisFileDirectory)..\backends\Farm.Backend.Plugin.Moonraker\bin\$(Configuration)\$(TargetFramework)\*.dll" />
      <_BackendPluginDll Include="$(MSBuildThisFileDirectory)..\backends\Farm.Backend.Plugin.PrusaLink\bin\$(Configuration)\$(TargetFramework)\*.dll" />
      <_BackendPluginDll Include="$(MSBuildThisFileDirectory)..\backends\Farm.Backend.Plugin.OctoPrint\bin\$(Configuration)\$(TargetFramework)\*.dll" />
      <_BackendPluginDll Include="$(MSBuildThisFileDirectory)..\backends\Farm.Backend.Plugin.Sdcp\bin\$(Configuration)\$(TargetFramework)\*.dll" />
      <_BackendPluginDll Include="$(MSBuildThisFileDirectory)..\backends\Farm.Backend.Plugin.FlashForge\bin\$(Configuration)\$(TargetFramework)\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_BackendPluginDll)" DestinationFolder="$(_BackendPluginsOutputDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Copy slicer plugin DLLs into the build output so they are available at runtime. -->
  <Target Name="CopySlicerPlugins" AfterTargets="Build">
    <PropertyGroup>
      <_SlicerPluginsOutputDir>$(OutputPath)plugins/slicer/</_SlicerPluginsOutputDir>
    </PropertyGroup>
    <MakeDir Directories="$(_SlicerPluginsOutputDir)" />
    <ItemGroup>
      <_SlicerPluginDll Include="$(MSBuildThisFileDirectory)..\slicer\Farm.Slicer.Module.Api\bin\$(Configuration)\$(TargetFramework)\*.dll" />
      <_SlicerPluginDll Include="$(MSBuildThisFileDirectory)..\Slicers\Farm.Slicers.OrcaSlicer.v2_3_1\bin\$(Configuration)\$(TargetFramework)\*.dll" />
      <_SlicerPluginDll Include="$(MSBuildThisFileDirectory)..\migrations\Farm.Slicer.Migrations.PostgreSQL\bin\$(Configuration)\$(TargetFramework)\*.dll" />
      <_SlicerPluginDll Include="$(MSBuildThisFileDirectory)..\migrations\Farm.Slicer.Migrations.SqlServer\bin\$(Configuration)\$(TargetFramework)\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_SlicerPluginDll)" DestinationFolder="$(_SlicerPluginsOutputDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
