<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Farm.Tools.AdminCli</RootNamespace>
    <!-- Avoid generating native apphost during build which can cause copy errors on some hosts -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../discovery/Farm.Shared.Discovery.csproj" />
    <ProjectReference Include="../../shared/Farm.Web.Shared.csproj" />
  </ItemGroup>
</Project>
