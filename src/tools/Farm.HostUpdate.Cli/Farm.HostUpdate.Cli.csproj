<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Farm.HostUpdate.Cli</RootNamespace>
    <AssemblyName>Farm.HostUpdate.Cli</AssemblyName>
    <!-- Framework-dependent for source checkouts (`dotnet Farm.HostUpdate.Cli.dll`). The installable
         package (scripts/package-host-update-cli.sh) overrides this with a self-contained apphost publish. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../infra/Farm.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Farm.HostUpdate.Cli.Tests" />
  </ItemGroup>
</Project>
