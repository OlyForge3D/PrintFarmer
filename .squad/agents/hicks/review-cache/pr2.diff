diff --git a/PrintFarmer/Services/PrinterService.swift b/PrintFarmer/Services/PrinterService.swift
index c848fda53..d4511444c 100644
--- a/PrintFarmer/Services/PrinterService.swift
+++ b/PrintFarmer/Services/PrinterService.swift
@@ -99,4 +99,17 @@ actor PrinterService: PrinterServiceProtocol {
     func changeFilament(printerId: UUID) async throws -> CommandResult {
         try await apiClient.post("/api/printers/\(printerId)/filament-change")
     }
+
+    func getBackendCapabilities(printerId: UUID) async throws -> PrinterBackendCapabilities {
+        do {
+            return try await apiClient.get("/api/printers/\(printerId)/backend-capabilities")
+        } catch NetworkError.notFound {
+            // Endpoint not available for this printer — use fallback table
+            let printer = try await get(id: printerId)
+            return PrinterBackendCapabilities.fallback(for: printer.backend, printerId: printerId, printerName: printer.name)
+        } catch is DecodingError {
+            let printer = try await get(id: printerId)
+            return PrinterBackendCapabilities.fallback(for: printer.backend, printerId: printerId, printerName: printer.name)
+        }
+    }
 }
