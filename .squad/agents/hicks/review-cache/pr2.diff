diff --git a/PrintFarmer/Models/PrinterBackendCapabilities.swift b/PrintFarmer/Models/PrinterBackendCapabilities.swift
new file mode 100644
index 000000000..31d40ec60
--- /dev/null
+++ b/PrintFarmer/Models/PrinterBackendCapabilities.swift
@@ -0,0 +1,167 @@
+import Foundation
+
+// MARK: - PrinterBackendCapabilities
+
+/// Backend capabilities for a specific printer, decoded from
+/// `GET /api/printers/{id}/backend-capabilities`.
+///
+/// Fields map directly to the server's `PrinterBackendCapabilitiesDto`.
+/// `supportsBedTemperature` and `supportsFanControl` are derived from
+/// the broader server fields per the locked Mobile Controls v1 decision.
+struct PrinterBackendCapabilities: Codable, Sendable, Equatable {
+    let printerId: UUID
+    let printerName: String
+    let backend: PrinterBackend
+
+    // Core capabilities decoded from server
+    let supportsMovement: Bool
+    let supportsTemperatureControl: Bool
+    let supportsControlOperations: Bool
+    let supportsCamera: Bool
+    let supportsFileList: Bool
+    let supportsFileUpload: Bool
+    let supportsFileDownload: Bool
+    let supportsStartPrint: Bool
+    let supportsFileMetadata: Bool
+    let supportsPrinterInformation: Bool
+    let supportsHistory: Bool
+    let supportsFilamentControl: Bool
+
+    // MARK: - Codable
+
+    private enum CodingKeys: String, CodingKey {
+        case printerId, printerName, backend
+        case supportsMovement, supportsTemperatureControl, supportsControlOperations
+        case supportsCamera, supportsFileList, supportsFileUpload, supportsFileDownload
+        case supportsStartPrint, supportsFileMetadata, supportsPrinterInformation
+        case supportsHistory, supportsFilamentControl
+    }
+
+    /// Safe-by-default decoder: `printerId`, `printerName`, and `backend` are required
+    /// (missing → throws). All capability booleans default to `false` when omitted so
+    /// a partial server payload never throws — unknown or future keys are simply off.
+    init(from decoder: Decoder) throws {
+        let c = try decoder.container(keyedBy: CodingKeys.self)
+        printerId                = try c.decode(UUID.self,           forKey: .printerId)
+        printerName              = try c.decode(String.self,         forKey: .printerName)
+        backend                  = try c.decode(PrinterBackend.self, forKey: .backend)
+        supportsMovement         = try c.decodeIfPresent(Bool.self, forKey: .supportsMovement)         ?? false
+        supportsTemperatureControl = try c.decodeIfPresent(Bool.self, forKey: .supportsTemperatureControl) ?? false
+        supportsControlOperations = try c.decodeIfPresent(Bool.self, forKey: .supportsControlOperations) ?? false
+        supportsCamera           = try c.decodeIfPresent(Bool.self, forKey: .supportsCamera)           ?? false
+        supportsFileList         = try c.decodeIfPresent(Bool.self, forKey: .supportsFileList)         ?? false
+        supportsFileUpload       = try c.decodeIfPresent(Bool.self, forKey: .supportsFileUpload)       ?? false
+        supportsFileDownload     = try c.decodeIfPresent(Bool.self, forKey: .supportsFileDownload)     ?? false
+        supportsStartPrint       = try c.decodeIfPresent(Bool.self, forKey: .supportsStartPrint)       ?? false
+        supportsFileMetadata     = try c.decodeIfPresent(Bool.self, forKey: .supportsFileMetadata)     ?? false
+        supportsPrinterInformation = try c.decodeIfPresent(Bool.self, forKey: .supportsPrinterInformation) ?? false
+        supportsHistory          = try c.decodeIfPresent(Bool.self, forKey: .supportsHistory)          ?? false
+        supportsFilamentControl  = try c.decodeIfPresent(Bool.self, forKey: .supportsFilamentControl)  ?? false
+    }
+
+    // MARK: Derived
+
+    /// True when the backend supports bed temperature control.
+    /// Per locked decision (Mobile Controls v1): trust `supportsTemperatureControl`
+    /// for FlashForge and all FFF backends — no separate spike required.
+    var supportsBedTemperature: Bool { supportsTemperatureControl }
+
+    /// True when the backend supports fan speed control.
+    /// Fan control is a subset of general control operations.
+    var supportsFanControl: Bool { supportsControlOperations }
+
+    // MARK: - Static Fallback Table
+
+    /// Returns a conservative best-effort capabilities value for **total-failure
+    /// scenarios** — 404 responses, network errors, or structurally malformed JSON
+    /// (e.g. wrong root type).
+    ///
+    /// **Contract after safe-by-default decoder:**
+    /// A well-formed server response with any keys missing will no longer throw;
+    /// omitted capability keys decode to `false` automatically. This fallback is
+    /// therefore only reached when the API is completely unreachable or returns a
+    /// non-decodable payload. It must *not* be used to infer capabilities from a
+    /// real (partial) server response.
+    ///
+    /// SDCP (resin) has no movement; all FFF backends support movement and temperature.
+    static func fallback(for backend: PrinterBackend, printerId: UUID = UUID(), printerName: String = "") -> PrinterBackendCapabilities {
+        switch backend {
+        case .sdcp:
+            // Resin printers: no movement, no temperature control (resin-specific)
+            return PrinterBackendCapabilities(
+                printerId: printerId,
+                printerName: printerName,
+                backend: backend,
+                supportsMovement: false,
+                supportsTemperatureControl: false,
+                supportsControlOperations: false,
+                supportsCamera: false,
+                supportsFileList: true,
+                supportsFileUpload: true,
+                supportsFileDownload: false,
+                supportsStartPrint: true,
+                supportsFileMetadata: false,
+                supportsPrinterInformation: true,
+                supportsHistory: false,
+                supportsFilamentControl: false
+            )
+        case .moonraker, .prusaLink, .octoPrint:
+            // Full FFF: movement, temperature, control operations all supported
+            return PrinterBackendCapabilities(
+                printerId: printerId,
+                printerName: printerName,
+                backend: backend,
+                supportsMovement: true,
+                supportsTemperatureControl: true,
+                supportsControlOperations: true,
+                supportsCamera: backend == .moonraker,
+                supportsFileList: true,
+                supportsFileUpload: true,
+                supportsFileDownload: true,
+                supportsStartPrint: true,
+                supportsFileMetadata: true,
+                supportsPrinterInformation: true,
+                supportsHistory: backend == .moonraker,
+                supportsFilamentControl: true
+            )
+        case .flashForge:
+            // FFF: movement and temperature supported; fan/camera limited
+            return PrinterBackendCapabilities(
+                printerId: printerId,
+                printerName: printerName,
+                backend: backend,
+                supportsMovement: true,
+                supportsTemperatureControl: true,
+                supportsControlOperations: false,
+                supportsCamera: false,
+                supportsFileList: true,
+                supportsFileUpload: true,
+                supportsFileDownload: false,
+                supportsStartPrint: true,
+                supportsFileMetadata: false,
+                supportsPrinterInformation: true,
+                supportsHistory: false,
+                supportsFilamentControl: false
+            )
+        case .unknown:
+            // Conservative: assume no special capabilities
+            return PrinterBackendCapabilities(
+                printerId: printerId,
+                printerName: printerName,
+                backend: backend,
+                supportsMovement: false,
+                supportsTemperatureControl: false,
+                supportsControlOperations: false,
+                supportsCamera: false,
+                supportsFileList: false,
+                supportsFileUpload: false,
+                supportsFileDownload: false,
+                supportsStartPrint: false,
+                supportsFileMetadata: false,
+                supportsPrinterInformation: false,
+                supportsHistory: false,
+                supportsFilamentControl: false
+            )
+        }
+    }
+}
