+      reason: 'Printer is not printing.',
+      isPrinting: false, // stale — DTO hasn't polled yet since print started
+      detectionSource: 'global',
+      lastOutcome: 'none',
+      lastAnalyzedAt: null,
+    };
+
+    render(
