{
  "name": "PrintFarmer (React + .NET 9, SQLite default)",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:20-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "9.0.302",
      "installUsingApt": false
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": true,
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/git:1": {
      "ppa": false
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        // .NET Extensions
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.vscode-dotnet-runtime",
        // React/TypeScript Extensions
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "ms-vscode.vscode-typescript-next",
        "formulahendry.auto-rename-tag",
        "christian-kohler.path-intellisense",
        // React/JSX Extensions
        "ms-vscode.vscode-json",
        "ms-playwright.playwright",
        "ms-vscode.vscode-node-azure-pack",
        // Database Extensions
        "ms-ossdata.vscode-postgresql",
        "cweijan.vscode-redis-client",
        // Development Tools
        "ms-vscode.extension-test-runner",
        "ms-vscode.vscode-jest",
        "eamodio.gitlens",
        "editorconfig.editorconfig",
        "ms-vscode.vscode-yaml",
        // Testing Tools
        "ZixuanChen.vitest-explorer",
        // Docker Extensions
        "ms-azuretools.vscode-docker",
        "ms-vscode-remote.remote-containers"
      ],
      "settings": {
        // .NET Settings
        "dotnet.defaultSolution": "src/farm-web.sln",
        "dotnetAcquisitionExtension.enableTelemetry": false,
        // TypeScript/React Settings
        "typescript.updateImportsOnFileMove.enabled": "always",
        "typescript.preferences.importModuleSpecifier": "relative",
        "emmet.includeLanguages": {
          "typescript": "html",
          "typescriptreact": "html"
        },
        // Formatting Settings  
        "[typescript]": {
          "editor.defaultFormatter": "vscode.typescript-language-features"
        },
        "[typescriptreact]": {
          "editor.defaultFormatter": "vscode.typescript-language-features"
        },
        "[json]": {
          "editor.defaultFormatter": "vscode.json-language-features"
        },
        "[jsonc]": {
          "editor.defaultFormatter": "vscode.json-language-features"
        },
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit",
          "source.organizeImports": "explicit"
        },
        // File Associations
        "files.associations": {
          "*.json": "jsonc"
        },
        // Terminal Settings
        "terminal.integrated.defaultProfile.linux": "bash",
        // Tailwind CSS Settings
        "tailwindCSS.includeLanguages": {
          "typescript": "javascript",
          "typescriptreact": "html"
        },
        "tailwindCSS.experimental.classRegex": [
          [
            "clsx\\(([^)]*)\\)",
            "(?:'|\"|`)([^']*)(?:'|\"|`)"
          ]
        ]
      }
    }
  },
  "containerEnv": {
    "ASPNETCORE_ENVIRONMENT": "Development",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    // Used by vite build/preview (not needed for vite dev due to proxy)
  "VITE_API_BASE_URL": "http://localhost:5245",
  "VITE_SIGNALR_PRINTERS_URL": "http://localhost:5245/hubs/printers",
  "VITE_SIGNALR_HARVEST_URL": "http://localhost:5245/hubs/harvest"
  },
  "remoteUser": "node",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [
    5245,
    3000,
    5432,
    6379,
    8080
  ],
  "portsAttributes": {
    "5245": {
      "label": "PrintFarmer API (Dev)",
      "requireLocalPort": false
    },
    "3000": {
      "label": "Vite Dev Server (React)",
      "requireLocalPort": false
    },
    "5432": {
      "label": "PostgreSQL",
      "requireLocalPort": false
    },
    "6379": {
      "label": "Redis",
      "requireLocalPort": false
    },
    "8080": {
      "label": "Nginx/Proxy or App",
      "requireLocalPort": false
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "notify"
  },
  "mounts": [
    "source=printfarmer-node-modules,target=${containerWorkspaceFolder}/src/Web/ReactApp/node_modules,type=volume"
  ],
  "shutdownAction": "stopContainer"
}