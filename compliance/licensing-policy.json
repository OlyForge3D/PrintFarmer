      "notContains": [
        "--clobber"
      ]
    },
    {
      "path": ".github/workflows/release.yml",
      "contains": [
        "bash scripts/sync-monorepo-version.sh --check",
        "--branch \"$VERSION\"",
        "IMAGES=(api frontend printer-discovery orcaslicer-worker monolith)",
        "cosign verify-attestation",
        "Finalize GitHub Release"
