# syntax=docker/dockerfile:1
# Web (client) container for ForgeIQ - Static Blazor WASM hosted by Nginx

FROM node:20-alpine AS tools
RUN apk add --no-cache bash

FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
# Prereqs for Emscripten toolchain used by wasm-tools (needs python on PATH)
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 \
 && ln -s /usr/bin/python3 /usr/local/bin/python \
 && rm -rf /var/lib/apt/lists/*
COPY src/farm-web.sln ./
COPY src/client/ ./client/
COPY src/shared/ ./shared/

# Restore client and shared
RUN dotnet restore ./client/Farm.Web.Client.csproj

WORKDIR /src/client
RUN dotnet workload install wasm-tools \
 && dotnet publish Farm.Web.Client.csproj -c Release -o /out --no-restore

FROM nginx:1.27-alpine AS final
WORKDIR /usr/share/nginx/html
COPY --from=build /out/wwwroot .
# Nginx config for HTTP and HTTPS
COPY deploy/nginx/nginx.conf /etc/nginx/conf.d/default.conf

# Self-signed certificate generation for development if none provided
RUN apk add --no-cache openssl jq && \
		mkdir -p /etc/nginx/certs && \
		if [ ! -f /etc/nginx/certs/tls.crt ] || [ ! -f /etc/nginx/certs/tls.key ]; then \
			openssl req -x509 -nodes -days 3650 -subj "/CN=localhost" -newkey rsa:2048 \
				-keyout /etc/nginx/certs/tls.key -out /etc/nginx/certs/tls.crt; \
		fi

# Create entrypoint script to handle environment variable substitution
RUN echo '#!/bin/sh' > /docker-entrypoint.sh && \
    echo 'set -e' >> /docker-entrypoint.sh && \
    echo 'if [ -n "$API_BASE_URL" ]; then' >> /docker-entrypoint.sh && \
    echo '  echo "Setting ApiBaseUrl to: $API_BASE_URL"' >> /docker-entrypoint.sh && \
    echo '  jq --arg url "$API_BASE_URL" '"'"'.ApiBaseUrl = $url'"'"' /usr/share/nginx/html/appsettings.json > /tmp/appsettings.json.tmp' >> /docker-entrypoint.sh && \
    echo '  mv /tmp/appsettings.json.tmp /usr/share/nginx/html/appsettings.json' >> /docker-entrypoint.sh && \
    echo '  if [ -f /usr/share/nginx/html/appsettings.Development.json ]; then' >> /docker-entrypoint.sh && \
    echo '    jq --arg url "$API_BASE_URL" '"'"'.ApiBaseUrl = $url'"'"' /usr/share/nginx/html/appsettings.Development.json > /tmp/appsettings.Development.json.tmp' >> /docker-entrypoint.sh && \
    echo '    mv /tmp/appsettings.Development.json.tmp /usr/share/nginx/html/appsettings.Development.json' >> /docker-entrypoint.sh && \
    echo '  fi' >> /docker-entrypoint.sh && \
    echo 'fi' >> /docker-entrypoint.sh && \
    echo 'exec nginx -g "daemon off;"' >> /docker-entrypoint.sh && \
    chmod +x /docker-entrypoint.sh

EXPOSE 8080 8443
ENTRYPOINT ["/docker-entrypoint.sh"]
