# syntax=docker/dockerfile:1
# Web (client) container for ForgeIQ - Static Blazor WASM hosted by Nginx

FROM node:20-alpine AS tools
RUN apk add --no-cache bash

FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
COPY src/farm-web.sln ./
COPY src/client/ ./client/
COPY src/shared/ ./shared/

# Restore client and shared
RUN dotnet restore ./client/Farm.Web.Client.csproj

WORKDIR /src/client
RUN dotnet publish Farm.Web.Client.csproj -c Release -o /out --no-restore

FROM nginx:1.27-alpine AS final
WORKDIR /usr/share/nginx/html
COPY --from=build /out/wwwroot .
COPY deploy/nginx/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
