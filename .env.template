# PrintFarmer Environment Configuration
# Copy this file to .env and update the values for your deployment

# Database Configuration
DB_PASSWORD=PrintFarm123!
POSTGRES_PASSWORD=PrintFarm123!

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-for-security
JWT_ISSUER=PrintFarmer
JWT_AUDIENCE=PrintFarmerClient

# Application Settings
ASPNETCORE_ENVIRONMENT=Production
UPLOAD_MAX_SIZE=100MB
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: External URLs for remote deployment
# EXTERNAL_URL=https://printfarmer.yourdomain.com
# API_BASE_URL=https://api.printfarmer.yourdomain.com

# Optional: Email Configuration (for user registration)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@printfarmer.com

# Optional: Cloud Storage (for file uploads)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=printfarmer-files