# PrintFarmer Environment Configuration Template
# Copy this to .env.monolithic or .env.microservices and customize

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Deployment architecture (monolithic or microservices)
DEPLOYMENT_TYPE=monolithic

# Application environment (Development or Production)
ASPNETCORE_ENVIRONMENT=Production

# Internal application URLs (do not change unless you know what you're doing)
ASPNETCORE_URLS=http://0.0.0.0:8080

# =============================================================================
# EXTERNAL ACCESS CONFIGURATION
# =============================================================================

# Port for web interface access
HTTP_PORT=8080

# Port for direct API access (microservices only)
API_PORT=5245

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database provider: sqlite, postgres, sqlserver, mysql
DB_PROVIDER=sqlite

# Database connection strings (uncomment and configure based on your provider)

# SQLite (default - simple file-based database)
ConnectionStrings__Default=Data Source=/data/farm.db

# PostgreSQL (recommended for production)
# ConnectionStrings__Postgres=Host=postgres;Database=printfarmer;Username=postgres;Password=your-password

# SQL Server (enterprise features)
# ConnectionStrings__SqlServer=Server=sqlserver;Database=printfarmer;User Id=sa;Password=YourStrong!Password123;TrustServerCertificate=True;

# MySQL (popular open-source)  
# ConnectionStrings__MySql=Server=mysql;Database=printfarmer;User=root;Password=your-password;

# =============================================================================
# NETWORK DISCOVERY CONFIGURATION
# =============================================================================

# Enable network discovery of printers
ALLOW_LOCAL_NETWORK=true

# IP address ranges to scan for printers (comma-separated CIDR notation)
# Common ranges:
#   192.168.0.0/16 = Home networks (192.168.x.x)
#   10.0.0.0/8     = Corporate networks (10.x.x.x)  
#   172.16.0.0/12  = Docker networks (172.16.x.x - 172.31.x.x)
ALLOWED_NETWORK_RANGES=192.168.0.0/16,10.0.0.0/8

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Allowed origins for CORS (comma-separated URLs)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:5000

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable Swagger API documentation (Development only)
ENABLE_SWAGGER=false

# Enable detailed logging (increases log verbosity)
ENABLE_DETAILED_LOGGING=false

# =============================================================================
# MICROSERVICES-SPECIFIC CONFIGURATION
# =============================================================================

# Redis connection for SignalR backplane (microservices only)
REDIS_CONNECTION=redis:6379

# =============================================================================
# DATABASE SERVICE CONFIGURATION (for included database containers)
# =============================================================================

# PostgreSQL configuration
POSTGRES_DB=printfarmer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# SQL Server configuration
MSSQL_SA_PASSWORD=YourStrong!Password123
ACCEPT_EULA=Y

# MySQL configuration
MYSQL_ROOT_PASSWORD=example
MYSQL_DATABASE=printfarmer