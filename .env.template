# PrintFarmer Environment Configuration Template
# Copy this file to .env and configure for your environment
#
# This template is used by the devcontainer post-create script
# and local development setup.

# Database Configuration
# Supported: sqlite, postgresql, mysql, sqlserver
DB_PROVIDER=sqlite

# API Configuration
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5245

# Admin User (used during initial setup)
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=your-secure-password

# External Storage Paths (bind mounts)
# MODELS_PATH=~/.printfarmer/models
# GCODE_PATH=~/.printfarmer/gcode
# PROFILES_PATH=~/.printfarmer/slicer-profiles
# APPDATA_PATH=~/.printfarmer/appdata
# DATABASE_PATH=~/.printfarmer/database
# PFARM__Calibration__BlobStorage__RootPath=~/.printfarmer/calibration-blobs

# Spoolman Integration (optional)
# Option 1: Deploy Spoolman as a container alongside PrintFarmer
# DEPLOY_SPOOLMAN_CONTAINER=yes
# SPOOLMAN_IMAGE=ghcr.io/olyforge3d/spoolman:latest
# SPOOLMAN_PORT=7912
# EXTERNAL_SPOOLMAN_PATH=~/.printfarmer/spoolman-data
#
# Option 2: Use an existing Spoolman instance
# SPOOLMAN_URL=http://your-spoolman-host:7912

# Distributed Slicing (optional)
# ENABLE_DISTRIBUTED_SLICING=false
# ORCASLICER_WORKER_URL=http://localhost:8081
# PRUSASLICER_WORKER_URL=http://localhost:8082
# Required when the slicer API surface is enabled. Use a secret provider in production.
# WorkerAuth__SharedKey=

# Split (microservices) deployments only — calibration profile resolution.
# The slicer host owns the calibration profile store, so the API resolves the machine/process/
# filament profiles over an authenticated internal HTTP hop, forwarding the end user's own bearer
# token. The generated compose file already defaults this to the container-internal slicer host;
# override only when the slicer host is reachable at a different internal address.
# Leaving it unset keeps calibration discovery fail-closed (503 profile_service_unavailable).
# Jwt__Key / Jwt__Issuer / Jwt__Audience MUST be identical for the api and slicer-host services,
# and callers need the calibration:read permission.
# SLICER_HOST_URL=http://slicer-host:5246

# Native Push (F3 iOS / operator app) — see docs/OPERATOR_NATIVE_PUSH.md
# NativePush__Mode controls the topology: disabled | relay | direct (restart the API after changing mode/settings).
# - Disabled (default, safe): no APNs traffic; controller endpoints 404 until OperatorFeature.NativePush is on.
# - Relay: forward each dispatch to an authenticated HTTPS relay that owns the .p8 key.
# - Direct: sign ES256 JWTs and POST directly to api.push.apple.com / api.sandbox.push.apple.com.
# NativePush__Mode=Disabled
#
# Relay mode:
# NativePush__Relay__Endpoint=https://push-relay.olyforge3d.com/v1/dispatch
# NativePush__Relay__ApiKey=<opaque bearer token issued by OlyForge3D>
# NativePush__Relay__InstallationId=<installation id sent to relay>
#
# Direct mode (selected-mode validation runs at startup; never commit real values):
# NativePush__Apns__TeamId=ABCDE12345
# NativePush__Apns__KeyId=KEY123ABCD
# NativePush__Apns__BundleId=com.olyforge3d.printfarmer
# NativePush__Apns__Environment=production   # or "development" for the sandbox APNs host
# NativePush__Apns__P8KeyPath=/run/secrets/apns-key.p8  # must exist/read when no inline PEM is set
# NativePush__Apns__P8KeyPem=<inline PEM; takes precedence over P8KeyPath>

# Internal discovery service authentication (microservices only).
# The deployment script generates this automatically; set a strong random value
# when invoking Docker Compose directly.
# DISCOVERY_SHARED_API_KEY=
