# syntax=docker/dockerfile:1
###################################################################################################
# DEPRECATED DOCKERFILE: Dockerfile.base
#
# This file formerly built a combined base + OrcaSlicer worker image. The architecture now uses:
#   - Dockerfile.slicer-base  (neutral runtime only)
#   - Dockerfile.orcaslicer   (engine-specific worker)
#   - Dockerfile.prusaslicer  (Prusa worker, analogous pattern if present)
#
# Retained temporarily to fail fast and instruct users to update references. Will be removed.
###################################################################################################

FROM busybox:1.37
LABEL deprecated="true" \
    component="legacy-slicer-base" \
    replacement.base="Dockerfile.slicer-base" \
    replacement.orca="Dockerfile.orcaslicer" \
    description="Deprecated combined slicer base; use new layered Dockerfiles."

COPY <<'EONOTICE' /DEPRECATED_NOTICE.txt
This image is deprecated and intentionally non-functional.

Update any builds referencing Dockerfile.base to use:
  docker build -f Dockerfile.slicer-base ... (for a neutral base)
  docker build -f Dockerfile.orcaslicer ...  (for Orca worker)

This file will be removed in a future release.
EONOTICE

ENTRYPOINT ["/bin/sh", "-c", "echo 'Deprecated: see /DEPRECATED_NOTICE.txt'; exit 1"]