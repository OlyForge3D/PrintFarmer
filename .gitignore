# OS junk
.DS_Store
# Build Folders
bin/
obj/

# Visual Studio 
.vs/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Logs
*.log

.pids/

deployment/

# Visual Studio Code
.vscode/

# Dependency directories
node_modules/

# Publish output
#wwwroot/

# Environment files
.env
.env.*
.deploy-config

# Docker generated files (created by deployment script)
/docker-compose*.yml
/otel-collector-config.yaml
/monitoring

.env.microservices
# Keep template sources tracked
!scripts/docker/compose-templates/
!scripts/docker/compose-templates/**

# SqlLite Database Files
*.db
*.db-shm
*.db-wal
*.db.back*

# Backup files
*.bak

# Test repository-local temp artifacts
src/tests/_temp/

# Test result artifacts
*.trx
TestResults/
src/src/
test-logs/

# Coverage artifacts
coverage/
lcov.info
coverage-final.json
*.coverage
*.coveragexml

# Prevent accidental duplicate copies of the dotnet installer script
dotnet-install.sh.*

# Deploy script generated compose files
/docker-compose.override.yml
/docker-compose.host-network.yml

# Deploy script generated Nginx config (auto-generated by deploy-docker.sh)
/deploy/nginx/conf.d.host/

# Local Orca extraction artifacts (should not be committed)
orca7z/
orcaslicer_binary/

# Local slicer assets and temporary build artifacts (do not commit)
orcaslicer.AppImage
orca_release_index.json
build_context/
orca_assets/
prusa_preseed/

# Test-generated artifacts directory (cleaned by tests). Safe to ignore.
src/test-artifacts/

# Ignore API artifact storage folders created during tests or local runs
# Test runs now redirect artifact storage to src/test-artifacts/ by default,
# but ignore src/api/artifacts/ as a safety-net for leftover files.
src/api/artifacts/

# Auto-generated docker files 
/dockerfiles/
/docker-entrypoint-config.sh
/Dockerfile.multistage