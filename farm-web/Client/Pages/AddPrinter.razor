@page "/printers/new"
@using Farm.Web.Shared
@inject HttpClient Http
@inject NavigationManager Nav
@inject Farm.Web.Client.ToastService toast

<h2>Add Printer</h2>

<div class="form">
  <label>Name</label>
  <div class="field">
    <input class="@(string.IsNullOrWhiteSpace(model.Name) ? "invalid" : null)" @bind="model.Name" />
    @if (string.IsNullOrWhiteSpace(model.Name))
    {
      <div class="hint error">Name is required.</div>
    }
  </div>

  <label>Moonraker URL</label>
  <div class="field">
    <input class="@(string.IsNullOrWhiteSpace(model.MoonrakerUrl) ? "invalid" : null)" @bind="model.MoonrakerUrl" placeholder="http://host:7125" />
    @if (string.IsNullOrWhiteSpace(model.MoonrakerUrl))
    {
      <div class="hint error">Moonraker URL is required.</div>
    }
  </div>

  <label>Notes</label>
  <input @bind="model.Notes" />

  <label>Manufacturer</label>
  <div class="field row-inline">
    <select @bind="selectedManufacturerId" @bind:after="OnManufacturerChanged">
      <option value="">-- Select --</option>
      @foreach (var m in manufacturers)
      {
        <option value="@m.Id">@m.Name</option>
      }
    </select>
    <button class="btn ghost" @onclick="ToggleNewManufacturer" type="button">New</button>
  </div>
  @if (showNewManufacturer)
  {
    <div class="field">
      <input placeholder="New manufacturer name" @bind="model.NewManufacturerName" />
    </div>
  }

  <label>Model</label>
  <div class="field row-inline">
    <select @bind="selectedModelId">
      <option value="">-- Select --</option>
      @foreach (var m in models)
      {
        <option value="@m.Id">@m.Name</option>
      }
    </select>
    <button class="btn ghost" @onclick="ToggleNewModel" type="button">New</button>
  </div>
  @if (showNewModel)
  {
    <div class="field">
      <input class="@((RequiresManufacturerForNewModel()) ? "invalid" : null)" placeholder="New model name" @bind="model.NewModelName" />
      @if (RequiresManufacturerForNewModel())
      {
        <div class="hint error">Select a manufacturer or enter a new manufacturer when creating a new model.</div>
      }
    </div>
  }

  @* Max dimensions now belong to Model. Use Catalog/Model to edit sizes. *@

  <label>Date Acquired</label>
  <input type="date" @bind-value="model.DateAcquired" @bind-value:format="yyyy-MM-dd" />

  <div class="actions">
  <button class="btn primary" @onclick="Save" disabled="@(!IsValid())">Save</button>
  <button class="btn" @onclick="Cancel" type="button">Cancel</button>
  </div>
</div>

@code {
  private CreatePrinterDto model = new() { MoonrakerUrl = "http://" };
  private List<ManufacturerDto> manufacturers = new();
  private List<ModelDto> models = new();
  private Guid? selectedManufacturerId;
  private Guid? selectedModelId;
  private bool showNewManufacturer;
  private bool showNewModel;
  

  protected override async Task OnInitializedAsync()
  {
    manufacturers = await Http.GetFromJsonAsync<List<ManufacturerDto>>("api/catalog/manufacturers") ?? new();
  }

  private async Task OnManufacturerChanged()
  {
    selectedModelId = null;
    if (selectedManufacturerId is Guid mid)
      models = await Http.GetFromJsonAsync<List<ModelDto>?>($"api/catalog/models?manufacturerId={mid}") ?? new();
    else
      models = new();
  }

  private void ToggleNewManufacturer() => showNewManufacturer = !showNewManufacturer;
  private void ToggleNewModel() => showNewModel = !showNewModel;

  private async Task Save()
  {
    model.ManufacturerId = selectedManufacturerId;
    model.ModelId = selectedModelId;
    // If user provided new names, ensure they exist first and pick existing if conflict
    if (!string.IsNullOrWhiteSpace(model.NewManufacturerName))
    {
      var mresp = await Http.PostAsJsonAsync("api/catalog/manufacturers", model.NewManufacturerName);
      if ((int)mresp.StatusCode == 409)
      {
        var existing = await mresp.Content.ReadFromJsonAsync<ManufacturerDto>();
        if (existing is not null) selectedManufacturerId = existing.Id;
      }
      else if (mresp.IsSuccessStatusCode)
      {
        var created = await mresp.Content.ReadFromJsonAsync<ManufacturerDto>();
        if (created is not null) selectedManufacturerId = created.Id;
      }
      model.ManufacturerId = selectedManufacturerId;
    }
    if (!string.IsNullOrWhiteSpace(model.NewModelName))
    {
      if (selectedManufacturerId is Guid mid)
      {
        var mresp = await Http.PostAsJsonAsync("api/catalog/models", new { ManufacturerId = mid, Name = model.NewModelName });
        if ((int)mresp.StatusCode == 409)
        {
          var existing = await mresp.Content.ReadFromJsonAsync<ModelDto>();
          if (existing is not null) selectedModelId = existing.Id;
        }
        else if (mresp.IsSuccessStatusCode)
        {
          var created = await mresp.Content.ReadFromJsonAsync<ModelDto>();
          if (created is not null) selectedModelId = created.Id;
        }
        model.ModelId = selectedModelId;
      }
    }
  var resp = await Http.PostAsJsonAsync("api/printers", model);
  if (resp.IsSuccessStatusCode) { toast.Success("Printer added"); Nav.NavigateTo("/"); }
  else { toast.Error($"Add failed: {(int)resp.StatusCode}"); }
  }

  private bool IsValid()
  {
    if (string.IsNullOrWhiteSpace(model.Name)) return false;
    if (string.IsNullOrWhiteSpace(model.MoonrakerUrl)) return false;
    // If providing a new model name, ensure manufacturer selection or new manufacturer name exists
    if (!string.IsNullOrWhiteSpace(model.NewModelName))
    {
      if (selectedManufacturerId is null && string.IsNullOrWhiteSpace(model.NewManufacturerName)) return false;
    }
    return true;
  }

  private bool RequiresManufacturerForNewModel()
    => showNewModel && !string.IsNullOrWhiteSpace(model.NewModelName) && selectedManufacturerId is null && string.IsNullOrWhiteSpace(model.NewManufacturerName);
  private void Cancel() => Nav.NavigateTo("/");
}


