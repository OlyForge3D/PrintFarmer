@page "/catalog"
@using Farm.Web.Shared
@inject HttpClient Http
@inject Farm.Web.Client.ToastService toast
@using Microsoft.AspNetCore.Components.Forms

<h2>Catalog</h2>

<div class="grid">
  <section>
    <h3>Manufacturers</h3>
    <div class="row">
      <input placeholder="New manufacturer" @bind="newManufacturer" />
      <button @onclick="AddManufacturer">Add</button>
    </div>
    <ul>
      @foreach (var m in manufacturers)
      {
        <li @onclick="() => SelectManufacturer(m)">@m.Name</li>
      }
    </ul>
  </section>

  <section>
    <h3>Models</h3>
    @if (selectedManufacturer is null)
    {
      <p>Select a manufacturer to view models.</p>
    }
    else
    {
      <div class="row">
        <input placeholder="New model" @bind="newModel" />
        <button @onclick="AddModel">Add</button>
      </div>
      @if (models.Count == 0)
      {
        <p>No models yet.</p>
      }
      else
      {
        <div class="list">
          @foreach (var m in models)
          {
            var ed = GetEdit(m);
            bool isDirty = (ed.MaxX != m.MaxX) || (ed.MaxY != m.MaxY) || (ed.MaxZ != m.MaxZ);
            <div class="card row" style="align-items:center; gap:12px;">
              <div style="min-width:220px; font-weight:600;">@m.Name</div>
              <div class="row" style="gap:8px; align-items:center;">
                <label title="Max X (mm)">X</label>
                <InputNumber TValue="double?" @bind-Value="ed.MaxX" class="input number" />
                <label title="Max Y (mm)">Y</label>
                <InputNumber TValue="double?" @bind-Value="ed.MaxY" class="input number" />
                <label title="Max Z (mm)">Z</label>
                <InputNumber TValue="double?" @bind-Value="ed.MaxZ" class="input number" />
                <span>mm</span>
              </div>
              <div class="row" style="margin-left:auto; gap:8px;">
                <button disabled="@(!isDirty)" @onclick="() => SaveModel(m)">Save</button>
                <button disabled="@(!isDirty)" @onclick="() => ResetModel(m)">Reset</button>
              </div>
            </div>
          }
        </div>
      }
    }
  </section>
</div>

@code {
  private List<ManufacturerDto> manufacturers = new();
  private List<ModelDto> models = new();
  private ManufacturerDto? selectedManufacturer;
  private string? newManufacturer;
  private string? newModel;
  private readonly Dictionary<Guid, EditModel> edit = new();

  protected override async Task OnInitializedAsync()
  {
    manufacturers = await Http.GetFromJsonAsync<List<ManufacturerDto>>("api/catalog/manufacturers") ?? new();
  }

  private async Task AddManufacturer()
  {
    if (string.IsNullOrWhiteSpace(newManufacturer)) return;
    var resp = await Http.PostAsJsonAsync("api/catalog/manufacturers", newManufacturer);
    if (resp.IsSuccessStatusCode)
    {
      manufacturers = await Http.GetFromJsonAsync<List<ManufacturerDto>>("api/catalog/manufacturers") ?? new();
      newManufacturer = string.Empty;
      toast.Success("Manufacturer added");
    }
    else if ((int)resp.StatusCode == 409)
    {
      // select existing
      var existing = await resp.Content.ReadFromJsonAsync<ManufacturerDto>();
      if (existing is not null)
      {
        await SelectManufacturer(existing);
        newManufacturer = string.Empty;
        toast.Success("Using existing manufacturer");
      }
    }
  }

  private async Task SelectManufacturer(ManufacturerDto m)
  {
    selectedManufacturer = m;
  models = await Http.GetFromJsonAsync<List<ModelDto>>($"api/catalog/models?manufacturerId={m.Id}") ?? new();
  BuildEditState();
  }

  private async Task AddModel()
  {
    if (selectedManufacturer is null || string.IsNullOrWhiteSpace(newModel)) return;
    var resp = await Http.PostAsJsonAsync("api/catalog/models", new { ManufacturerId = selectedManufacturer.Id, Name = newModel });
    if (resp.IsSuccessStatusCode)
    {
      models = await Http.GetFromJsonAsync<List<ModelDto>>($"api/catalog/models?manufacturerId={selectedManufacturer.Id}") ?? new();
      BuildEditState();
      newModel = string.Empty;
      toast.Success("Model added");
    }
    else if ((int)resp.StatusCode == 409)
    {
      var existing = await resp.Content.ReadFromJsonAsync<ModelDto>();
      if (existing is not null)
      {
        models = await Http.GetFromJsonAsync<List<ModelDto>>($"api/catalog/models?manufacturerId={selectedManufacturer.Id}") ?? new();
        BuildEditState();
        newModel = string.Empty;
        toast.Success("Using existing model");
      }
    }
  }

  private void BuildEditState()
  {
    edit.Clear();
    foreach (var m in models)
    {
      edit[m.Id] = new EditModel { MaxX = m.MaxX, MaxY = m.MaxY, MaxZ = m.MaxZ };
    }
  }

  private EditModel GetEdit(ModelDto m)
  {
    if (!edit.TryGetValue(m.Id, out var e))
    {
      e = new EditModel { MaxX = m.MaxX, MaxY = m.MaxY, MaxZ = m.MaxZ };
      edit[m.Id] = e;
    }
    return e;
  }

  private async Task SaveModel(ModelDto m)
  {
    var ed = GetEdit(m);
    // Basic validation: non-negative numbers or null
    if ((ed.MaxX is < 0) || (ed.MaxY is < 0) || (ed.MaxZ is < 0))
    {
      toast.Error("Sizes must be >= 0 or empty");
      return;
    }

    var resp = await Http.PutAsJsonAsync($"api/catalog/models/{m.Id}", new { Name = m.Name, ed.MaxX, ed.MaxY, ed.MaxZ });
    if (resp.IsSuccessStatusCode)
    {
      // Refresh source of truth to keep lists in sync
      if (selectedManufacturer is not null)
      {
        models = await Http.GetFromJsonAsync<List<ModelDto>>($"api/catalog/models?manufacturerId={selectedManufacturer.Id}") ?? new();
        BuildEditState();
      }
      toast.Success("Model updated");
    }
    else
    {
      toast.Error($"Update failed: {(int)resp.StatusCode}");
    }
  }

  private void ResetModel(ModelDto m)
  {
    edit[m.Id] = new EditModel { MaxX = m.MaxX, MaxY = m.MaxY, MaxZ = m.MaxZ };
  }

  private class EditModel
  {
    public double? MaxX { get; set; }
    public double? MaxY { get; set; }
    public double? MaxZ { get; set; }
  }
}

