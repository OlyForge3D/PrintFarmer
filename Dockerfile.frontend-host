# Frontend Dockerfile for Host Network Mode
# Uses host.docker.internal to proxy to API running on host machine

FROM node:18-alpine AS build

# Build-time configuration for host network deployment
ARG VITE_API_BASE_URL=/api
ARG VITE_SIGNALR_PRINTERS_URL=/hubs/printers
ARG VITE_SIGNALR_HARVEST_URL=/hubs/harvest

ENV VITE_API_BASE_URL=${VITE_API_BASE_URL} \
    VITE_SIGNALR_PRINTERS_URL=${VITE_SIGNALR_PRINTERS_URL} \
    VITE_SIGNALR_HARVEST_URL=${VITE_SIGNALR_HARVEST_URL}

WORKDIR /app

# Copy package files
COPY src/Web/ReactApp/package*.json ./
RUN npm install --silent

# Copy source and build
COPY src/Web/ReactApp/ ./
RUN echo "Building with VITE_API_BASE_URL=$VITE_API_BASE_URL VITE_SIGNALR_PRINTERS_URL=$VITE_SIGNALR_PRINTERS_URL VITE_SIGNALR_HARVEST_URL=$VITE_SIGNALR_HARVEST_URL" && npm run build

# Production stage with Nginx
FROM nginx:alpine

# Copy built app to nginx
COPY --from=build /app/dist /usr/share/nginx/html

# Copy nginx configuration for host network mode
COPY deploy/nginx/nginx-frontend.conf /etc/nginx/nginx.conf
COPY deploy/nginx/conf.d/frontend-app-host-network.conf /etc/nginx/conf.d/frontend-app.conf

# Remove default server config
RUN rm -f /etc/nginx/conf.d/default.conf || true

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:80/health || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
