@inherits LayoutComponentBase

<div class="popup-layout">
    <main class="popup-content">
        @Body
    </main>
</div>

<style>
    .popup-layout {
        height: 100vh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        background: #0b1020;
        color: #e5e7eb;
        margin: 0;
        padding: 0;
        font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Ubuntu, Cantarell, Noto Sans, sans-serif;
    }

    .popup-content {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
        margin: 0;
    }

    /* Apply dark theme variables to popup */
    .popup-layout {
        --bg-0: #0b1020;
        --bg-1: #0f172a;
        --bg-2: #111827;
        --panel: #0e1528;
        --border: #243145;
        --muted: #9ca3af;
        --accent: #10b981;
        --accent-2: #2563eb;
        --control-h: 36px;
    }

    /* Hide any potential navigation elements */
    .navbar,
    .nav,
    .sidebar,
    .main-nav {
        display: none !important;
    }
</style>
