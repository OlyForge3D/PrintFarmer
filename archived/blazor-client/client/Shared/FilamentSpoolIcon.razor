@* Filament Spool SVG Component - True Side View *@
<svg width="@Width" height="@Height" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" class="filament-spool-icon" title="@Title">
    <!-- Spool Background/Shadow -->
    <ellipse cx="50" cy="52" rx="42" ry="32" fill="#1a202c" opacity="0.3"/>
    
    <!-- Left Flange (Rim) -->
    <ellipse cx="50" cy="25" rx="35" ry="15" fill="#2d3748" stroke="#4a5568" stroke-width="1"/>
    <ellipse cx="50" cy="22" rx="35" ry="15" fill="#4a5568" stroke="#5a6a7a" stroke-width="1"/>
    
    <!-- Right Flange (Rim) -->
    <ellipse cx="50" cy="75" rx="35" ry="15" fill="#2d3748" stroke="#4a5568" stroke-width="1"/>
    <ellipse cx="50" cy="78" rx="35" ry="15" fill="#1a202c" stroke="#2d3748" stroke-width="1"/>
    
    <!-- Central Hub/Core -->
    <rect x="40" y="22" width="20" height="56" fill="#1a202c" stroke="#2d3748" stroke-width="1"/>
    <rect x="41" y="23" width="18" height="54" fill="#2d3748" opacity="0.7"/>
    
    <!-- Filament Wound Around Core -->
    @if (FilamentColor != null && RemainingPercentage > 0)
    {
        // Calculate filament radius based on remaining percentage
        var maxFilamentRadius = 18; // Maximum distance from center hub to flange edge
        var currentFilamentRadius = 10 + (maxFilamentRadius * RemainingPercentage / 100.0);
        var leftEdge = 50 - currentFilamentRadius;
        var rightEdge = 50 + currentFilamentRadius;
        
        <!-- Filament Bulk - Main Body -->
        <rect x="@leftEdge" y="25" width="@(currentFilamentRadius * 2)" height="50" 
              fill="@FilamentColor" opacity="0.8" rx="2"/>
        
        <!-- Filament Top Curve -->
        <ellipse cx="50" cy="25" rx="@currentFilamentRadius" ry="8" 
                 fill="@FilamentColor" opacity="0.9"/>
        
        <!-- Filament Bottom Curve -->
        <ellipse cx="50" cy="75" rx="@currentFilamentRadius" ry="8" 
                 fill="@FilamentColor" opacity="0.7"/>
        
        <!-- Filament Surface Highlight -->
        <ellipse cx="50" cy="25" rx="@(currentFilamentRadius - 2)" ry="6" 
                 fill="@FilamentColor" opacity="0.6"/>
        <rect x="@(leftEdge + 2)" y="25" width="@(currentFilamentRadius * 2 - 4)" height="48" 
              fill="@FilamentColor" opacity="0.5" rx="1"/>
        
        <!-- Filament Winding Lines for Texture -->
        @for (int i = 0; i < Math.Min(7, (int)(RemainingPercentage / 12) + 1); i++)
        {
            var lineY = 28 + (i * 7);
            <line x1="@(leftEdge + 1)" y1="@lineY" x2="@(rightEdge - 1)" y2="@lineY" 
                  stroke="@FilamentColor" stroke-width="0.5" opacity="0.4"/>
        }
        
        <!-- Filament Side Shadows -->
        <rect x="@leftEdge" y="26" width="3" height="48" 
              fill="@FilamentColor" opacity="0.3"/>
        <rect x="@(rightEdge - 3)" y="26" width="3" height="48" 
              fill="@FilamentColor" opacity="0.3"/>
    }
    
    <!-- Hub Center Details -->
    <rect x="42" y="30" width="16" height="40" fill="#0f1419" opacity="0.8"/>
    
    <!-- Hub Mounting Holes -->
    <ellipse cx="50" cy="35" rx="3" ry="2" fill="#0f1419"/>
    <ellipse cx="50" cy="50" rx="4" ry="3" fill="#0f1419"/>
    <ellipse cx="50" cy="65" rx="3" ry="2" fill="#0f1419"/>
    
    <!-- Flange Details and Highlights -->
    <ellipse cx="50" cy="22" rx="30" ry="12" fill="none" stroke="#5a6a7a" stroke-width="1" opacity="0.6"/>
    <ellipse cx="50" cy="78" rx="30" ry="12" fill="none" stroke="#4a5568" stroke-width="1" opacity="0.8"/>
    
    <!-- Inner Flange Rims -->
    <ellipse cx="50" cy="25" rx="12" ry="6" fill="#4a5568" stroke="#5a6a7a" stroke-width="1"/>
    <ellipse cx="50" cy="75" rx="12" ry="6" fill="#2d3748" stroke="#4a5568" stroke-width="1"/>
    
    <!-- Empty Spool Indicator -->
    @if (!HasSpoolLoaded)
    {
        <!-- No spool loaded overlay - circle with diagonal line -->
        <g>
            <circle cx="50" cy="50" r="38" fill="rgba(239, 68, 68, 0.1)" stroke="#ef4444" stroke-width="2"/>
            <line x1="20" y1="20" x2="80" y2="80" stroke="#ef4444" stroke-width="4" stroke-linecap="round"/>
            <text x="50" y="92" text-anchor="middle" font-size="8" fill="#ef4444" font-weight="bold">NO SPOOL</text>
        </g>
    }
    else if (FilamentColor == null || RemainingPercentage <= 0)
    {
        <!-- Empty indicator -->
        <g>
            <text x="50" y="52" text-anchor="middle" font-size="9" fill="#9ca3af" font-family="Arial" font-weight="bold">EMPTY</text>
        </g>
    }
    else if (RemainingPercentage <= 15)
    {
        <!-- Low filament warning -->
        <circle cx="80" cy="20" r="6" fill="#ef4444" stroke="#ffffff" stroke-width="1"/>
        <g>
            <text x="80" y="24" text-anchor="middle" font-size="7" fill="white" font-weight="bold">!</text>
        </g>
    }
</svg>

@code {
    [Parameter] public string? FilamentColor { get; set; }
    [Parameter] public double RemainingPercentage { get; set; } = 100;
    [Parameter] public int Width { get; set; } = 50;
    [Parameter] public int Height { get; set; } = 50;
    [Parameter] public string? Title { get; set; }
    [Parameter] public bool HasSpoolLoaded { get; set; } = true;
}
