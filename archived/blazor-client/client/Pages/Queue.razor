@page "/queue"
@using Farm.Web.Shared
@using Farm.Web.Client.Services
@inject JobQueueService JobQueueService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>Print Job Queue - PrintFarmer</PageTitle>

<div class="queue-container">
    <div class="queue-header">
        <h1>Print Job Queue</h1>
        <button class="btn btn-primary" @onclick="ShowAddJobDialog">
            ➕ Add Job
        </button>
    </div>

    @if (isLoading)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>Loading print queue...</p>
        </div>
    }
    else if (!jobs.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">📋</div>
            <h2>No jobs in queue</h2>
            <p>Add your first print job to get started!</p>
            <button class="btn btn-primary" @onclick="ShowAddJobDialog">
                Add First Job
            </button>
        </div>
    }
    else
    {
        <div class="queue-stats">
            <div class="stat">
                <span class="stat-number">@jobs.Count</span>
                <span class="stat-label">Total Jobs</span>
            </div>
            <div class="stat">
                <span class="stat-number">@jobs.Count(j => j.Status == PrintJobStatusDto.Queued)</span>
                <span class="stat-label">Queued</span>
            </div>
            <div class="stat">
                <span class="stat-number">@jobs.Count(j => j.Status == PrintJobStatusDto.Printing)</span>
                <span class="stat-label">Printing</span>
            </div>
            <div class="stat">
                <span class="stat-number">@jobs.Count(j => j.Status == PrintJobStatusDto.Completed)</span>
                <span class="stat-label">Completed</span>
            </div>
        </div>

        <div class="jobs-grid">
            @foreach (var job in jobs.OrderBy(j => j.QueuePosition))
            {
                <div class="job-card @GetJobStatusClass(job.Status)">
                    <div class="job-header">
                        <div class="job-position">#{job.QueuePosition}</div>
                        <div class="job-status">@job.Status</div>
                        <div class="job-actions">
                            @if (job.Status == PrintJobStatusDto.Queued)
                            {
                                <button class="btn-icon" @onclick="() => StartJob(job.Id)" title="Start Job">
                                    ▶️
                                </button>
                            }
                            @if (job.Status == PrintJobStatusDto.Printing)
                            {
                                <button class="btn-icon" @onclick="() => CancelJob(job.Id)" title="Cancel Job">
                                    ⏹️
                                </button>
                            }
                            <button class="btn-icon" @onclick="() => EditJob(job)" title="Edit Job">
                                ✏️
                            </button>
                            <button class="btn-icon" @onclick="() => DeleteJob(job.Id)" title="Delete Job">
                                🗑️
                            </button>
                        </div>
                    </div>
                    
                    <div class="job-details">
                        <h3>@job.GcodeFileName</h3>
                        <div class="job-meta">
                            <div class="meta-item">
                                <span class="meta-label">File ID:</span>
                                <span class="meta-value">@job.GcodeFileId</span>
                            </div>
                            @if (!string.IsNullOrEmpty(job.AssignedPrinterName))
                            {
                                <div class="meta-item">
                                    <span class="meta-label">Printer:</span>
                                    <span class="meta-value">@job.AssignedPrinterName</span>
                                </div>
                            }
                            @if (job.EstimatedPrintTime.HasValue)
                            {
                                <div class="meta-item">
                                    <span class="meta-label">Duration:</span>
                                    <span class="meta-value">@FormatDuration(job.EstimatedPrintTime.Value)</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(job.RequiredMaterialType))
                            {
                                <div class="meta-item">
                                    <span class="meta-label">Material:</span>
                                    <span class="meta-value">@job.RequiredMaterialType</span>
                                </div>
                            }
                            @if (job.RequiredNozzleDiameter.HasValue)
                            {
                                <div class="meta-item">
                                    <span class="meta-label">Nozzle:</span>
                                    <span class="meta-value">@job.RequiredNozzleDiameter.Value mm</span>
                                </div>
                            }
                        </div>
                        
                        <div class="job-timestamps">
                            @if (job.ActualStartTime.HasValue)
                            {
                                <div class="timestamp">Started: @job.ActualStartTime.Value.ToString("MM/dd HH:mm")</div>
                            }
                            @if (job.ActualEndTime.HasValue)
                            {
                                <div class="timestamp">Completed: @job.ActualEndTime.Value.ToString("MM/dd HH:mm")</div>
                            }
                            else
                            {
                                <div class="timestamp">Created: @job.CreatedAt.ToString("MM/dd HH:mm")</div>
                            }
                        </div>
                        
                        @if (!string.IsNullOrEmpty(job.FailureReason))
                        {
                            <div class="error-message">
                                <strong>Error:</strong> @job.FailureReason
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (showAddJobDialog)
{
    <div class="modal-overlay" @onclick="HideAddJobDialog">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>@(editingJob != null ? "Edit Job" : "Add New Job")</h2>
                <button class="modal-close" @onclick="HideAddJobDialog">×</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>G-code File ID</label>
                    <input @bind="newJob.GcodeFileId" placeholder="Enter file ID..." />
                </div>
                <div class="form-group">
                    <label>G-code Filename</label>
                    <input @bind="newJob.GcodeFileName" placeholder="filename.gcode" />
                </div>
                <div class="form-group">
                    <label>Assigned Printer Name</label>
                    <input @bind="newJob.AssignedPrinterName" placeholder="Printer name" />
                </div>
                <div class="form-group">
                    <label>Priority</label>
                    <select @bind="newJob.Priority">
                        <option value="0">Low</option>
                        <option value="1">Normal</option>
                        <option value="2">High</option>
                        <option value="3">Urgent</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Estimated Print Time (minutes)</label>
                    <input type="number" @bind="estimatedMinutes" placeholder="120" />
                </div>
                <div class="form-group">
                    <label>Required Material Type</label>
                    <input @bind="newJob.RequiredMaterialType" placeholder="PLA" />
                </div>
                <div class="form-group">
                    <label>Required Nozzle Diameter (mm)</label>
                    <input type="number" step="0.1" @bind="nozzleDiameter" placeholder="0.4" />
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="HideAddJobDialog">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveJob" disabled="@(newJob.GcodeFileId == Guid.Empty)">
                    @(editingJob != null ? "Update Job" : "Add Job")
                </button>
            </div>
        </div>
    </div>
}

<style>
.queue-container { padding: 1rem; }
.queue-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
.queue-header h1 { margin: 0; color: #e5e7eb; font-size: 1.75rem; }

.loading, .empty-state { text-align: center; padding: 3rem 1rem; }
.spinner { width: 40px; height: 40px; border: 4px solid rgba(255,255,255,0.1); border-top: 4px solid #3b82f6; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto 1rem; }

.empty-state .empty-icon { font-size: 4rem; margin-bottom: 1rem; }
.empty-state h2 { color: #e5e7eb; margin-bottom: 0.5rem; }
.empty-state p { color: #9ca3af; margin-bottom: 1.5rem; }

.queue-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
.stat { background: linear-gradient(180deg, #1f2937, #111827); padding: 1rem; border-radius: 8px; text-align: center; }
.stat-number { display: block; font-size: 2rem; font-weight: bold; color: #3b82f6; }
.stat-label { color: #9ca3af; font-size: 0.875rem; }

.jobs-grid { display: grid; gap: 1rem; }
.job-card { background: linear-gradient(180deg, #1f2937, #111827); border-radius: 8px; padding: 1rem; border-left: 4px solid #6b7280; }
.job-card.pending { border-left-color: #f59e0b; }
.job-card.printing { border-left-color: #3b82f6; }
.job-card.completed { border-left-color: #10b981; }
.job-card.failed { border-left-color: #ef4444; }
.job-card.cancelled { border-left-color: #6b7280; }

.job-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem; }
.job-position { background: #374151; color: #e5e7eb; padding: 0.25rem 0.5rem; border-radius: 4px; font-weight: bold; min-width: 40px; text-align: center; }
.job-status { background: #4b5563; color: #e5e7eb; padding: 0.25rem 0.5rem; border-radius: 4px; text-transform: capitalize; }
.job-actions { margin-left: auto; display: flex; gap: 0.5rem; }

.job-details h3 { margin: 0 0 0.75rem 0; color: #e5e7eb; font-size: 1.25rem; }
.job-meta { display: grid; gap: 0.5rem; margin-bottom: 1rem; }
.meta-item { display: flex; }
.meta-label { color: #9ca3af; min-width: 80px; }
.meta-value { color: #e5e7eb; }

.progress-container { display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem; }
.progress-bar { flex: 1; height: 8px; background: #374151; border-radius: 4px; overflow: hidden; }
.progress-fill { height: 100%; background: #3b82f6; border-radius: 4px; transition: width 0.3s ease; }
.progress-text { color: #e5e7eb; font-weight: bold; min-width: 50px; }

.job-timestamps { display: flex; gap: 1rem; color: #9ca3af; font-size: 0.875rem; }

.btn { padding: 0.5rem 1rem; border: none; border-radius: 6px; font-weight: 600; cursor: pointer; transition: all 0.2s ease; }
.btn-primary { background: #3b82f6; color: white; }
.btn-primary:hover { background: #2563eb; }
.btn-secondary { background: #4b5563; color: white; }
.btn-secondary:hover { background: #374151; }
.btn-icon { background: none; border: none; font-size: 1rem; cursor: pointer; padding: 0.25rem; border-radius: 4px; }
.btn-icon:hover { background: rgba(255,255,255,0.1); }

.modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.8); z-index: 1000; display: flex; align-items: center; justify-content: center; padding: 1rem; }
.modal { background: linear-gradient(180deg, #1f2937, #111827); border-radius: 8px; width: 100%; max-width: 500px; max-height: 90vh; overflow: auto; }
.modal-header { display: flex; justify-content: space-between; align-items: center; padding: 1rem; border-bottom: 1px solid #374151; }
.modal-header h2 { margin: 0; color: #e5e7eb; }
.modal-close { background: none; border: none; font-size: 1.5rem; color: #9ca3af; cursor: pointer; }
.modal-body { padding: 1rem; }
.modal-footer { display: flex; gap: 1rem; justify-content: flex-end; padding: 1rem; border-top: 1px solid #374151; }

.form-group { margin-bottom: 1rem; }
.form-group label { display: block; color: #e5e7eb; margin-bottom: 0.5rem; font-weight: 600; }
.form-group input, .form-group textarea { width: 100%; padding: 0.5rem; border: 1px solid #4b5563; border-radius: 4px; background: #374151; color: #e5e7eb; }
.form-group textarea { min-height: 80px; resize: vertical; }
</style>

@code {
    private List<JobQueuePrintJobDto> jobs = new();
    private bool isLoading = true;
    private bool showAddJobDialog = false;
    private JobQueuePrintJobDto newJob = new();
    private JobQueuePrintJobDto? editingJob;
    private int? estimatedMinutes;
    private decimal? nozzleDiameter;

    protected override async Task OnInitializedAsync()
    {
        await LoadJobs();
        isLoading = false;
    }

    private async Task LoadJobs()
    {
        jobs = await JobQueueService.GetJobsAsync();
    }

    private void ShowAddJobDialog()
    {
        editingJob = null;
        newJob = new JobQueuePrintJobDto();
        estimatedMinutes = null;
        nozzleDiameter = null;
        showAddJobDialog = true;
    }

    private void EditJob(JobQueuePrintJobDto job)
    {
        editingJob = job;
        newJob = new JobQueuePrintJobDto
        {
            GcodeFileId = job.GcodeFileId,
            GcodeFileName = job.GcodeFileName,
            AssignedPrinterName = job.AssignedPrinterName,
            RequiredMaterialType = job.RequiredMaterialType,
            Priority = job.Priority
        };
        estimatedMinutes = job.EstimatedPrintTime?.TotalMinutes != null ? (int)job.EstimatedPrintTime.Value.TotalMinutes : null;
        nozzleDiameter = job.RequiredNozzleDiameter;
        showAddJobDialog = true;
    }

    private void HideAddJobDialog()
    {
        showAddJobDialog = false;
        editingJob = null;
        newJob = new();
        estimatedMinutes = null;
        nozzleDiameter = null;
    }

    private async Task SaveJob()
    {
        if (estimatedMinutes.HasValue)
        {
            newJob.EstimatedPrintTime = TimeSpan.FromMinutes(estimatedMinutes.Value);
        }
        
        newJob.RequiredNozzleDiameter = nozzleDiameter;

        if (editingJob != null)
        {
            await JobQueueService.UpdateJobAsync(editingJob.Id, newJob);
        }
        else
        {
            await JobQueueService.CreateJobAsync(newJob);
        }

        await LoadJobs();
        HideAddJobDialog();
    }

    private async Task StartJob(Guid jobId)
    {
        await JobQueueService.StartJobAsync(jobId);
        await LoadJobs();
    }

    private async Task CancelJob(Guid jobId)
    {
        await JobQueueService.CancelJobAsync(jobId);
        await LoadJobs();
    }

    private async Task DeleteJob(Guid jobId)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this job?"))
        {
            await JobQueueService.DeleteJobAsync(jobId);
            await LoadJobs();
        }
    }

    private string GetJobStatusClass(PrintJobStatusDto status)
    {
        return status.ToString().ToLowerInvariant();
    }

    private string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalHours >= 1)
        {
            return $"{duration.TotalHours:F1}h";
        }
        return $"{duration.TotalMinutes:F0}m";
    }

    public async ValueTask DisposeAsync()
    {
        await Task.CompletedTask;
    }
}
