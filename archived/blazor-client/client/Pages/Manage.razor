@page "/manage"
@using Farm.Web.Shared
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav

<h2>Management</h2>

<div class="manage-grid">

  <div class="manage-card">
    <h3>Printers</h3>
    <p>Edit printer details, import or export printer configurations.</p>
    
    <div class="row" style="margin-bottom: 1rem;">
      <button class="btn btn-primary" @onclick="DiscoverPrinters" disabled="@isDiscovering">
        @if (isDiscovering)
        {
          <div class="spinner-sm" style="margin-right: 0.5rem;"></div>
          <span>Discovering...</span>
        }
        else
        {
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="margin-right: 0.5rem;">
            <path d="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M16.2,17.2L15,16C14.7,16.6 14.1,17 13.5,17C12.7,17 12,16.3 12,15.5C12,14.7 12.7,14 13.5,14C14.3,14 15,14.7 15,15.5C15,15.9 14.8,16.2 14.5,16.4L15.8,17.8C16.3,17.2 16.5,16.4 16.5,15.5C16.5,13.8 15.2,12.5 13.5,12.5C11.8,12.5 10.5,13.8 10.5,15.5C10.5,17.2 11.8,18.5 13.5,18.5C14.4,18.5 15.2,18.1 15.8,17.6L16.2,17.2M18.5,15.5C18.5,18.3 16.3,20.5 13.5,20.5C10.7,20.5 8.5,18.3 8.5,15.5C8.5,12.7 10.7,10.5 13.5,10.5C16.3,10.5 18.5,12.7 18.5,15.5Z"/>
          </svg>
          <span>Discover Printers</span>
        }
      </button>
      
      <button class="btn btn-secondary" @onclick="ExportPrinters" disabled="@isExporting">
        @if (isExporting)
        {
          <span>Exporting...</span>
        }
        else
        {
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="margin-right: 0.5rem;">
            <path d="M19,9H15V3H9V9H5L12,16L19,9M5,18V20H19V18H5Z"/>
          </svg>
          <span>Export CSV</span>
        }
      </button>
      
      <button class="btn btn-secondary" @onclick="TriggerFileInput" disabled="@isImporting">
        @if (isImporting)
        {
          <span>Importing...</span>
        }
        else
        {
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="margin-right: 0.5rem;">
            <path d="M5,4H19V6H5V4M12,8L5,15H9V21H15V15H19L12,8Z"/>
          </svg>
          <span>Import CSV</span>
        }
      </button>
    </div>

    <InputFile @ref="fileInput" OnChange="OnFileSelected" accept=".csv" style="display: none;" id="@fileInputElementId" />

    @if (!string.IsNullOrEmpty(importMessage))
    {
      <div class="alert @(importSuccess ? "alert-success" : "alert-error")" style="margin-bottom: 1rem;">
        @importMessage
      </div>
    }

    @if (!string.IsNullOrEmpty(discoveryMessage))
    {
      <div class="alert @(discoverySuccess ? "alert-success" : "alert-error")" style="margin-bottom: 1rem;">
        @discoveryMessage
      </div>
    }

    @if (discoveredPrinters?.Any() == true)
    {
      <div class="discovery-section" style="margin-bottom: 2rem;">
        <h4 style="margin-bottom: 1rem;">Discovered Printers (@discoveredPrinters.Count found)</h4>
        <div class="discovery-grid">
          @foreach (var discovered in discoveredPrinters)
          {
            <div class="discovery-card">
              <div class="discovery-header">
                <div class="discovery-info">
                  <div class="discovery-name">@discovered.Name</div>
                  <div class="discovery-details">
                    @if (!string.IsNullOrEmpty(discovered.Manufacturer) || !string.IsNullOrEmpty(discovered.Model))
                    {
                      <div class="discovery-model">@($"{discovered.Manufacturer} {discovered.Model}".Trim())</div>
                    }
                    <div class="discovery-url">@discovered.ServerUrl</div>
                    <div class="discovery-backend">@discovered.Backend</div>
                  </div>
                </div>
                <div class="discovery-actions">
                  <button class="btn btn-sm btn-primary" @onclick="() => AddDiscoveredPrinter(discovered)" disabled="@isAddingPrinter">
                    @if (isAddingPrinter && selectedDiscoveredPrinter?.ServerUrl == discovered.ServerUrl)
                    {
                      <div class="spinner-sm"></div>
                    }
                    else
                    {
                      <span>Add</span>
                    }
                  </button>
                </div>
              </div>
            </div>
          }
        </div>
        <button class="btn btn-secondary btn-sm" @onclick="ClearDiscoveredPrinters" style="margin-top: 1rem;">
          Clear Discovery Results
        </button>
      </div>
    }

    <ul>
      @if (printers is null)
      {
        <div class="loading-state">
          <div class="spinner"></div>
          <p>Loading printers...</p>
        </div>
      }
      else if (printers.Count == 0)
      {
        <div class="empty-state">
          <div class="empty-icon">🖨️</div>
          <h3>No Printers Found</h3>
          <p>Add your first printer to get started with print management.</p>
          <a href="/printers/new" class="btn btn-primary">Add Printer</a>
        </div>
      }
      else
      {
        <div class="cards">
          @foreach (var p in printers)
          {
            <div class="card">
              <div class="card-header-unified">
                <div class="card-header-main">
                  <div class="printer-identity">
                    <div class="name caps-font">@p.Name</div>
                    @if (!string.IsNullOrWhiteSpace(p.ManufacturerName) || !string.IsNullOrWhiteSpace(p.ModelName))
                    {
                      <div class="model mini-header">@($"{p.ManufacturerName} {p.ModelName}".Trim())</div>
                    }
                    <div class="url-row">
                      <div class="url mini-header">@p.ServerUrl</div>
                      <a class="icon-btn" href="@ToPort80(p.ServerUrl)" target="_blank" rel="noopener" title="Open printer (port 80)" aria-label="Open printer on port 80">
                        <!-- External link icon -->
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3z"/>
                          <path d="M5 5h6V3H5c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2v-6h-2v6H5V5z"/>
                        </svg>
                      </a>
                    </div>
                  </div>
                </div>
                <div class="card-header-actions">
                  <a class="icon-btn" href="/printers/@p.Id/edit" title="Edit details" aria-label="Edit details">
                    <!-- Edit icon -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M3 17.25V21h3.75L20.81 6.94l-3.75-3.75L3 17.25zm2.92 1.33l-.5-1.99 9.9-9.9 1.99 1.99-9.9 9.9z"/>
                      <path d="M18.37 3.87a1.25 1.25 0 011.77 1.77l-1.06 1.06-1.77-1.77 1.06-1.06z"/>
                    </svg>
                  </a>
                  <button class="icon-btn danger" title="Delete printer" aria-label="Delete printer" @onclick="() => ConfirmDelete(p.Id, p.Name)">
                    <!-- Delete icon -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          }
        </div>
      }
    </ul>
  </div>
</div>

@code {
  private List<PrinterDto>? printers;
  private InputFile? fileInput;
  private bool isExporting = false;
  private bool isImporting = false;
  private string importMessage = string.Empty;
  private bool importSuccess = false;
  private readonly string fileInputId = Guid.NewGuid().ToString();
  private string fileInputElementId => $"file-input-{fileInputId}";
  
  // Discovery-related fields
  private List<DiscoveredPrinterDto>? discoveredPrinters;
  private bool isDiscovering = false;
  private string discoveryMessage = string.Empty;
  private bool discoverySuccess = false;
  private bool isAddingPrinter = false;
  private DiscoveredPrinterDto? selectedDiscoveredPrinter;

  protected override async Task OnInitializedAsync()
  {
    // Use fast endpoint for immediate display without waiting for status checks
    try
    {
      printers = await Http.GetFromJsonAsync<List<PrinterDto>>("api/printers/fast");
      StateHasChanged(); // Show printers immediately, all offline initially
    }
    catch (Exception ex)
    {
      Console.WriteLine($"Failed to load printers: {ex.Message}");
      // Fallback to basic endpoint
      var basicPrinters = await Http.GetFromJsonAsync<List<PrinterBasicDto>>("api/printers/basic");
      if (basicPrinters is not null)
      {
        // Create PrinterDto instances with default offline status
        printers = basicPrinters.Select(p => new PrinterDto(
          Id: p.Id,
          Name: p.Name,
          ServerUrl: p.ServerUrl,
          Notes: p.Notes,
          IsOnline: false, // Default to offline until status loads
          State: null,
          ManufacturerName: p.ManufacturerName,
          ModelName: p.ModelName,
          Backend: p.Backend,
          ApiKey: p.ApiKey,
          OriginalServerUrl: p.OriginalServerUrl,
          IpAddress: p.IpAddress
        )).ToList();
        
        StateHasChanged(); // Show cards immediately
      }
    }
    
    // Try to restore discovered printers from session storage
    await RestoreDiscoveredPrinters();
  }

  private async Task RestoreDiscoveredPrinters()
  {
    try
    {
      var discoveredJson = await JS.InvokeAsync<string>("sessionStorage.getItem", "discoveredPrinters");
      if (!string.IsNullOrEmpty(discoveredJson))
      {
        var restoredPrinters = System.Text.Json.JsonSerializer.Deserialize<List<DiscoveredPrinterDto>>(discoveredJson, new System.Text.Json.JsonSerializerOptions
        {
          PropertyNameCaseInsensitive = true
        });
        
        if (restoredPrinters?.Any() == true)
        {
          // Filter out any printers that have already been added to the system
          var existingUrls = printers?.Select(p => p.ServerUrl).ToHashSet() ?? new HashSet<string>();
          discoveredPrinters = restoredPrinters.Where(d => !existingUrls.Contains(d.ServerUrl)).ToList();
          
          if (discoveredPrinters.Count > 0)
          {
            discoveryMessage = $"Restored {discoveredPrinters.Count} remaining discovered printer(s).";
            discoverySuccess = true;
            StateHasChanged();
            
            // Clear message after 5 seconds
            _ = Task.Run(async () =>
            {
              await Task.Delay(5000);
              discoveryMessage = string.Empty;
              await InvokeAsync(StateHasChanged);
            });
          }
          else
          {
            // All discovered printers were already added, clear storage
            await JS.InvokeVoidAsync("sessionStorage.removeItem", "discoveredPrinters");
          }
        }
      }
    }
    catch (Exception ex)
    {
      Console.WriteLine($"Failed to restore discovered printers: {ex.Message}");
    }
  }

  private static string ToPort80(string? url)
  {
    if (string.IsNullOrWhiteSpace(url)) return "#";
    try
    {
      var uri = new Uri(url);
      var builder = new UriBuilder(uri)
      {
        Scheme = Uri.UriSchemeHttp,
        Port = 80
      };
      return builder.Uri.ToString();
    }
    catch
    {
      // Fallback: if it's not a valid URI, prepend http:// and :80
      var trimmed = url.Trim();
      if (!trimmed.StartsWith("http", StringComparison.OrdinalIgnoreCase))
        trimmed = "http://" + trimmed;
      return trimmed.EndsWith(":80", StringComparison.Ordinal) ? trimmed : trimmed.TrimEnd('/') + ":80";
    }
  }

  private async Task TriggerFileInput()
  {
    await JS.InvokeVoidAsync("clickElement", fileInputElementId);
  }

  private async Task ExportPrinters()
  {
    try
    {
      isExporting = true;
      StateHasChanged();

  var response = await Http.GetAsync(new Uri("api/printers/export", UriKind.Relative));
      if (response.IsSuccessStatusCode)
      {
        var content = await response.Content.ReadAsByteArrayAsync();
        var fileName = $"printers-export-{DateTime.Now:yyyy-MM-dd-HHmm}.csv";
        
        // Download the file using JavaScript
        await JS.InvokeVoidAsync("downloadFile", fileName, "text/csv", content);
        
        importMessage = "Printers exported successfully!";
        importSuccess = true;
      }
      else
      {
        importMessage = "Failed to export printers. Please try again.";
        importSuccess = false;
      }
    }
    catch (Exception ex)
    {
      importMessage = $"Export error: {ex.Message}";
      importSuccess = false;
    }
    finally
    {
      isExporting = false;
      StateHasChanged();
      
      // Clear message after 5 seconds
      _ = Task.Run(async () =>
      {
        await Task.Delay(5000);
        importMessage = string.Empty;
        await InvokeAsync(StateHasChanged);
      });
    }
  }

  private async Task OnFileSelected(InputFileChangeEventArgs e)
  {
    var file = e.File;
    if (file == null) return;

    if (!file.Name.EndsWith(".csv", StringComparison.OrdinalIgnoreCase))
    {
      importMessage = "Please select a valid CSV file.";
      importSuccess = false;
      StateHasChanged();
      return;
    }

    try
    {
      isImporting = true;
      importMessage = string.Empty;
      StateHasChanged();

      var content = new MultipartFormDataContent();
      var fileContent = new StreamContent(file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024)); // 5MB max
      fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("text/csv");
      content.Add(fileContent, "file", file.Name);

  var response = await Http.PostAsync(new Uri("api/printers/import", UriKind.Relative), content);
      var responseContent = await response.Content.ReadAsStringAsync();

      if (response.IsSuccessStatusCode)
      {
        var result = System.Text.Json.JsonSerializer.Deserialize<ImportResult>(responseContent, new System.Text.Json.JsonSerializerOptions
        {
          PropertyNameCaseInsensitive = true
        });

        if (result != null)
        {
          var messages = new List<string>();
          messages.Add($"Import completed: {result.ImportedCount} imported, {result.SkippedCount} skipped");
          
          if (result.Errors?.Any() == true)
          {
            messages.Add($"Errors: {string.Join(", ", result.Errors.Take(3))}");
            if (result.Errors.Count > 3)
              messages.Add($"... and {result.Errors.Count - 3} more errors");
          }

          importMessage = string.Join(". ", messages);
          importSuccess = result.ImportedCount > 0 || result.Errors?.Any() != true;

          // Refresh the printers list if any were imported
          if (result.ImportedCount > 0)
          {
            printers = await Http.GetFromJsonAsync<List<PrinterDto>>("api/printers");
          }
        }
        else
        {
          importMessage = "Import completed, but response format was unexpected.";
          importSuccess = false;
        }
      }
      else
      {
        importMessage = $"Import failed: {responseContent}";
        importSuccess = false;
      }
    }
    catch (Exception ex)
    {
      importMessage = $"Import error: {ex.Message}";
      importSuccess = false;
    }
    finally
    {
      isImporting = false;
      StateHasChanged();
      
      // Clear message after 10 seconds for import (longer due to potentially more info)
      _ = Task.Run(async () =>
      {
        await Task.Delay(10000);
        importMessage = string.Empty;
        await InvokeAsync(StateHasChanged);
      });
    }
  }

  private async Task DiscoverPrinters()
  {
    try
    {
      isDiscovering = true;
      discoveryMessage = string.Empty;
      StateHasChanged();

  var response = await Http.GetAsync(new Uri("api/printers/discover", UriKind.Relative));
      if (response.IsSuccessStatusCode)
      {
        var responseContent = await response.Content.ReadAsStringAsync();
        discoveredPrinters = System.Text.Json.JsonSerializer.Deserialize<List<DiscoveredPrinterDto>>(responseContent, new System.Text.Json.JsonSerializerOptions
        {
          PropertyNameCaseInsensitive = true
        });

        if (discoveredPrinters?.Any() == true)
        {
          discoveryMessage = $"Discovery completed! Found {discoveredPrinters.Count} printer(s) on the network.";
          discoverySuccess = true;
        }
        else
        {
          discoveryMessage = "Discovery completed, but no printers were found on the network.";
          discoverySuccess = false;
        }
      }
      else
      {
        var errorContent = await response.Content.ReadAsStringAsync();
        discoveryMessage = $"Discovery failed: {errorContent}";
        discoverySuccess = false;
      }
    }
    catch (Exception ex)
    {
      discoveryMessage = $"Discovery error: {ex.Message}";
      discoverySuccess = false;
    }
    finally
    {
      isDiscovering = false;
      StateHasChanged();
      
      // Clear message after 8 seconds
      _ = Task.Run(async () =>
      {
        await Task.Delay(8000);
        discoveryMessage = string.Empty;
        await InvokeAsync(StateHasChanged);
      });
    }
  }

  private async Task AddDiscoveredPrinter(DiscoveredPrinterDto discovered)
  {
    try
    {
      isAddingPrinter = true;
      selectedDiscoveredPrinter = discovered;
      StateHasChanged();

      // Create a URL with pre-filled data for the add printer page
      var queryParams = new List<string>
      {
        $"name={Uri.EscapeDataString(discovered.Name)}",
        $"serverUrl={Uri.EscapeDataString(discovered.ServerUrl)}",
        $"backend={discovered.Backend}",
        $"ipAddress={Uri.EscapeDataString(discovered.IpAddress)}",
        $"returnTo=manage" // Add return parameter to indicate where to go back
      };

      if (!string.IsNullOrEmpty(discovered.Manufacturer))
      {
        queryParams.Add($"manufacturer={Uri.EscapeDataString(discovered.Manufacturer)}");
      }
      
      if (!string.IsNullOrEmpty(discovered.Model))
      {
        queryParams.Add($"model={Uri.EscapeDataString(discovered.Model)}");
      }

      var url = $"/printers/new?{string.Join("&", queryParams)}";
      
      // Store discovered printers in session storage before navigation
      var discoveredJson = System.Text.Json.JsonSerializer.Serialize(discoveredPrinters);
      await JS.InvokeVoidAsync("sessionStorage.setItem", "discoveredPrinters", discoveredJson);
      
      // Navigate in same tab to preserve the flow
      Nav.NavigateTo(url);
    }
    catch (Exception ex)
    {
      discoveryMessage = $"Failed to add printer: {ex.Message}";
      discoverySuccess = false;
      StateHasChanged();
    }
    finally
    {
      isAddingPrinter = false;
      selectedDiscoveredPrinter = null;
      StateHasChanged();
    }
  }

  private void ClearDiscoveredPrinters()
  {
    discoveredPrinters = null;
    discoveryMessage = string.Empty;
    StateHasChanged();
  }

  // DTO for import result
  public class ImportResult
  {
    public int ImportedCount { get; set; }
    public int SkippedCount { get; set; }
    public List<object>? Results { get; set; }
    public List<string>? Errors { get; set; }
  }

  private async Task ConfirmDelete(Guid printerId, string printerName)
  {
    var confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete the printer '{printerName}'? This action cannot be undone.");
    if (confirmed)
    {
      await DeletePrinter(printerId, printerName);
    }
  }

  private async Task DeletePrinter(Guid printerId, string printerName)
  {
    try
    {
  var response = await Http.DeleteAsync(new Uri($"api/printers/{printerId}", UriKind.Relative));
      if (response.IsSuccessStatusCode)
      {
        // Remove printer from local list
        printers?.RemoveAll(p => p.Id == printerId);
        StateHasChanged();
        
        // Show success message
        importMessage = $"Printer '{printerName}' deleted successfully.";
        importSuccess = true;
      }
      else
      {
        importMessage = $"Failed to delete printer '{printerName}'. Server returned: {(int)response.StatusCode}";
        importSuccess = false;
      }
    }
    catch (Exception ex)
    {
      importMessage = $"Error deleting printer '{printerName}': {ex.Message}";
      importSuccess = false;
    }
    
    StateHasChanged();
    
    // Clear message after 5 seconds
    _ = Task.Run(async () =>
    {
      await Task.Delay(5000);
      importMessage = string.Empty;
      if (InvokeAsync(() => StateHasChanged()).IsCompleted == false)
      {
        // Component might be disposed, ignore
      }
    });
  }
}
