@code {
    private List<GcodeHarvestOperationDto> harvestOperations = new();
    private List<PrinterBasicDto> availablePrinters = new();
    private List<DiscoveredGcodeFileDto> discoveredFiles = new();
    
    private GcodeHarvestOperationDto? currentOperation;
    private bool isLoading = true;
    private bool showStartHarvestDialog = false;
    private bool isStartingHarvest = false;
    
    private string selectedPrinterId = "";
    private bool includeSubdirectories = true;
    private int maxFileSizeMB = 100;
    private DateTime? modifiedAfter;
    
    private Timer? progressTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        isLoading = false;
    }

    private async Task LoadData()
    {
        await Task.WhenAll(
            LoadHarvestOperations(),
            LoadAvailablePrinters()
        );
    }

    private async Task LoadAvailablePrinters()
    {
        try
        {
            availablePrinters = await PrinterService.GetPrintersAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading printers: {ex.Message}");
            availablePrinters = new List<PrinterBasicDto>();
        }
    }

    private async Task LoadHarvestOperations()
    {
        try
        {
            // Get active harvest operations to restore state
            var activeOperations = await GcodeLibraryService.GetActiveHarvestsAsync();
            
            // If there's an active operation, restore it as the current operation
            if (activeOperations.Any())
            {
                currentOperation = activeOperations.FirstOrDefault();
                if (currentOperation != null)
                {
                    // Load discovered files for the active operation
                    discoveredFiles = (await GcodeLibraryService.GetDiscoveredFilesAsync(currentOperation.Id)).ToList();
                    
                    // Start polling for progress if the operation is still running
                    if (currentOperation.Status == GcodeHarvestStatusDto.Running)
                    {
                        StartProgressPolling();
                    }
                }
            }
            
            // Load all recent operations for display
            harvestOperations = activeOperations.ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading harvest operations: {ex.Message}");
            harvestOperations = new List<GcodeHarvestOperationDto>();
        }
    }

    private async Task ShowStartHarvestDialog()
    {
        selectedPrinterId = "";
        includeSubdirectories = true;
        maxFileSizeMB = 100;
        modifiedAfter = null;
        
        // Refresh printer list to ensure it's up to date
        await LoadAvailablePrinters();
        
        showStartHarvestDialog = true;
    }

    private void HideStartHarvestDialog()
    {
        showStartHarvestDialog = false;
    }

    private async Task StartHarvest()
    {
        if (string.IsNullOrEmpty(selectedPrinterId) || !Guid.TryParse(selectedPrinterId, out var printerId))
            return;

        isStartingHarvest = true;
        StateHasChanged();

        try
        {
            var request = new StartGcodeHarvestDto
            {
                PrinterId = printerId,
                IncludeSubdirectories = includeSubdirectories,
                MaxFileSizeBytes = maxFileSizeMB * 1024 * 1024, // Convert MB to bytes
                ModifiedAfter = modifiedAfter
            };

            var result = await GcodeLibraryService.StartHarvestAsync(request);
            if (result?.Success == true)
            {
                HideStartHarvestDialog();
                
                // Load the operation details
                currentOperation = await GcodeLibraryService.GetHarvestOperationAsync(result.OperationId);
                discoveredFiles = new List<DiscoveredGcodeFileDto>();
                
                // Start polling for progress
                StartProgressPolling();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", result?.Message ?? "Failed to start harvest operation");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error starting harvest: {ex.Message}");
        }
        finally
        {
            isStartingHarvest = false;
            StateHasChanged();
        }
    }

    private void StartProgressPolling()
    {
        progressTimer?.Dispose();
        progressTimer = new Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await UpdateCurrentOperation();
            });
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(2));
    }

    private async Task UpdateCurrentOperation()
    {
        if (currentOperation == null) return;

        try
        {
            var updated = await GcodeLibraryService.GetHarvestOperationAsync(currentOperation.Id);
            if (updated != null)
            {
                currentOperation = updated;
                
                // Load discovered files
                discoveredFiles = await GcodeLibraryService.GetDiscoveredFilesAsync(currentOperation.Id);
                
                StateHasChanged();
                
                // Stop polling if operation is complete
                if (updated.Status != GcodeHarvestStatusDto.Running)
                {
                    progressTimer?.Dispose();
                    progressTimer = null;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating harvest operation: {ex.Message}");
        }
    }

    private async Task CancelCurrentOperation()
    {
        if (currentOperation == null) return;

        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to cancel this harvest operation?"))
        {
            await GcodeLibraryService.CancelHarvestAsync(currentOperation.Id);
            progressTimer?.Dispose();
            progressTimer = null;
            currentOperation = null;
            discoveredFiles = new List<DiscoveredGcodeFileDto>();
            StateHasChanged();
        }
    }

    private void ClearCurrentOperation()
    {
        progressTimer?.Dispose();
        progressTimer = null;
        currentOperation = null;
        discoveredFiles = new List<DiscoveredGcodeFileDto>();
    }

    private void SelectAllFiles()
    {
        var newState = !discoveredFiles.Where(f => !f.AlreadyInLibrary).All(f => f.IsSelected);
        foreach (var file in discoveredFiles.Where(f => !f.AlreadyInLibrary))
        {
            ToggleFileSelection(file, newState);
        }
        StateHasChanged();
    }

    private void ToggleFileSelection(DiscoveredGcodeFileDto file, bool isSelected)
    {
        // Since IsSelected is init-only, we need to create a new record
        var index = discoveredFiles.IndexOf(file);
        if (index >= 0)
        {
            discoveredFiles[index] = file with { IsSelected = isSelected };
        }
    }

    private async Task ImportSelectedFiles()
    {
        if (currentOperation == null) return;

        var selectedFiles = discoveredFiles.Where(f => f.IsSelected).ToArray();
        if (!selectedFiles.Any()) return;

        try
        {
            var request = new ImportSelectedGcodeFilesDto
            {
                HarvestOperationId = currentOperation.Id,
                SelectedFileIds = selectedFiles.Select(f => f.Id).ToArray(),
                AddToLibraryOnly = true,
                AutoDetectCapabilities = true
            };

            var success = await GcodeLibraryService.ImportSelectedFilesAsync(request);
            if (success)
            {
                // Refresh the operation to see updated counts
                await UpdateCurrentOperation();
                await JSRuntime.InvokeVoidAsync("alert", $"Successfully imported {selectedFiles.Length} files to your library!");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Failed to import selected files");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error importing files: {ex.Message}");
        }
    }

    private void ViewHarvestResults(Guid operationId)
    {
        Navigation.NavigateTo($"/library?harvest={operationId}");
    }

    private void ViewHarvestResults()
    {
        if (currentOperation != null)
        {
            ViewHarvestResults(currentOperation.Id);
        }
    }

    private async Task DeleteOperation(Guid operationId)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this harvest operation?"))
        {
            // TODO: Implement delete operation API call
            await LoadHarvestOperations();
        }
    }

    private string GetOperationStatusClass(GcodeHarvestStatusDto status)
    {
        return status.ToString().ToLowerInvariant();
    }

    private string GetStatusIcon(GcodeHarvestStatusDto status)
    {
        return status switch
        {
            GcodeHarvestStatusDto.Running => "🔄",
            GcodeHarvestStatusDto.Completed => "✅",
            GcodeHarvestStatusDto.Failed => "❌",
            GcodeHarvestStatusDto.Cancelled => "⏹️",
            _ => "❓"
        };
    }

    private string GetFileStatusIcon(DiscoveredGcodeFileDto file)
    {
        if (file.ProcessingFailed) return "❌";
        if (file.AlreadyInLibrary) return "✅";
        return "📄";
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1024 * 1024 * 1024) return $"{bytes / (1024.0 * 1024):F1} MB";
        return $"{bytes / (1024.0 * 1024 * 1024):F1} GB";
    }

    private string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalMinutes < 1) return $"{duration.Seconds}s";
        if (duration.TotalHours < 1) return $"{duration.TotalMinutes:F0}m";
        return $"{duration.TotalHours:F1}h";
    }

    public async ValueTask DisposeAsync()
    {
        progressTimer?.Dispose();
        await Task.CompletedTask;
    }
}
