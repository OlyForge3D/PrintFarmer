@page "/harvest"
@using Farm.Web.Shared
@using Farm.Web.Client.Services
@inject GcodeLibraryService GcodeLibraryService
@inject PrinterService PrinterService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>G-code Harvester - PrintFarmer</PageTitle>

<div class="harvest-container">
    <div class="harvest-header">
        <h1>G-code Harvester</h1>
        <button class="btn btn-primary" @onclick="ShowStartHarvestDialog" disabled="@(currentOperation != null)">
            🌾 Start New Harvest
        </button>
    </div>

    <div class="harvest-info">
        <div class="info-card">
            <h3>What is G-code Harvesting?</h3>
            <p>
                The G-code harvester scans your printers for existing G-code files and imports them into your library.
                This is useful for collecting files that are already on your printers from previous prints or transfers.
            </p>
            <ul>
                <li>Scans printer storage for .gcode files</li>
                <li>Extracts metadata from file headers</li>
                <li>Detects duplicates to avoid re-importing</li>
                <li>Preserves original printer paths for reference</li>
            </ul>
        </div>
    </div>

    @if (currentOperation != null)
    {
        <div class="current-operation">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">🌾 Harvesting from @currentOperation.PrinterName</div>
                    <div class="card-subtitle">Started @currentOperation.StartedAt.ToString("MMM d, yyyy 'at' h:mm tt")</div>
                </div>
                <div class="card-body">
                    <div class="operation-summary">
                        <div class="summary-item">
                            <span class="summary-value">@currentOperation.FilesFound</span>
                            <span class="summary-label">Files Found</span>
                        </div>
                        <div class="summary-item">
                            <span class="summary-value">@currentOperation.FilesAdded</span>
                            <span class="summary-label">Imported</span>
                        </div>
                        <div class="summary-item">
                            <span class="summary-value">@currentOperation.FilesSkipped</span>
                            <span class="summary-label">Skipped</span>
                        </div>
                        @if (currentOperation.FilesErrored > 0)
                        {
                            <div class="summary-item">
                                <span class="summary-value" style="color: #ef4444;">@currentOperation.FilesErrored</span>
                                <span class="summary-label">Errors</span>
                            </div>
                        }
                    </div>

                    <div class="status-section">
                        <div class="status-badge @GetOperationStatusClass(currentOperation.Status)">
                            @GetStatusIcon(currentOperation.Status) @currentOperation.Status
                        </div>
                        
                        @if (currentOperation.Status == GcodeHarvestStatusDto.Running)
                        {
                            <div class="progress-container">
                                <div class="progress">
                                    <div class="progress-bar" style="width: @(currentOperation.FilesFound > 0 ? (currentOperation.FilesFound * 100.0 / Math.Max(currentOperation.FilesFound, 1)) : 0)%"></div>
                                </div>
                                <div class="progress-text">
                                    Processing files... @currentOperation.FilesFound found
                                </div>
                            </div>
                        }
                    </div>

                    <div class="action-buttons">
                        @if (currentOperation.Status == GcodeHarvestStatusDto.Running)
                        {
                            <button class="btn btn-outline-danger" @onclick="CancelCurrentOperation">
                                ⏹️ Cancel Operation
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-outline-primary" @onclick="ViewHarvestResults">
                                📚 View in Library
                            </button>
                            <button class="btn btn-outline-danger" @onclick="ClearCurrentOperation">
                                🗑️ Clear
                            </button>
                        }
                    </div>

                    @if (discoveredFiles.Any())
                    {
                        <div class="files-section">
                            <div class="files-header">
                                <h3>📁 Discovered Files (@discoveredFiles.Count)</h3>
                                <div class="bulk-actions-right">
                                    @if (discoveredFiles.Any(f => f.IsSelected))
                                    {
                                        <button class="btn btn-success btn-sm" @onclick="ImportSelectedFiles">
                                            📥 Import Selected (@discoveredFiles.Count(f => f.IsSelected))
                                        </button>
                                    }
                                </div>
                            </div>

                            <div class="files-list">
                                <div class="bulk-actions">
                                    <div class="bulk-actions-left">
                                        <label class="form-check">
                                            <input type="checkbox" 
                                                   @onchange="@(e => SelectAllFiles())"
                                                   checked="@discoveredFiles.Where(f => !f.AlreadyInLibrary).All(f => f.IsSelected)">
                                            <span class="form-check-label">Select All</span>
                                        </label>
                                        <span class="text-muted">
                                            @discoveredFiles.Count(f => f.IsSelected) of @discoveredFiles.Count(f => !f.AlreadyInLibrary) selected
                                        </span>
                                    </div>
                                </div>

                                @foreach (var file in discoveredFiles.OrderBy(f => f.FileName))
                                {
                                    <div class="file-item">
                                        @if (!file.AlreadyInLibrary && !file.ProcessingFailed)
                                        {
                                            <div class="file-checkbox">
                                                <input type="checkbox" @onchange="@(e => ToggleFileSelection(file, (bool)e.Value!))">
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="file-checkbox">
                                                <input type="checkbox" disabled>
                                            </div>
                                        }

                                        <div class="file-icon">@GetFileStatusIcon(file)</div>
                                        
                                        <div class="file-info">
                                            <div class="file-name">@file.FileName</div>
                                            <div class="file-meta">
                                                <span>@FormatFileSize(file.FileSizeBytes)</span>
                                                @if (file.ModifiedAt.HasValue)
                                                {
                                                    <span>Modified @file.ModifiedAt.Value.ToString("MMM d, yyyy")</span>
                                                }
                                                @if (file.ExtractedPrintTime.HasValue)
                                                {
                                                    <span>Print time: @FormatDuration(TimeSpan.FromMinutes(file.ExtractedPrintTime.Value))</span>
                                                }
                                            </div>
                                        </div>

                                        <div class="file-status @(file.AlreadyInLibrary ? "in-library" : file.ProcessingFailed ? "failed" : "new")">
                                            @if (file.AlreadyInLibrary)
                                            {
                                                <span>In Library</span>
                                            }
                                            else if (file.ProcessingFailed)
                                            {
                                                <span>Failed</span>
                                            }
                                            else
                                            {
                                                <span>New</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else if (currentOperation.Status == GcodeHarvestStatusDto.Completed && currentOperation.FilesFound == 0)
                    {
                        <div class="no-files">
                            <div class="empty-icon">📂</div>
                            <p>No G-code files were found on this printer.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @if (isLoading)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>Loading harvest operations...</p>
        </div>
    }
    else if (harvestOperations.Any())
    {
        <div class="operations-list">
            <h2>Previous Harvest Operations</h2>
            @foreach (var operation in harvestOperations.OrderByDescending(o => o.StartedAt))
            {
                <div class="operation-card @GetOperationStatusClass(operation.Status)">
                    <div class="operation-header">
                        <div class="operation-info">
                            <h3>@operation.PrinterName</h3>
                            <div class="operation-status">@GetStatusIcon(operation.Status) @operation.Status</div>
                        </div>
                        <div class="operation-actions">
                            <button class="btn-icon" @onclick="() => ViewHarvestResults(operation.Id)" title="View Results">
                                📚
                            </button>
                            <button class="btn-icon" @onclick="() => DeleteOperation(operation.Id)" title="Delete">
                                🗑️
                            </button>
                        </div>
                    </div>

                    <div class="stats-grid">
                        <div class="stat">
                            <span class="stat-number">@operation.FilesFound</span>
                            <span class="stat-label">Found</span>
                        </div>
                        <div class="stat">
                            <span class="stat-number">@operation.FilesAdded</span>
                            <span class="stat-label">Added</span>
                        </div>
                        <div class="stat">
                            <span class="stat-number">@operation.FilesSkipped</span>
                            <span class="stat-label">Skipped</span>
                        </div>
                        @if (operation.FilesErrored > 0)
                        {
                            <div class="stat error">
                                <span class="stat-number">@operation.FilesErrored</span>
                                <span class="stat-label">Errors</span>
                            </div>
                        }
                    </div>

                    <div class="operation-times">
                        <div class="time-item">
                            <span class="time-label">Started:</span>
                            <span class="time-value">@operation.StartedAt.ToString("MMM d, yyyy 'at' h:mm tt")</span>
                        </div>
                        @if (operation.CompletedAt.HasValue)
                        {
                            <div class="time-item">
                                <span class="time-label">Completed:</span>
                                <span class="time-value">@operation.CompletedAt.Value.ToString("MMM d, yyyy 'at' h:mm tt")</span>
                            </div>
                            <div class="time-item">
                                <span class="time-label">Duration:</span>
                                <span class="time-value">@FormatDuration(operation.CompletedAt.Value - operation.StartedAt)</span>
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(operation.ErrorMessage))
                    {
                        <div class="error-message">
                            <strong>Error:</strong> @operation.ErrorMessage
                        </div>
                    }
                </div>
            }
        </div>
    }
    else if (!isLoading && currentOperation == null)
    {
        <div class="empty-state">
            <div class="empty-state-icon">🌾</div>
            <h2>No Harvest Operations Yet</h2>
            <p>Start your first harvest operation to begin collecting G-code files from your printers.</p>
        </div>
    }
</div>

@* Start Harvest Modal *@
@if (showStartHarvestDialog)
{
    <div class="modal-overlay" @onclick="HideStartHarvestDialog">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>🌾 Start G-code Harvest</h2>
                <button class="modal-close" @onclick="HideStartHarvestDialog">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="printer">Printer</label>
                    <select @bind="selectedPrinterId" class="form-select" id="printer">
                        <option value="">Select a printer...</option>
                        @foreach (var printer in availablePrinters)
                        {
                            <option value="@printer.Id">@printer.Name (@printer.ModelName)</option>
                        }
                    </select>
                    <small class="form-text">Choose which printer to harvest G-code files from</small>
                </div>

                <div class="form-group">
                    <label>
                        <input type="checkbox" @bind="includeSubdirectories">
                        Include subdirectories
                    </label>
                    <small class="form-text">Search in all folders, not just the root directory</small>
                </div>

                <div class="form-group">
                    <label for="maxSize">Maximum file size (MB)</label>
                    <input @bind="maxFileSizeMB" type="number" min="1" max="1000" class="form-input" id="maxSize">
                    <small class="form-text">Skip files larger than this size</small>
                </div>

                <div class="form-group">
                    <label for="modifiedAfter">Only files modified after</label>
                    <input @bind="modifiedAfter" type="date" class="form-input" id="modifiedAfter">
                    <small class="form-text">Leave empty to include all files</small>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="HideStartHarvestDialog">Cancel</button>
                <button class="btn btn-primary" @onclick="StartHarvest" disabled="@(string.IsNullOrEmpty(selectedPrinterId) || isStartingHarvest)">
                    @if (isStartingHarvest)
                    {
                        <span class="spinner"></span>
                    }
                    🌾 Start Harvest
                </button>
            </div>
        </div>
    </div>
}

