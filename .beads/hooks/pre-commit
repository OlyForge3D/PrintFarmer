#!/usr/bin/env bash
# =============================================================================
# Pre-commit hook — lint staged files for fast local feedback
# Mirrors CI checks: ShellCheck, yamllint, path casing, ESLint, dotnet format
# =============================================================================

set -uo pipefail

readonly REPO_ROOT="$(git rev-parse --show-toplevel)"
STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACM)"

if [[ -z "$STAGED_FILES" ]]; then
  exit 0
fi

# ---------------------------------------------------------------------------
# Color helpers (standalone — no dependency on common-utils.sh)
# ---------------------------------------------------------------------------
if [[ -t 1 ]]; then
  readonly RED='\033[0;31m'
  readonly GREEN='\033[0;32m'
  readonly YELLOW='\033[0;33m'
  readonly BOLD='\033[1m'
  readonly RESET='\033[0m'
else
  readonly RED='' GREEN='' YELLOW='' BOLD='' RESET=''
fi

pass()  { printf "${GREEN}✅ %s${RESET}\n" "$1"; }
fail()  { printf "${RED}❌ %s${RESET}\n" "$1"; }
skip()  { printf "${YELLOW}⚠️  %s${RESET}\n" "$1"; }
header(){ printf "\n${BOLD}%s${RESET}\n" "$1"; }

ERRORS=0

# ---------------------------------------------------------------------------
# Helper: filter staged files by extension
# ---------------------------------------------------------------------------
staged_by_ext() {
  local pattern="$1"
  echo "$STAGED_FILES" | grep -E "$pattern" || true
}

# ---------------------------------------------------------------------------
# 1. ShellCheck — staged *.sh files
# ---------------------------------------------------------------------------
SH_FILES="$(staged_by_ext '\.sh$')"
if [[ -n "$SH_FILES" ]]; then
  header "ShellCheck"
  if command -v shellcheck >/dev/null 2>&1; then
    sc_fail=0
    while IFS= read -r f; do
      if ! shellcheck -x -s bash "$REPO_ROOT/$f" 2>&1; then
        sc_fail=1
      fi
    done <<< "$SH_FILES"
    if [[ $sc_fail -eq 0 ]]; then
      pass "ShellCheck passed"
    else
      fail "ShellCheck found issues"
      ERRORS=$((ERRORS + 1))
    fi
  else
    skip "shellcheck not installed — brew install shellcheck"
  fi
fi

# ---------------------------------------------------------------------------
# 2. yamllint — staged *.yml / *.yaml files
# ---------------------------------------------------------------------------
YAML_FILES="$(staged_by_ext '\.(yml|yaml)$')"
if [[ -n "$YAML_FILES" ]]; then
  header "yamllint"
  if command -v yamllint >/dev/null 2>&1; then
    yl_fail=0
    while IFS= read -r f; do
      if ! yamllint "$REPO_ROOT/$f" 2>&1; then
        yl_fail=1
      fi
    done <<< "$YAML_FILES"
    if [[ $yl_fail -eq 0 ]]; then
      pass "yamllint passed"
    else
      fail "yamllint found issues"
      ERRORS=$((ERRORS + 1))
    fi
  else
    skip "yamllint not installed — pip install yamllint"
  fi
fi

# ---------------------------------------------------------------------------
# 3. Path casing — replicate enforce-path-casing.yml logic
#    Checks that git-tracked path components match on-disk casing.
# ---------------------------------------------------------------------------
header "Path casing"
if command -v node >/dev/null 2>&1 && [[ -f "$REPO_ROOT/scripts/check-path-casing.js" ]]; then
  pc_fail=0
  # The script checks all tracked files; for speed we still run it but it's
  # fast (< 200ms) and gives the same guarantee as the CI workflow.
  if ! node "$REPO_ROOT/scripts/check-path-casing.js" 2>&1; then
    pc_fail=1
  fi
  if [[ $pc_fail -eq 0 ]]; then
    pass "Path casing OK"
  else
    fail "Path casing mismatch detected"
    ERRORS=$((ERRORS + 1))
  fi
else
  skip "node or scripts/check-path-casing.js not available — skipping path casing check"
fi

# ---------------------------------------------------------------------------
# 4. ESLint — staged *.ts / *.tsx files
# ---------------------------------------------------------------------------
TS_FILES="$(staged_by_ext '\.(ts|tsx)$')"
if [[ -n "$TS_FILES" ]]; then
  header "ESLint"
  REACT_DIR="$REPO_ROOT/src/Web/ReactApp"
  if [[ -f "$REACT_DIR/node_modules/.bin/eslint" ]]; then
    eslint_fail=0
    # Build file list relative to ReactApp for eslint config resolution
    eslint_args=()
    while IFS= read -r f; do
      eslint_args+=("$REPO_ROOT/$f")
    done <<< "$TS_FILES"
    if ! (cd "$REACT_DIR" && npx eslint --no-warn-ignored "${eslint_args[@]}" 2>&1); then
      eslint_fail=1
    fi
    if [[ $eslint_fail -eq 0 ]]; then
      pass "ESLint passed"
    else
      fail "ESLint found issues"
      ERRORS=$((ERRORS + 1))
    fi
  else
    skip "ESLint not installed — run 'npm install' in src/Web/ReactApp/"
  fi
fi

# ---------------------------------------------------------------------------
# 5. dotnet format — staged *.cs files
# ---------------------------------------------------------------------------
CS_FILES="$(staged_by_ext '\.cs$')"
if [[ -n "$CS_FILES" ]]; then
  header "dotnet format"
  if command -v dotnet >/dev/null 2>&1; then
    df_fail=0
    # dotnet format --include accepts space-separated file paths
    cs_args=()
    while IFS= read -r f; do
      cs_args+=("$REPO_ROOT/$f")
    done <<< "$CS_FILES"
    if ! (cd "$REPO_ROOT/src" && dotnet format ./farm-web.sln --verify-no-changes --include "${cs_args[@]}" 2>&1); then
      df_fail=1
    fi
    if [[ $df_fail -eq 0 ]]; then
      pass "dotnet format passed"
    else
      fail "dotnet format found issues — run 'dotnet format ./farm-web.sln' from src/"
      ERRORS=$((ERRORS + 1))
    fi
  else
    skip "dotnet not installed — install .NET SDK"
  fi
fi

# ---------------------------------------------------------------------------
# Result
# ---------------------------------------------------------------------------
echo ""
if [[ $ERRORS -gt 0 ]]; then
  fail "Pre-commit: $ERRORS check(s) failed. Fix issues or commit with --no-verify to bypass."
  exit 1
else
  pass "Pre-commit: all checks passed"
  exit 0
fi

# --- BEGIN BEADS INTEGRATION v0.63.3 ---
# This section is managed by beads. Do not remove these markers.
if command -v bd >/dev/null 2>&1; then
  export BD_GIT_HOOK=1
  _bd_timeout=${BEADS_HOOK_TIMEOUT:-300}
  if command -v timeout >/dev/null 2>&1; then
    timeout "$_bd_timeout" bd hooks run pre-commit "$@"
    _bd_exit=$?
    if [ $_bd_exit -eq 124 ]; then
      echo >&2 "beads: hook 'pre-commit' timed out after ${_bd_timeout}s — continuing without beads"
      _bd_exit=0
    fi
  else
    bd hooks run pre-commit "$@"
    _bd_exit=$?
  fi
  if [ $_bd_exit -eq 3 ]; then
    echo >&2 "beads: database not initialized — skipping hook 'pre-commit'"
    _bd_exit=0
  fi
  if [ $_bd_exit -ne 0 ]; then exit $_bd_exit; fi
fi
# --- END BEADS INTEGRATION v0.63.3 ---
