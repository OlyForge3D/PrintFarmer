# syntax=docker/dockerfile:1
# Web (client) container for PrintFarmer - Static Blazor WASM hosted by Nginx

FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
# Prereqs for Emscripten toolchain used by wasm-tools (needs python on PATH)
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 \
 && ln -s /usr/bin/python3 /usr/local/bin/python \
 && rm -rf /var/lib/apt/lists/*
# Source is in root directory on remote, not in src/ subdirectory
COPY farm-web.sln ./
COPY client/ ./client/
COPY shared/ ./shared/

# Restore client and shared
RUN dotnet restore ./client/Farm.Web.Client.csproj

WORKDIR /src/client
RUN dotnet workload install wasm-tools \
 && dotnet publish Farm.Web.Client.csproj -c Release -o /out --no-restore

FROM nginx:1.27-alpine AS final
WORKDIR /usr/share/nginx/html
COPY --from=build /out/wwwroot .

# Install bash and jq for configuration processing
RUN apk add --no-cache bash jq

# Copy entrypoint script and make it executable
COPY docker-entrypoint-config.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Nginx config for HTTP and HTTPS
COPY deploy/nginx/nginx.conf /etc/nginx/conf.d/default.conf

# Expose both HTTP and HTTPS ports
EXPOSE 80 443

ENTRYPOINT ["/docker-entrypoint.sh"]
