# Normalize text files
* text=auto

# Shell scripts must retain LF for Unix execution
*.sh text eol=lf
install.sh text eol=lf
scripts/**/*.sh text eol=lf

# CI tooling manifest is read by bash/python via process substitution; keep LF
scripts/ci/dotnet-test-manifest.json text eol=lf
# Cross-language CI fixtures include byte-exact signed payloads.
scripts/ci/fixtures/*.json text eol=lf

# Release metadata pins these source artifacts by SHA-256; keep checkout bytes LF-stable.
/scripts/docker/configs/security-config.json text eol=lf
/scripts/docker/configs/security-config.production.json text eol=lf
