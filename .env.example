# PrintFarmer environment example
# Copy to .env and adjust values. Only set admin bootstrap for first-run provisioning.

# --- Core API Settings ---
ASPNETCORE_ENVIRONMENT=Production
DB_PROVIDER=Sqlite
ConnectionStrings__Default=Data Source=/data/farm.db
Redis__ConnectionString=redis:6379
CORS__AllowedOrigins=http://localhost:3000,http://localhost:8080,http://localhost:5001
Jwt__Key=change-me-to-a-long-random-64+char-secret

# --- Optional Spoolman Integration ---
SPOOLMAN_ENABLED=no
SPOOLMAN_BASE_URL=
SPOOLMAN_PORT=

# --- Optional Initial Admin Bootstrap (Disabled by default) ---
# Set ENABLE_ADMIN_BOOTSTRAP=true only for first startup, then remove or set to false.
# Strong password policy: >= 12 characters recommended.
ENABLE_ADMIN_BOOTSTRAP=false
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Distributed Slicing ---
ENABLE_DISTRIBUTED_SLICING=true
ORCA_WORKER_ENDPOINT=http://orcaslicer-worker:8080
PRUSA_WORKER_ENDPOINT=http://prusaslicer-worker:8080

# --- Network Access ---
ALLOW_LOCAL_NETWORK=true
ALLOWED_NETWORK_RANGES=10.0.0.0/24,172.16.0.0/12

# --- Discovery Ports ---
DISCOVERY_PORTS=7125,80

# After creating an admin via bootstrap, set ENABLE_ADMIN_BOOTSTRAP=false and clear ADMIN_* vars.
