# syntax=docker/dockerfile:1
############################################################
# PrusaSlicer Worker Container (Refactored to use slicer-base)
# Builds dedicated Prusa worker and layers only Prusa-specific
# bits atop the common slicer-base runtime.
############################################################

ARG PRUSASLICER_VERSION=2.8.0
ARG PRUSASLICER_URL=https://github.com/prusa3d/PrusaSlicer/releases/download/version_${PRUSASLICER_VERSION}/PrusaSlicer-${PRUSASLICER_VERSION}+linux-x64-GTK3.AppImage
ARG ALLOW_STUB=true
ARG GITHUB_TOKEN
ARG DEBUG_PRUSA_ASSETS=false

########################################
# Build Stage (.NET publish for Prusa worker)
########################################
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Copy shared, infrastructure, and worker project files first (restore layer caching)
COPY Directory.Build.props ./
COPY src/shared/*.csproj ./shared/
COPY src/Infrastructure/*.csproj ./infrastructure/
COPY src/worker-shared/*.csproj ./worker-shared/
COPY src/prusaslicer-worker/*.csproj ./prusaslicer-worker/

RUN dotnet restore ./prusaslicer-worker/Farm.PrusaSlicer.Worker.csproj

COPY src/shared/ ./shared/
COPY src/Infrastructure/ ./infrastructure/
COPY src/worker-shared/ ./worker-shared/
COPY src/prusaslicer-worker/ ./prusaslicer-worker/

RUN dotnet publish ./prusaslicer-worker/Farm.PrusaSlicer.Worker.csproj \
    -c Release -o /app/publish --no-restore --verbosity minimal && \
    # Verify critical runtime files exist and are non-empty
    test -s /app/publish/Farm.PrusaSlicer.Worker.dll && \
    test -s /app/publish/Farm.PrusaSlicer.Worker.runtimeconfig.json && \
    echo "[build] Published files verified successfully" || \
    (echo "[build] ERROR: Critical publish files missing or empty" && exit 1)

########################################
# Runtime Stage (layer on slicer-base)
########################################
########################################
# Assets Stage (download & extract Prusa AppImage)
########################################
FROM slicer-base AS prusaassets
USER root
WORKDIR /tmp
ARG PRUSASLICER_VERSION
ARG PRUSASLICER_URL
ARG ALLOW_STUB
ARG GITHUB_TOKEN
RUN set -e; echo "[prusaassets] Resolving PrusaSlicer version=${PRUSASLICER_VERSION}"; \
    # Install tooling (prefer apt since base is Debian). apk branch retained for future alpine variants.
    apk add --no-cache curl ca-certificates jq 2>/dev/null || ( \
    apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates jq fuse libfuse2 squashfs-tools libarchive-tools p7zip-full file \
    && rm -rf /var/lib/apt/lists/* ); \
    API_URL="https://api.github.com/repos/prusa3d/PrusaSlicer/releases"; \
    AUTH=""; [ -n "${GITHUB_TOKEN}" ] && AUTH="-H Authorization: Bearer ${GITHUB_TOKEN}"; \
    echo "[prusaassets] Querying GitHub Releases API"; \
    dynamic_url=$(curl -H "Accept: application/vnd.github+json" -H "User-Agent: PrusaSlicerWorker/1.0" $AUTH -fsSL "$API_URL" | jq -r --arg tag "version_${PRUSASLICER_VERSION}" --arg raw "${PRUSASLICER_VERSION}" 'map(select(.tag_name==$tag)) | .[0].assets[] | select(.name | test("^PrusaSlicer-" + $raw + "\\+linux-(x64|x86_64)-GTK3(-[0-9]+)?\\.AppImage$"; "i")) | .browser_download_url' | head -n1 || true); \
    if [ -z "$dynamic_url" ]; then \
    dynamic_url=$(curl -H "Accept: application/vnd.github+json" -H "User-Agent: PrusaSlicerWorker/1.0" $AUTH -fsSL "$API_URL" | jq -r --arg tag "version_${PRUSASLICER_VERSION}" --arg raw "${PRUSASLICER_VERSION}" 'map(select(.tag_name==$tag)) | .[0].assets[] | select(.name | (contains($raw) and contains("AppImage") and (contains("x64") or contains("x86_64")))) | .browser_download_url' | head -n1 || true); \
    if [ -n "$dynamic_url" ]; then echo "[prusaassets] Fallback asset discovered: $dynamic_url"; fi; \
    else \
    echo "[prusaassets] Discovered asset: $dynamic_url"; \
    fi; \
    if [ -z "$dynamic_url" ] && [ "${DEBUG_PRUSA_ASSETS}" = "true" ]; then \
    echo "[prusaassets][debug] Listing asset names for tag version_${PRUSASLICER_VERSION}"; \
    curl -H "Accept: application/vnd.github+json" -H "User-Agent: PrusaSlicerWorker/1.0" $AUTH -fsSL "$API_URL" | jq -r --arg tag "version_${PRUSASLICER_VERSION}" 'map(select(.tag_name==$tag)) | .[0].assets[]?.name'; \
    fi; \
    if [ -n "$dynamic_url" ]; then PRUSASLICER_URL="$dynamic_url"; fi; \
    try_download() { url="$1"; echo "[prusaassets] -> $url"; \
    if curl -H "User-Agent: PrusaSlicerWorker/1.0" -fSL -o prusaslicer.AppImage.tmp "$url"; then \
    size=$(stat -c%s prusaslicer.AppImage.tmp || echo 0); \
    if [ "$size" -gt 5000000 ]; then mv prusaslicer.AppImage.tmp prusaslicer.AppImage; return 0; fi; \
    echo "[prusaassets]   (size $size < 5MB, invalid)"; \
    fi; rm -f prusaslicer.AppImage.tmp || true; return 1; }; \
    try_download "${PRUSASLICER_URL}" \
    || try_download "https://github.com/prusa3d/PrusaSlicer/releases/download/version_${PRUSASLICER_VERSION}/PrusaSlicer-${PRUSASLICER_VERSION}+linux-x64-GTK3.AppImage" \
    || echo "[prusaassets] WARNING: Download attempts failed."; \
    mkdir -p /prusaslicer-dist/opt/prusaslicer; \
    if [ -f prusaslicer.AppImage ]; then chmod +x prusaslicer.AppImage; arch=$(uname -m); \
    echo "[prusaassets] File magic: $( (command -v file >/dev/null 2>&1 && file prusaslicer.AppImage) || echo 'file N/A')"; \
    echo "[prusaassets] Head bytes: $(od -An -tx1 -N8 prusaslicer.AppImage 2>/dev/null | tr -s ' ' | sed 's/^ //')"; \
    echo "[prusaassets] Host build arch: $arch"; \
    if [ "$arch" = "x86_64" ] || [ "$arch" = "amd64" ]; then \
    echo "[prusaassets] Attempting unsquashfs extraction (priority)"; \
    if unsquashfs -d squashfs-root prusaslicer.AppImage >/dev/null 2>&1; then \
    echo "[prusaassets] unsquashfs succeeded"; \
    mv squashfs-root /prusaslicer-dist/opt/prusaslicer; \
    cp /prusaslicer-dist/opt/prusaslicer/AppRun /prusaslicer-dist/prusa-slicer || true; \
    else \
    echo "[prusaassets] unsquashfs failed, trying AppImage --appimage-extract"; \
    if ./prusaslicer.AppImage --appimage-extract 2>extract.err; then \
    mv squashfs-root /prusaslicer-dist/opt/prusaslicer; \
    cp /prusaslicer-dist/opt/prusaslicer/AppRun /prusaslicer-dist/prusa-slicer || true; \
    else \
    if grep -qi "exec format error" extract.err; then echo "[prusaassets] Exec format error during exec extraction"; else echo "[prusaassets] AppImage exec extraction failed"; fi; \
    echo "[prusaassets] Attempting 7z fallback"; \
    if command -v 7z >/dev/null 2>&1; then \
    if 7z x -y -oprusa7z prusaslicer.AppImage >/dev/null 2>&1; then \
    echo "[prusaassets] 7z extraction succeeded"; \
    if [ -d prusa7z/squashfs-root ]; then mv prusa7z/squashfs-root /prusaslicer-dist/opt/prusaslicer; fi; \
    if [ ! -d /prusaslicer-dist/opt/prusaslicer ]; then mkdir -p /prusaslicer-dist/opt/prusaslicer; cp -R prusa7z/* /prusaslicer-dist/opt/prusaslicer/ || true; fi; \
    cand=$(find /prusaslicer-dist/opt/prusaslicer -maxdepth 3 -type f -name 'PrusaSlicer*' | head -n1 || true); \
    if [ -n "$cand" ]; then cp "$cand" /prusaslicer-dist/prusa-slicer || true; fi; \
    else \
    echo "[prusaassets] 7z extraction failed"; \
    fi; \
    else echo "[prusaassets] 7z not installed"; fi; \
    if [ ! -f /prusaslicer-dist/prusa-slicer ]; then \
    echo "[prusaassets] Trying bsdtar fallback"; \
    if command -v bsdtar >/dev/null 2>&1; then \
    if bsdtar -xf prusaslicer.AppImage 2>/dev/null; then \
    if [ -d squashfs-root ]; then \
    mv squashfs-root /prusaslicer-dist/opt/prusaslicer; \
    cp /prusaslicer-dist/opt/prusaslicer/AppRun /prusaslicer-dist/prusa-slicer || true; \
    else echo "[prusaassets] bsdtar extracted but no squashfs-root"; fi; \
    else echo "[prusaassets] bsdtar fallback failed"; fi; \
    else echo "[prusaassets] bsdtar not available"; fi; \
    fi; \
    if [ ! -d /prusaslicer-dist/opt/prusaslicer ]; then \
    echo "[prusaassets] Attempting raw squashfs carve (searching hsqs magic)"; \
    off=$(grep -aob 'hsqs' prusaslicer.AppImage | head -n1 | cut -d: -f1 || true); \
    if [ -n "$off" ]; then \
    dd if=prusaslicer.AppImage bs=1 skip=$off of=core.squashfs 2>/dev/null || true; \
    if unsquashfs -d squashfs-root core.squashfs >/dev/null 2>&1; then \
    mv squashfs-root /prusaslicer-dist/opt/prusaslicer; \
    cp /prusaslicer-dist/opt/prusaslicer/AppRun /prusaslicer-dist/prusa-slicer || true; \
    echo "[prusaassets] Carved squashfs extraction succeeded"; \
    else echo "[prusaassets] Carved squashfs extraction failed"; fi; \
    else echo "[prusaassets] hsqs magic not found"; fi; \
    fi; \
    fi; \
    fi; \
    else echo "[prusaassets] Skipping extraction (arch mismatch)"; fi; \
    rm -f prusaslicer.AppImage; \
    fi; \
    if [ ! -f /prusaslicer-dist/prusa-slicer ]; then \
    if [ "${ALLOW_STUB}" = "true" ]; then \
    echo "[prusaassets] Creating stub binary"; \
    printf '#!/bin/sh\n>&2 echo "[WARN] PrusaSlicer binary not present (version %s)"\nexit 2\n' "${PRUSASLICER_VERSION}" > /prusaslicer-dist/prusa-slicer; \
    chmod +x /prusaslicer-dist/prusa-slicer; \
    # Ensure directory exists even in stub mode so final COPY never fails
    mkdir -p /prusaslicer-dist/opt/prusaslicer; \
    else echo "[prusaassets] ERROR: Binary missing and ALLOW_STUB=false"; exit 1; fi; \
    fi

########################################
# Final Runtime Stage
########################################
FROM slicer-base AS final
ARG PRUSASLICER_VERSION
ARG ALLOW_STUB
LABEL component="prusaslicer-worker" \
    prusaslicer.version="${PRUSASLICER_VERSION}" \
    description="Dedicated PrusaSlicer worker container"
USER root
WORKDIR /app
COPY --from=prusaassets /prusaslicer-dist/prusa-slicer /usr/local/bin/prusa-slicer
COPY --from=prusaassets /prusaslicer-dist/opt/prusaslicer /opt/prusaslicer
USER sliceruser
COPY --from=build /app/publish .
ENV Worker__PrusaSlicerPath=/usr/local/bin/prusa-slicer \
    Worker__WorkingDirectory=/app/temp \
    Worker__StorageEndpoint=http://api:5245
EXPOSE 8080
ENTRYPOINT ["dotnet", "Farm.PrusaSlicer.Worker.dll"]