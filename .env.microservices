# PrintFarmer Docker Configuration
# Generated by deploy-docker.sh on Mon Oct  6 13:15:22 PDT 2025

# Architecture
DEPLOYMENT_TYPE=microservices

# Application Settings
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:8080

# Database Configuration
DB_PROVIDER=postgres
ConnectionStrings__Default=Host=postgres;Database=printfarmer;Username=postgres;Password=postgres

# Network Configuration
ALLOW_LOCAL_NETWORK=true
ALLOWED_NETWORK_RANGES=192.168.0.0/16
NETWORK_MODE=host
DOCKER_HOST_NETWORK=true

# CORS Configuration
CORS__AllowedOrigins=http://localhost:3000,http://localhost:8080,http://localhost:5245

# Feature Flags  
ENABLE_SWAGGER=false
ENABLE_DETAILED_LOGGING=false
ENABLE_DISTRIBUTED_SLICING=false
ORCA_WORKER_COUNT=0
PRUSA_WORKER_COUNT=0
ENABLE_ORCA_WORKER=no
ENABLE_PRUSA_WORKER=no
ORCA_HOST_PORT=8081
PRUSA_HOST_PORT=8082

# Spoolman
SPOOLMAN_ENABLED=no
SPOOLMAN_BASE_URL=
SPOOLMAN_PORT=

# Port Configuration
HTTP_PORT=8080
API_PORT=5245

# Redis Configuration
REDIS_CONNECTION=redis:6379

# PostgreSQL Configuration
POSTGRES_DB=printfarmer
POSTGRES_USER=postgres  
POSTGRES_PASSWORD=postgres
