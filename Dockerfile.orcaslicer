# syntax=docker/dockerfile:1
############################################################
# OrcaSlicer Worker Container
# Builds the dedicated Orca slicer worker (.NET) and installs
# OrcaSlicer on top of the neutral slicer-base runtime image.
#
# Expectations:
#  - Parent image 'slicer-base' already built (Dockerfile.slicer-base)
#  - This image focuses ONLY on Orca-specific bits
############################################################

ARG ORCASLICER_VERSION=2.3.1
# Default URL (x86_64). Dynamic discovery may override; we also attempt arm64/aarch64 patterns.
ARG ORCASLICER_URL=https://github.com/SoftFever/OrcaSlicer/releases/download/v${ORCASLICER_VERSION}/OrcaSlicer_Linux_V${ORCASLICER_VERSION}.AppImage
ARG ALLOW_STUB=true
ARG GITHUB_TOKEN

# Pre-install tooling in a separate layer for better caching
FROM printfarmer-slicer-base AS orca-tools
USER root
RUN set -e; apk add --no-cache curl ca-certificates jq 2>/dev/null || (apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates jq fuse libfuse2 squashfs-tools libarchive-tools p7zip-full file && rm -rf /var/lib/apt/lists/*)


########################################
# Build Stage (.NET publish for Orca worker)
########################################
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Copy shared + worker project files first (restore layer caching)

# Copy shared, infrastructure, and worker project files first (restore layer caching)
COPY Directory.Build.props ./
COPY src/shared/*.csproj ./shared/
COPY src/infra/*.csproj ./infra/
COPY src/worker-shared/*.csproj ./worker-shared/
COPY src/orcaslicer-worker/*.csproj ./orcaslicer-worker/

RUN dotnet restore ./orcaslicer-worker/Farm.OrcaSlicer.Worker.csproj

# Copy sources
COPY src/shared/ ./shared/
COPY src/infra/ ./infra/
COPY src/worker-shared/ ./worker-shared/
COPY src/orcaslicer-worker/ ./orcaslicer-worker/

RUN set -e; \
    echo "[build] Starting dotnet publish"; \
    dotnet publish ./orcaslicer-worker/Farm.OrcaSlicer.Worker.csproj -c Release -o /app/publish --verbosity minimal > /tmp/publish.log 2>&1 || (echo "[build] dotnet publish FAILED - dumping /tmp/publish.log" && cat /tmp/publish.log && exit 1); \
    # Verify critical runtime files exist and are non-empty
    test -s /app/publish/Farm.OrcaSlicer.Worker.dll && \
    test -s /app/publish/Farm.OrcaSlicer.Worker.runtimeconfig.json && \
    echo "[build] Published files verified successfully" || \
    (echo "[build] ERROR: Critical publish files missing or empty" && ls -la /app/publish || true && cat /tmp/publish.log || true && exit 1)

########################################
# Runtime Stage
########################################
########################################
# Orca Binary Assets Stage (download & extract) for better caching
########################################
FROM orcaslicer-assets:local AS orcaassets
USER root
WORKDIR /tmp
ARG ORCASLICER_VERSION
ARG ORCASLICER_URL
ARG ALLOW_STUB
ARG GITHUB_TOKEN
ARG PRESEED_SECRET_ID=orca
# If a buildkit secret with id matching PRESEED_SECRET_ID is provided, it will be mounted at /run/secrets/${PRESEED_SECRET_ID}
RUN set -e; echo "[orcaassets] Resolving OrcaSlicer version=${ORCASLICER_VERSION}"; \
    if [ -f "/run/secrets/${PRESEED_SECRET_ID}" ]; then echo "[orcaassets] Using preseeded AppImage from /run/secrets/${PRESEED_SECRET_ID}"; cp "/run/secrets/${PRESEED_SECRET_ID}" orcaslicer.AppImage || true; fi; \
    API_URL="https://api.github.com/repos/SoftFever/OrcaSlicer/releases"; \
    AUTH=""; [ -n "${GITHUB_TOKEN}" ] && AUTH="-H Authorization: Bearer ${GITHUB_TOKEN}"; \
    echo "[orcaassets] Querying GitHub Releases API"; \
    dynamic_url=$(curl -H "Accept: application/vnd.github+json" -H "User-Agent: OrcaSlicerWorker/1.0" $AUTH -fsSL "$API_URL" | jq -r --arg ver "v${ORCASLICER_VERSION}" '.[] | select(.tag_name==$ver) | .assets[] | select(.name | test("(?i)(orca)?slicer.*(linux).*(x86_64|amd64).*AppImage$") or test("(?i)(orca)?slicer.*(aarch64|arm64).*AppImage$") or test("(?i)AppImage$")) | .browser_download_url' | head -n1 || true); \
    if [ -n "$dynamic_url" ]; then echo "[orcaassets] Discovered asset: $dynamic_url"; ORCASLICER_URL="$dynamic_url"; fi; \
    try_download() { url="$1"; echo "[orcaassets] -> $url"; \
    if curl -H "User-Agent: OrcaSlicerWorker/1.0" -fSL -o orcaslicer.AppImage.tmp "$url"; then \
    size=$(stat -c%s orcaslicer.AppImage.tmp || echo 0); \
    if [ "$size" -gt 5000000 ]; then mv orcaslicer.AppImage.tmp orcaslicer.AppImage; return 0; fi; \
    echo "[orcaassets]   (size $size < 5MB, invalid)"; \
    fi; rm -f orcaslicer.AppImage.tmp || true; return 1; }; \
    try_download "${ORCASLICER_URL}" \
    || try_download "https://github.com/SoftFever/OrcaSlicer/releases/download/v${ORCASLICER_VERSION}/OrcaSlicer_V${ORCASLICER_VERSION}_Linux_x86_64.AppImage" \
    || try_download "https://github.com/SoftFever/OrcaSlicer/releases/download/v${ORCASLICER_VERSION}/OrcaSlicer_Linux_V${ORCASLICER_VERSION}.AppImage" \
    || echo "[orcaassets] WARNING: All download attempts failed."; \
    mkdir -p /orcaslicer-dist/opt; \
    if [ -f orcaslicer.AppImage ]; then chmod +x orcaslicer.AppImage; arch=$(uname -m); \
    echo "[orcaassets] File magic: $( (command -v file >/dev/null 2>&1 && file orcaslicer.AppImage) || echo 'file N/A')"; \
    echo "[orcaassets] Head bytes: $(od -An -tx1 -N8 orcaslicer.AppImage 2>/dev/null | tr -s ' ' | sed 's/^ //')"; \
    echo "[orcaassets] Host build arch: $arch"; \
    if [ "$arch" = "x86_64" ] || [ "$arch" = "aarch64" ] || [ "$arch" = "arm64" ]; then \
    echo "[orcaassets] Attempting unsquashfs extraction first"; \
    if unsquashfs -d squashfs-root orcaslicer.AppImage >/dev/null 2>&1; then \
    mv squashfs-root /orcaslicer-dist/opt/orcaslicer; \
    cp /orcaslicer-dist/opt/orcaslicer/AppRun /orcaslicer-dist/orcaslicer || true; \
    else \
    echo "[orcaassets] unsquashfs failed, trying --appimage-extract"; \
    if ./orcaslicer.AppImage --appimage-extract 2>extract.err; then \
    mv squashfs-root /orcaslicer-dist/opt/orcaslicer; \
    cp /orcaslicer-dist/opt/orcaslicer/AppRun /orcaslicer-dist/orcaslicer || true; \
    else \
    echo "[orcaassets] Primary extract failed (exec format or other). Trying 7z then bsdtar then carve"; \
    if command -v 7z >/dev/null 2>&1; then \
    if 7z x -y -oorca7z orcaslicer.AppImage >/dev/null 2>&1; then \
    if [ -d orca7z/squashfs-root ]; then mv orca7z/squashfs-root /orcaslicer-dist/opt/orcaslicer; fi; \
    if [ ! -d /orcaslicer-dist/opt/orcaslicer ]; then mkdir -p /orcaslicer-dist/opt/orcaslicer; cp -R orca7z/* /orcaslicer-dist/opt/orcaslicer/ || true; fi; \
    cp /orcaslicer-dist/opt/orcaslicer/AppRun /orcaslicer-dist/orcaslicer 2>/dev/null || true; \
    else echo "[orcaassets] 7z extraction failed"; fi; \
    fi; \
    if [ ! -d /orcaslicer-dist/opt/orcaslicer ] && command -v bsdtar >/dev/null 2>&1; then \
    if bsdtar -xf orcaslicer.AppImage 2>/dev/null && [ -d squashfs-root ]; then \
    mv squashfs-root /orcaslicer-dist/opt/orcaslicer; \
    cp /orcaslicer-dist/opt/orcaslicer/AppRun /orcaslicer-dist/orcaslicer 2>/dev/null || true; \
    fi; \
    fi; \
    if [ ! -d /orcaslicer-dist/opt/orcaslicer ]; then \
    echo "[orcaassets] Attempting raw carve for hsqs magic"; \
    off=$(grep -aob 'hsqs' orcaslicer.AppImage | head -n1 | cut -d: -f1 || true); \
    if [ -n "$off" ]; then \
    dd if=orcaslicer.AppImage bs=1 skip=$off of=core.squashfs 2>/dev/null || true; \
    if unsquashfs -d squashfs-root core.squashfs >/dev/null 2>&1; then \
    mv squashfs-root /orcaslicer-dist/opt/orcaslicer; \
    cp /orcaslicer-dist/opt/orcaslicer/AppRun /orcaslicer-dist/orcaslicer 2>/dev/null || true; \
    else echo "[orcaassets] Carve unsquashfs failed"; fi; \
    else echo "[orcaassets] hsqs magic not found"; fi; \
    fi; \
    fi; \
    fi; \
    else echo "[orcaassets] Skipping extraction due to unsupported arch: $arch"; fi; \
    rm -f orcaslicer.AppImage; \
    fi; \
    if [ ! -f /orcaslicer-dist/orcaslicer ]; then \
    if [ "${ALLOW_STUB}" = "true" ]; then \
    echo "[orcaassets] Creating stub binary"; \
    printf '#!/bin/sh\n>&2 echo "[WARN] OrcaSlicer binary not present (version %s)"\nexit 2\n' "${ORCASLICER_VERSION}" > /orcaslicer-dist/orcaslicer; \
    chmod +x /orcaslicer-dist/orcaslicer; \
    else echo "[orcaassets] ERROR: Binary missing and ALLOW_STUB=false"; exit 1; fi; \
    fi

########################################
# Final Runtime Stage
########################################
FROM printfarmer-slicer-base AS final
ARG ORCASLICER_VERSION
ARG ALLOW_STUB
LABEL component="orcaslicer-worker" \
    orcaslicer.version="${ORCASLICER_VERSION}" \
    description="Dedicated OrcaSlicer worker container"
USER root
WORKDIR /app

# Install runtime dependencies needed by the OrcaSlicer ELF (graphics / webkit / gstreamer)
RUN set -e; \
        apt-get update && apt-get install -y --no-install-recommends \
            libegl1 libegl1-mesa libgles2 libgtk-3-0 libwebkit2gtk-4.0-37 libjavascriptcoregtk-4.0-18 \
            gstreamer1.0-plugins-base gstreamer1.0-plugins-good gstreamer1.0-plugins-bad \
            gstreamer1.0-libav libgstreamer1.0-0 libgstreamer-plugins-base1.0-0 \
            fontconfig locales tzdata && rm -rf /var/lib/apt/lists/*; \
        # Ensure a minimal locale is present (some GTK/WebKit code expects it)
        locale-gen en_US.UTF-8 || true

# Copy binary assets (real or stub) & optional extracted directory
COPY --from=orcaassets /orcaslicer-dist/orcaslicer /usr/local/bin/orcaslicer
COPY --from=orcaassets /orcaslicer-dist/opt/orcaslicer /opt/orcaslicer

USER sliceruser
COPY --from=build /app/publish .

ENV Worker__OrcaSlicerPath=/usr/local/bin/orcaslicer \
    Worker__WorkingDirectory=/app/temp \
    Worker__StorageEndpoint=http://api:5245

EXPOSE 8080
ENTRYPOINT ["dotnet", "Farm.OrcaSlicer.Worker.dll"]
