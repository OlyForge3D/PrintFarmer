# syntax=docker/dockerfile:1
# API container for PrintFarmer - ASP.NET Core API server only

FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS base
WORKDIR /app
ENV ASPNETCORE_URLS=http://0.0.0.0:8080
EXPOSE 8080

FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Copy solution and projects (api references shared)
COPY src/farm-web.sln ./
COPY src/api/ ./api/
COPY src/shared/ ./shared/

RUN dotnet restore ./api/Farm.Web.Api.csproj

WORKDIR /src/api
RUN dotnet publish Farm.Web.Api.csproj -c Release -o /app/publish --no-restore

FROM base AS final
WORKDIR /app
COPY --from=build /app/publish .

ENTRYPOINT ["dotnet", "Farm.Web.Api.dll"]
