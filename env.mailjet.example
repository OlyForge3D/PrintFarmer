# PrintFarmer Mailjet Email Configuration Example
# Copy needed values into .env.monolithic or .env.microservices (or export before non-interactive deploy)
# Never commit real API keys or secrets.

# Enable email features
Email__Enabled=true

# Provider: mailjet for real sending, console for development logging only
Email__Provider=mailjet

# Sender identity
Email__FromAddress=noreply@yourdomain.com
Email__FromName=PrintFarmer

# Base URL of your deployed site (used to construct links in emails)
Email__BaseUrl=https://yourdomain.com

# Mailjet credentials (replace with your real keys; consider Docker secrets or external secret manager)
Email__Mailjet__ApiKey=YOUR_MAILJET_API_KEY
Email__Mailjet__ApiSecret=YOUR_MAILJET_API_SECRET

# Sandbox mode: true = accept but DO NOT deliver emails; false = live sending
Email__Mailjet__Sandbox=false

# Optional rate limiting overrides (keep defaults unless you have a specific need)
RateLimiting__PasswordReset__MaxPerHour=5
RateLimiting__PasswordReset__MaxPerDay=20
RateLimiting__EmailConfirmation__MaxPerHour=5
RateLimiting__EmailConfirmation__MaxPerDay=20

# Switch to console provider for local dev (uncomment to use)
# Email__Provider=console

# Security Tips:
# - Do NOT store real keys in source control
# - Rotate API keys regularly
# - Configure SPF/DKIM for the domain in Email__FromAddress
# - Restrict access to logs that contain email payload metadata
